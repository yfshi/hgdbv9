#
# PostgreSQL top level makefile
#
# GNUmakefile.in
#
#	Begin - BUGM0000266
#					!!!!!!!READ THIS!!!!!!!
# If you want to add an extension, you should add it in contrib/Makefile,
# Unless your extension is kernel-bound like ivorysql_ora. 
#	End - BUGM0000266

subdir =
top_builddir = .
include $(top_builddir)/src/Makefile.global
 
ifeq ($(with_sqlite),yes)
$(call recurse,all install,src config contrib/gb18030_2022 contrib/ivorysql_ora contrib/pg_object contrib/postgres_fdw contrib/ivorysql_my contrib/uuid-ossp contrib/restricted_dba contrib/pg_audit contrib/sqlite_fdw contrib/pg_track_settings contrib/credcheck contrib/ora_synonym contrib/hg_sysmac contrib/hg_antitamper contrib/hg_rolstatus contrib/hg_integrity_check contrib/diskquota contrib/sql_sentinel)	# SRS-MISC-GB18030	# BUGM0000266 # ReqID:SRS-MISC-MYSQL-FRAME #BUGM59  #ReqID:SRS-SECURITY-AUDIT #ReqID:SRS-SECURITY-IDENTITYAUTH #/* ReqID:SRS-SQL-SYNONYM */ #ReqID:SRS-SECURITY-RESOURCEMANAGEMENT-DISK #SRS-SECURITY-SQL-SENTINEL
else
$(call recurse,all install,src config contrib/gb18030_2022 contrib/ivorysql_ora contrib/pg_object contrib/postgres_fdw contrib/ivorysql_my contrib/uuid-ossp contrib/restricted_dba contrib/pg_audit contrib/pg_track_settings contrib/credcheck contrib/ora_synonym contrib/hg_sysmac contrib/hg_antitamper contrib/hg_rolstatus contrib/hg_integrity_check contrib/diskquota contrib/sql_sentinel)    # SRS-MISC-GB18030      # BUGM0000266 # ReqID:SRS-MISC-MYSQL-FRAME #BUGM59  #ReqID:SRS-SECURITY-AUDIT #ReqID:SRS-SECURITY-IDENTITYAUTH # /* ReqID:SRS-SQL-SYNONYM */ #ReqID:SRS-SECURITY-RESOURCEMANAGEMENT-DISK #SRS-SECURITY-SQL-SENTINEL
endif

# hg_alarm is only built when --enable-compatible-ak is enabled, so it is
# added to the top-level build separately from the fixed list above.
ifeq ($(enable_compatible_ak), yes)
$(call recurse,all install,contrib/hg_alarm)
endif

#/* Begin - BUG#Z00004703 */
#build src/ before contrib/ or make -j 16 maybe failed for contrilb
#rely on src
all-contrib/gb18030_2022-recurse: all-src-recurse
install-contrib/gb18030_2022-recurse: install-src-recurse
all-contrib/ivorysql_ora-recurse: all-src-recurse
install-contrib/ivorysql_ora-recurse: install-src-recurse
all-contrib/pg_object-recurse: all-src-recurse
install-contrib/pg_object-recurse: install-src-recurse
all-contrib/postgres_fdw-recurse: all-src-recurse
install-contrib/postgres_fdw-recurse: install-src-recurse
all-contrib/ivorysql_my-recurse: all-src-recurse
install-contrib/ivorysql_my-recurse: install-src-recurse
all-contrib/uuid-ossp-recurse: all-src-recurse
install-contrib/uuid-ossp-recurse: install-src-recurse
all-contrib/restricted_dba-recurse: all-src-recurse
install-contrib/restricted_dba-recurse: install-src-recurse
all-contrib/pg_audit-recurse: all-src-recurse
install-contrib/pg_audit-recurse: install-src-recurse
ifeq ($(with_sqlite),yes)
all-contrib/sqlite_fdw-recurse: all-src-recurse
install-contrib/sqlite_fdw-recurse: install-src-recurse
endif
all-contrib/pg_track_settings-recurse: all-src-recurse
install-contrib/pg_track_settings-recurse: install-src-recurse
all-contrib/credcheck-recurse: all-src-recurse
install-contrib/credcheck-recurse: install-src-recurse
all-contrib/ora_synonym-recurse: all-src-recurse
install-contrib/ora_synonym-recurse: install-src-recurse
all-contrib/hg_sysmac: all-src-recurse
install-contrib/hg_sysmac: install-src-recurse
all-contrib/hg_antitamper: all-src-recurse
install-contrib/hg_antitamper: install-src-recurse
all-contrib/hg_rolstatus: all-src-recurse
install-contrib/hg_rolstatus: install-src-recurse
all-contrib/hg_integrity_check: all-src-recurse
install-contrib/hg_integrity_check: install-src-recurse
all-contrib/diskquota: all-src-recurse
install-contrib/diskquota: install-src-recurse
#/* End - BUG#Z00004703 */
#Begin - SRS-SECURITY-SQL-SENTINEL
all-contrib/sql_sentinel: all-src-recurse
install-contrib/sql_sentinel: install-src-recurse
#End - SRS-SECURITY-SQL-SENTINEL
# hg_alarm: build src/ before contrib/ (only when --enable-compatible-ak)
ifeq ($(enable_compatible_ak), yes)
all-contrib/hg_alarm-recurse: all-src-recurse
install-contrib/hg_alarm-recurse: install-src-recurse
endif


docs:
	$(MAKE) -C doc all

$(call recurse,world,doc src config contrib,all)

# build src/ before contrib/
world-contrib-recurse: world-src-recurse

$(call recurse,world-bin,src config contrib,all)

# build src/ before contrib/
world-bin-contrib-recurse: world-bin-src-recurse

html man:
	$(MAKE) -C doc $@

install-docs:
	$(MAKE) -C doc install

$(call recurse,install-world,doc src config contrib,install)

# build src/ before contrib/
install-world-contrib-recurse: install-world-src-recurse

$(call recurse,install-world-bin,src config contrib,install)

# build src/ before contrib/
install-world-bin-contrib-recurse: install-world-bin-src-recurse

$(call recurse,installdirs uninstall init-po update-po,doc src config)

$(call recurse,distprep coverage,doc src config contrib)

# clean, distclean, etc should apply to contrib too, even though
# it's not built by default
ifeq ($(with_sqlite),yes)
$(call recurse,clean,doc contrib contrib/ivorysql_ora contrib/gb18030_2022 contrib/postgres_fdw contrib/pg_audit contrib/sqlite_fdw contrib/pg_track_settings contrib/credcheck contrib/hg_sysmac contrib/hg_antitamper  contrib/hg_rolstatus contrib/hg_integrity_check contrib/diskquota src config)	#BUG#M0000243 #BUGM0000266  #ReqID:SRS-SECURITY-AUDIT #ReqID:SRS-SECURITY-IDENTITYAUTH #ReqID:SRS-SECURITY-RESOURCEMANAGEMENT-DISK
else
$(call recurse,clean,doc contrib contrib/ivorysql_ora contrib/gb18030_2022 contrib/postgres_fdw contrib/pg_audit contrib/pg_track_settings contrib/credcheck contrib/hg_sysmac contrib/hg_antitamper  contrib/hg_rolstatus contrib/hg_integrity_check contrib/diskquota src config)     #BUG#M0000243 #BUGM0000266  #ReqID:SRS-SECURITY-AUDIT #ReqID:SRS-SECURITY-IDENTITYAUTH #ReqID:SRS-SECURITY-RESOURCEMANAGEMENT-DISK
endif

clean:
	rm -rf tmp_install/ portlock/
# Garbage from autoconf:
	@rm -rf autom4te.cache/

# Important: distclean `src' last, otherwise Makefile.global
# will be gone too soon.
distclean maintainer-clean:
	$(MAKE) -C doc $@
	$(MAKE) -C contrib $@
	$(MAKE) -C config $@
	$(MAKE) -C src $@
	rm -rf tmp_install/ portlock/
# Garbage from autoconf:
	@rm -rf autom4te.cache/
	rm -f config.cache config.log config.status GNUmakefile

check-tests: | temp-install
check check-tests installcheck installcheck-parallel installcheck-tests oracle-pg-check mysql-pg-check: CHECKPREP_TOP=src/test/regress
check check-tests installcheck installcheck-parallel installcheck-tests oracle-pg-check mysql-pg-check: submake-generated-headers
	$(MAKE) -C src/test/regress $@

#BEGIN - SQL PARSER
# add oracle regression
oracle-check oracle-check-tests oracle-installcheck oracle-installcheck-parallel oracle-installcheck-tests: CHECKPREP_TOP=src/oracle_test/regress
oracle-check oracle-check-tests oracle-installcheck oracle-installcheck-parallel oracle-installcheck-tests: submake-generated-headers
	$(MAKE) -C src/oracle_test/regress $@

# add mysql regression
mysql-check mysql-check-tests mysql-installcheck mysql-installcheck-parallel mysql-installcheck-tests: CHECKPREP_TOP=src/mysql_test/regress
mysql-check mysql-check-tests mysql-installcheck mysql-installcheck-parallel mysql-installcheck-tests: submake-generated-headers
	$(MAKE) -C src/mysql_test/regress $@

#add all check regression
all-check: check oracle-check mysql-check
all-installcheck: installcheck oracle-installcheck mysql-installcheck 
all-check-world:check-world oracle-pg-check-world mysql-pg-check-world oracle-check-world mysql-check-world
all-installcheck-world:installcheck-world oracle-installcheck-world mysql-installcheck-world
# END - SQL PARSER

$(call recurse,check-world,src/test src/pl src/interfaces/ecpg contrib src/bin,check)
$(call recurse,checkprep,  src/test src/pl src/interfaces/ecpg contrib src/bin)

$(call recurse,installcheck-world,src/test src/pl src/interfaces/ecpg contrib src/bin,installcheck)
$(call recurse,install-tests,src/test/regress,install-tests)

#BEGIN - SQL PARSER
$(call recurse,oracle-pg-check-world,src/test,oracle-pg-check)		#BUGM0000237
#add oracle regression
$(call recurse,oracle-check-world,src/oracle_test src/pl src/interfaces/ecpg src/interfaces/libpq/ivytest contrib src/bin,oracle-check)	#BUG#M0000243 #BUGM0000266
$(call recurse,oracle-checkprep,  src/oracle_test src/pl src/interfaces/ecpg contrib src/bin)

$(call recurse,oracle-installcheck-world,src/oracle_test src/pl src/interfaces/ecpg contrib src/bin,oracle-installcheck)
#add mysql regression
$(call recurse,mysql-pg-check-world,src/test/regress,mysql-pg-check)
$(call recurse,mysql-check-world,src/mysql_test src/pl src/interfaces/ecpg contrib src/bin,mysql-check)
$(call recurse,mysql-checkprep,  src/mysql_test src/pl src/interfaces/ecpg contrib src/bin)

$(call recurse,mysql-installcheck-world,src/mysql_test src/pl src/interfaces/ecpg contrib src/bin,mysql-installcheck)
#END - SQL PARSER

GNUmakefile: GNUmakefile.in $(top_builddir)/config.status
	./config.status $@

update-unicode: | submake-generated-headers submake-libpgport
	$(MAKE) -C src/common/unicode $@
	$(MAKE) -C contrib/unaccent $@


##########################################################################

distdir	= postgresql-$(VERSION)
dummy	= =install=

dist: $(distdir).tar.gz $(distdir).tar.bz2
	rm -rf $(distdir)

$(distdir).tar: distdir
	$(TAR) chf $@ $(distdir)

.INTERMEDIATE: $(distdir).tar

distdir-location:
	@echo $(distdir)

distdir:
	rm -rf $(distdir)* $(dummy)
	for x in `cd $(top_srcdir) && find . \( -name CVS -prune \) -o \( -name .git -prune \) -o -print`; do \
	  file=`expr X$$x : 'X\./\(.*\)'`; \
	  if test -d "$(top_srcdir)/$$file" ; then \
	    mkdir "$(distdir)/$$file" && chmod 777 "$(distdir)/$$file";	\
	  else \
	    ln "$(top_srcdir)/$$file" "$(distdir)/$$file" >/dev/null 2>&1 \
	      || cp "$(top_srcdir)/$$file" "$(distdir)/$$file"; \
	  fi || exit; \
	done
	$(MAKE) -C $(distdir) distprep
	$(MAKE) -C $(distdir)/doc/src/sgml/ INSTALL
	cp $(distdir)/doc/src/sgml/INSTALL $(distdir)/
	$(MAKE) -C $(distdir) distclean
	rm -f $(distdir)/README.git

distcheck: dist
	rm -rf $(dummy)
	mkdir $(dummy)
	$(GZIP) -d -c $(distdir).tar.gz | $(TAR) xf -
	install_prefix=`cd $(dummy) && pwd`; \
	cd $(distdir) \
	&& ./configure --prefix="$$install_prefix"
	$(MAKE) -C $(distdir) -q distprep
	$(MAKE) -C $(distdir)
	$(MAKE) -C $(distdir) install
	$(MAKE) -C $(distdir) uninstall
	@echo "checking whether \`$(MAKE) uninstall' works"
	test `find $(dummy) ! -type d | wc -l` -eq 0
	$(MAKE) -C $(distdir) dist
# Room for improvement: Check here whether this distribution tarball
# is sufficiently similar to the original one.
	rm -rf $(distdir) $(dummy)
	@echo "Distribution integrity checks out."

headerscheck: submake-generated-headers
	$(top_srcdir)/src/tools/pginclude/headerscheck $(top_srcdir) $(abs_top_builddir)

cpluspluscheck: submake-generated-headers
	$(top_srcdir)/src/tools/pginclude/cpluspluscheck $(top_srcdir) $(abs_top_builddir)

#.PHONY: dist distdir distcheck docs install-docs world check-world install-world installcheck-world headerscheck cpluspluscheck
#BEGIN - SQL PARSER
.PHONY: dist distdir distcheck docs install-docs world check-world install-world installcheck-world headerscheck cpluspluscheck oracle-pg-check-world oracle-check-world oracle-installcheck-world \
mysql-pg-check-world mysql-check-world mysql-installcheck-world all-check all-check-world all-installcheck-world
#END - SQL PARSER
