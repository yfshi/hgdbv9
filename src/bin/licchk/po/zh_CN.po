#: licchk.c:292 licchk.c:328
#, c-format
msgid "license validate fail.\n"
msgstr "license 验证失败\n"

#: licchk.c:448
#, c-format
msgid "Usage:\n"
msgstr "使用方法:\n"

#: licchk.c:449
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [选项]... [DATADIR]\n"

#: licchk.c:450
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: licchk.c:451
#, c-format
msgid "  -l, --list                  list enabled function items\n"
msgstr "  -l, --list                  列出开启功能项\n"

#: licchk.c:452
#, c-format
msgid "  -a, --all                   all functional items\n"
msgstr "  -a, --all                   列出所有功能项\n"

#: licchk.c:453
#, c-format
msgid "  -v, --view                  show desc information\n"
msgstr "  -v, --view                  显示描述信息\n"

#: licchk.c:454
#, c-format
msgid "  -f, --filename=xxx.dat      set license filename\n"
msgstr "  -f, --filename=xxx.dat      指定license文件名\n"

#: licchk.c:455
#, c-format
msgid "  -c, --check=xxx.txt         check hardware code, then exit.\n"
msgstr "  -c, --check=xxx.txt         检查硬件码，然后退出\n"

#: licchk.c:457
#, c-format
msgid "  -C, --client-information    show client client_info.dat information.\n"
msgstr "  -C, --client-information    显示客户端client_info.dat文件信息\n"

#: licchk.c:458
#, c-format
msgid "  -S, --server-license        show server license.dat information.\n"
msgstr "  -S, --server-license        显示服务端license.dat文件信息\n"

#: licchk.c:459
#, c-format
msgid "  -d, --ignore-datetime-check ignore validity date of the license.\n"
msgstr "  -d, --ignore-datetime-check 忽略license有效日期校验\n"

#: licchk.c:461
#, c-format
msgid "  -m, --max-connections       show max connections.\n"
msgstr "  -m, --max-connections       获取license授权最大连接数\n"

#: licchk.c:462
#, c-format
msgid "  -U, --username              obtain the username from the license file.\n"
msgstr "  -U, --username              获取license文件中默认用户名\n"

#: licchk.c:463
#, c-format
msgid "  -P, --port                  obtain the port from the license file.\n"
msgstr "  -P, --port                  获取license文件中默认端口号\n"

#: licchk.c:465
#, c-format
msgid "  -s, --set-encoding          set license character encoding.\n"
msgstr "  -s, --set-encoding          设置license字符编码\n"

#: licchk.c:466
#, c-format
msgid "  -e, --set-language          set display language(ch or en).\n"
msgstr "  -e, --set-language          设置显示语言(ch 或 en)\n"

#: licchk.c:468
#, c-format
msgid "  -V, --version               output version information, then exit\n"
msgstr "  -V, --version               输出版本信息，然后退出\n"

#: licchk.c:469
#, c-format
msgid "  -?, --help                  show this help, then exit\n"
msgstr "  -?, --help                  显示此帮助，然后退出\n"
