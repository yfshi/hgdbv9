#: licchk.c:248 licchk.c:275
#, c-format
msgid "license validate fail.\n"
msgstr "license 验证失败\n"

#: licchk.c:390
#, c-format
msgid "Usage:\n"
msgstr "使用方法:\n"

#: licchk.c:391
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [选项]... [DATADIR]\n"

#: licchk.c:392
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: licchk.c:393
#, c-format
msgid "  -l, --list                \tlist enabled function items\n"
msgstr "  -l, --list                \t列出开启功能项\n"

#: licchk.c:394
#, c-format
msgid "  -a, --all                 \tall functional items\n"
msgstr "  -a, --all                 \t列出所有功能项\n"

#: licchk.c:395
#, c-format
msgid "  -v, --view                \tshow desc information\n"
msgstr "  -v, --view                \t显示描述信息\n"

#: licchk.c:396
#, c-format
msgid "  -f, --filename=xxx.dat    \tset license filename\n"
msgstr "  -f, --filename=xxx.dat    \t指定license文件名\n"

#: licchk.c:397
#, c-format
msgid "  -c, --check=xxx.txt       \tcheck hardware code, then exit.\n"
msgstr "  -c, --check=xxx.txt       \t检查硬件码，然后退出\n"

#: licchk.c:399
#, c-format
msgid "  -C, --client-license      \tshow client license_cli.dat information.\n"
msgstr "  -C, --client-license      \t显示客户端license_cli.dat文件信息\n"

#: licchk.c:400
#, c-format
msgid "  -S, --server-license      \tshow server license.dat information.\n"
msgstr "  -S, --server-license      \t显示服务端license.dat文件信息\n"

#: licchk.c:401
#, c-format
msgid "  -d, --ignore-datetime-check\tignore validity date of the license.\n"
msgstr "  -d, --ignore-datetime-check\t忽略license有效日期校验\n"

#: licchk.c:403
#, c-format
msgid "  -U, --username            \tobtain the username from the license file.\n"
msgstr "  -U, --username            \t获取license文件中默认用户名\n"

#: licchk.c:404
#, c-format
msgid "  -P, --port                \tobtain the port from the license file.\n"
msgstr "  -P, --port                \t获取license文件中默认端口号\n"

#: licchk.c:405
#, c-format
msgid "  -V, --version             \toutput version information, then exit\n"
msgstr "  -V, --version             \t输出版本信息，然后退出\n"

#: licchk.c:406
#, c-format
msgid "  -?, --help                \tshow this help, then exit\n"
msgstr "  -?, --help                \t显示此帮助，然后退出\n"
