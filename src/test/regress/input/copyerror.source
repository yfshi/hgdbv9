CREATE TABLE x_bad (
	taskid varchar(64),
	schema varchar(64),
	tablename  varchar(64),
	filename varchar(128),
	type char,
	lineno bigint,
	buff text
) ;
CREATE TABLE x (
	a int primary key,
	b int,
	c numeric check(c > 10),
	d int not null,
	e text not null,
	f int unique
) ;

