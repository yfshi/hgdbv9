TRUNCATE x_bad;
CREATE TABLE pk_t (
	pa integer primary key,
	pb integer unique,
	pc integer unique,
	pd varchar(10) unique
) ;
CREATE TABLE fk_t (
	fa integer,
	fb integer REFERENCES pk_t(pb)
) ;

