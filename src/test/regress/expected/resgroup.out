\d+ pg_resgroup_config
                       View "pg_catalog.pg_resgroup_config"
     Column      | Type | Collation | Nullable | Default | Storage  | Description 
-----------------+------+-----------+----------+---------+----------+-------------
 groupid         | oid  |           |          |         | plain    | 
 groupname       | name |           |          |         | plain    | 
 concurrency     | text | C         |          |         | extended | 
 cpu_max_percent | text | C         |          |         | extended | 
 cpu_weight      | text | C         |          |         | extended | 
 cpuset          | text | C         |          |         | extended | 
 memory_limit    | text | C         |          |         | extended | 
 min_cost        | text | C         |          |         | extended | 
 io_limit        | text | C         |          |         | extended | 
View definition:
 SELECT g.oid AS groupid,
    g.rsgname AS groupname,
    t1.value AS concurrency,
    t2.value AS cpu_max_percent,
    t3.value AS cpu_weight,
    t4.value AS cpuset,
    t5.value AS memory_limit,
    t6.value AS min_cost,
    t7.value AS io_limit
   FROM pg_resgroup g
     JOIN pg_resgroupcapability t1 ON g.oid = t1.resgroupid AND t1.reslimittype = 1
     JOIN pg_resgroupcapability t2 ON g.oid = t2.resgroupid AND t2.reslimittype = 2
     JOIN pg_resgroupcapability t3 ON g.oid = t3.resgroupid AND t3.reslimittype = 3
     JOIN pg_resgroupcapability t5 ON g.oid = t5.resgroupid AND t5.reslimittype = 5
     JOIN pg_resgroupcapability t6 ON g.oid = t6.resgroupid AND t6.reslimittype = 6
     JOIN pg_resgroupcapability t7 ON g.oid = t7.resgroupid AND t7.reslimittype = 7
     LEFT JOIN pg_resgroupcapability t4 ON g.oid = t4.resgroupid AND t4.reslimittype = 4;

\d+ pg_resgroup_role
                    View "pg_catalog.pg_resgroup_role"
  Column   | Type | Collation | Nullable | Default | Storage | Description 
-----------+------+-----------+----------+---------+---------+-------------
 rrrolname | name |           |          |         | plain   | 
 rrrsgname | name |           |          |         | plain   | 
View definition:
 SELECT pgr.rolname AS rrrolname,
    pgrg.rsgname AS rrrsgname
   FROM pg_roles pgr
     JOIN pg_resgroup pgrg ON getoidbypgobjectviews(pgr.oid) = pgrg.oid;

\d+ pg_resgroup_status
                           View "pg_catalog.pg_resgroup_status"
        Column        |   Type   | Collation | Nullable | Default | Storage | Description 
----------------------+----------+-----------+----------+---------+---------+-------------
 groupid              | oid      |           |          |         | plain   | 
 groupname            | name     |           |          |         | plain   | 
 num_running          | integer  |           |          |         | plain   | 
 num_queueing         | integer  |           |          |         | plain   | 
 num_queued           | bigint   |           |          |         | plain   | 
 num_executed         | bigint   |           |          |         | plain   | 
 total_queue_duration | interval |           |          |         | plain   | 
View definition:
 SELECT s.groupid,
    r.rsgname AS groupname,
    s.num_running,
    s.num_queueing,
    s.num_queued,
    s.num_executed,
    s.total_queue_duration
   FROM pg_resgroup_get_status(NULL::oid) s(groupid, num_running, num_queueing, num_queued, num_executed, total_queue_duration, cpu_usage, memory_usage),
    pg_resgroup r
  WHERE s.groupid = r.oid;

