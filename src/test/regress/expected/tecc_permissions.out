SELECT has_dek_privilege('test_perm_dek', 'USAGE') AS current_user_has_dek_priv;
 current_user_has_dek_priv 
---------------------------
 t
(1 row)

SELECT has_dek_privilege('tecc_user1', 'test_perm_dek', 'USAGE') AS user1_has_dek_priv;
 user1_has_dek_priv 
--------------------
 f
