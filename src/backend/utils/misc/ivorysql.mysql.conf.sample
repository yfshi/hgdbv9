#mysql.default_database = highgo 		# Comma-separated list of default databases, e.g. 'highgo,highgo1'

#sha256_password_public_key_path = '' 	# private key for caching_sha2_password auth if channel is not security.
#sha256_password_private_key_path = ''	# public  key for caching_sha2_password auth if channel is not security.

#div_precision_increment = 4		# the number of digits by which to increase the scale of the result of divison operations.

#block_encrytion_mode = aes-128-ecb	 # block encrytion mode

#lc_time_names = 'en_US'

#default_week_format = 0

#mysql.create_database_mode = schema   # 'database' or 'schema' for CREATE/DROP DATABASE