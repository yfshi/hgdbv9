SET ivorysql.enable_ora_user_schema = on;
SET ivorysql.compatible_mode = pg;
CREATE SCHEMA reg_u1;
SET ivorysql.compatible_mode = oracle;
-- create user
CREATE USER reg_u1; --error
ERROR:  schema "reg_u1" already exists
