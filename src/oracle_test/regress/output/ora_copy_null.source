-- utf8 to utf8
\c copy_utf8
create table x_utf8_fixed(
    id int,
    c1 char(32),
    c2 char(32 char),
    v1 varchar(32),
    v2 varchar(32 char));
CREATE TABLE x_utf8_fixed_2(like x_utf8_fixed);
create table x_utf8(
    id int, 
    c1 char(128), 
    c2 char(128 char), 
    v1 varchar(128), 
    v2 varchar(128 char));
CREATE TABLE x_utf8_2(like x_utf8);
