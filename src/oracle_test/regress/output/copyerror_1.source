--
-- copy test for output the error record
--
CREATE TABLE x_bad (
	taskid varchar(64),
	schema varchar(64),
	tablename  varchar(64),
	filename varchar(128),
	type char,
	lineno bigint,
	buff text
) ;
CREATE TABLE x (
	a int primary key,
	b int,
	c numeric check(c > 10),
	d int not null,
	e text not null,
	f int unique
) ;
-- checking new options
COPY x from stdin with sharding 2 sharding 2;
ERROR:  conflicting or redundant options
LINE 1: COPY x from stdin with sharding 2 sharding 2;
                                          ^
COPY x from stdin with sharding 2;
ERROR:  sharding and current_shard should occured together
COPY x from stdin with sharding 2 current_shard 2;
ERROR:  current_shard should less than sharding
COPY x from stdin with badtable 'xxx_bad' badfile 'xxx.bad';
ERROR:  badtable and badfile must not occured together
COPY x from stdin with binary badtable 'xxx_bad';
ERROR:  Text and Binary file type is not support for tolerate mode
COPY x from stdin with binary sharding 2 current_shard 1;
ERROR:  Text and Binary file type is not support for sharding
COPY x from stdin with badtable 'xxx_bad';
ERROR:  Text and Binary file type is not support for tolerate mode
COPY x from stdin with sharding 2 current_shard 1;
ERROR:  Text and Binary file type is not support for sharding
-- TABLE
-- with error tolerate, but bad table xx_bad did not exist: should fail
COPY x (a, b, c, d, e, f) from stdin with csv delimiter ',' badtable 'xx_bad';
ERROR:  Tolerate mode, taskid is necessary opts
COPY x (a, b, c, d, e, f) from stdin with csv delimiter ',' taskid '12' filename 'csv1.csv' badtable 'xx_bad';
ERROR:  relation "xx_bad" does not exist
LINE 1: insert into xx_bad values('12', 'public', 'x', 'csv1.csv', '...
                    ^
QUERY:  insert into xx_bad values('12', 'public', 'x', 'csv1.csv', 'i', 2, '1,2,22.22,2,name_2,2');
CONTEXT:  COPY x, line 2
