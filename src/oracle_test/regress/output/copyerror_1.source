-- test with INSTEAD OF INSERT trigger on a view
CREATE TABLE instead_of_insert_tbl(id serial, name text);
CREATE VIEW instead_of_insert_tbl_view AS SELECT ''::text AS str;
CREATE TABLE view_bad (
	taskid varchar(16),
	schema varchar(64),
	tablename  varchar(64),
	filename varchar(64),
	lineno bigint,
	buff text
) ;
CREATE FUNCTION fun_instead_of_insert_tbl() RETURNS trigger AS $$
BEGIN
  INSERT INTO instead_of_insert_tbl (name) VALUES (NEW.str);
  RETURN NULL;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER trig_instead_of_insert_tbl_view
  INSTEAD OF INSERT ON instead_of_insert_tbl_view
  FOR EACH ROW EXECUTE PROCEDURE fun_instead_of_insert_tbl();
COPY instead_of_insert_tbl_view FROM stdin with csv delimiter ',' taskid 'view12' filename 'csv5.csv' badtable 'view_bad';
ERROR:  tolerate mode,cannot copy to relation "instead_of_insert_tbl_view" as not base or partition table
