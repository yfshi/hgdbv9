-- fk is unique(a,b)
CREATE TABLE pk_t_u (
	pa integer primary key,
	pb integer,
	pc integer,
	pd varchar(10) unique,
	UNIQUE(pb, pc)
) ;
CREATE TABLE fk_t_u (
	fa integer,
	fb integer,
	fc integer,
	FOREIGN KEY (fb, fc) REFERENCES pk_t_u (pb,pc)
) ;
insert into pk_t_u values(1,1,10,'aaaa');
insert into pk_t_u values(2,2,20,'bbbb');
insert into pk_t_u values(3,3,30,'cccc');
