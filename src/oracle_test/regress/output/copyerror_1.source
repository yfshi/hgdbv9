-- Sharding
-- AS the input is stdin, so BE will not splite the content
-- but the error num will cal by sharding
CREATE TABLE xshd (
	a int primary key,
	b varchar(10)
) ;
CREATE TABLE xshd_bad (
	taskid varchar(64),
	schema varchar(64),
	tablename  varchar(64),
	filename varchar(64),
	type char,
	lineno bigint,
	buff text
) ;
