-- utf8 to utf8

\c copy_utf8

create table x_utf8_fixed(
    id int,
    c1 char(32),
    c2 char(32 char),
    v1 varchar(32),
    v2 varchar(32 char));
CREATE TABLE x_utf8_fixed_2(like x_utf8_fixed);


create table x_utf8(
    id int, 
    c1 char(128), 
    c2 char(128 char), 
    v1 varchar(128), 
    v2 varchar(128 char));
CREATE TABLE x_utf8_2(like x_utf8);

show server_encoding;
create extension pageinspect;

--
-- If need to confirm the output of the printf, can using hexdump -C xxx.data
--
set client_encoding to utf8;
show client_encoding;

-- enable_store_nullterminator_char off,check error for \0
show ivorysql.enable_store_nullterminator_char;
-- COPY x_utf8_fixed FROM '@abs_srcdir@/data/ora_copy_null_utf8_fixed.data' with (format csv, encoding 'utf8');
-- if "en_US.UTF-8", ERROR:  invalid byte sequence for encoding "GBK": 0x00
-- if "zh_CN.UTF-8", 错误:  无效的 "GBK" 编码字节顺序: 0x00

-- enable_store_nullterminator_char on,check pass for \0
set ivorysql.enable_store_nullterminator_char = true;
show ivorysql.enable_store_nullterminator_char;

COPY x_utf8_fixed FROM '@abs_srcdir@/data/ora_copy_null_utf8_fixed.data' with (format csv, encoding 'utf8');
insert into x_utf8_fixed values(1000,'狜狝1gda1sgds瀚高1基''础','猉猋("2猌猍gf2saf㓿㔀㔂㔃s"2a猏','gdai@3#&sgds3f',E'猔"4g猟\ng"4猠');
set client_encoding to utf8;
show client_encoding;
SELECT * from x_utf8_fixed;
SELECT t_data FROM heap_page_items(get_raw_page('x_utf8_fixed', 0));
DROP TABLE x_utf8_fixed;


COPY x_utf8 FROM '@abs_srcdir@/data/ora_copy_null_utf8.data' with(format csv, encoding 'utf8');
