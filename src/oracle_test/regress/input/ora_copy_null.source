-- gbk to gbk
\c copy_gbk;

create table x_gbk_fixed(
    id int,
    c1 char(32),
    c2 char(32 char),
    v1 varchar(32),
    v2 varchar(32 char));
CREATE TABLE x_gbk_fixed_2(like x_gbk_fixed);

create table x_gbk(
    id int,
    c1 char(128),
    c2 char(128 char),
    v1 varchar(128),
    v2 varchar(128 char));
CREATE TABLE x_gbk_2(like x_gbk);

create extension pageinspect;

show server_encoding;
set client_encoding to utf8;
show client_encoding;

-- COPY x_gbk_fixed FROM '@abs_srcdir@/data/ora_copy_null_gbk_fixed.data' with(format csv, encoding 'gbk');
-- if "en_US.UTF-8", ERROR:  invalid byte sequence for encoding "GBK": 0x00
-- if "zh_CN.UTF-8", 错误:  无效的 "GBK" 编码字节顺序: 0x00

set ivorysql.enable_store_nullterminator_char = true;
show ivorysql.enable_store_nullterminator_char;

-- as gbk did not support 㓿㔀㔂㔃
-- so when insert 㓿㔀㔂㔃 as utf8, server transfer to \xa3bf
-- in source input, if there have \xa3bf, store it
COPY x_gbk_fixed FROM '@abs_srcdir@/data/ora_copy_null_gbk_fixed.data' with(format csv, encoding 'gbk');
set client_encoding to utf8;
show client_encoding;
insert into x_gbk_fixed values(1000,'狜狝1gda1sgds瀚高1基''础','猉猋("2猌猍gf2saf㓿㔀㔂㔃s"2a猏','gdai@3#&sgds3f',E'猔"4g猟\ng"4猠');
SELECT * FROM x_gbk_fixed;
SELECT t_data FROM heap_page_items(get_raw_page('x_gbk_fixed', 0));
DROP TABLE x_gbk_fixed;


COPY x_gbk FROM '@abs_srcdir@/data/ora_copy_null_gbk.data' with(format csv, encoding 'gbk');
insert into x_gbk values(200,'狜狝狟狢狣狤狥狦狧狪狫狵狶狹狽狾1狿猀猂猄猅猆猇猈猉猋猌猍猏猐猑猒','猔猘猙猚猟猠猣猤2猦猧猨猭猯猰猲猳','猵猶猺猻猼猽獀獁獂獃獄獅獆獇獈3獉獊獋獌獎獏獑獓獔獕獖獘獙獚獛獜','獝獞獟獡獢獣獤獥獦獧獨獩獪獫獮獰4獱');

SELECT * FROM x_gbk;
SELECT t_data FROM heap_page_items(get_raw_page('x_gbk', 0));
DROP TABLE x_gbk;


