\c copy_gbk;
create extension pageinspect;

set client_encoding to 'utf8';
show client_encoding;
show server_encoding;

CREATE TABLE x_double (
        id int,
        sch1 char(32 char),
        sch2 char(32 byte),
        tab1 varchar2(32 char),
        tab2 varchar2(32 byte)
);

CREATE TABLE x_double_2 (like x_double);

COPY x_double FROM '@abs_srcdir@/data/ora_copy_double_gbk.data' with(format csv, encoding 'gbk', doubdeli '0x800xaa', quotes '0x800xbb');
SELECT * FROM x_double;
SELECT t_data FROM heap_page_items(get_raw_page('x_double', 0));


