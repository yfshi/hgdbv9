-- BUG#M0000414

-- create database
create or replace function dbuser_createdb() RETURNS void as
$$
declare
    name text;
begin
	select into name 10::regrole;
    execute format('set session authorization %s;',name);
	return;
end;
$$ language plpgsql;
/

set ivorysql.compatible_mode to pg;
show ivorysql.compatible_mode;

select dbuser_createdb();

create database copy_utf8 encoding='UTF8' LC_COLLATE='C' LC_CTYPE ='C' TEMPLATE=template0;
create database copy_gbk encoding='GBK' LC_COLLATE='C' LC_CTYPE ='C' TEMPLATE=template0;
create database copy_gb18030 encoding='GB18030' LC_COLLATE='C' LC_CTYPE ='C' TEMPLATE=template0;

set ivorysql.compatible_mode to oracle;
show ivorysql.compatible_mode;

-- utf8 --> utf8
\c copy_utf8;
create extension pageinspect;

set client_encoding to 'utf8';
show client_encoding;
show server_encoding;

CREATE TABLE x_double (
        id int,
        sch1 char(32 char),
        sch2 char(32 byte),
        tab1 varchar2(32 char),
        tab2 varchar2(32 byte)
);

CREATE TABLE x_double_2 (like x_double);

-- testing using double deli and quotes
-- printf "100\x80\xaa1234瀚高7890\x80\xaa1234瀚高7890\x80\xaa1234瀚高7890\x80\xaa1234瀚高7890\x0A200\x80\xaa\x80\xbb1234'\"\"瀚高7890\x80\xbb\x80\xaa1234\\\瀚高7890\x80\xaa1234瀚高7890\x80\xaa1234瀚高7890\x0A" > ora_copy_double_utf8.data
COPY x_double FROM '@abs_srcdir@/data/ora_copy_double_utf8.data' with(format csv, doubdeli '0x800xaa', quotes '0x800xbb');
SELECT * FROM x_double;
SELECT t_data FROM heap_page_items(get_raw_page('x_double', 0));

-- gbk --> gbk
