-- utf8 --> gbk, include \0
-- printf "100\x80\xaa1234瀚\x00高7890\x80\xaa1234瀚高78\x0090\x80\xaa1234瀚\x00高7890\x80\xaa1234瀚高78\x0090\x0A200\x80\xaa\x80\xbb1234'\"\"瀚高7890\x80\xbb\x80\xaa1234\\\瀚高7890\x80\xaa1234瀚高7890\x80\xaa1234瀚 高790\x0A" > ora_copy_double_utf8_2.data

\c copy_gbk;
set client_encoding to 'utf8';
show client_encoding;
show server_encoding;
DROP TABLE x_double;
CREATE TABLE x_double (like x_double_2);

-- if not setting ivorysql.enable_store_nullterminator_char
-- \0 checking passed, but will not store \0 and the following data
show ivorysql.enable_store_nullterminator_char;
COPY x_double FROM '@abs_srcdir@/data/ora_copy_double_utf8_2.data' with(format csv, encoding 'utf8', doubdeli '0x800xAA', quotes '0x800xBB');
SELECT * FROM x_double;
SELECT t_data FROM heap_page_items(get_raw_page('x_double', 0));


-- setting ivorysql.enable_store_nullterminator_char, store \0 and the following data
set ivorysql.enable_store_nullterminator_char = true;
show ivorysql.enable_store_nullterminator_char;
COPY x_double FROM '@abs_srcdir@/data/ora_copy_double_utf8_2.data' with(format csv, encoding 'utf8', doubdeli '0x800xAA', quotes '0x800xBB');

insert into x_double values(100,'1234瀚|高7890','1234瀚高78|90','1234瀚|高7890','1234瀚高78|90');
SELECT * FROM x_double;
SELECT t_data FROM heap_page_items(get_raw_page('x_double', 0));


-- gb18030 --> utf8, including \0
-- \x80\xAA  \x80\xBB
-- printf "100\x80\xaa\x31\x32\x33\x34\xe5\xab\x00\xb8\xdf\x37\x38\x39\x30\x80\xAA\x31\x32\x33\x34\xe5\xab\xb8\xdf\x37\x38\x00\x39\x30\x80\xAA\x31\x32\x33\x34\xe5\xab\x00\xb8\xdf\x37\x38\x39\x30\x80\xAA\x31\x32\x33\x34\xe5\xab\xb8\xdf\x37\x38\x00\x39\x30\x0A200\x80\xAA\x80\xBB\x31\x32\x33\x34\x27\x22\xe5\xab\xb8\xdf\x37\x38\x39\x30\x80\xBB\x80\xAA\x31\x32\x33\x34\x5c\xe5\xab\xb8\xdf\x37\x38\x39\x30\x80\xAA\x31\x32\x33\x34\xe5\xab\xb8\xdf\x37\x38\x39\x30\x80\xAA\x31\x32\x33\x34\xe5\xab\xb8\xdf\x37\x38\x39\x30\x0A" > ora_copy_double_gb18030_2.data

\c copy_utf8;
set client_encoding to 'utf8';
show client_encoding;
show server_encoding;
DROP TABLE x_double;
CREATE TABLE x_double (like x_double_2);

show ivorysql.enable_store_nullterminator_char;
COPY x_double FROM '@abs_srcdir@/data/ora_copy_double_gb18030_2.data' with(format csv, encoding 'gb18030', doubdeli '0x800xAA', quotes '0x800xBB');

SELECT * FROM x_double;
SELECT t_data FROM heap_page_items(get_raw_page('x_double', 0));

-- set enable_store_nullterminator_char
set ivorysql.enable_store_nullterminator_char = true;
show ivorysql.enable_store_nullterminator_char;

DROP TABLE x_double;
CREATE TABLE x_double (like x_double_2);
COPY x_double FROM '@abs_srcdir@/data/ora_copy_double_gb18030_2.data' with(format csv, encoding 'gb18030', doubdeli '0x800xAA', quotes '0x800xBB');
insert into x_double values(100,'1234瀚|高7890','1234瀚高78|90','1234瀚|高7890','1234瀚高78|90');
insert into x_double values(200,'1234''"瀚高7890','1234\瀚高7890','1234瀚高7890','1234瀚高7890');
SELECT * FROM x_double;
SELECT t_data FROM heap_page_items(get_raw_page('x_double', 0));


--- cleanup
\c regression system

set ivorysql.compatible_mode to pg;
show ivorysql.compatible_mode;

select dbuser_createdb();

DROP DATABASE copy_utf8;
DROP DATABASE copy_gbk;
DROP DATABASE copy_gb18030;

set ivorysql.compatible_mode to oracle;
show ivorysql.compatible_mode;

drop function dbuser_createdb;
