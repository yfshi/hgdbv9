DROP TABLE IF EXISTS ora_hgb_orders;
NOTICE:  table "ora_hgb_orders" does not exist, skipping
DROP TABLE IF EXISTS ora_hgb_customers;
NOTICE:  table "ora_hgb_customers" does not exist, skipping
CREATE TABLE ora_hgb_customers
(
    customer_id NUMBER PRIMARY KEY,
    customer_name VARCHAR2(30),
    region VARCHAR2(20),
    channel VARCHAR2(20)
);
CREATE TABLE ora_hgb_orders
(
    order_id NUMBER PRIMARY KEY,
    customer_id NUMBER,
    dept VARCHAR2(20),
    product VARCHAR2(20),
    order_month VARCHAR2(7),
    amount NUMBER,
    status VARCHAR2(10),
    sales_rep VARCHAR2(20)
);
