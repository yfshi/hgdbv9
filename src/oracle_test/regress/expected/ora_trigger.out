(1 row)

select * from empt_logs; -- bschb.trgins will be fire
 log_id | emp_id |          action           |  log_date  
--------+--------+---------------------------+------------
 2      | 7380   | bschb.trgins-> INSERT (b) | 2025-09-03
(1 row)

drop trigger trgins;
drop schema tscha;
drop schema bschb;
