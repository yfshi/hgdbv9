CREATE OR REPLACE TRIGGER tgdel6559
BEFORE DELETE ON t_orders
FOR EACH ROW
WHEN (
        NEW.status IS NOT NULL
    AND OLD.status IN ('PAID', 'CANCELLED')
)
BEGIN
    INSERT INTO order_delete_log (
        order_id,
        old_status,
        delete_time
    )
    VALUES (
        :OLD.order_id,
