CREATE TABLE t_emp (
    emp_id     NUMBER PRIMARY KEY,
    emp_name   VARCHAR2(50),
    salary     NUMBER,
    created_at DATE
);
CREATE TABLE salary_audit_log (
    emp_id      NUMBER,
    action      VARCHAR2(50),
    old_salary  NUMBER,
    new_salary  NUMBER,
    action_time DATE
);
CREATE TRIGGER tgins6559
BEFORE INSERT ON t_emp
FOR EACH ROW
WHEN (
        OLD.salary IS NULL
    AND NEW.salary IS NOT NULL
)
BEGIN
    INSERT INTO salary_audit_log (
        emp_id,
        action,
        old_salary,
        new_salary,
        action_time
    )
    VALUES (
        :NEW.emp_id,
        'TEST_WHEN_OLD_IS_NULL',
        NULL,
        :NEW.salary,
        TO_DATE('2025-12-24','yyyy-mm-dd')
    );
END;
/
