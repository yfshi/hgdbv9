--show explain(verbose, costs off)
explain (costs off) select * from t1, t2 where t1.i = t2.i(+);
         QUERY PLAN          
-----------------------------
 Merge Left Join
   Merge Cond: (t1.i = t2.i)
   ->  Sort
         Sort Key: t1.i
         ->  Seq Scan on t1
   ->  Sort
         Sort Key: t2.i
         ->  Seq Scan on t2
(8 rows)

explain (costs off) select * from t1,t2,t3,t4,t5 where t1.i(+)+t2.i = t3.i and t4.i(+)= t2.i + t5.i;
                          QUERY PLAN                           
---------------------------------------------------------------
 Merge Right Join
   Merge Cond: (t4.i = ((t2.i + t5.i)))
   ->  Sort
         Sort Key: t4.i
         ->  Seq Scan on t4
   ->  Materialize
         ->  Sort
               Sort Key: ((t2.i + t5.i))
               ->  Nested Loop
                     ->  Nested Loop Left Join
                           Join Filter: ((t1.i + t2.i) = t3.i)
                           ->  Nested Loop
                                 ->  Seq Scan on t2
                                 ->  Materialize
                                       ->  Seq Scan on t3
                           ->  Materialize
                                 ->  Seq Scan on t1
                     ->  Materialize
                           ->  Seq Scan on t5
(19 rows)

explain (costs off) select * from t1, t2 where t2.i = (select max(t1.i) from t1,t2 where t1.i(+)=t2.i) ;
                  QUERY PLAN                   
-----------------------------------------------
 Nested Loop
   InitPlan 1 (returns $0)
     ->  Aggregate
           ->  Merge Left Join
                 Merge Cond: (t2_1.i = t1_1.i)
                 ->  Sort
                       Sort Key: t2_1.i
                       ->  Seq Scan on t2 t2_1
                 ->  Sort
                       Sort Key: t1_1.i
                       ->  Seq Scan on t1 t1_1
   ->  Seq Scan on t1
   ->  Materialize
         ->  Seq Scan on t2
               Filter: (i = $0)
(15 rows)

explain (costs off) select * from t1,t2 where not (t1.i = t2.i(+));
          QUERY PLAN           
-------------------------------
 Nested Loop Left Join
   Join Filter: (t1.i <> t2.i)
   ->  Seq Scan on t1
   ->  Materialize
         ->  Seq Scan on t2
(5 rows)

