\d+ v1
                                   View "public.v1"
 Column |     Type     |   Collation    | Nullable | Default | Storage  | Description 
--------+--------------+----------------+----------+---------+----------+-------------
 i1     | integer      |                |          |         | plain    | 
 j1     | integer      |                |          |         | plain    | 
 k1     | varchar2(10) | using_nls_comp |          |         | extended | 
 i2     | integer      |                |          |         | plain    | 
 j2     | integer      |                |          |         | plain    | 
 k2     | varchar2(10) | using_nls_comp |          |         | extended | 
View definition:
 SELECT toj1.id AS i1,
    toj1.id2 AS j1,
    toj1.name AS k1,
    toj2.id AS i2,
    toj2.id2 AS j2,
    toj2.name AS k2
   FROM toj2
     LEFT JOIN toj1 ON toj1.id = toj2.id;

drop view v1;
create view v1 (i1, j1, k1, i2, j2, k2,i3, j3, k3 )as select *from toj1, toj2, toj3 
	where toj1.id(+) = toj2.id and toj2.id (+)= toj3.id;
