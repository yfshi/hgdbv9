select * from t1,t2 where t2.i = t1.i(+)+t2.j;--dedumplicate join t2
 i | j | i | j 
---+---+---+---
   |   | 1 | 2
   |   | 2 | 2
 2 | 2 | 3 | 1
   |   |   |  
