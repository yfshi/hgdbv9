--bug0000584
create table a_bug584(i int, j int);
create table b_bug584(i int, j int);
create table c_bug584(i int, j int);
create view idx_bug584 as
  SELECT 'a' AS zyfl
  from
   (select i  AS type1, j AS type11 from a_bug584 ) t1,
   (select i  AS type2, j AS type22 from b_bug584 ) t2,
   (select i  AS type3, j AS type33 from c_bug584 ) t3
   where t1.type1 = t2.type2(+) and t1.type11 = t2.type22(+)
       and t1.type1 = t3.type3(+) and t1.type11 = t3.type33(+);
\d+ idx_bug584
                          View "public.idx_bug584"
 Column |   Type   | Collation | Nullable | Default | Storage  | Description 
--------+----------+-----------+----------+---------+----------+-------------
 zyfl   | varchar2 |           |          |         | extended | 
View definition:
 SELECT 'a'::varchar2 AS zyfl
   FROM ( SELECT a_bug584.i AS type1,
            a_bug584.j AS type11
           FROM a_bug584) t1
     LEFT JOIN ( SELECT b_bug584.i AS type2,
            b_bug584.j AS type22
           FROM b_bug584) t2 ON t1.type1 = t2.type2 AND t1.type11 = t2.type22
     LEFT JOIN ( SELECT c_bug584.i AS type3,
            c_bug584.j AS type33
           FROM c_bug584) t3 ON t1.type1 = t3.type3 AND t1.type11 = t3.type33;

drop view idx_bug584;
drop table a_bug584;
drop table b_bug584;
drop table c_bug584;
