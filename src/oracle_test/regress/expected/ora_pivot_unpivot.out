--1, join + pivot
select *
from (
    select a.noc,
           m.sport,
           m.medal
    from h_athletes a
    join h_olympic_medals m on a.athlete_id = m.athlete_id
)
pivot (
    count(medal)
    for medal in ('Gold' as GOLD, 'Silver' as SILVER, 'Bronze' as BRONZE)
)
order by noc, sport;
