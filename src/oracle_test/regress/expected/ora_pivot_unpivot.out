CREATE TABLE pivot_expr_test (
    id      NUMBER,
    k_num   NUMBER,
    k_chr   VARCHAR2(30),
    k_date  DATE,
    k_ts    TIMESTAMP,
    amount  NUMBER
);
INSERT INTO pivot_expr_test VALUES (
    1, 1, 'A',
    DATE '2024-01-01',
    TIMESTAMP '2024-01-01 10:00:00',
    100
);
INSERT INTO pivot_expr_test VALUES (
    1, 2, 'B',
    DATE '2024-01-02',
    TIMESTAMP '2024-01-02 10:00:00',
    200
);
INSERT INTO pivot_expr_test VALUES (
    2, 3, 'C',
    DATE '2024-01-03',
    TIMESTAMP '2024-01-03 10:00:00',
