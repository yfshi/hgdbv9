-- ============================
-- 1. PIVOT
--   aggregate_function(expr)
--   FOR column
--   IN (expr, expr, ...)
-- ============================
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount)
    FOR quarter IN ('Q1', 'Q2')
)
ORDER BY product_name;
 product_name | 'Q1' | 'Q2' 
--------------+------+------
 Laptop       | 180  | 120
 Phone        | 50   | 70
 Tablet       | 380  | 430
(3 rows)

SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
) su
PIVOT (
    SUM(su.sales_amount)
    FOR quarter IN ('Q1', 'Q2')
)
ORDER BY product_name;
 product_name | 'Q1' | 'Q2' 
--------------+------+------
 Laptop       | 180  | 120
 Phone        | 50   | 70
 Tablet       | 380  | 430
(3 rows)

SELECT *
    FROM sales_pu su
PIVOT (
    SUM(su.sales_amount)
    FOR quarter IN ('Q1', 'Q2')
)
ORDER BY product_name;
 product_name | region_name | year_no | sales_qty | 'Q1' | 'Q2' 
--------------+-------------+---------+-----------+------+------
 Laptop       | Americas    | 2024    | 10        | 100  | 
 Laptop       | Americas    | 2024    | 12        |      | 120
 Laptop       | Europe      | 2024    | 8         | 80   | 
 Laptop       | Europe      | 2024    | 9         |      | 
 Phone        | Europe      | 2025    | 5         | 50   | 
 Phone        | Europe      | 2025    | 7         |      | 70
 Tablet       | Americas    | 2024    | 20        | 200  | 
 Tablet       | Americas    | 2024    | 23        |      | 230
 Tablet       | Asia        | 2025    | 18        | 180  | 
 Tablet       | Asia        | 2025    | 20        |      | 200
(10 rows)

-- ====================================
-- 2. PIVOT
--   aggregate_function(expr) AS alias
--   expr AS alias
-- ====================================
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) AS amt
    FOR quarter IN (
        'Q1' AS q1,
        'Q2' AS q2
    )
)
ORDER BY product_name;
 product_name | q1_amt | q2_amt 
--------------+--------+--------
 Laptop       | 180    | 120
 Phone        | 50     | 70
 Tablet       | 380    | 430
(3 rows)

-- ====================================
-- 3. PIVOT
--   aggregate_function(expr) alias,
--   aggregate_function(expr) alias ...
-- ====================================
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount, sales_qty
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) AS sum_amt,
    COUNT(sales_amount) AS cnt_amt,
    MAX(sales_qty) AS max_qty
    FOR quarter IN (
        'Q1' AS q1,
        'Q2' AS q2
    )
)
ORDER BY product_name;
 product_name | q1_sum_amt | q1_cnt_amt | q1_max_qty | q2_sum_amt | q2_cnt_amt | q2_max_qty 
--------------+------------+------------+------------+------------+------------+------------
 Laptop       | 180        |          2 | 10         | 120        |          1 | 12
 Phone        | 50         |          1 | 5          | 70         |          1 | 7
 Tablet       | 380        |          2 | 20         | 430        |          2 | 23
(3 rows)

-- ==================================
-- 4. PIVOT
--   FOR (column, column, ...)
--   IN ((expr, expr) AS alias, ...)
-- ==================================
SELECT *
FROM (
    SELECT product_name, year_no, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) AS amt
    FOR (year_no, quarter) IN (
        (2024, 'Q1') AS y2024_q1,
        (2024, 'Q2') AS y2024_q2,
        (2025, 'Q1') AS y2025_q1,
        (2025, 'Q2') AS y2025_q2
    )
)
ORDER BY product_name;
 product_name | y2024_q1_amt | y2024_q2_amt | y2025_q1_amt | y2025_q2_amt 
--------------+--------------+--------------+--------------+--------------
 Laptop       | 180          | 120          |              | 
 Phone        |              |              | 50           | 70
 Tablet       | 200          | 230          | 180          | 200
(3 rows)

-- =====================================
-- 5. PIVOT
--   pivot_in_clause  (expr [, expr]...)
--   single expression list
-- =====================================
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) AS amt
    FOR quarter IN (
        ('Q1') AS q1,
        ('Q2') AS q2
    )
)
ORDER BY product_name;
 product_name | q1_amt | q2_amt 
--------------+--------+--------
 Laptop       | 180    | 120
 Phone        | 50     | 70
 Tablet       | 380    | 430
(3 rows)

-- ===============
-- 6. PIVOT
--   [[AS] alias]
-- ===============
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) amt
    FOR quarter IN (
        'Q1' q1,
        'Q2' q2
    )
)
ORDER BY product_name;
 product_name | q1_amt | q2_amt 
--------------+--------+--------
 Laptop       | 180    | 120
 Phone        | 50     | 70
 Tablet       | 380    | 430
(3 rows)

-- Generated names must be unique after aggregate aliases are appended
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) AS amt
    FOR quarter IN (
        'Q1' AS duplicate_name,
        'Q2' AS duplicate_name
    )
);
ERROR:  column ambiguously defined
DETAIL:  PIVOT generates column name "duplicate_name_amt" more than once.
-- Generated names must not be silently truncated to NAMEDATALEN
SELECT *
FROM (
    SELECT product_name, quarter, sales_amount
    FROM sales_pu
)
PIVOT (
    SUM(sales_amount) AS this_is_a_long_aggregate_alias
    FOR quarter IN (
        'Q1' AS this_is_a_very_long_pivot_value_alias_1234567890
    )
);
ERROR:  generated PIVOT column name is too long
DETAIL:  Generated column name "this_is_a_very_long_pivot_value_alias_1234567890_this_is_a_long_aggregate_alias" exceeds the maximum identifier length of 63 bytes.
HINT:  Specify shorter aliases for the pivot value or aggregate function.
-- ==============================
-- 7. UNPIVOT
--   UNPIVOT
--   column
--   FOR column
--   IN (column AS literal, ...)
-- default is EXCLUDE NULLS
-- ==============================
SELECT *
FROM (
    SELECT product_name, region_name,
           SUM(CASE WHEN quarter = 'Q1' THEN sales_amount END) AS q1,
           SUM(CASE WHEN quarter = 'Q2' THEN sales_amount END) AS q2
    FROM sales_pu
    GROUP BY product_name, region_name
)
UNPIVOT (
    sales_amount
    FOR quarter IN (
        q1 AS 'Q1',
        q2 AS 'Q2'
    )
)
ORDER BY product_name, region_name, quarter;
 product_name | region_name | quarter | sales_amount 
