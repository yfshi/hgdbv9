CREATE TABLE g_sales (
    product_id NUMBER,
    region_id  NUMBER,
    q1 NUMBER,
    q2 NUMBER,
    q3 NUMBER,
    q4 NUMBER
);
INSERT INTO g_sales VALUES (1, 10, 100, 120, NULL, 150);
INSERT INTO g_sales VALUES (1, 20,  80, NULL,  90, 110);
INSERT INTO g_sales VALUES (2, 10, 200, 230, 210, NULL);
INSERT INTO g_sales VALUES (2, 30, NULL, NULL, 180, 200);
INSERT INTO g_sales VALUES (3, 20,  50,  70,  60,  80);
SELECT *
FROM (
    SELECT
        p.product_name,
        r.region_name,
        s.q1, s.q2, s.q3, s.q4
    FROM g_sales s
    JOIN g_products p ON s.product_id = p.product_id
    JOIN g_regions  r ON s.region_id  = r.region_id
)
PIVOT (
    SUM(q1) AS Q1,
    SUM(q2) AS Q2,
    SUM(q3) AS Q3,
    SUM(q4) AS Q4
    FOR region_name IN (
        'Americas' AS AMR,
        'Europe'   AS EUR,
        'Asia'     AS ASIA
    )
)
ORDER BY product_name;
 product_name | amr_q1 | amr_q2 | amr_q3 | amr_q4 | eur_q1 | eur_q2 | eur_q3 | eur_q4 | asia_q1 | asia_q2 | asia_q3 | asia_q4 
--------------+--------+--------+--------+--------+--------+--------+--------+--------+---------+---------+---------+---------
 Laptop       | 100    | 120    |        | 150    | 80     |        | 90     | 110    |         |         |         | 
 Phone        |        |        |        |        | 50     | 70     | 60     | 80     |         |         |         | 
 Tablet       | 200    | 230    | 210    |        |        |        |        |        |         |         | 180     | 200
(3 rows)

SELECT *
FROM (
    SELECT
        p.product_name,
        r.region_name,
        s.q1, s.q2, s.q3, s.q4
    FROM g_sales s
    JOIN g_products p ON s.product_id = p.product_id
    JOIN g_regions  r ON s.region_id  = r.region_id
)
UNPIVOT (
    sales_amount FOR quarter IN (
        q1 AS 'Q1',
        q2 AS 'Q2',
        q3 AS 'Q3',
        q4 AS 'Q4'
    )
)
ORDER BY product_name, region_name, quarter;
 product_name | region_name | quarter | sales_amount 
