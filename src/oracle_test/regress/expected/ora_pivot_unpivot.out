--
-- regression test for compatible Oracle pivot and unpivot
--
drop table if exists olympic_medal_winners;
NOTICE:  table "olympic_medal_winners" does not exist, skipping
create table olympic_medal_winners (   
  olympic_year int,  
  sport        varchar2( 30 ),  
  gender       varchar2( 1 ),  
  event        varchar2( 128 ),  
  medal        varchar2( 10 ),  
  noc          varchar2( 3 ),  
  athlete      varchar2( 128 ) 
);
