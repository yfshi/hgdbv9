CREATE TABLE piv_diff_test (
  order_id NUMBER,
  product_id NUMBER,
  product_name VARCHAR2(20),
  amount NUMBER
);
INSERT INTO piv_diff_test VALUES (1, 10, 'APPLE', 100);
INSERT INTO piv_diff_test VALUES (2, 20, 'ORANGE', 200);
