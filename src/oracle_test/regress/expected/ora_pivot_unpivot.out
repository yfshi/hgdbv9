CREATE TABLE sales_pu (
    product_name VARCHAR2(30),
    region_name  VARCHAR2(30),
    year_no      NUMBER,
    quarter      VARCHAR2(2),
    sales_amount NUMBER,
    sales_qty    NUMBER
);
