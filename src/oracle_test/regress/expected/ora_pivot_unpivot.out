WITH pivoted AS (
    SELECT *
    FROM (
        SELECT
            p.product_name,
            r.region_name,
            s.q1, s.q2, s.q3, s.q4
        FROM g_sales s
        JOIN g_products p ON s.product_id = p.product_id
        JOIN g_regions  r ON s.region_id  = r.region_id
    )
    PIVOT (
        SUM(q1 + q2 + q3 + q4) AS TOTAL
        FOR region_name IN ('Americas' AS AMR, 'Europe' AS EUR, 'Asia' AS ASIA)
    )
)
SELECT * FROM pivoted;
