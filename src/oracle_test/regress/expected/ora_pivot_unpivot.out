--
-- 7, Constant expressions such as CASE / DECODE / NVL
--
-- CASE constant expression
SELECT *
FROM (
    SELECT id, k_chr, amount
    FROM pivot_expr_test
)
PIVOT (
    SUM(amount)
    FOR k_chr IN (
        CASE WHEN 1 = 1 THEN 'A' ELSE 'X' END AS case_a,
        CASE WHEN 2 = 2 THEN 'B' ELSE 'X' END AS case_b
    )
)
ORDER BY id;
 id | case_a | case_b 
----+--------+--------
