-- negative numbers
SELECT *
FROM piv_diff_test
PIVOT (
  SUM(amount)
  FOR product_id IN (
    -10 AS neg10,
    20  AS p20
  )
);
 order_id | product_name | neg10 | p20 
----------+--------------+-------+-----
 1        | APPLE        |       | 
 2        | ORANGE       |       | 200
 3        | APPLE        |       | 
(3 rows)

--2. When multiple aggregate functions are used in PIVOT, at most one agregate expression may omit an alias
SELECT *
FROM piv_diff_test
PIVOT (
  SUM(amount) total_amount,
  COUNT(*)
  FOR product_name IN (
    'APPLE'  AS apple,
    'ORANGE' AS orange
  )
);
 order_id | product_id | apple_total_amount | apple | orange_total_amount | orange 
----------+------------+--------------------+-------+---------------------+--------
 1        | 10         | 100                |     1 |                     |      0
 2        | 20         |                    |     0 | 200                 |      1
 3        | 10         | 300                |     1 |                     |      0
(3 rows)

--4. Aggregation parameters are complex expressions, such as CASE...WHEN
SELECT *
FROM piv_diff_test
PIVOT (
  SUM(CASE WHEN amount > 0 THEN amount ELSE 0 END)
  FOR product_name IN (
    'APPLE'  AS apple,
    'ORANGE' AS orange
  )
);
 order_id | product_id | apple | orange 
----------+------------+-------+--------
 1        | 10         | 100   | 
 2        | 20         |       | 200
 3        | 10         | 300   | 
(3 rows)

