--
--1 Numeric constant expr
--
-- numceri literal
SELECT *
FROM (
    SELECT id, k_num, amount
    FROM pivot_expr_test
)
PIVOT (
    SUM(amount)
    FOR k_num IN (
        1 AS n1,
        2 AS n2,
        3 AS n3
    )
)
ORDER BY id;
 id | n1  | n2  | n3  
----+-----+-----+-----
 1  | 100 | 200 | 
 2  |     |     | 300
(2 rows)

-- plus-minus sign
SELECT *
FROM (
    SELECT id, k_num, amount
    FROM pivot_expr_test
)
PIVOT (
    SUM(amount)
    FOR k_num IN (
        +1 AS plus_1,
        -1 AS minus_1,
        2 AS n2
    )
)
ORDER BY id;
 id | plus_1 | minus_1 | n2  
----+--------+---------+-----
 1  | 100    |         | 200
 2  |        |         | 
(2 rows)

-- Numerical arithmetic expression
SELECT *
FROM (
    SELECT id, k_num, amount
    FROM pivot_expr_test
)
PIVOT (
    SUM(amount)
    FOR k_num IN (
        1 + 0 AS expr_1,
        1 * 2 AS expr_2,
        10 - 7 AS expr_3
    )
)
ORDER BY id;
 id | expr_1 | expr_2 | expr_3 
----+--------+--------+--------
 1  | 100    | 200    | 
 2  |        |        | 300
(2 rows)

-- Numerical function expression
SELECT *
FROM (
    SELECT id, k_num, amount
    FROM pivot_expr_test
)
PIVOT (
    SUM(amount)
    FOR k_num IN (
        ABS(-1) AS abs_1,
        ROUND(1.6) AS round_2,
        TRUNC(3.9) AS trunc_3
    )
)
ORDER BY id;
 id | abs_1 | round_2 | trunc_3 
----+-------+---------+---------
 1  | 100   | 200     | 
 2  |       |         | 300
(2 rows)

