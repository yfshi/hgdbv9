--
-- Support PIVOT XML
--
DROP TABLE if exists pivot_xml_sales;
NOTICE:  table "pivot_xml_sales" does not exist, skipping
CREATE TABLE pivot_xml_sales (
    region       VARCHAR2(10),
    salesman    VARCHAR2(20),
    product     VARCHAR2(20),
    amount      NUMBER,
    order_count NUMBER
);
INSERT INTO pivot_xml_sales VALUES ('N', 'Alice', 'Apple',  100, 1);
INSERT INTO pivot_xml_sales VALUES ('N', 'Alice', 'Apple',  100, 1);
INSERT INTO pivot_xml_sales VALUES ('N', 'Alice', 'Apple',  120, 1);
INSERT INTO pivot_xml_sales VALUES ('N', 'Alice', 'Orange', 200, 1);
INSERT INTO pivot_xml_sales VALUES ('S', 'Bob',   'Apple',   80, 1);
INSERT INTO pivot_xml_sales VALUES ('S', 'Bob',   'Berry',  300, 1);
INSERT INTO pivot_xml_sales VALUES  ('S', 'Bob',   'Berry',  320, 1);
--1, PIVOT XML IN (ANY) includes only values present in each group
SELECT region, salesman
FROM (
    SELECT region, salesman, product, amount, order_count
    FROM pivot_xml_sales
)
PIVOT XML (
    SUM(amount) AS total,
    COUNT(*) AS rows_seen
    FOR product IN (ANY)
)
ORDER BY region, salesman;
 region | salesman 
--------+----------
 N      | Alice
 S      | Bob
(2 rows)

--2, PIVOT XML IN (subquery) includes all subquery values for every group
SELECT region, salesman
FROM (
    SELECT region, salesman, product, amount
    FROM pivot_xml_sales
)
PIVOT XML (
    SUM(amount) AS total
    FOR product IN (SELECT DISTINCT product FROM pivot_xml_sales)
)
ORDER BY region, salesman;
 region | salesman 
--------+----------
 N      | Alice
 S      | Bob
(2 rows)

--3, PIVOT XML count(*) returns zero for subquery values with no matching rows
SELECT *
FROM (
    SELECT region, salesman, product
    FROM pivot_xml_sales
)
PIVOT XML (
    COUNT(*) AS cnt
    FOR product IN (SELECT DISTINCT product FROM pivot_xml_sales)
)
ORDER BY region, salesman;
 region | salesman |                                                                                                                             product_xml                                                                                                                             
--------+----------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 N      | Alice    | <PivotSet><item><column name="PRODUCT">Apple</column><column name="CNT">3</column></item><item><column name="PRODUCT">Berry</column><column name="CNT">0</column></item><item><column name="PRODUCT">Orange</column><column name="CNT">1</column></item></PivotSet>
 S      | Bob      | <PivotSet><item><column name="PRODUCT">Apple</column><column name="CNT">1</column></item><item><column name="PRODUCT">Berry</column><column name="CNT">2</column></item><item><column name="PRODUCT">Orange</column><column name="CNT">0</column></item></PivotSet>
(2 rows)

--4, COUNT(*) uses a non-null source-row marker when the FOR value is NULL
DROP TABLE if exists pivot_xml_null_key;
NOTICE:  table "pivot_xml_null_key" does not exist, skipping
CREATE TABLE pivot_xml_null_key (
    grp     VARCHAR2(10),
    key_col VARCHAR2(10),
    amount  NUMBER
);
INSERT INTO pivot_xml_null_key VALUES ('A', NULL, 10);
INSERT INTO pivot_xml_null_key VALUES ('A', NULL, 20);
SELECT *
FROM pivot_xml_null_key
PIVOT XML (
    COUNT(*) AS cnt,
    SUM(amount) AS total
    FOR key_col IN (ANY)
)
ORDER BY grp;
 grp |                                                       key_col_xml                                                       
-----+-------------------------------------------------------------------------------------------------------------------------
 A   | <PivotSet><item><column name="KEY_COL"/><column name="CNT">2</column><column name="TOTAL">30</column></item></PivotSet>
(1 row)

DROP TABLE pivot_xml_null_key;
DROP TABLE pivot_xml_sales;
--5, PIVOT XML multi-column FOR with matching ANY list
DROP TABLE if exists pivot_xml_multi_for;
NOTICE:  table "pivot_xml_multi_for" does not exist, skipping
CREATE TABLE pivot_xml_multi_for (
    product VARCHAR2(20),
    region  VARCHAR2(20),
    channel VARCHAR2(20),
    amount  NUMBER
);
INSERT INTO pivot_xml_multi_for VALUES ('Laptop', 'East', 'Online', 100);
INSERT INTO pivot_xml_multi_for VALUES ('Laptop', 'East', 'Online',  50);
INSERT INTO pivot_xml_multi_for VALUES ('Laptop', 'East', 'Store',  150);
INSERT INTO pivot_xml_multi_for VALUES ('Laptop', 'West', 'Online', 200);
INSERT INTO pivot_xml_multi_for VALUES ('Phone',  'East', 'Online', 300);
INSERT INTO pivot_xml_multi_for VALUES ('Phone',  'West', 'Store',  400);
SELECT p.product, p."region_channel_xml"
FROM pivot_xml_multi_for
PIVOT XML (
    SUM(amount) AS total_amount
    FOR (region, channel) IN (ANY, ANY)
) p
ORDER BY product;
 product |                                                                                                                                                                                               region_channel_xml                                                                                                                                                                                               
---------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Laptop  | <PivotSet><item><column name="REGION">East</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT">150</column></item><item><column name="REGION">East</column><column name="CHANNEL">Store</column><column name="TOTAL_AMOUNT">150</column></item><item><column name="REGION">West</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT">200</column></item></PivotSet>
 Phone   | <PivotSet><item><column name="REGION">East</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT">300</column></item><item><column name="REGION">West</column><column name="CHANNEL">Store</column><column name="TOTAL_AMOUNT">400</column></item></PivotSet>
(2 rows)

--6, duplicate multi-column subquery combinations are rejected at runtime
SELECT p.product, p."region_channel_xml"
FROM pivot_xml_multi_for
PIVOT XML (
    SUM(amount) AS total_amount
    FOR (region, channel) IN (
        SELECT region, channel FROM pivot_xml_multi_for
    )
) p
ORDER BY product;
ERROR:  more than one row returned by a subquery used as an expression
--7, multi-column subquery values are densified across implicit groups
SELECT p.product, p."region_channel_xml"
FROM pivot_xml_multi_for
PIVOT XML (
    SUM(amount) AS total_amount
    FOR (region, channel) IN (
        SELECT DISTINCT region, channel FROM pivot_xml_multi_for
    )
) p
ORDER BY product;
 product |                                                                                                                                                                                                                                                        region_channel_xml                                                                                                                                                                                                                                                        
---------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Laptop  | <PivotSet><item><column name="REGION">East</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT">150</column></item><item><column name="REGION">East</column><column name="CHANNEL">Store</column><column name="TOTAL_AMOUNT">150</column></item><item><column name="REGION">West</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT">200</column></item><item><column name="REGION">West</column><column name="CHANNEL">Store</column><column name="TOTAL_AMOUNT"/></item></PivotSet>
 Phone   | <PivotSet><item><column name="REGION">East</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT">300</column></item><item><column name="REGION">East</column><column name="CHANNEL">Store</column><column name="TOTAL_AMOUNT"/></item><item><column name="REGION">West</column><column name="CHANNEL">Online</column><column name="TOTAL_AMOUNT"/></item><item><column name="REGION">West</column><column name="CHANNEL">Store</column><column name="TOTAL_AMOUNT">400</column></item></PivotSet>
(2 rows)

--8, the number of ANY keywords must match the number of FOR columns
SELECT p.*
FROM pivot_xml_multi_for
PIVOT XML (
    SUM(amount) AS total_amount
    FOR (region, channel) IN (ANY)
) p;
ERROR:  PIVOT XML ANY count does not match FOR column count
DROP TABLE pivot_xml_multi_for;
--9, subquery keys are coerced to the FOR column type before comparison
DROP TABLE if exists pivot_xml_typed_key;
NOTICE:  table "pivot_xml_typed_key" does not exist, skipping
CREATE TABLE pivot_xml_typed_key (
    grp     VARCHAR2(10),
    key_col CHAR(3),
    amount  NUMBER
);
INSERT INTO pivot_xml_typed_key VALUES ('A', 'X', 10);
SELECT p.*
FROM pivot_xml_typed_key
PIVOT XML (
    SUM(amount) AS total
    FOR key_col IN (
        SELECT CAST('X' AS VARCHAR2(3)) FROM dual
    )
) p;
 grp |                                              key_col_xml                                              
-----+-------------------------------------------------------------------------------------------------------
 A   | <PivotSet><item><column name="KEY_COL">X  </column><column name="TOTAL">10</column></item></PivotSet>
(1 row)

DROP TABLE pivot_xml_typed_key;
--10, XML name attributes retain spelling; the generated output column is lowercase
DROP TABLE if exists pivot_xml_identifier_test;
NOTICE:  table "pivot_xml_identifier_test" does not exist, skipping
CREATE TABLE pivot_xml_identifier_test (
    "Group Key"     VARCHAR2(10),
    "lowercase"     VARCHAR2(20),
    "Pivot&Key"     VARCHAR2(20),
    "Measure&Value" NUMBER
);
INSERT INTO pivot_xml_identifier_test
VALUES ('G1', 'A&B', '<Online>', 12.50);
INSERT INTO pivot_xml_identifier_test
VALUES ('G1', NULL, NULL, 7);
SELECT p."Group Key", p."lowercase_pivot&key_xml"
FROM pivot_xml_identifier_test
PIVOT XML (
    SUM("Measure&Value") AS "Total&Value"
    FOR ("lowercase", "Pivot&Key") IN (ANY, ANY)
) p
ORDER BY p."Group Key";
 Group Key |                                                                                                                                  lowercase_pivot&key_xml                                                                                                                                   
-----------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 G1        | <PivotSet><item><column name="lowercase">A&amp;B</column><column name="Pivot&amp;Key">&lt;Online&gt;</column><column name="Total&amp;Value">12.50</column></item><item><column name="lowercase"/><column name="Pivot&amp;Key"/><column name="Total&amp;Value">7</column></item></PivotSet>
(1 row)

-- Ordinary PIVOT combines quoted aliases without folding or losing symbols
SELECT p.*
FROM pivot_xml_identifier_test
PIVOT (
    SUM("Measure&Value") AS "Total&Value"
    FOR ("lowercase", "Pivot&Key") IN (
        ('A&B', '<Online>') AS "Mixed Alias"
    )
) p;
 Group Key | Mixed Alias_Total&Value 
-----------+-------------------------
 G1        | 12.50
(1 row)

-- Generated XML output names must not be silently truncated
SELECT p.*
FROM (
    SELECT "Group Key",
           "lowercase" AS
             "this_is_a_quoted_for_column_name_that_is_long_enough_1234567",
           "Measure&Value"
    FROM pivot_xml_identifier_test
)
PIVOT XML (
    SUM("Measure&Value") AS total
    FOR "this_is_a_quoted_for_column_name_that_is_long_enough_1234567"
    IN (ANY)
) p;
ERROR:  generated PIVOT XML column name is too long
DETAIL:  Generated column name "this_is_a_quoted_for_column_name_that_is_long_enough_1234567_xml" exceeds the maximum identifier length of 63 bytes.
HINT:  Use shorter FOR column names in the PIVOT XML source query.
DROP TABLE pivot_xml_identifier_test;
--11, Oracle DATE/TIMESTAMP/NUMBER retain their native XML output forms
DROP TABLE if exists pivot_xml_scalar_format_test;
NOTICE:  table "pivot_xml_scalar_format_test" does not exist, skipping
CREATE TABLE pivot_xml_scalar_format_test (
    grp          VARCHAR2(10),
    date_key     DATE,
    ts_measure   TIMESTAMP,
    amount       NUMBER(10,4),
    null_measure NUMBER
);
INSERT INTO pivot_xml_scalar_format_test VALUES (
    'G1', DATE '2024-01-02',
    TIMESTAMP '2024-01-02 03:04:05.123456',
    123.4500, NULL
);
SELECT p.*
FROM pivot_xml_scalar_format_test
PIVOT XML (
    MAX(ts_measure) AS max_ts,
    SUM(amount) AS total_amount,
    MAX(null_measure) AS null_measure
    FOR date_key IN (ANY)
) p;
 grp |                                                                                                   date_key_xml                                                                                                   
-----+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 G1  | <PivotSet><item><column name="DATE_KEY">2024-01-02</column><column name="MAX_TS">2024-01-02 03:04:05.123456</column><column name="TOTAL_AMOUNT">123.4500</column><column name="NULL_MEASURE"/></item></PivotSet>
(1 row)

DROP TABLE pivot_xml_scalar_format_test;
-- Oracle DATE time fields reach XMLELEMENT without a cast to pg_catalog.date.
SET nls_date_format = 'YYYY-MM-DD HH24:MI:SS';
SELECT p.*
FROM (
    SELECT TO_DATE('2024-01-02 03:04:05', 'YYYY-MM-DD HH24:MI:SS') AS date_key,
           1 AS amount
    FROM dual
)
PIVOT XML (SUM(amount) AS total FOR date_key IN (ANY)) p;
                                                     date_key_xml                                                      
-----------------------------------------------------------------------------------------------------------------------
 <PivotSet><item><column name="DATE_KEY">2024-01-02 03:04:05</column><column name="TOTAL">1</column></item></PivotSet>
(1 row)

