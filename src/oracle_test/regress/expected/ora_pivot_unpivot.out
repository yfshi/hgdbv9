FROM (
    SELECT id, k_num, k_chr, amount
    FROM pivot_expr_test
)
PIVOT (
    SUM(amount)
    FOR (k_num, k_chr) IN (
        (1, 'A') AS n1_a,
        (2, 'B') AS n2_b,
        (1 + 2, UPPER('c')) AS n3_c
    )
)
ORDER BY id;
