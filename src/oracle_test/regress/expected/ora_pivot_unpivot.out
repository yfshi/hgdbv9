-- unpivot include nulls
SELECT *
FROM (
    SELECT
        p.product_name,
        r.region_name,
        s.q1, s.q2, s.q3, s.q4
    FROM g_sales s
    JOIN g_products p ON s.product_id = p.product_id
    JOIN g_regions  r ON s.region_id  = r.region_id
)
