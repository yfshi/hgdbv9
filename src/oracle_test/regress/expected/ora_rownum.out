CREATE TABLE sales (
    id          int,
    category    varchar2(20),
    amount      number,
    region      varchar2(20),
    status      varchar2(20),
    col1        varchar2(20),
    col2        varchar2(20),
    col3        varchar2(20),
    col4        varchar2(20),
    col5        varchar2(20),
    col6        varchar2(20),
    col7        varchar2(20),
    col8        varchar2(20),
    col9        varchar2(20),
    col10       varchar2(20)
) PARTITION BY RANGE (id);
CREATE TABLE sales_p1 PARTITION OF sales
FOR VALUES FROM (1) TO (301);
CREATE TABLE sales_p2 PARTITION OF sales
FOR VALUES FROM (301) TO (601);
CREATE TABLE sales_p3 PARTITION OF sales
FOR VALUES FROM (601) TO (1001);
CREATE OR REPLACE VIEW sales_view AS
SELECT
    id,
    category,
    amount,
    region,
    status,
    col1,
    col2,
    col3,
    col4,
    col5,
    col6,
    col7,
    ctid,
    0 AS mds,
    sysdate as md
FROM sales;
INSERT INTO sales (
    id, category, amount, region, status,
    col1, col2, col3, col4, col5,
    col6, col7, col8, col9, col10
)
SELECT
    gs,
    'cat-' || gs,
    gs * 1.25,
    'region-' || (gs % 5),
    CASE WHEN gs % 2 = 0 THEN 'OK' ELSE 'PENDING' END,
    'c1-' || gs, 'c2-' || gs, 'c3-' || gs, 'c4-' || gs, 'c5-' || gs,
    'c6-' || gs, 'c7-' || gs, 'c8-' || gs, 'c9-' || gs, 'c10-' || gs
FROM generate_series(1, 1000) gs;
UPDATE sales_view
SET amount = amount + 100,
    status = 'UPDATED'
WHERE id < 10;
