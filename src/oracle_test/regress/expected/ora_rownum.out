-- Pagination with ROWNUM
select *
	from
	(select a.*, rownum rnum
		from
		(select empno, sal
			from eemp
		 order by sal) a
		where rownum <= 12
	)
	where rnum >= 8;
 empno |   sal   | rnum 
-------+---------+------
 7499  | 1600.00 |    8
 7782  | 2450.00 |    9
 7698  | 2850.00 |   10
 7566  | 2975.00 |   11
 7902  | 3000.00 |   12
(5 rows)

select deptno from eemp where rownum < 5 group by deptno;
 deptno 
--------
 20
 30
(2 rows)

select rownum from eemp group by deptno; -- error
ERROR:  column "ROWNUM" must appear in the GROUP BY clause or be used in an aggregate function
