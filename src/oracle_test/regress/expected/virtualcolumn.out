--Test inherits table
CREATE TABLE v_parent (a int primary key, b int GENERATED ALWAYS AS (a * 2));
CREATE TABLE v_inh (
    state           char(2)
) INHERITS (v_parent);
\d v_inh
                                Table "public.v_inh"
 Column |  Type   |   Collation    | Nullable |               Default               
--------+---------+----------------+----------+-------------------------------------
 a      | integer |                | not null | 
 b      | integer |                |          | generated always as (a * 2) virtual
 state  | char(2) | using_nls_comp |          | 
Inherits: v_parent

insert into v_inh (a, b, state) values (1, 3, 'd');
ERROR:  INSERT operation disallowed on virtual columns
drop table v_inh;
CREATE TABLE v_like (like v_parent including generated);
\d v_like
                             Table "public.v_like"
 Column |  Type   | Collation | Nullable |               Default               
--------+---------+-----------+----------+-------------------------------------
 a      | integer |           | not null | 
 b      | integer |           |          | generated always as (a * 2) virtual

insert into v_like (a, b) values (1,3);
ERROR:  INSERT operation disallowed on virtual columns
drop table v_like;
drop table v_parent;
