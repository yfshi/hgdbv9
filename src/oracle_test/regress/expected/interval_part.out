--
-- ReqID:RSR-SQL-Partition-interval
--
--
-- partition key and interval expression
--
-- error: unsupported partition key types
CREATE TABLE i_partitioned (
	a time
) PARTITION BY RANGE (a) INTERVAL (10);
ERROR:  Invalid data type for partitioning column of an interval partitioned
-- error: unsupported partition key types
CREATE TABLE i_partitioned (
	a text
) PARTITION BY RANGE (a) INTERVAL (10);
ERROR:  Invalid data type for partitioning column of an interval partitioned
-- error: unsupported partition key types
CREATE TABLE i_partitioned (
	a dsinterval
) PARTITION BY RANGE (a) INTERVAL (interval '1' hour);
ERROR:  Invalid data type for partitioning column of an interval partitioned
-- error: multiple intervals
CREATE TABLE i_partitioned (
	a int,
	b int
) PARTITION BY RANGE (a) INTERVAL (1,2);
ERROR:  syntax error at or near ","
LINE 4: ) PARTITION BY RANGE (a) INTERVAL (1,2);
                                            ^
-- error: multiple partition keys
CREATE TABLE i_partitioned (
	a int,
	b int
) PARTITION BY RANGE (a,b) INTERVAL (10);
ERROR:  Range partitioned table with INTERVAL clause has more than one column
LINE 4: ) PARTITION BY RANGE (a,b) INTERVAL (10);
                       ^
-- error: invalid collation
CREATE TABLE i_partitioned (
	a int,
	b int
) PARTITION BY RANGE (a) INTERVAL (10 collate aa_DJ);
ERROR:  collations are not supported by type integer
LINE 4: ) PARTITION BY RANGE (a) INTERVAL (10 collate aa_DJ);
                                              ^
--
-- interval data types
--
-- error: must be greater than 0
CREATE TABLE i_partitioned (
	a int
) PARTITION BY RANGE (a) INTERVAL (0);
ERROR:  interval must be greater than zero
LINE 3: ) PARTITION BY RANGE (a) INTERVAL (0);
                                           ^
-- error: must be greater than 0
CREATE TABLE i_partitioned (
	a float
) PARTITION BY RANGE (a) INTERVAL (0);
ERROR:  interval must be greater than zero
LINE 3: ) PARTITION BY RANGE (a) INTERVAL (0);
                                           ^
-- error: must be greater than 0
CREATE TABLE i_partitioned (
	a numeric
) PARTITION BY RANGE (a) INTERVAL (-1);
ERROR:  interval must be greater than zero
LINE 3: ) PARTITION BY RANGE (a) INTERVAL (-1);
                                           ^
-- error: must be greater than 0
CREATE TABLE i_partitioned (
	a number
) PARTITION BY RANGE (a) INTERVAL (0);
ERROR:  interval must be greater than zero
LINE 3: ) PARTITION BY RANGE (a) INTERVAL (0);
                                           ^
-- error: must be greater than 0
CREATE TABLE i_partitioned (
	a date
) PARTITION BY RANGE (a) INTERVAL (interval '0' day);
ERROR:  interval must be greater than zero
LINE 3: ) PARTITION BY RANGE (a) INTERVAL (interval '0' day);
                                           ^
-- error: must be greater than 0
CREATE TABLE i_partitioned (
	a timestamp
) PARTITION BY RANGE (a) INTERVAL (interval '-1' hour);
ERROR:  interval must be greater than zero
LINE 3: ) PARTITION BY RANGE (a) INTERVAL (interval '-1' hour);
                                           ^
CREATE TABLE i_partitioned (
	a int
) PARTITION BY RANGE (a) INTERVAL (1);
