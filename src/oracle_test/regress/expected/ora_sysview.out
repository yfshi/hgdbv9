/* Begin - bug#7786 */
SET timezone = '-08:00';
CREATE TABLE PAR_TEST(
 A FLOAT,
 B NUMERIC,
 C INT,
 D BINARY_FLOAT,
 E BINARY_DOUBLE,
 F DATE,
 G TIMESTAMP(3),
 H TIMESTAMP(4) WITH TIME ZONE,
 I TIMESTAMP(5) WITH LOCAL TIME ZONE,
 J INTERVAL YEAR TO MONTH,
 K INTERVAL DAY TO SECOND,
 L CHAR(10),
 M VARCHAR2(10))
PARTITION BY RANGE(A,B,C,D,E,F,G,H,I,J,K,L,M)
(
 PARTITION P1 VALUES LESS THAN(1E2, 1E2, 1E2, 1E2, 1E2,
							DATE '2026-1-1',
							TIMESTAMP '2026-1-1 11:11:11.123',
							TIMESTAMP '2026-1-1 11:11:11.123 +08:00',
							TIMESTAMP '2026-1-1 11:11:11.123',
							INTERVAL '1-2' YEAR TO MONTH,
							INTERVAL '1 1:1:1' DAY TO SECOND,
							'CHAR',
							'VARCHAR2')
);
select table_name, partition_name, high_value from dba_tab_partitions where table_name ilike 'PAR_TEST';
 table_name | partition_name |                                                                                                                                                                                               high_value                                                                                                                                                                                               
------------+----------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 par_test   | p1             | 100, 100, 100, 1.0E+002, 1.0E+002, TO_DATE('2026-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS'), TO_TIMESTAMP('2026-01-01 11:11:11.123000', 'SYYYY-MM-DD HH24:MI:SS.FF'), TO_TIMESTAMP_TZ('2026-01-01 11:11:11.123000 +08:00', 'SYYYY-MM-DD HH24:MI:SS.FF TZH:TZM'), TO_TIMESTAMP_TZ('2026-01-01 11:11:11.123000', 'SYYYY-MM-DD HH24:MI:SS.FF'), '+01-02', '+01 01:01:01.000000', 'CHAR      ', 'VARCHAR2'
(1 row)

RESET timezone;
DROP TABLE PAR_TEST;
/* Begin - bug#7786 */
/* Begin - OA#2669 */
CREATE TABLE OA_2669_TB(
    COL1 LONG RAW,
    COL2 FLOAT,
    COL3 TIMESTAMP(6),
    COL4 TIMESTAMP(6) WITH TIME ZONE,
    COL5 TIMESTAMP(6) WITH LOCAL TIME ZONE,
    COL6 INTERVAL YEAR(5) TO MONTH,
    COL7 INTERVAL DAY(9) TO SECOND(6),
    COL8 DATE,
    COL9 CHAR,
    COL10 NCHAR,
    COL11 CHAR(10),
    COL12 NCHAR(10),
    COL13 NVARCHAR2,
    COL14 NVARCHAR2(128),
    COL15 VARCHAR2,
    COL16 VARCHAR2(128),
