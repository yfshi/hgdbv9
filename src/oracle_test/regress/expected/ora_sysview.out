 table_name,
 partition_name,
 subpartition_name,
 high_value,
 high_value_length,
 partition_position,
 subpartition_position
FROM ALL_TAB_SUBPARTITIONS
WHERE table_name ILIKE 'test_%' OR table_name ILIKE 'user1_%' OR table_name ILIKE 'user2_%'
ORDER BY table_owner, table_name, partition_name, subpartition_name;
  table_name  | partition_name | subpartition_name | high_value | high_value_length | partition_position | subpartition_position 
--------------+----------------+-------------------+------------+-------------------+--------------------+-----------------------
 test_subpart | p202401        | p202401_sp_east   | 'EAST'     | 6                 | 1                  | 1
 test_subpart | p202401        | p202401_sp_other  | DEFAULT    | 7                 | 1                  | 3
 test_subpart | p202401        | p202401_sp_west   | 'WEST'     | 6                 | 1                  | 2
 test_subpart | p202402        | p202402_sp_east   | 'EAST'     | 6                 | 2                  | 1
 test_subpart | p202402        | p202402_sp_other  | DEFAULT    | 7                 | 2                  | 3
 test_subpart | p202402        | p202402_sp_west   | 'WEST'     | 6                 | 2                  | 2
(6 rows)

