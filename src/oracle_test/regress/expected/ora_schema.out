-- clean
RESET SESSION AUTHORIZATION;
DROP OWNED BY sc_u1 CASCADE;
NOTICE:  drop cascades to 5 other objects
DETAIL:  drop cascades to operator family sc_u1.obj_opf1 for access method hash
drop cascades to operator family sc_u1.obj_opc1 for access method hash
drop cascades to statistics object sc_u1.obj_stat1
drop cascades to view obj_v1
drop cascades to materialized view sc_mv1
DROP USER sc_u1;
DROP OWNED BY sc_pub CASCADE;
DROP USER sc_pub;
