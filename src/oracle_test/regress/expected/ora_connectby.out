                 ->  WindowAgg
                       ->  Sort
                             Sort Key: level__query1."_colh1.id", level__query1."_colh1.pid", ((level__query1."_colh1.name")::varchar2(256)) COLLATE "binary"
                             ->  CTE Scan on level__query1
