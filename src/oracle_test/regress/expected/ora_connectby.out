select * from h1 LEFT JOIN h1 hh on h1.c1=hh.c1 and h1.c1>1 connect by nocycle prior (h1.c1)= prior(h1.c1) start with h1.c1 =1 order siblings by h1.c1,hh.c1,h1.name;
 c1 | name | c1 | name 
