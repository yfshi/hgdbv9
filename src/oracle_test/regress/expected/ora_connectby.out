explain (costs off) SELECT h1.id AS id,h1.pid AS pid,h1.name,level FROM connect_by_table h1 left JOIN connect_by_table h2
ON h1.id > 2 AND h1.id > 102 connect BY nocycle h1.id = prior h2.pid order siblings by h1.id,h1.pid,h1.name;
                                                                             QUERY PLAN                                                                             
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Subquery Scan on final_level__query
   ->  Sort
         Sort Key: level__query.cte_0_by_order_col
         CTE level__query
           ->  Recursive Union
                 CTE level__query1
                   ->  Nested Loop Left Join
                         Join Filter: ((h1.id > 2) AND (h1.id > 102))
                         ->  Seq Scan on connect_by_table h1
                         ->  Materialize
                               ->  Seq Scan on connect_by_table h2
                 ->  WindowAgg
                       ->  Sort
                             Sort Key: level__query1."_colh1.id", level__query1."_colh1.pid", ((level__query1."_colh1.name")::varchar2(256)) COLLATE "binary"
                             ->  CTE Scan on level__query1
                 ->  WindowAgg
                       ->  Incremental Sort
                             Sort Key: level__query1_1."_colh1.id", level__query1_1."_colh1.pid", ((level__query1_1."_colh1.name")::varchar2(256)) COLLATE "binary"
                             Presorted Key: level__query1_1."_colh1.id"
                             ->  Merge Join
                                   Merge Cond: (level__query1_1."_colh1.id" = level__query_1."_colh2.pid")
                                   Join Filter: cycle_check(level__query_1.cte_0_array__path, (ROW(level__query1_1."_colh2.pid"))::text, true)
                                   ->  Sort
                                         Sort Key: level__query1_1."_colh1.id"
                                         ->  CTE Scan on level__query1 level__query1_1
                                   ->  Materialize
                                         ->  Sort
                                               Sort Key: level__query_1."_colh2.pid"
                                               ->  WorkTable Scan on level__query level__query_1
         ->  CTE Scan on level__query
(30 rows)

--test with_clause
with cte_1 as (select * from connect_by_table)
SELECT id,pid,name,level,prior id,CONNECT_BY_ISCYCLE as cycle ,CONNECT_BY_ISLEAF as leaf FROM cte_1 START WITH id = 1 CONNECT BY NOCYCLE PRIOR id = pid order siblings by id;
  id   | pid | name | level | _priorid | cycle | leaf 
-------+-----+------+-------+----------+-------+------
     1 |     | A    |     1 |          |     0 |    0
   101 |   1 | B1   |     2 |        1 |     0 |    0
 10101 | 101 | C0   |     3 |      101 |     0 |    1
 10102 | 101 | C1   |     3 |      101 |     0 |    1
   102 |   1 | B2   |     2 |        1 |     0 |    0
 10201 | 102 | C2   |     3 |      102 |     1 |    1
(6 rows)

