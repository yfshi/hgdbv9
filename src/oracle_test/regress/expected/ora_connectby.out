--11 rows
SELECT h1.id AS id,h1.pid AS pid,h1.name,level FROM connect_by_table h1 LEFT JOIN connect_by_table h2
ON h1.id = h2.id AND h1.id > 102 connect BY h1.id = prior h2.pid order siblings by h1.id,h1.pid,h1.name;
  id   |  pid  | name  | level 
-------+-------+-------+-------
     1 |       | A     |     1
   101 |     1 | B1    |     1
   102 |     1 | B2    |     1
   102 | 10201 | CYCLE |     1
 10101 |   101 | C0    |     1
   101 |     1 | B1    |     2
 10102 |   101 | C1    |     1
   101 |     1 | B1    |     2
 10201 |   102 | C2    |     1
   102 |     1 | B2    |     2
   102 | 10201 | CYCLE |     2
(11 rows)

explain(costs off) select h1.id AS id,h1.pid AS pid,h1.name,level FROM connect_by_table h1 LEFT JOIN connect_by_table h2
ON h1.id = h2.id AND h1.id > 102 connect BY h1.id = prior h2.pid order siblings by h1.id,h1.pid,h1.name;
                                                                             QUERY PLAN                                                                             
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Subquery Scan on final_level__query
   ->  Sort
         Sort Key: level__query.cte_0_by_order_col
         CTE level__query
           ->  Recursive Union
                 CTE level__query1
                   ->  Hash Left Join
                         Hash Cond: (h1.id = h2.id)
                         Join Filter: (h1.id > 102)
                         ->  Seq Scan on connect_by_table h1
                         ->  Hash
                               ->  Seq Scan on connect_by_table h2
                 ->  WindowAgg
                       ->  Sort
                             Sort Key: level__query1."_colh1.id", level__query1."_colh1.pid", ((level__query1."_colh1.name")::varchar2(256)) COLLATE "binary"
                             ->  CTE Scan on level__query1
                 ->  WindowAgg
                       ->  Sort
                             Sort Key: level__query1_1."_colh1.id", level__query1_1."_colh1.pid", ((level__query1_1."_colh1.name")::varchar2(256)) COLLATE "binary"
                             ->  Hash Join
                                   Hash Cond: (level__query_1."_colh2.pid" = level__query1_1."_colh1.id")
                                   Join Filter: cycle_check(level__query_1.cte_0_array__path, (ROW(level__query1_1."_colh2.pid"))::text, false)
                                   ->  WorkTable Scan on level__query level__query_1
                                   ->  Hash
                                         ->  CTE Scan on level__query1 level__query1_1
         ->  CTE Scan on level__query
(26 rows)

