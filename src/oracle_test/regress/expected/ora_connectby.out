                       ->  Incremental Sort
                             Sort Key: level__query1_1."_colh1.id", level__query1_1."_colh1.pid", ((level__query1_1."_colh1.name")::varchar2(256)) COLLATE "binary"
                             Presorted Key: level__query1_1."_colh1.id"
                             ->  Merge Join
                                   Merge Cond: (level__query1_1."_colh1.id" = level__query_1."_colh2.pid")
                                   Join Filter: cycle_check(level__query_1.cte_0_array__path, (ROW(level__query1_1."_colh2.pid"))::text, true)
                                   ->  Sort
                                         Sort Key: level__query1_1."_colh1.id"
                                         ->  CTE Scan on level__query1 level__query1_1
                                   ->  Sort
                                         Sort Key: level__query_1."_colh2.pid"
                                         ->  WorkTable Scan on level__query level__query_1
         ->  CTE Scan on level__query
               Filter: ("_colh1.id" > 102)
