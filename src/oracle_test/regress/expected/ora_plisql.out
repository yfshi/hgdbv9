(1 row)

SELECT pg_get_functiondef('test_subproc_func'::regproc) from dual;
                          pg_get_functiondef                          
----------------------------------------------------------------------
 CREATE OR REPLACE FUNCTION public.test_subproc_func(INOUT a integer)+
  RETURN integer                                                     +
  AUTHID DEFINER                                                     +
 IS                                                                  +
                                                                     +
 declare                                                             +
   mds integer;                                                      +
   original integer;                                                 +
   function square(original in out integer) return integer;          +
   function square(original in out integer) return integer           +
   AS                                                                +
   declare                                                           +
        original_squared integer;                                    +
   begin                                                             +
        original_squared := original * original;                     +
        original := original_squared + 1;                            +
