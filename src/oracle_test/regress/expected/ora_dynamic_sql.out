DROP PACKAGE pkg;
CREATE OR REPLACE PACKAGE pkg2 AUTHID DEFINER AS
  TYPE rec IS RECORD (n1 NUMBER, n2 NUMBER);
  TYPE rec2 IS RECORD (m1 rec, m2 NUMBER);
  PROCEDURE p (i rec, j NUMBER, k NUMBER);
  PROCEDURE p2 (i rec2, j NUMBER, k NUMBER);
  PROCEDURE p3 (i OUT rec2, j NUMBER, k NUMBER);
END pkg2;
/
CREATE OR REPLACE PACKAGE BODY pkg2 AS
  PROCEDURE p (i rec, j NUMBER, k NUMBER) AS
    a  int;
  BEGIN
    a :=  i.n1 + i.n2 + j + k;
	raise notice 'a = %',a;
  END p;
  PROCEDURE p2 (i rec2, j NUMBER, k NUMBER) AS
    a  int;
  BEGIN
    a :=  i.m1.n1 + i.m1.n2 + i.m2 + j + k;
	raise notice 'a = %',a;
  END p2;
  PROCEDURE p3 (i OUT rec2, j NUMBER, k NUMBER) AS
  BEGIN
    i.m1.n1 := j;
	i.m1.n2 := k;
	i.m2 := j + k;
  END p3;
END pkg2;
/
DECLARE
  r pkg2.rec;
  dyn_str VARCHAR2(3000);
BEGIN
  r.n1 := 11;
  r.n2 := 22;
  dyn_str := 'BEGIN pkg2.p(:x, 3, 4); END;';
  EXECUTE IMMEDIATE dyn_str USING r;
  RAISE NOTICE 'r = %', r;
END;
/
NOTICE:  a = 40
NOTICE:  r = (11,22)
DECLARE
  r pkg2.rec2;
  dyn_str VARCHAR2(3000);
BEGIN
  r.m1.n1 := 11;
  r.m1.n2 := 22;
  r.m2 := 2;
  dyn_str := 'BEGIN pkg2.p2(:x, 3, 4); END;';
  EXECUTE IMMEDIATE dyn_str USING r;
  RAISE NOTICE 'r.m1 = %, r.m2 = %', r.m1, r.m2;
END;
/
NOTICE:  a = 42
NOTICE:  r.m1 = (11,22), r.m2 = 2
DECLARE
  r pkg2.rec2;
  dyn_str VARCHAR2(3000);
BEGIN
  dyn_str := 'BEGIN pkg2.p3(:x, 3, 4); END;';
  EXECUTE IMMEDIATE dyn_str USING OUT r;
  RAISE NOTICE 'r.m1 = %, r.m2 = %', r.m1, r.m2;
END;
/
NOTICE:  r.m1 = (3,4), r.m2 = 7
DECLARE
  r pkg2.rec2;
  dyn_str VARCHAR2(3000);
BEGIN
  r.m1.n1 := 11;
  r.m1.n2 := 22;
  dyn_str := 'BEGIN pkg2.p(:x, 3, 4); END;';
  EXECUTE IMMEDIATE dyn_str USING r.m1;
  RAISE NOTICE 'r.m1 = %, r.m2 = %', r.m1, r.m2;
END;
/
NOTICE:  a = 40
NOTICE:  r.m1 = (11,22), r.m2 = <NULL>
DROP PACKAGE pkg2;
