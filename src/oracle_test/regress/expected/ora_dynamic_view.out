-- support bool - array_nulls
select name, type, value, display_value, default_value, isdefault, isses_modifiable, issys_modifiable, ismodified, description, update_comment, isbasic from v$parameter where name = 'array_nulls';
    name     | type | value | display_value | default_value | isdefault | isses_modifiable | issys_modifiable | ismodified |               description                |                                               update_comment                                               | isbasic 
-------------+------+-------+---------------+---------------+-----------+------------------+------------------+------------+------------------------------------------+------------------------------------------------------------------------------------------------------------+---------
 array_nulls | 1    | on    | on            | on            | TRUE      | TRUE             | IMMEDIATE        | false      | Enable input of NULL elements in arrays. | When turned on, unquoted NULL in an array input value means a null value; otherwise it is taken literally. | FALSE
(1 row)

set array_nulls='off';
select name, type, value, display_value, default_value, isdefault, isses_modifiable, issys_modifiable, ismodified, description, update_comment, isbasic from v$parameter where name = 'array_nulls';
    name     | type | value | display_value | default_value | isdefault | isses_modifiable | issys_modifiable | ismodified |               description                |                                               update_comment                                               | isbasic 
-------------+------+-------+---------------+---------------+-----------+------------------+------------------+------------+------------------------------------------+------------------------------------------------------------------------------------------------------------+---------
 array_nulls | 1    | off   | off           | on            | FALSE     | TRUE             | IMMEDIATE        | modified   | Enable input of NULL elements in arrays. | When turned on, unquoted NULL in an array input value means a null value; otherwise it is taken literally. | FALSE
(1 row)

reset array_nulls;
select name, type, value, display_value, default_value, isdefault, isses_modifiable, issys_modifiable, ismodified, description, update_comment, isbasic from v$parameter where name = 'array_nulls';
    name     | type | value | display_value | default_value | isdefault | isses_modifiable | issys_modifiable | ismodified |               description                |                                               update_comment                                               | isbasic 
-------------+------+-------+---------------+---------------+-----------+------------------+------------------+------------+------------------------------------------+------------------------------------------------------------------------------------------------------------+---------
 array_nulls | 1    | on    | on            | on            | TRUE      | TRUE             | IMMEDIATE        | false      | Enable input of NULL elements in arrays. | When turned on, unquoted NULL in an array input value means a null value; otherwise it is taken literally. | FALSE
(1 row)

