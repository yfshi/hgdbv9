--
-- Test Compatible Oracle ROWID pseudo
--
--
--1, Support rowid feature via default_with_rowids GUC parameter
--
show ivorysql.default_with_rowids;
 ivorysql.default_with_rowids 
------------------------------
 off
(1 row)

-- rowid conflicts with a system column
create table t1(rowid int, a int);	--error
ERROR:  column name "rowid" conflicts with a system column name
set ivorysql.default_with_rowids to on;
create table t2 (a int, b int);
insert into t2 values(20, 3);
insert into t2 values(5, 7);
insert into t2 values(4, 9);
create table t3 (a int, b int);
insert into t3 values(2, 6);
insert into t3 values(15, 17);
insert into t3 values(5, 30);
-- select without rowid pseudo
select * from t2;
 a  | b 
----+---
 20 | 3
  5 | 7
  4 | 9
(3 rows)

select * from t3;
 a  | b  
----+----
  2 |  6
 15 | 17
  5 | 30
(3 rows)

-- select with rowid pseudo
select rowid, * from t2;
   rowid   | a  | b 
-----------+----+---
 (16387,1) | 20 | 3
 (16387,2) |  5 | 7
 (16387,3) |  4 | 9
(3 rows)

select rowid, * from t2 where rowid = '(16387,3)';
   rowid   | a | b 
-----------+---+---
 (16387,3) | 4 | 9
(1 row)

select rowid, * from t3;
   rowid   | a  | b  
-----------+----+----
 (16392,1) |  2 |  6
 (16392,2) | 15 | 17
 (16392,3) |  5 | 30
(3 rows)

select rowid, * from t3 where rowid = '(16392,2)';
   rowid   | a  | b  
-----------+----+----
 (16392,2) | 15 | 17
(1 row)

-- test join
select t2.rowid, t3.rowid from t2 INNER join t3 on (t2.a = t3.a);
   rowid   |   rowid   
-----------+-----------
 (16387,2) | (16392,3)
(1 row)

-- test update rowid column
update t2 set rowid = 100 where a = 20; --error
ERROR:  cannot specify system column name "rowid"
-- test update using rowid
update t2 set a = a + 100 where rowid = '(16387,3)';
select rowid, * from t2;
   rowid   |  a  | b 
-----------+-----+---
 (16387,1) |  20 | 3
 (16387,2) |   5 | 7
 (16387,3) | 104 | 9
(3 rows)

--test delete using rowid
delete from t2 where rowid = '(16387,1)';
select rowid, * from t2;
   rowid   |  a  | b 
-----------+-----+---
 (16387,2) |   5 | 7
 (16387,3) | 104 | 9
(2 rows)

-- test insert rowid column
insert into t2(rowid, a, b) values(50, 2, 3); --error
ERROR:  column "rowid" of relation "t2" does not exist
LINE 1: insert into t2(rowid, a, b) values(50, 2, 3);
                       ^
drop table t2;
drop table t3;
set ivorysql.default_with_rowids to off;
--
--2, Support rowid feature via ALTER TABLE command
--
create table t2 (a int, b int);
insert into t2 values(20, 3);
insert into t2 values(5, 7);
insert into t2 values(4, 9);
alter table t2 set with rowid;
create table t3 (a int, b int);
alter table t3 set with rowid;
insert into t3 values(2, 6);
insert into t3 values(15, 17);
insert into t3 values(5, 30);
-- select without rowid pseudo
select * from t2;
 a  | b 
----+---
 20 | 3
  5 | 7
  4 | 9
(3 rows)

select * from t3;
 a  | b  
----+----
  2 |  6
 15 | 17
  5 | 30
(3 rows)

-- select with rowid pseudo
select rowid, * from t2;
   rowid   | a  | b 
-----------+----+---
 (16396,1) | 20 | 3
 (16396,2) |  5 | 7
 (16396,3) |  4 | 9
(3 rows)

select rowid, * from t2 where rowid = '(16396,2)';
   rowid   | a | b 
-----------+---+---
 (16396,2) | 5 | 7
(1 row)

select rowid, * from t3;
   rowid   | a  | b  
-----------+----+----
 (16403,1) |  2 |  6
 (16403,2) | 15 | 17
 (16403,3) |  5 | 30
(3 rows)

select rowid, * from t3 where rowid = '(16403,1)';
   rowid   | a | b 
-----------+---+---
 (16403,1) | 2 | 6
(1 row)

-- test join
select t2.rowid, t3.rowid from t2 INNER join t3 on (t2.a = t3.a);
   rowid   |   rowid   
-----------+-----------
 (16396,2) | (16403,3)
(1 row)

-- test update rowid column
update t2 set rowid = 100 where a = 20; --error
ERROR:  cannot specify system column name "rowid"
-- test update using rowid
update t2 set a = a + 100 where rowid = '(16396,3)';
select rowid, * from t2;
   rowid   |  a  | b 
-----------+-----+---
 (16396,1) |  20 | 3
 (16396,2) |   5 | 7
 (16396,3) | 104 | 9
(3 rows)

--test delete using rowid
delete from t2 where rowid = '(16396,1)';
select rowid, * from t2;
   rowid   |  a  | b 
-----------+-----+---
 (16396,2) |   5 | 7
 (16396,3) | 104 | 9
(2 rows)

-- test insert rowid column
insert into t2(rowid, a, b) values(50, 2, 3); --error
ERROR:  column "rowid" of relation "t2" does not exist
LINE 1: insert into t2(rowid, a, b) values(50, 2, 3);
                       ^
--
-- ALTER TABLE ... SET WITHOUT ROWID
--
alter table t2 set without rowid;
select rowid, * from t2;
ERROR:  "rowid": invalid identifier
LINE 1: select rowid, * from t2;
               ^
-- clearup
drop table t2;
drop table t3;
--
--3, CTEATE TABLE ... WITH ROWID 
--
create table t2 (a int, b int) with rowid;
insert into t2 values(20, 3);
insert into t2 values(5, 7);
insert into t2 values(4, 9);
create table t3 (a int, b int) with rowid;
insert into t3 values(2, 6);
insert into t3 values(15, 17);
insert into t3 values(5, 30);
-- select without rowid pseudo
select * from t2;
 a  | b 
----+---
 20 | 3
  5 | 7
  4 | 9
(3 rows)

select * from t3;
 a  | b  
----+----
  2 |  6
 15 | 17
  5 | 30
(3 rows)

-- select with rowid pseudo
select rowid, * from t2;
   rowid   | a  | b 
-----------+----+---
 (16414,1) | 20 | 3
 (16414,2) |  5 | 7
 (16414,3) |  4 | 9
(3 rows)

select rowid, * from t2 where rowid = '(16414,1)';
   rowid   | a  | b 
-----------+----+---
 (16414,1) | 20 | 3
(1 row)

select rowid, * from t3;
   rowid   | a  | b  
-----------+----+----
 (16419,1) |  2 |  6
 (16419,2) | 15 | 17
 (16419,3) |  5 | 30
(3 rows)

select rowid, * from t3 where rowid = '(16419,2)';
   rowid   | a  | b  
-----------+----+----
 (16419,2) | 15 | 17
(1 row)

-- test join
select t2.rowid, t3.rowid from t2 INNER join t3 on (t2.a = t3.a);
   rowid   |   rowid   
-----------+-----------
 (16414,2) | (16419,3)
(1 row)

drop table t2;
drop table t3;
--
--4, Test rowid type
--
create table t2(a int, b int) with rowid;
insert into t2 values(100, 101);
create or replace function tf_r() return int
as
declare
    rr rowid;
begin
    select rowid from t2 into rr;
    raise info 'rr.rowoid = %, rr.rowno = %', rr.rowoid, rr.rowno;
	return 1;
end;
/
select tf_r() from dual;
INFO:  rr.rowoid = 16424, rr.rowno = 1
 tf_r 
------
    1
(1 row)

drop table t2;
drop function tf_r;
--
--5, Test PARTITION TABLE support ROWID
--
create table ptable(id int, td varchar2(100)) partition by list(td) with rowid;
create table pt_01 partition of ptable for values in ('2021-08-05');
create table pt_02 partition of ptable for values in ('2021-08-06');
insert into ptable values(1,'2021-08-05');
insert into ptable values(2,'2021-08-05');
insert into ptable values(3,'2021-08-05');
insert into ptable values(4,'2021-08-05');
insert into ptable values(5,'2021-08-06');
insert into ptable values(6,'2021-08-06');
insert into ptable values(7,'2021-08-06');
insert into ptable values(8,'2021-08-06');
select rowid, * from ptable;
   rowid   | id |     td     
-----------+----+------------
 (16434,1) |  1 | 2021-08-05
 (16434,2) |  2 | 2021-08-05
 (16434,3) |  3 | 2021-08-05
 (16434,4) |  4 | 2021-08-05
 (16438,1) |  5 | 2021-08-06
 (16438,2) |  6 | 2021-08-06
 (16438,3) |  7 | 2021-08-06
 (16438,4) |  8 | 2021-08-06
(8 rows)

select rowid, * from pt_01;
   rowid   | id |     td     
-----------+----+------------
 (16434,1) |  1 | 2021-08-05
 (16434,2) |  2 | 2021-08-05
 (16434,3) |  3 | 2021-08-05
 (16434,4) |  4 | 2021-08-05
(4 rows)

select rowid, * from pt_02;
   rowid   | id |     td     
-----------+----+------------
 (16438,1) |  5 | 2021-08-06
 (16438,2) |  6 | 2021-08-06
 (16438,3) |  7 | 2021-08-06
 (16438,4) |  8 | 2021-08-06
(4 rows)

drop table ptable;
--
--6, Test default index on rowid
--
create table t2(mystr varchar2(100), id int) with rowid;
insert into t2 SELECT 'INSERT table t2 WITH ROWID', generate_series(1,20000);
select rowid, * from t2 limit 10;
   rowid    |           mystr            | id 
------------+----------------------------+----
 (16442,1)  | INSERT table t2 WITH ROWID |  1
 (16442,2)  | INSERT table t2 WITH ROWID |  2
 (16442,3)  | INSERT table t2 WITH ROWID |  3
 (16442,4)  | INSERT table t2 WITH ROWID |  4
 (16442,5)  | INSERT table t2 WITH ROWID |  5
 (16442,6)  | INSERT table t2 WITH ROWID |  6
 (16442,7)  | INSERT table t2 WITH ROWID |  7
 (16442,8)  | INSERT table t2 WITH ROWID |  8
 (16442,9)  | INSERT table t2 WITH ROWID |  9
 (16442,10) | INSERT table t2 WITH ROWID | 10
(10 rows)

explain (COSTS OFF) select rowid, * from t2 where rowid = '(16442,9)';
                    QUERY PLAN                    
--------------------------------------------------
 Bitmap Heap Scan on t2
   Recheck Cond: (rowid = '(16442,9)'::rowid)
   ->  Bitmap Index Scan on t2_16442_rowid_idx
         Index Cond: (rowid = '(16442,9)'::rowid)
(4 rows)

drop table t2;
--
--7, Test CREATE TABLE LIKE
--
create table t2 (a int, b int) with rowid;
create table t2_like (LIKE t2);
insert into t2_like values(20, 3);
insert into t2_like values(5, 7);
insert into t2_like values(4, 9);
select rowid, * from t2_like;
   rowid   | a  | b 
-----------+----+---
 (16452,1) | 20 | 3
 (16452,2) |  5 | 7
 (16452,3) |  4 | 9
(3 rows)

drop table t2_like;
drop table t2;
--
--8, Test temp table with rowid
--
create temp table t3(
    mystr  text,
    id      int
) with rowid;
insert into t3 SELECT 'INSERT TEMP table t3 WITH ROWID', generate_series(1,200);
select rowid, * from t3 limit 5;
   rowid   |              mystr              | id 
-----------+---------------------------------+----
 (16459,1) | INSERT TEMP table t3 WITH ROWID |  1
 (16459,2) | INSERT TEMP table t3 WITH ROWID |  2
 (16459,3) | INSERT TEMP table t3 WITH ROWID |  3
 (16459,4) | INSERT TEMP table t3 WITH ROWID |  4
 (16459,5) | INSERT TEMP table t3 WITH ROWID |  5
(5 rows)

drop table t3;
--
--9, Test GTT with rowid
--
create global temporary table t4(
    mystr  text,
    id      int
) with rowid ON COMMIT PRESERVE ROWS;
insert into t4 SELECT 'INSERT GTT table t4 WITH ROWID', generate_series(1,200);
select rowid, * from t4 limit 5;
   rowid   |             mystr              | id 
-----------+--------------------------------+----
 (16466,1) | INSERT GTT table t4 WITH ROWID |  1
 (16466,2) | INSERT GTT table t4 WITH ROWID |  2
 (16466,3) | INSERT GTT table t4 WITH ROWID |  3
 (16466,4) | INSERT GTT table t4 WITH ROWID |  4
 (16466,5) | INSERT GTT table t4 WITH ROWID |  5
(5 rows)

truncate table t4;
drop table t4;
--
--10, Test View
--
create table t2(mystr varchar2(100), id int) with rowid;
	
insert into t2 SELECT 'INSERT table t2 WITH ROWID', generate_series(1,5);
create view v1 as select * from t2;
select rowid from v1;
   rowid   
-----------
 (16473,1)
 (16473,2)
 (16473,3)
 (16473,4)
 (16473,5)
(5 rows)

select * from v1;
           mystr            | id |   rowid   
----------------------------+----+-----------
 INSERT table t2 WITH ROWID |  1 | (16473,1)
 INSERT table t2 WITH ROWID |  2 | (16473,2)
 INSERT table t2 WITH ROWID |  3 | (16473,3)
 INSERT table t2 WITH ROWID |  4 | (16473,4)
 INSERT table t2 WITH ROWID |  5 | (16473,5)
(5 rows)

drop view v1;
drop table t2;
