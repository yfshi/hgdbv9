  job_number INTEGER;
BEGIN
  Call test_JOB.submit(
    job       => job_number,
    what      => 'INSERT INTO random_data (random_number, insert_currenttime)
  VALUES (10 , SYSTIMESTAMP);',
    next_date => '2024-2-26',
    no_parse  => FALSE
  );
  COMMIT;
END;
