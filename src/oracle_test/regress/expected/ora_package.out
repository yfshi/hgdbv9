--more than one parameter
CREATE OR REPLACE PACKAGE pkg_test_default_var AS
    gv_str  VARCHAR2(50) := 'a value';
    gv_num  NUMBER       := 888;
    gv_date DATE         := to_date('2026-04-15','YYYY-MM-DD');
    gv_null VARCHAR2(10) := NULL;
	function test_f( p_str  VARCHAR2 DEFAULT pkg_test_default_var.gv_str,
    p_num  NUMBER   DEFAULT pkg_test_default_var.gv_num,
    p_date DATE     DEFAULT pkg_test_default_var.gv_date) return varchar2;
END pkg_test_default_var;
/
CREATE OR REPLACE PACKAGE BODY pkg_test_default_var AS
	function test_f( p_str  VARCHAR2 DEFAULT pkg_test_default_var.gv_str,
    p_num  NUMBER   DEFAULT pkg_test_default_var.gv_num,
    p_date DATE     DEFAULT pkg_test_default_var.gv_date) return varchar2 IS
	BEGIN
		RETURN 'str='||p_str||', num='||p_num||', date='||TO_CHAR(p_date,'YYYY-MM-DD');
	end;
END pkg_test_default_var;
/
CREATE OR REPLACE FUNCTION fn_test(
    p_str  VARCHAR2 DEFAULT pkg_test_default_var.gv_str,
    p_num  NUMBER   DEFAULT pkg_test_default_var.gv_num,
    p_date DATE     DEFAULT pkg_test_default_var.gv_date
) RETURN VARCHAR2 AS
BEGIN
    RETURN 'str='||p_str||', num='||p_num||', date='||TO_CHAR(p_date,'YYYY-MM-DD');
END fn_test;
/
CREATE OR REPLACE PROCEDURE proc_test(
    p_str  VARCHAR2 DEFAULT pkg_test_default_var.gv_str,
    p_num  NUMBER   DEFAULT pkg_test_default_var.gv_num,
    p_date DATE     DEFAULT pkg_test_default_var.gv_date
) AS
BEGIN
    DBMS_OUTPUT.PUT_LINE('str='||p_str||', num='||p_num||', date='||TO_CHAR(p_date,'YYYY-MM-DD'));
END proc_test;
/
CREATE OR REPLACE PROCEDURE proc_mixed_default(
    p_str  VARCHAR2 DEFAULT pkg_test_default_var.gv_str,
    p_num  NUMBER   DEFAULT 123,
    p_date DATE     DEFAULT to_date('2026-4-15', 'YYYY-MM-DD')
) AS
BEGIN
    DBMS_OUTPUT.PUT_LINE('complex => str='||p_str||', num='||p_num||', date='||TO_CHAR(p_date,'YYYY-MM-DD'));
END proc_mixed_default;
/
CREATE OR REPLACE PROCEDURE proc_null_default(
    p_str VARCHAR2 DEFAULT pkg_test_default_var.gv_null
) AS
BEGIN
    IF p_str IS NULL THEN
        DBMS_OUTPUT.PUT_LINE('parameter is null');
    ELSE
        DBMS_OUTPUT.PUT_LINE('parameter：'||p_str);
    END IF;
END proc_null_default;
/
CREATE OR REPLACE PROCEDURE proc_nested_call AS
BEGIN
    DBMS_OUTPUT.PUT_LINE('=== nested ===');
    proc_test();
END proc_nested_call;
/
--ok
DECLARE
	v VARCHAR2(200);
BEGIN
    v := fn_test();
    DBMS_OUTPUT.PUT_LINE('all parameter default '||v);
END;
/
all parameter default str=a value, num=888, date=2026-04-15
--one parameter
DECLARE
	v VARCHAR2(200);
BEGIN
    v := fn_test('I am parameter');
    DBMS_OUTPUT.PUT_LINE('one parameter '||v);
END;
/
one parameter str=I am parameter, num=888, date=2026-04-15
DECLARE
   v VARCHAR2(200);
BEGIN
    v := fn_test(p_num=>999);
    DBMS_OUTPUT.PUT_LINE('parameter 2 '||v);
END;
/
parameter 2 str=a value, num=999, date=2026-04-15
--
DECLARE
	v VARCHAR2(200);
BEGIN
    v := fn_test(p_date=>TO_DATE('2025-10-01','YYYY-MM-DD'));
    DBMS_OUTPUT.PUT_LINE('parameter 3 '||v);
END;
/
parameter 3 str=a value, num=888, date=2025-10-01
BEGIN
    DBMS_OUTPUT.PUT('all parameter default');
    proc_test();
END;
/
all parameter defaultstr=a value, num=888, date=2026-04-15
BEGIN
    DBMS_OUTPUT.PUT('p_num');
    proc_test(p_num=>555);
END;
/
p_numstr=a value, num=555, date=2026-04-15
--ok
BEGIN
    proc_mixed_default();
END;
/
complex => str=a value, num=123, date=2026-04-15
--ok
BEGIN
    proc_null_default();
END;
/
parameter is null
--nested
BEGIN
    proc_nested_call();
END;
/
=== nested ===
str=a value, num=888, date=2026-04-15
BEGIN
    DBMS_OUTPUT.PUT_LINE('===change parameter ===');
    pkg_test_default_var.gv_str := 'I am changed';
    pkg_test_default_var.gv_num := 1000;
END;
/
===change parameter ===
--call
BEGIN
    DBMS_OUTPUT.PUT('change:');
    proc_test();
END;
/
change:str=I am changed, num=1000, date=2026-04-15
