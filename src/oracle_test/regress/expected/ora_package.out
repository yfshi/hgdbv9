declare
  c1 cursor is select * from test_cursor;
  var1 test_cursor%rowtype;
begin
  open c1;
  declare
     c1 cursor is select * from test_cursor;
   begin
     open c1;
     fetch c1 into var1;
     raise info 'inter-%', var1;
     close c1;
   end;
   fetch c1 into var1;
   raise info 'outer-%', var1;
   close c1;
end;
/
