create or replace package body test_pkg is
  procedure test_p(id integer) IS
    var2 integer;
  begin
    var1 := var1 + 2;
    if id % 3 = 1 then
       var2 := 2;
    elseif id % 1000 = 2 then
       var2 := var1 + 2;
    else
       var2 := var1;
    end if;
  end;
  procedure test_p1(id integer)  is
    var1 integer;
  begin
    call test_p(id);
  end;
begin
  var1 := 1;
end;
/
