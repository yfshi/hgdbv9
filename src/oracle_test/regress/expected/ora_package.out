    BEGIN
		name := 'welcome';
        RETURN 1;
    END;
  function rect_test1(id integer) return integer is
    var2 varchar2(23);
	var1 integer;
  begin
       --raise info '%', name;
	   insert into test1 values(rec_test(23), name);
	   name := '';
	   var1 := rec_test(23);
	   insert into test1 values(var1, name);
	   return 23;
	end;
begin
  var1 := rect_test1(23);
end;
