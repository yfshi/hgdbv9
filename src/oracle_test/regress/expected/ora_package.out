create or replace package test_mds_pkg is
  var1 test_mds%rowtype;
  cursor c1 is select * from test_mds;
  r record;
  var2 c1%rowtype;
  function test_f(id test_mds%rowtype default var1) return test_mds%rowtype;
  function test_ff(id varchar2 default var1.name) return varchar2;
  function test_cursor(id c1%rowtype default var2) return c1%rowtype;
  function test_record(id record default r) return record;
end;
/
create or replace package body test_mds_pkg is
  function test_f(id test_mds%rowtype default var1) return test_mds%rowtype is
  begin
    return id;
  end;
  function test_ff(id varchar2 default var1.name) return varchar2 is
  begin
	return id;
  end;
  function test_cursor(id c1%rowtype default var2) return c1%rowtype is
  begin
	return id;
  end;
  function test_record(id record default r) return record is
  begin
	return id;
  end;
begin
	var1.id := 23;
	var1.name := 'welcome';
	select * into r from test_mds where id = 1;
	select * into var2 from test_mds where id = 2;
end;
/
create or replace function testff(id test_mds%rowtype default test_mds_pkg.var1) return test_mds%rowtype is
begin
  return id;
end;
/
create or replace function testff1(id varchar2 default test_mds_pkg.var1.name) return varchar2 is
begin
  return id;
end;
/
create or replace function test_record(id record default test_mds_pkg.r) return record is
begin
	return id;
end;
/
