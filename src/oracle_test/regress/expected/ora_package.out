create or replace package body test_pkg is
  function test_f(id integer) return integer is
  begin
    var1 := var1 + 2;
    if id % 3 = 1 then
       return 2;
    elseif id % 1000 = 2 then
       return var1 + 2;
    else
       return var1;
    end if;
  end;
  function test_f1(id integer) return integer is
    var1 integer;
  begin
    var1 := test_f(id);
    return var1;
  end;
begin
  var1 := 1;
end;
/
