--plpgsql can not reference package global var
--error
CREATE OR REPLACE FUNCTION test_plpgsql(id integer default test_pkg.var1)
RETURNS integer AS $$
BEGIN
    RETURN id;
END $$ LANGUAGE plpgsql;
/
ERROR:  only plisql language function or procedure can use package var in parameter default value
create user enrol11;
create schema enrol11;
alter schema enrol11 owner to enrol11;
\c - enrol11
create or replace package test_pkg IS
  var1 varchar2(256);
  function test_f(id integer default test_pkg.var1) return integer;
  procedure test_p(id integer default test_pkg.var1);
end;
/
create or replace package body test_pkg IS
  function test_f(id integer default test_pkg.var1) return integer IS
  BEGIN
    return id;
  end;
  procedure test_p(id integer default test_pkg.var1) is
  begin
    dbms_output.put_line('id = ' || id);
  end;
BEGIN
  var1 := '24';
end;
/
grant usage on schema enrol11 to system;
grant execute on package test_pkg to system;
--call  24
set serveroutput on;
select test_pkg.test_f() from dual;
 test_f 
--------
     24
(1 row)

call test_pkg.test_p();
id = 24
\c - system
--24
set serveroutput on;
select enrol11.test_pkg.test_f() from dual;
 test_f 
--------
     24
(1 row)

call enrol11.test_pkg.test_p();
id = 24
\c - enrol11;
--clean
drop package test_pkg;
drop schema enrol11;
\c - system
drop package test_pkg;
drop user enrol11;
declare
    name text;
begin
        select into name 10::regrole;
		execute format('set session authorization %s;',name);
end;
/
