var1  integer;
function set(id varchar) return integer;
end;
/
--test ok
create or replace package body pkg is
var2 varchar2(256);
function set(id varchar) return integer is
begin
   raise info 'var2=%',var2;
   var2 := id;
   return 0;
end;
begin
  raise info 'init block';
end;
/
