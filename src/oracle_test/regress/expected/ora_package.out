 dbms_metadata | PACKAGE BODY | 5    |   AS
 dbms_metadata | PACKAGE BODY | 6    |   DECLARE
 dbms_metadata | PACKAGE BODY | 7    |     resname    VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 8    |         uppername        VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 9    |         lowername    VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 10   |   BEGIN
 dbms_metadata | PACKAGE BODY | 11   |     resname := ori_name;
 dbms_metadata | PACKAGE BODY | 12   |         uppername = UPPER(ori_name);
 dbms_metadata | PACKAGE BODY | 13   |         lowername = LOWER(ori_name);
 dbms_metadata | PACKAGE BODY | 14   |         IF ori_name = uppername THEN
 dbms_metadata | PACKAGE BODY | 15   |            resname =  lowername;
 dbms_metadata | PACKAGE BODY | 16   |         ELSE
 dbms_metadata | PACKAGE BODY | 17   |           IF ori_name = lowername THEN
 dbms_metadata | PACKAGE BODY | 18   |              resname =  uppername;
 dbms_metadata | PACKAGE BODY | 19   |           END IF;
 dbms_metadata | PACKAGE BODY | 20   |         END IF;
 dbms_metadata | PACKAGE BODY | 21   |         return resname;
 dbms_metadata | PACKAGE BODY | 22   |   END;
 dbms_metadata | PACKAGE BODY | 23   | 
 dbms_metadata | PACKAGE BODY | 24   |   --function CHECK_PRIVILEGE
 dbms_metadata | PACKAGE BODY | 25   |   FUNCTION CHECK_PRIVILEGE(owneroid IN OID) RETURN BOOLEAN
 dbms_metadata | PACKAGE BODY | 26   |   AS
 dbms_metadata | PACKAGE BODY | 27   |   DECLARE
 dbms_metadata | PACKAGE BODY | 28   |     res BOOLEAN := FALSE;
 dbms_metadata | PACKAGE BODY | 29   |   BEGIN
 dbms_metadata | PACKAGE BODY | 30   |     IF(owneroid = 0) THEN
 dbms_metadata | PACKAGE BODY | 31   |       RETURN FALSE;
 dbms_metadata | PACKAGE BODY | 32   |     END IF;
 dbms_metadata | PACKAGE BODY | 33   | 
 dbms_metadata | PACKAGE BODY | 34   |         SELECT TRUE INTO res
 dbms_metadata | PACKAGE BODY | 35   |           FROM pg_roles u, pg_database d
 dbms_metadata | PACKAGE BODY | 36   |           WHERE (u.oid = owneroid)
 dbms_metadata | PACKAGE BODY | 37   |           AND (u.rolname = current_user OR u.rolsuper IS TRUE)
 dbms_metadata | PACKAGE BODY | 38   |           AND (d.datname = current_database);
 dbms_metadata | PACKAGE BODY | 39   | 
 dbms_metadata | PACKAGE BODY | 40   |         RETURN res;
 dbms_metadata | PACKAGE BODY | 41   |   END;
 dbms_metadata | PACKAGE BODY | 42   | 
 dbms_metadata | PACKAGE BODY | 43   |   FUNCTION is_supper_user(username IN VARCHAR2(63)) RETURN BOOLEAN
 dbms_metadata | PACKAGE BODY | 44   |   AS
 dbms_metadata | PACKAGE BODY | 45   |   DECLARE
 dbms_metadata | PACKAGE BODY | 46   |     user_super BOOLEAN := FALSE;
 dbms_metadata | PACKAGE BODY | 47   |     CURSOR mycur1 FOR
 dbms_metadata | PACKAGE BODY | 48   |     SELECT u.rolsuper
 dbms_metadata | PACKAGE BODY | 49   |     FROM pg_roles u where u.rolname = username;
 dbms_metadata | PACKAGE BODY | 50   |   BEGIN
 dbms_metadata | PACKAGE BODY | 51   |     OPEN mycur1;
 dbms_metadata | PACKAGE BODY | 52   |     FETCH mycur1 INTO user_super;
 dbms_metadata | PACKAGE BODY | 53   |     IF mycur1%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 54   |       CLOSE mycur1;
 dbms_metadata | PACKAGE BODY | 55   |       RAISE EXCEPTION 'USER DOES NOT EXIST!';
 dbms_metadata | PACKAGE BODY | 56   |         END IF;
 dbms_metadata | PACKAGE BODY | 57   | 
 dbms_metadata | PACKAGE BODY | 58   |         CLOSE mycur1;
 dbms_metadata | PACKAGE BODY | 59   |         RETURN user_super;
 dbms_metadata | PACKAGE BODY | 60   |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 61   |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 62   |       IF mycur1%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 63   |         CLOSE mycur1;
 dbms_metadata | PACKAGE BODY | 64   |       END IF;
 dbms_metadata | PACKAGE BODY | 65   |       RAISE;
 dbms_metadata | PACKAGE BODY | 66   |   END;
 dbms_metadata | PACKAGE BODY | 67   | 
 dbms_metadata | PACKAGE BODY | 68   |   --function GET_VIEW_DDL
 dbms_metadata | PACKAGE BODY | 69   |   FUNCTION GET_VIEW_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 70   |   AS
 dbms_metadata | PACKAGE BODY | 71   |   DECLARE
 dbms_metadata | PACKAGE BODY | 72   |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 73   |     SELECT cl.oid, cl.relowner, cl.relkind
 dbms_metadata | PACKAGE BODY | 74   |     FROM pg_class cl, pg_namespace nsp
 dbms_metadata | PACKAGE BODY | 75   |     WHERE (cl.relkind = 'v' OR cl.relkind = 'm')
 dbms_metadata | PACKAGE BODY | 76   |     AND cl.relname = OBJNAME
 dbms_metadata | PACKAGE BODY | 77   |     AND nsp.nspname = SCHEMA
 dbms_metadata | PACKAGE BODY | 78   |     AND cl.relnamespace = nsp.oid;
 dbms_metadata | PACKAGE BODY | 79   | 
 dbms_metadata | PACKAGE BODY | 80   |     CURSOR mycur2 FOR
 dbms_metadata | PACKAGE BODY | 81   |     SELECT f.source
 dbms_metadata | PACKAGE BODY | 82   |         FROM pg_class cl, pg_force_view f
 dbms_metadata | PACKAGE BODY | 83   |         WHERE cl.oid = f.fvoid;
 dbms_metadata | PACKAGE BODY | 84   | 
 dbms_metadata | PACKAGE BODY | 85   |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 86   |     viewddl      TEXT;
 dbms_metadata | PACKAGE BODY | 87   |     tmpddl       TEXT;
 dbms_metadata | PACKAGE BODY | 88   |         relkind      TEXT;
 dbms_metadata | PACKAGE BODY | 89   | 
 dbms_metadata | PACKAGE BODY | 90   |     obj_owneroid OID;
 dbms_metadata | PACKAGE BODY | 91   |         source       TEXT;
 dbms_metadata | PACKAGE BODY | 92   |   BEGIN
 dbms_metadata | PACKAGE BODY | 93   |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 94   |     FETCH mycur INTO objtoid, obj_owneroid, relkind;
 dbms_metadata | PACKAGE BODY | 95   |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 96   |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 97   |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 98   |     ELSE
 dbms_metadata | PACKAGE BODY | 99   |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 100  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 101  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 102  |       END IF;
 dbms_metadata | PACKAGE BODY | 103  |     END IF;
 dbms_metadata | PACKAGE BODY | 104  | 
 dbms_metadata | PACKAGE BODY | 105  |     IF SCHEMA LIKE 'PG_TEMP_%' THEN
 dbms_metadata | PACKAGE BODY | 106  |       viewddl := 'CREATE OR REPLACE TEMPORARY VIEW '||'"'||GET_OBJNAME(OBJNAME)||'"'||' AS ';
 dbms_metadata | PACKAGE BODY | 107  |     ELSEIF relkind = 'v' THEN
 dbms_metadata | PACKAGE BODY | 108  |           OPEN mycur2;
 dbms_metadata | PACKAGE BODY | 109  |           FETCH mycur2 INTO source;
 dbms_metadata | PACKAGE BODY | 110  |           IF mycur2%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 111  |         viewddl := 'CREATE OR REPLACE VIEW '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(OBJNAME)||'"'||' AS ';
 dbms_metadata | PACKAGE BODY | 112  |           END IF;
 dbms_metadata | PACKAGE BODY | 113  |           CLOSE mycur2;
 dbms_metadata | PACKAGE BODY | 114  |     ELSEIF relkind = 'm' THEN
 dbms_metadata | PACKAGE BODY | 115  |       viewddl := 'CREATE MATERIALIZED VIEW '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(OBJNAME)||'"'||' AS ';
 dbms_metadata | PACKAGE BODY | 116  |     END IF;
 dbms_metadata | PACKAGE BODY | 117  | 
 dbms_metadata | PACKAGE BODY | 118  |     --get view context
 dbms_metadata | PACKAGE BODY | 119  |     SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 120  |     SELECT pg_get_viewdef(objtoid, true) INTO tmpddl FROM dual;
 dbms_metadata | PACKAGE BODY | 121  |         RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 122  |     viewddl := viewddl || tmpddl;
 dbms_metadata | PACKAGE BODY | 123  | 
 dbms_metadata | PACKAGE BODY | 124  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 125  |     RETURN viewddl;
 dbms_metadata | PACKAGE BODY | 126  |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 127  |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 128  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 129  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 130  |       END IF;
 dbms_metadata | PACKAGE BODY | 131  |       IF mycur2%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 132  |             CLOSE mycur2;
 dbms_metadata | PACKAGE BODY | 133  |       END IF;
 dbms_metadata | PACKAGE BODY | 134  |       RAISE;
 dbms_metadata | PACKAGE BODY | 135  |   END;
 dbms_metadata | PACKAGE BODY | 136  | 
 dbms_metadata | PACKAGE BODY | 137  |  --function GET_FUNC_DDL
 dbms_metadata | PACKAGE BODY | 138  |   FUNCTION GET_FUNC_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 139  |   AS
 dbms_metadata | PACKAGE BODY | 140  |   DECLARE
 dbms_metadata | PACKAGE BODY | 141  |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 142  |     SELECT proc.oid, proc.proowner
 dbms_metadata | PACKAGE BODY | 143  |     FROM pg_proc proc, pg_namespace nsp
 dbms_metadata | PACKAGE BODY | 144  |     WHERE nsp.oid = proc.pronamespace
 dbms_metadata | PACKAGE BODY | 145  |     AND nsp.nspname = SCHEMA
 dbms_metadata | PACKAGE BODY | 146  |     AND proc.proname = OBJNAME
 dbms_metadata | PACKAGE BODY | 147  |         AND proc.prokind = 'f';
 dbms_metadata | PACKAGE BODY | 148  | 
 dbms_metadata | PACKAGE BODY | 149  |     objtoid         OID;
 dbms_metadata | PACKAGE BODY | 150  |     parameter       TEXT;
 dbms_metadata | PACKAGE BODY | 151  |     paratype        OID;
 dbms_metadata | PACKAGE BODY | 152  |     paratypename    TEXT;
 dbms_metadata | PACKAGE BODY | 153  |     rettype         OID;
 dbms_metadata | PACKAGE BODY | 154  |     rettypename     TEXT;
 dbms_metadata | PACKAGE BODY | 155  |     probody         TEXT;
 dbms_metadata | PACKAGE BODY | 156  |     paranum         INTEGER;
 dbms_metadata | PACKAGE BODY | 157  |     i               INTEGER;
 dbms_metadata | PACKAGE BODY | 158  |     parameterall    TEXT;
 dbms_metadata | PACKAGE BODY | 159  |     funcddl         TEXT;
 dbms_metadata | PACKAGE BODY | 160  |     pargmode        CHAR;
 dbms_metadata | PACKAGE BODY | 161  |     pargmodetext    TEXT;
 dbms_metadata | PACKAGE BODY | 162  |     obj_owneroid     OID;
 dbms_metadata | PACKAGE BODY | 163  |   BEGIN
 dbms_metadata | PACKAGE BODY | 164  |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 165  |     FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 166  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 167  |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 168  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 169  |     END IF;
 dbms_metadata | PACKAGE BODY | 170  | 
 dbms_metadata | PACKAGE BODY | 171  |     funcddl := '';
 dbms_metadata | PACKAGE BODY | 172  | 
 dbms_metadata | PACKAGE BODY | 173  |     WHILE (mycur%FOUND) LOOP
 dbms_metadata | PACKAGE BODY | 174  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 175  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 176  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 177  |       END IF;
 dbms_metadata | PACKAGE BODY | 178  | 
 dbms_metadata | PACKAGE BODY | 179  |       parameterall := '(';
 dbms_metadata | PACKAGE BODY | 180  |       SELECT proc.pronargs INTO paranum FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 181  |       FOR i IN 1 .. paranum LOOP
 dbms_metadata | PACKAGE BODY | 182  |       -- get parameter name
 dbms_metadata | PACKAGE BODY | 183  |         SELECT proc.proargnames[i], proc.proargtypes[i - 1], proc.proargmodes[i]
 dbms_metadata | PACKAGE BODY | 184  |         INTO parameter, paratype, pargmode
 dbms_metadata | PACKAGE BODY | 185  |         FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 186  |         -- get parameter type name
 dbms_metadata | PACKAGE BODY | 187  |         SELECT typname INTO paratypename FROM pg_type WHERE oid = paratype;
 dbms_metadata | PACKAGE BODY | 188  | 
 dbms_metadata | PACKAGE BODY | 189  |         CASE
 dbms_metadata | PACKAGE BODY | 190  |                 WHEN pargmode = 'o' THEN
 dbms_metadata | PACKAGE BODY | 191  |           pargmodetext := ' OUT ';
 dbms_metadata | PACKAGE BODY | 192  |         WHEN pargmode = 'b' THEN
 dbms_metadata | PACKAGE BODY | 193  |           pargmodetext := ' INOUT ';
 dbms_metadata | PACKAGE BODY | 194  |         WHEN pargmode = 'i' THEN
 dbms_metadata | PACKAGE BODY | 195  |           pargmodetext := ' IN ';
 dbms_metadata | PACKAGE BODY | 196  |         ELSE
 dbms_metadata | PACKAGE BODY | 197  |           pargmodetext := ' ';
 dbms_metadata | PACKAGE BODY | 198  |         END CASE;
 dbms_metadata | PACKAGE BODY | 199  | 
 dbms_metadata | PACKAGE BODY | 200  |         IF i < paranum THEN
 dbms_metadata | PACKAGE BODY | 201  |           parameterall := parameterall||pargmodetext||parameter||' '||paratypename||',';
 dbms_metadata | PACKAGE BODY | 202  |         ELSE
 dbms_metadata | PACKAGE BODY | 203  |           parameterall := parameterall||pargmodetext||parameter||' '||paratypename;
 dbms_metadata | PACKAGE BODY | 204  |         END IF;
 dbms_metadata | PACKAGE BODY | 205  |       END LOOP;
 dbms_metadata | PACKAGE BODY | 206  |       parameterall := parameterall||')';
 dbms_metadata | PACKAGE BODY | 207  | 
 dbms_metadata | PACKAGE BODY | 208  |       -- get return type name
 dbms_metadata | PACKAGE BODY | 209  |       SELECT proc.prorettype INTO rettype FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 210  |       SELECT typname INTO rettypename FROM pg_type WHERE oid=rettype;
 dbms_metadata | PACKAGE BODY | 211  |       -- get function body
 dbms_metadata | PACKAGE BODY | 212  |       SELECT proc.prosrc INTO probody FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 213  | 
 dbms_metadata | PACKAGE BODY | 214  |       funcddl := funcddl||'CREATE OR REPLACE FUNCTION '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(OBJNAME)|| '"' || parameterall||' RETURN '||rettypename||' AS' ||probody||chr(10);
 dbms_metadata | PACKAGE BODY | 215  |       FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 216  |     END LOOP;
 dbms_metadata | PACKAGE BODY | 217  | 
 dbms_metadata | PACKAGE BODY | 218  |   CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 219  |   RETURN funcddl;
 dbms_metadata | PACKAGE BODY | 220  |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 221  |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 222  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 223  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 224  |       END IF;
 dbms_metadata | PACKAGE BODY | 225  |       RAISE;
 dbms_metadata | PACKAGE BODY | 226  |   END;
 dbms_metadata | PACKAGE BODY | 227  | 
 dbms_metadata | PACKAGE BODY | 228  |    --function GET_PROCEDURE_DDL
 dbms_metadata | PACKAGE BODY | 229  |   FUNCTION GET_PROCEDURE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 230  |   AS
 dbms_metadata | PACKAGE BODY | 231  |   DECLARE
 dbms_metadata | PACKAGE BODY | 232  |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 233  |     SELECT proc.oid, proc.proowner
 dbms_metadata | PACKAGE BODY | 234  |     FROM pg_proc proc, pg_namespace nsp
 dbms_metadata | PACKAGE BODY | 235  |     WHERE proc.prokind='p'
 dbms_metadata | PACKAGE BODY | 236  |     AND nsp.oid = proc.pronamespace
 dbms_metadata | PACKAGE BODY | 237  |     AND nsp.nspname = SCHEMA
 dbms_metadata | PACKAGE BODY | 238  |     AND proc.proname = OBJNAME;
 dbms_metadata | PACKAGE BODY | 239  | 
 dbms_metadata | PACKAGE BODY | 240  |     objtoid       OID;
 dbms_metadata | PACKAGE BODY | 241  |     parameter     TEXT;
 dbms_metadata | PACKAGE BODY | 242  |     paratype      INT;
 dbms_metadata | PACKAGE BODY | 243  |     paratypename  TEXT;
 dbms_metadata | PACKAGE BODY | 244  |     rettype       INT;
 dbms_metadata | PACKAGE BODY | 245  |     rettypename   TEXT;
 dbms_metadata | PACKAGE BODY | 246  |     probody       TEXT;
 dbms_metadata | PACKAGE BODY | 247  |     paranum       INTEGER;
 dbms_metadata | PACKAGE BODY | 248  |     i             INTEGER;
 dbms_metadata | PACKAGE BODY | 249  |     parameterall  TEXT;
 dbms_metadata | PACKAGE BODY | 250  |     procdureddl   TEXT;
 dbms_metadata | PACKAGE BODY | 251  |     pargmode      CHAR;
 dbms_metadata | PACKAGE BODY | 252  |     pargmodetext  TEXT;
 dbms_metadata | PACKAGE BODY | 253  |     obj_owneroid   OID;
 dbms_metadata | PACKAGE BODY | 254  |   BEGIN
 dbms_metadata | PACKAGE BODY | 255  |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 256  |     FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 257  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 258  |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 259  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 260  |     END IF;
 dbms_metadata | PACKAGE BODY | 261  | 
 dbms_metadata | PACKAGE BODY | 262  |     procdureddl := '';
 dbms_metadata | PACKAGE BODY | 263  | 
 dbms_metadata | PACKAGE BODY | 264  |     WHILE (mycur%FOUND) LOOP
 dbms_metadata | PACKAGE BODY | 265  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 266  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 267  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 268  |       END IF;
 dbms_metadata | PACKAGE BODY | 269  | 
 dbms_metadata | PACKAGE BODY | 270  |       parameterall := '(';
 dbms_metadata | PACKAGE BODY | 271  |       SELECT proc.pronargs INTO paranum FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 272  |       FOR i IN 1 .. paranum LOOP
 dbms_metadata | PACKAGE BODY | 273  |         -- get parameter name
 dbms_metadata | PACKAGE BODY | 274  |         SELECT proc.proargnames[i], proc.proargtypes[i - 1], proc.proargmodes[i]
 dbms_metadata | PACKAGE BODY | 275  |         INTO parameter, paratype, pargmode
 dbms_metadata | PACKAGE BODY | 276  |         FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 277  | 
 dbms_metadata | PACKAGE BODY | 278  |         CASE
 dbms_metadata | PACKAGE BODY | 279  |         WHEN pargmode = 'o' THEN
 dbms_metadata | PACKAGE BODY | 280  |           pargmodetext := ' OUT ';
 dbms_metadata | PACKAGE BODY | 281  |         WHEN pargmode = 'b' THEN
 dbms_metadata | PACKAGE BODY | 282  |           pargmodetext := ' INOUT ';
 dbms_metadata | PACKAGE BODY | 283  |         WHEN pargmode = 'i' THEN
 dbms_metadata | PACKAGE BODY | 284  |           pargmodetext := ' IN ';
 dbms_metadata | PACKAGE BODY | 285  |         ELSE
 dbms_metadata | PACKAGE BODY | 286  |           pargmodetext := ' ';
 dbms_metadata | PACKAGE BODY | 287  |         END CASE;
 dbms_metadata | PACKAGE BODY | 288  | 
 dbms_metadata | PACKAGE BODY | 289  |         -- get parameter type name
 dbms_metadata | PACKAGE BODY | 290  |         SELECT typname INTO paratypename FROM pg_type WHERE oid=paratype;
 dbms_metadata | PACKAGE BODY | 291  | 
 dbms_metadata | PACKAGE BODY | 292  |         IF i < paranum THEN
 dbms_metadata | PACKAGE BODY | 293  |           parameterall := parameterall||pargmodetext||parameter||' '||paratypename||',';
 dbms_metadata | PACKAGE BODY | 294  |         ELSE
 dbms_metadata | PACKAGE BODY | 295  |           parameterall := parameterall||pargmodetext||parameter||' '||paratypename;
 dbms_metadata | PACKAGE BODY | 296  |         END IF;
 dbms_metadata | PACKAGE BODY | 297  |       END LOOP;
 dbms_metadata | PACKAGE BODY | 298  |       parameterall := parameterall||')';
 dbms_metadata | PACKAGE BODY | 299  | 
 dbms_metadata | PACKAGE BODY | 300  |       -- get procdure body
 dbms_metadata | PACKAGE BODY | 301  |       SELECT proc.prosrc INTO probody FROM pg_proc proc WHERE proc.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 302  | 
 dbms_metadata | PACKAGE BODY | 303  |       procdureddl := procdureddl||'CREATE OR REPLACE PROCEDURE '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(OBJNAME)||'"' ||parameterall||' AS' ||probody||';'||chr(10);
 dbms_metadata | PACKAGE BODY | 304  |       FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 305  |     END LOOP;
 dbms_metadata | PACKAGE BODY | 306  | 
 dbms_metadata | PACKAGE BODY | 307  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 308  |     RETURN procdureddl;
 dbms_metadata | PACKAGE BODY | 309  |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 310  |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 311  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 312  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 313  |       END IF;
 dbms_metadata | PACKAGE BODY | 314  |       RAISE;
 dbms_metadata | PACKAGE BODY | 315  |   END;
 dbms_metadata | PACKAGE BODY | 316  | 
 dbms_metadata | PACKAGE BODY | 317  |   --function GET_TRIGGER_DDL
 dbms_metadata | PACKAGE BODY | 318  |   FUNCTION GET_TRIGGER_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 319  |   AS
 dbms_metadata | PACKAGE BODY | 320  |   DECLARE
 dbms_metadata | PACKAGE BODY | 321  |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 322  |     schemaoid    OID;
 dbms_metadata | PACKAGE BODY | 323  |     stmt         TEXT;
 dbms_metadata | PACKAGE BODY | 324  |     tmpddl       TEXT;
 dbms_metadata | PACKAGE BODY | 325  |     triggerddl   TEXT;
 dbms_metadata | PACKAGE BODY | 326  |     mycur        SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 327  | 
 dbms_metadata | PACKAGE BODY | 328  |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 329  |     obj_valid     INT := 0;
 dbms_metadata | PACKAGE BODY | 330  |     obj_invalid   INT := 0;
 dbms_metadata | PACKAGE BODY | 331  |         funname       TEXT = NULL;
 dbms_metadata | PACKAGE BODY | 332  |   BEGIN
 dbms_metadata | PACKAGE BODY | 333  |     stmt := 'SELECT tg.oid 
 dbms_metadata | PACKAGE BODY | 334  |     FROM pg_trigger tg, pg_namespace nsp
 dbms_metadata | PACKAGE BODY | 335  |     WHERE tg.tgname = '||''''||OBJNAME||''''||' AND nsp.nspname = '||''''||SCHEMA||'''';
 dbms_metadata | PACKAGE BODY | 336  |     IF TABOID > 0 THEN
 dbms_metadata | PACKAGE BODY | 337  |       stmt := stmt||' AND tg.tgrelid = '||TABOID;
 dbms_metadata | PACKAGE BODY | 338  |     END IF;
 dbms_metadata | PACKAGE BODY | 339  |     stmt := stmt||';';
 dbms_metadata | PACKAGE BODY | 340  | 
 dbms_metadata | PACKAGE BODY | 341  |     OPEN mycur FOR EXECUTE stmt;
 dbms_metadata | PACKAGE BODY | 342  |     FETCH mycur INTO objtoid;
 dbms_metadata | PACKAGE BODY | 343  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 344  |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 345  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 346  |     END IF;
 dbms_metadata | PACKAGE BODY | 347  | 
 dbms_metadata | PACKAGE BODY | 348  |         triggerddl := '';
 dbms_metadata | PACKAGE BODY | 349  |         WHILE mycur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 350  |                   SELECT relowner INTO obj_owneroid FROM pg_class WHERE pg_class.oid = (SELECT tgrelid FROM pg_trigger WHERE pg_trigger.oid = objtoid);
 dbms_metadata | PACKAGE BODY | 351  |                   IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 352  |                         obj_invalid := obj_invalid + 1;
 dbms_metadata | PACKAGE BODY | 353  |                   ELSE
 dbms_metadata | PACKAGE BODY | 354  |                         obj_valid := obj_valid + 1;
 dbms_metadata | PACKAGE BODY | 355  |                         SELECT pg_get_triggerdef(objtoid, false) INTO tmpddl;
 dbms_metadata | PACKAGE BODY | 356  |                         triggerddl := triggerddl||tmpddl||chr(10);
 dbms_metadata | PACKAGE BODY | 357  |                   END IF;
 dbms_metadata | PACKAGE BODY | 358  |                   FETCH mycur INTO objtoid;
 dbms_metadata | PACKAGE BODY | 359  |         END LOOP;
 dbms_metadata | PACKAGE BODY | 360  |         CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 361  | 
 dbms_metadata | PACKAGE BODY | 362  |         IF(obj_valid > 0) THEN
 dbms_metadata | PACKAGE BODY | 363  |                 RETURN triggerddl;
 dbms_metadata | PACKAGE BODY | 364  |         ELSE
 dbms_metadata | PACKAGE BODY | 365  |            IF(obj_invalid > 0) THEN
 dbms_metadata | PACKAGE BODY | 366  |                 RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 367  |            END IF;
 dbms_metadata | PACKAGE BODY | 368  |         END IF;
 dbms_metadata | PACKAGE BODY | 369  |         RETURN triggerddl;
 dbms_metadata | PACKAGE BODY | 370  |    EXCEPTION
 dbms_metadata | PACKAGE BODY | 371  |      WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 372  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 373  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 374  |       END IF;
 dbms_metadata | PACKAGE BODY | 375  |       RAISE;
 dbms_metadata | PACKAGE BODY | 376  |   END;
 dbms_metadata | PACKAGE BODY | 377  | 
 dbms_metadata | PACKAGE BODY | 378  |   --function GET_TABLESPACE_DDL 
 dbms_metadata | PACKAGE BODY | 379  |   FUNCTION GET_TABLESPACE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 380  |   AS
 dbms_metadata | PACKAGE BODY | 381  |   DECLARE
 dbms_metadata | PACKAGE BODY | 382  |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 383  |     SELECT t.oid, t.spcowner
 dbms_metadata | PACKAGE BODY | 384  |     FROM pg_tablespace t
 dbms_metadata | PACKAGE BODY | 385  |     WHERE t.spcname = OBJNAME;
 dbms_metadata | PACKAGE BODY | 386  | 
 dbms_metadata | PACKAGE BODY | 387  |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 388  |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 389  |     result       RECORD;
 dbms_metadata | PACKAGE BODY | 390  | 
 dbms_metadata | PACKAGE BODY | 391  |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 392  |         loc_name          TEXT;
 dbms_metadata | PACKAGE BODY | 393  |   BEGIN
 dbms_metadata | PACKAGE BODY | 394  |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 395  |     FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 396  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 397  |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 398  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 399  |     ELSE
 dbms_metadata | PACKAGE BODY | 400  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 401  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 402  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 403  |       END IF;
 dbms_metadata | PACKAGE BODY | 404  |     END IF; 
 dbms_metadata | PACKAGE BODY | 405  | 
 dbms_metadata | PACKAGE BODY | 406  |     --get tablespace context
 dbms_metadata | PACKAGE BODY | 407  |     SELECT * INTO result FROM pg_tablespace t WHERE t.spcname = OBJNAME;
 dbms_metadata | PACKAGE BODY | 408  |         SELECT pg_tablespace_location INTO loc_name FROM pg_tablespace_location(objtoid);
 dbms_metadata | PACKAGE BODY | 409  |     retddl := 'CREATE TABLESPACE ' ||'"'|| result.spcname || '"';
 dbms_metadata | PACKAGE BODY | 410  | 
 dbms_metadata | PACKAGE BODY | 411  |         IF (loc_name IS NOT NULL) THEN
 dbms_metadata | PACKAGE BODY | 412  |                 retddl := retddl||' LOCATION '|| '''' || loc_name || '''';
 dbms_metadata | PACKAGE BODY | 413  |         END IF;
 dbms_metadata | PACKAGE BODY | 414  |     retddl := retddl||';';
 dbms_metadata | PACKAGE BODY | 415  | 
 dbms_metadata | PACKAGE BODY | 416  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 417  |     RETURN retddl;
 dbms_metadata | PACKAGE BODY | 418  |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 419  |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 420  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 421  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 422  |       END IF;
 dbms_metadata | PACKAGE BODY | 423  |       RAISE;
 dbms_metadata | PACKAGE BODY | 424  |   END;
 dbms_metadata | PACKAGE BODY | 425  | 
 dbms_metadata | PACKAGE BODY | 426  |   FUNCTION GET_INDEX_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 427  |   AS
 dbms_metadata | PACKAGE BODY | 428  |   DECLARE
 dbms_metadata | PACKAGE BODY | 429  |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 430  |     tbsoid       OID;
 dbms_metadata | PACKAGE BODY | 431  |     isprimary    BOOLEAN;
 dbms_metadata | PACKAGE BODY | 432  |     isunique     BOOLEAN;
 dbms_metadata | PACKAGE BODY | 433  |     isclustered  BOOLEAN;
 dbms_metadata | PACKAGE BODY | 434  |     isvalid      BOOLEAN;
 dbms_metadata | PACKAGE BODY | 435  |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 436  |     tmpddl       TEXT;
 dbms_metadata | PACKAGE BODY | 437  |     tabspace     TEXT;
 dbms_metadata | PACKAGE BODY | 438  |     stmt         TEXT;
 dbms_metadata | PACKAGE BODY | 439  |     mycur        SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 440  | 
 dbms_metadata | PACKAGE BODY | 441  |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 442  |     obj_valid     INT := 0;
 dbms_metadata | PACKAGE BODY | 443  |     obj_invalid   INT := 0;
 dbms_metadata | PACKAGE BODY | 444  |   BEGIN
 dbms_metadata | PACKAGE BODY | 445  |     stmt := 'SELECT c.oid, c.reltablespace, i.indisprimary, i.indisunique, i.indisclustered, i.indisvalid, c.relowner
 dbms_metadata | PACKAGE BODY | 446  |     FROM pg_catalog.pg_class c, pg_catalog.pg_namespace n, pg_catalog.pg_index i
 dbms_metadata | PACKAGE BODY | 447  |     WHERE c.relkind=''i'' AND i.indexrelid = c.oid AND n.oid = c.relnamespace AND c.relname= '||''''||OBJNAME||''''||' AND n.nspname = '||''''||SCHEMA||'''';
 dbms_metadata | PACKAGE BODY | 448  |     IF TABOID > 0 THEN
 dbms_metadata | PACKAGE BODY | 449  |       stmt := stmt||' AND i.indrelid = '||TABOID;
 dbms_metadata | PACKAGE BODY | 450  |     END IF;
 dbms_metadata | PACKAGE BODY | 451  |     stmt := stmt || ' ORDER BY i.indisprimary DESC, i.indisunique DESC, c.relname;';
 dbms_metadata | PACKAGE BODY | 452  |     OPEN mycur FOR EXECUTE stmt;
 dbms_metadata | PACKAGE BODY | 453  | 
 dbms_metadata | PACKAGE BODY | 454  |     FETCH mycur INTO objtoid, tbsoid, isprimary, isunique, isclustered, isvalid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 455  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 456  |       CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 457  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 458  |     END IF;
 dbms_metadata | PACKAGE BODY | 459  |  
 dbms_metadata | PACKAGE BODY | 460  |     retddl := '';
 dbms_metadata | PACKAGE BODY | 461  |     WHILE mycur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 462  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 463  |         obj_invalid := obj_invalid + 1;
 dbms_metadata | PACKAGE BODY | 464  |       ELSE
 dbms_metadata | PACKAGE BODY | 465  |         obj_valid := obj_valid + 1;
 dbms_metadata | PACKAGE BODY | 466  |                   SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 467  |                   SELECT pg_get_indexdef(objtoid) INTO tmpddl;
 dbms_metadata | PACKAGE BODY | 468  |                   RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 469  |         retddl := retddl || tmpddl ||';'||chr(10);
 dbms_metadata | PACKAGE BODY | 470  |       END IF;
 dbms_metadata | PACKAGE BODY | 471  |       FETCH mycur INTO objtoid, tbsoid, isprimary, isunique, isclustered, isvalid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 472  |     END LOOP;
 dbms_metadata | PACKAGE BODY | 473  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 474  | 
 dbms_metadata | PACKAGE BODY | 475  |     IF(obj_valid > 0) THEN
 dbms_metadata | PACKAGE BODY | 476  |       RETURN retddl;
 dbms_metadata | PACKAGE BODY | 477  |     ELSE
 dbms_metadata | PACKAGE BODY | 478  |       IF(obj_invalid > 0) THEN
 dbms_metadata | PACKAGE BODY | 479  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 480  |       END IF;
 dbms_metadata | PACKAGE BODY | 481  |     END IF;
 dbms_metadata | PACKAGE BODY | 482  |    EXCEPTION
 dbms_metadata | PACKAGE BODY | 483  |      WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 484  |        IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 485  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 486  |        END IF;
 dbms_metadata | PACKAGE BODY | 487  |      RAISE;
 dbms_metadata | PACKAGE BODY | 488  |   END;
 dbms_metadata | PACKAGE BODY | 489  | 
 dbms_metadata | PACKAGE BODY | 490  |   FUNCTION GET_CONSTRAINT_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 491  |   AS
 dbms_metadata | PACKAGE BODY | 492  |   DECLARE
 dbms_metadata | PACKAGE BODY | 493  |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 494  |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 495  |     rsconname    TEXT;
 dbms_metadata | PACKAGE BODY | 496  |     rscondef     TEXT;
 dbms_metadata | PACKAGE BODY | 497  |     rstabname    TEXT;
 dbms_metadata | PACKAGE BODY | 498  |     stmt         TEXT;
 dbms_metadata | PACKAGE BODY | 499  |     mycur        SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 500  | 
 dbms_metadata | PACKAGE BODY | 501  |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 502  |     obj_valid     INT := 0;
 dbms_metadata | PACKAGE BODY | 503  |     obj_invalid   INT := 0;
 dbms_metadata | PACKAGE BODY | 504  |   BEGIN
 dbms_metadata | PACKAGE BODY | 505  |     stmt := 'SELECT c.oid FROM pg_constraint c, pg_namespace nsp
 dbms_metadata | PACKAGE BODY | 506  |     WHERE nsp.oid = c.connamespace
 dbms_metadata | PACKAGE BODY | 507  |     AND nsp.nspname = '||''''||SCHEMA||''''||' AND c.conname = '||''''||OBJNAME||'''';
 dbms_metadata | PACKAGE BODY | 508  |     IF TABOID > 0 THEN
 dbms_metadata | PACKAGE BODY | 509  |       stmt := stmt||' AND c.conrelid = '||TABOID;
 dbms_metadata | PACKAGE BODY | 510  |     END IF;
 dbms_metadata | PACKAGE BODY | 511  |     stmt := stmt||';';
 dbms_metadata | PACKAGE BODY | 512  | 
 dbms_metadata | PACKAGE BODY | 513  |     OPEN mycur FOR EXECUTE stmt;
 dbms_metadata | PACKAGE BODY | 514  |     FETCH mycur INTO objtoid;
 dbms_metadata | PACKAGE BODY | 515  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 516  |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 517  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 518  |     END IF; 
 dbms_metadata | PACKAGE BODY | 519  | 
 dbms_metadata | PACKAGE BODY | 520  |     retddl := '';
 dbms_metadata | PACKAGE BODY | 521  |     --get constraint context
 dbms_metadata | PACKAGE BODY | 522  |     WHILE mycur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 523  |       SELECT relowner INTO obj_owneroid FROM pg_class WHERE pg_class.oid = (SELECT conrelid FROM pg_constraint WHERE pg_constraint.oid = objtoid);
 dbms_metadata | PACKAGE BODY | 524  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 525  |         obj_invalid := obj_invalid + 1;
 dbms_metadata | PACKAGE BODY | 526  |       ELSE
 dbms_metadata | PACKAGE BODY | 527  |         obj_valid := obj_valid + 1;
 dbms_metadata | PACKAGE BODY | 528  |                 SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 529  | 
 dbms_metadata | PACKAGE BODY | 530  |         SELECT r.conname, pg_catalog.pg_get_constraintdef(r.oid, true)
 dbms_metadata | PACKAGE BODY | 531  |         INTO rsconname, rscondef
 dbms_metadata | PACKAGE BODY | 532  |         FROM pg_catalog.pg_constraint r
 dbms_metadata | PACKAGE BODY | 533  |         WHERE r.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 534  | 
 dbms_metadata | PACKAGE BODY | 535  |                 RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 536  | 
 dbms_metadata | PACKAGE BODY | 537  |         SELECT relname INTO rstabname FROM pg_class c WHERE c.oid = (SELECT conrelid FROM pg_constraint con WHERE con.oid = objtoid);
 dbms_metadata | PACKAGE BODY | 538  | 
 dbms_metadata | PACKAGE BODY | 539  |         retddl := retddl||'ALTER TABLE '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(rstabname)||'"'||' ADD CONSTRAINT '||'"'||GET_OBJNAME(rsconname)||'"'||' '||rscondef||';'||chr(10);
 dbms_metadata | PACKAGE BODY | 540  |       END IF;
 dbms_metadata | PACKAGE BODY | 541  |       FETCH mycur INTO objtoid;
 dbms_metadata | PACKAGE BODY | 542  |     END LOOP;
 dbms_metadata | PACKAGE BODY | 543  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 544  | 
 dbms_metadata | PACKAGE BODY | 545  |    IF(obj_valid > 0) THEN
 dbms_metadata | PACKAGE BODY | 546  |       RETURN retddl;
 dbms_metadata | PACKAGE BODY | 547  |     ELSE
 dbms_metadata | PACKAGE BODY | 548  |       IF(obj_invalid > 0) THEN
 dbms_metadata | PACKAGE BODY | 549  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 550  |       END IF;
 dbms_metadata | PACKAGE BODY | 551  |     END IF;
 dbms_metadata | PACKAGE BODY | 552  |    EXCEPTION
 dbms_metadata | PACKAGE BODY | 553  |      WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 554  |        IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 555  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 556  |       END IF;
 dbms_metadata | PACKAGE BODY | 557  |       RAISE;
 dbms_metadata | PACKAGE BODY | 558  |   END;
 dbms_metadata | PACKAGE BODY | 559  | 
 dbms_metadata | PACKAGE BODY | 560  |   --function GET_REF_CONSTRAINT_DDL
 dbms_metadata | PACKAGE BODY | 561  |   FUNCTION GET_REF_CONSTRAINT_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 562  |   AS
 dbms_metadata | PACKAGE BODY | 563  |   DECLARE
 dbms_metadata | PACKAGE BODY | 564  |     objtoid       OID;
 dbms_metadata | PACKAGE BODY | 565  |     retddl        TEXT;
 dbms_metadata | PACKAGE BODY | 566  |     rsconname     TEXT;
 dbms_metadata | PACKAGE BODY | 567  |     rscondef      TEXT;
 dbms_metadata | PACKAGE BODY | 568  |     rstabname     TEXT;
 dbms_metadata | PACKAGE BODY | 569  |     stmt          TEXT;
 dbms_metadata | PACKAGE BODY | 570  |     mycur         SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 571  | 
 dbms_metadata | PACKAGE BODY | 572  |     obj_owneroid   OID;
 dbms_metadata | PACKAGE BODY | 573  |     obj_valid      INT := 0;
 dbms_metadata | PACKAGE BODY | 574  |     obj_invalid    INT := 0;
 dbms_metadata | PACKAGE BODY | 575  |   BEGIN
 dbms_metadata | PACKAGE BODY | 576  |     stmt := 'SELECT c.oid FROM pg_constraint c, pg_namespace nsp
 dbms_metadata | PACKAGE BODY | 577  |     WHERE c.contype = ''f''
 dbms_metadata | PACKAGE BODY | 578  |     AND nsp.oid = c.connamespace
 dbms_metadata | PACKAGE BODY | 579  |     AND nsp.nspname = '||''''||SCHEMA||''''||' AND c.conname = '||''''||OBJNAME||'''';
 dbms_metadata | PACKAGE BODY | 580  |     IF TABOID > 0 THEN
 dbms_metadata | PACKAGE BODY | 581  |       stmt := stmt||' AND c.conrelid = '||TABOID;
 dbms_metadata | PACKAGE BODY | 582  |     END IF;
 dbms_metadata | PACKAGE BODY | 583  |     stmt := stmt||'ORDER BY c.oid;';
 dbms_metadata | PACKAGE BODY | 584  | 
 dbms_metadata | PACKAGE BODY | 585  |     OPEN mycur FOR EXECUTE stmt;
 dbms_metadata | PACKAGE BODY | 586  |     FETCH mycur INTO objtoid;
 dbms_metadata | PACKAGE BODY | 587  |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 588  |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 589  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 590  |     END IF;
 dbms_metadata | PACKAGE BODY | 591  | 
 dbms_metadata | PACKAGE BODY | 592  |     retddl := '';
 dbms_metadata | PACKAGE BODY | 593  |     --get constraint context
 dbms_metadata | PACKAGE BODY | 594  |     WHILE mycur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 595  |       SELECT relowner INTO obj_owneroid FROM pg_class WHERE pg_class.oid = (SELECT conrelid FROM pg_constraint WHERE pg_constraint.oid = objtoid);
 dbms_metadata | PACKAGE BODY | 596  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 597  |         obj_invalid := obj_invalid + 1;
 dbms_metadata | PACKAGE BODY | 598  |       ELSE
 dbms_metadata | PACKAGE BODY | 599  |         obj_valid := obj_valid + 1;
 dbms_metadata | PACKAGE BODY | 600  |                 SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 601  | 
 dbms_metadata | PACKAGE BODY | 602  |         SELECT r.conname, pg_catalog.pg_get_constraintdef(r.oid, true)
 dbms_metadata | PACKAGE BODY | 603  |         INTO rsconname, rscondef
 dbms_metadata | PACKAGE BODY | 604  |         FROM pg_catalog.pg_constraint r
 dbms_metadata | PACKAGE BODY | 605  |         WHERE r.oid = objtoid;
 dbms_metadata | PACKAGE BODY | 606  | 
 dbms_metadata | PACKAGE BODY | 607  |         RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 608  | 
 dbms_metadata | PACKAGE BODY | 609  |         SELECT relname
 dbms_metadata | PACKAGE BODY | 610  |         INTO rstabname
 dbms_metadata | PACKAGE BODY | 611  |         FROM pg_class c 
 dbms_metadata | PACKAGE BODY | 612  |         WHERE c.oid = (SELECT conrelid FROM pg_constraint con WHERE con.oid = objtoid);
 dbms_metadata | PACKAGE BODY | 613  | 
 dbms_metadata | PACKAGE BODY | 614  |         retddl := retddl||'ALTER TABLE '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(rstabname)||'"'||' ADD CONSTRAINT '||'"'||GET_OBJNAME(rsconname)||'"'||' '||rscondef||';'||chr(10);
 dbms_metadata | PACKAGE BODY | 615  |       END IF;
 dbms_metadata | PACKAGE BODY | 616  |       FETCH mycur INTO objtoid;
 dbms_metadata | PACKAGE BODY | 617  |     END LOOP;
 dbms_metadata | PACKAGE BODY | 618  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 619  | 
 dbms_metadata | PACKAGE BODY | 620  |    IF(obj_valid > 0) THEN
 dbms_metadata | PACKAGE BODY | 621  |       RETURN retddl;
 dbms_metadata | PACKAGE BODY | 622  |     ELSE
 dbms_metadata | PACKAGE BODY | 623  |       IF(obj_invalid > 0) THEN
 dbms_metadata | PACKAGE BODY | 624  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 625  |       END IF;
 dbms_metadata | PACKAGE BODY | 626  |     END IF;
 dbms_metadata | PACKAGE BODY | 627  |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 628  |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 629  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 630  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 631  |       END IF;
 dbms_metadata | PACKAGE BODY | 632  |       RAISE;
 dbms_metadata | PACKAGE BODY | 633  |   END;
 dbms_metadata | PACKAGE BODY | 634  | 
 dbms_metadata | PACKAGE BODY | 635  |   --procedure GET_ATTR
 dbms_metadata | PACKAGE BODY | 636  |   PROCEDURE GET_ATTR(TABOID IN OID, ATTRCNT IN INT, BUF OUT VARCHAR2(8000))
 dbms_metadata | PACKAGE BODY | 637  |   AS
 dbms_metadata | PACKAGE BODY | 638  |   DECLARE
 dbms_metadata | PACKAGE BODY | 639  |     rsattname       TEXT;
 dbms_metadata | PACKAGE BODY | 640  |     rsattinfo       TEXT;
 dbms_metadata | PACKAGE BODY | 641  |     rsnotnull       BOOLEAN;
 dbms_metadata | PACKAGE BODY | 642  |     rsnum           SMALLINT;
 dbms_metadata | PACKAGE BODY | 643  |     rscnt           INT;
 dbms_metadata | PACKAGE BODY | 644  |     hasindex        BOOLEAN;
 dbms_metadata | PACKAGE BODY | 645  |     tmpddl          TEXT;
 dbms_metadata | PACKAGE BODY | 646  |     mycur           SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 647  |         rsattgenerated  TEXT;
 dbms_metadata | PACKAGE BODY | 648  |         refobjid        OID;
 dbms_metadata | PACKAGE BODY | 649  |         attidentity     CHAR;
 dbms_metadata | PACKAGE BODY | 650  |         seqrelcursor    SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 651  |         seqrelid        OID;
 dbms_metadata | PACKAGE BODY | 652  |         seq_record       RECORD;
 dbms_metadata | PACKAGE BODY | 653  |     stmt         TEXT;
 dbms_metadata | PACKAGE BODY | 654  |         seqname      TEXT;
 dbms_metadata | PACKAGE BODY | 655  |         seqnamespace TEXT;
 dbms_metadata | PACKAGE BODY | 656  |         seqvalue     RECORD;
 dbms_metadata | PACKAGE BODY | 657  |         upperpname    TEXT;
 dbms_metadata | PACKAGE BODY | 658  |         lowerpname    TEXT;
 dbms_metadata | PACKAGE BODY | 659  |         uppername    TEXT;
 dbms_metadata | PACKAGE BODY | 660  |         lowername    TEXT;
 dbms_metadata | PACKAGE BODY | 661  |         attisvisible BOOLEAN;
 dbms_metadata | PACKAGE BODY | 662  |         attgenerated CHAR;
 dbms_metadata | PACKAGE BODY | 663  |         virexpr      TEXT;
 dbms_metadata | PACKAGE BODY | 664  |         atthasdef    BOOLEAN;
 dbms_metadata | PACKAGE BODY | 665  |         defaultexpr  TEXT;
 dbms_metadata | PACKAGE BODY | 666  | 
 dbms_metadata | PACKAGE BODY | 667  |         CURSOR relcursor FOR
 dbms_metadata | PACKAGE BODY | 668  |             SELECT d.refobjid FROM pg_index i, pg_depend d, pg_constraint c
 dbms_metadata | PACKAGE BODY | 669  |                 WHERE i.indrelid = TABOID AND i.indisprimary  = 't'AND d.objid = i.indexrelid
 dbms_metadata | PACKAGE BODY | 670  |                 AND d.refobjid = c.oid and c.conrelid = TABOID;
 dbms_metadata | PACKAGE BODY | 671  |   BEGIN
 dbms_metadata | PACKAGE BODY | 672  |     OPEN mycur FOR
 dbms_metadata | PACKAGE BODY | 673  |     SELECT a.attname, pg_catalog.format_type(a.atttypid, a.atttypmod::INTEGER),
 dbms_metadata | PACKAGE BODY | 674  |     a.attnotnull, a.attgenerated, a.attnum, a.attidentity, a.attisvisible, a.attgenerated, a.atthasdef
 dbms_metadata | PACKAGE BODY | 675  |     FROM pg_catalog.pg_attribute a
 dbms_metadata | PACKAGE BODY | 676  |     WHERE a.attrelid = TABOID AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum;
 dbms_metadata | PACKAGE BODY | 677  | 
 dbms_metadata | PACKAGE BODY | 678  |     FETCH mycur INTO rsattname, rsattinfo, rsnotnull, rsattgenerated, rsnum, attidentity, attisvisible, attgenerated, atthasdef;
 dbms_metadata | PACKAGE BODY | 679  | 
 dbms_metadata | PACKAGE BODY | 680  |     CASE
 dbms_metadata | PACKAGE BODY | 681  |     WHEN mycur%FOUND THEN
 dbms_metadata | PACKAGE BODY | 682  |       BUF := '( '||chr(10);
 dbms_metadata | PACKAGE BODY | 683  |       rscnt := 1;
 dbms_metadata | PACKAGE BODY | 684  |       WHILE mycur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 685  |         BUF := BUF ||' '|| '"' || GET_OBJNAME(rsattname) || '"' ||' '||rsattinfo;
 dbms_metadata | PACKAGE BODY | 686  | 
 dbms_metadata | PACKAGE BODY | 687  |                 --check if the colum is INVISIBLE
 dbms_metadata | PACKAGE BODY | 688  |                 IF attisvisible = FALSE THEN
 dbms_metadata | PACKAGE BODY | 689  |                    BUF := BUF ||' INVISIBLE ';
 dbms_metadata | PACKAGE BODY | 690  |                 END IF;
 dbms_metadata | PACKAGE BODY | 691  | 
 dbms_metadata | PACKAGE BODY | 692  |                 --check if the colum is identity column
 dbms_metadata | PACKAGE BODY | 693  |         IF attidentity = 'i' OR  attidentity = 'o' OR attidentity = 'n' THEN
 dbms_metadata | PACKAGE BODY | 694  |                   IF attidentity = 'i' THEN
 dbms_metadata | PACKAGE BODY | 695  |                     BUF := BUF ||' GENERATED ALWAYS AS IDENTITY ';
 dbms_metadata | PACKAGE BODY | 696  |                   ELSEIF attidentity = 'o' THEN
 dbms_metadata | PACKAGE BODY | 697  |                     BUF := BUF ||' GENERATED BY DEFAULT AS IDENTITY ';
 dbms_metadata | PACKAGE BODY | 698  |                   ELSEIF attidentity = 'n' THEN
 dbms_metadata | PACKAGE BODY | 699  |                      BUF := BUF ||' GENERATED BY DEFAULT ON NULL AS IDENTITY ';
 dbms_metadata | PACKAGE BODY | 700  |                   END IF;
 dbms_metadata | PACKAGE BODY | 701  | 
 dbms_metadata | PACKAGE BODY | 702  |           OPEN seqrelcursor FOR SELECT c.oid, c.relname, n.nspname
 dbms_metadata | PACKAGE BODY | 703  |           FROM pg_depend d, pg_class c, pg_sequence q, pg_namespace n
 dbms_metadata | PACKAGE BODY | 704  |           WHERE d.refobjid = TABOID AND d.classid = 1259
 dbms_metadata | PACKAGE BODY | 705  |           AND c.oid = d.objid AND q.seqrelid = d.objid
 dbms_metadata | PACKAGE BODY | 706  |           AND c.relkind = 'S' AND n.oid = c.relnamespace;
 dbms_metadata | PACKAGE BODY | 707  |  
 dbms_metadata | PACKAGE BODY | 708  |           FETCH seqrelcursor INTO seqrelid, seqname, seqnamespace;
 dbms_metadata | PACKAGE BODY | 709  |           IF seqrelcursor%FOUND THEN
 dbms_metadata | PACKAGE BODY | 710  |                 stmt := 'SELECT * FROM pg_sequence where seqrelid =' || seqrelid;
 dbms_metadata | PACKAGE BODY | 711  |                 EXECUTE stmt INTO seq_record;
 dbms_metadata | PACKAGE BODY | 712  |             BUF := BUF ||' MINVALUE '||seq_record.seqmin||' MAXVALUE '||seq_record.seqmax;
 dbms_metadata | PACKAGE BODY | 713  |             BUF := BUF ||' INCREMENT BY '||seq_record.seqincrement ||chr(10);
 dbms_metadata | PACKAGE BODY | 714  | 
 dbms_metadata | PACKAGE BODY | 715  |                         upperpname = UPPER(seqnamespace);
 dbms_metadata | PACKAGE BODY | 716  |                         lowerpname = LOWER(seqnamespace);
 dbms_metadata | PACKAGE BODY | 717  |                         IF seqnamespace = upperpname THEN
 dbms_metadata | PACKAGE BODY | 718  |                           seqnamespace =  lowerpname;
 dbms_metadata | PACKAGE BODY | 719  |                         ELSEIF seqnamespace = lowerpname THEN
 dbms_metadata | PACKAGE BODY | 720  |                           seqnamespace =  upperpname;
 dbms_metadata | PACKAGE BODY | 721  |                         END IF;
 dbms_metadata | PACKAGE BODY | 722  | 
 dbms_metadata | PACKAGE BODY | 723  |                         uppername = UPPER(seqname);
 dbms_metadata | PACKAGE BODY | 724  |                         lowername = LOWER(seqname);
 dbms_metadata | PACKAGE BODY | 725  |                         IF seqname = uppername THEN
 dbms_metadata | PACKAGE BODY | 726  |                           seqname =  lowername;
 dbms_metadata | PACKAGE BODY | 727  |                         ELSEIF seqname = lowername THEN
 dbms_metadata | PACKAGE BODY | 728  |                           seqname =  uppername;
 dbms_metadata | PACKAGE BODY | 729  |                         END IF;
 dbms_metadata | PACKAGE BODY | 730  | 
 dbms_metadata | PACKAGE BODY | 731  |             stmt := 'SELECT * FROM '||'"'||seqnamespace||'" '||'.'|| '"'||seqname||'" ';
 dbms_metadata | PACKAGE BODY | 732  |             EXECUTE stmt INTO seqvalue;
 dbms_metadata | PACKAGE BODY | 733  | 
 dbms_metadata | PACKAGE BODY | 734  |             IF seqvalue.is_called THEN
 dbms_metadata | PACKAGE BODY | 735  |               BUF := BUF ||'START WITH '||seqvalue.last_value + seq_record.seqincrement ||' CACHE '||seq_record.seqcache;
 dbms_metadata | PACKAGE BODY | 736  |             ELSE
 dbms_metadata | PACKAGE BODY | 737  |               BUF := BUF ||'START WITH '||seq_record.seqstart ||' CACHE '||seq_record.seqcache;
 dbms_metadata | PACKAGE BODY | 738  |             END IF;
 dbms_metadata | PACKAGE BODY | 739  |             
 dbms_metadata | PACKAGE BODY | 740  |             IF seq_record.seqcycle THEN
 dbms_metadata | PACKAGE BODY | 741  |               BUF := BUF || ' CYCLE '||chr(10);
 dbms_metadata | PACKAGE BODY | 742  |             ELSE
 dbms_metadata | PACKAGE BODY | 743  |               BUF := BUF || ' NOCYCLE '||chr(10);
 dbms_metadata | PACKAGE BODY | 744  |             END IF;
 dbms_metadata | PACKAGE BODY | 745  |           END IF;
 dbms_metadata | PACKAGE BODY | 746  |           CLOSE seqrelcursor;
 dbms_metadata | PACKAGE BODY | 747  |                 ELSEIF attgenerated = 'v' THEN --virtual column
 dbms_metadata | PACKAGE BODY | 748  |                   SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true) INTO virexpr FROM pg_catalog.pg_attrdef d WHERE d.adrelid = TABOID AND d.adnum = rscnt;
 dbms_metadata | PACKAGE BODY | 749  |                   BUF := BUF || ' GENERATED ALWAYS AS (' || virexpr || ')' ||chr(10);
 dbms_metadata | PACKAGE BODY | 750  |                 ELSEIF atthasdef = TRUE THEN --default value
 dbms_metadata | PACKAGE BODY | 751  |                   SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true) INTO defaultexpr FROM pg_catalog.pg_attrdef d WHERE d.adrelid = TABOID AND d.adnum = rscnt;
 dbms_metadata | PACKAGE BODY | 752  |                   BUF := BUF || ' DEFAULT ' || defaultexpr ||chr(10);
 dbms_metadata | PACKAGE BODY | 753  |         END IF;
 dbms_metadata | PACKAGE BODY | 754  | 
 dbms_metadata | PACKAGE BODY | 755  |         IF rsnotnull IS TRUE THEN
 dbms_metadata | PACKAGE BODY | 756  |           BUF := BUF ||' NOT NULL';
 dbms_metadata | PACKAGE BODY | 757  |         END IF;
 dbms_metadata | PACKAGE BODY | 758  | 
 dbms_metadata | PACKAGE BODY | 759  |         IF (rscnt <> ATTRCNT) THEN
 dbms_metadata | PACKAGE BODY | 760  |           BUF := BUF ||', '||chr(10);
 dbms_metadata | PACKAGE BODY | 761  |         END IF;
 dbms_metadata | PACKAGE BODY | 762  |  
 dbms_metadata | PACKAGE BODY | 763  |         FETCH mycur INTO rsattname, rsattinfo, rsnotnull, rsattgenerated, rsnum, attidentity, attisvisible, attgenerated, atthasdef;
 dbms_metadata | PACKAGE BODY | 764  |         rscnt := rscnt + 1;
 dbms_metadata | PACKAGE BODY | 765  |      END LOOP;
 dbms_metadata | PACKAGE BODY | 766  | 
 dbms_metadata | PACKAGE BODY | 767  |      SELECT relhasindex INTO hasindex FROM pg_class WHERE oid = TABOID;
 dbms_metadata | PACKAGE BODY | 768  |      IF (hasindex) THEN
 dbms_metadata | PACKAGE BODY | 769  |         BUF := BUF || ', '||chr(10);
 dbms_metadata | PACKAGE BODY | 770  |         --get primary key information
 dbms_metadata | PACKAGE BODY | 771  |                 OPEN relcursor;
 dbms_metadata | PACKAGE BODY | 772  |         FETCH relcursor INTO refobjid;
 dbms_metadata | PACKAGE BODY | 773  |         IF relcursor%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 774  |               CLOSE relcursor;
 dbms_metadata | PACKAGE BODY | 775  |         ELSE
 dbms_metadata | PACKAGE BODY | 776  |                   SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 777  | 
 dbms_metadata | PACKAGE BODY | 778  |           SELECT pg_get_constraintdef(refobjid) INTO tmpddl;
 dbms_metadata | PACKAGE BODY | 779  | 
 dbms_metadata | PACKAGE BODY | 780  |                   RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 781  |               CLOSE relcursor;
 dbms_metadata | PACKAGE BODY | 782  |         END IF;
 dbms_metadata | PACKAGE BODY | 783  | 
 dbms_metadata | PACKAGE BODY | 784  |         IF tmpddl IS NOT NULL THEN
 dbms_metadata | PACKAGE BODY | 785  |           BUF := BUF||tmpddl||chr(10);
 dbms_metadata | PACKAGE BODY | 786  |         END IF;
 dbms_metadata | PACKAGE BODY | 787  |      ELSE
 dbms_metadata | PACKAGE BODY | 788  |         BUF := BUF||chr(10);
 dbms_metadata | PACKAGE BODY | 789  |      END IF;
 dbms_metadata | PACKAGE BODY | 790  | 
 dbms_metadata | PACKAGE BODY | 791  |      BUF := BUF || ') ';
 dbms_metadata | PACKAGE BODY | 792  |      ELSE
 dbms_metadata | PACKAGE BODY | 793  |         BUF := '';       
 dbms_metadata | PACKAGE BODY | 794  |     END CASE;
 dbms_metadata | PACKAGE BODY | 795  |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 796  |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 797  |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 798  |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 799  |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 800  |       END IF;
 dbms_metadata | PACKAGE BODY | 801  |       IF seqrelcursor%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 802  |             CLOSE seqrelcursor;
 dbms_metadata | PACKAGE BODY | 803  |       END IF;
 dbms_metadata | PACKAGE BODY | 804  |       RAISE;
 dbms_metadata | PACKAGE BODY | 805  |   END;
 dbms_metadata | PACKAGE BODY | 806  | 
 dbms_metadata | PACKAGE BODY | 807  |  --function GET_TABLE_DDL
 dbms_metadata | PACKAGE BODY | 808  |  FUNCTION GET_TABLE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), PARENTOBJNAME VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 809  |   AS
 dbms_metadata | PACKAGE BODY | 810  |   DECLARE
 dbms_metadata | PACKAGE BODY | 811  |     relid           OID;
 dbms_metadata | PACKAGE BODY | 812  |     relname         TEXT;
 dbms_metadata | PACKAGE BODY | 813  |     relnatts        INT;
 dbms_metadata | PACKAGE BODY | 814  |     stmt            TEXT;
 dbms_metadata | PACKAGE BODY | 815  |     relchecks       INT;
 dbms_metadata | PACKAGE BODY | 816  |         relhastriggers  BOOLEAN;
 dbms_metadata | PACKAGE BODY | 817  |     relkind         CHAR;
 dbms_metadata | PACKAGE BODY | 818  |     relhasindex     BOOLEAN;
 dbms_metadata | PACKAGE BODY | 819  |     relhasrules     BOOLEAN;
 dbms_metadata | PACKAGE BODY | 820  |     relhasrowid      BOOLEAN;
 dbms_metadata | PACKAGE BODY | 821  |     tablespaceid    OID;
 dbms_metadata | PACKAGE BODY | 822  |     ddltmp          TEXT;
 dbms_metadata | PACKAGE BODY | 823  |     idxrelname      TEXT;
 dbms_metadata | PACKAGE BODY | 824  |         unconstraintname TEXT;
 dbms_metadata | PACKAGE BODY | 825  |     chkname         TEXT;
 dbms_metadata | PACKAGE BODY | 826  |     fkname          TEXT;
 dbms_metadata | PACKAGE BODY | 827  |     tabspacename    TEXT;
 dbms_metadata | PACKAGE BODY | 828  |     tabtype    TEXT;
 dbms_metadata | PACKAGE BODY | 829  |         globaloptions TEXT;
 dbms_metadata | PACKAGE BODY | 830  |         relispartition  BOOLEAN;
 dbms_metadata | PACKAGE BODY | 831  |         relpartbound  pg_node_tree;
 dbms_metadata | PACKAGE BODY | 832  | 
 dbms_metadata | PACKAGE BODY | 833  |     CURSOR relcursor FOR
 dbms_metadata | PACKAGE BODY | 834  |     SELECT c.oid, c.relname, c.relnatts, c.relowner,
 dbms_metadata | PACKAGE BODY | 835  |     c.relhasindex, c.relkind, c.relchecks, c.relhastriggers, 
 dbms_metadata | PACKAGE BODY | 836  |         c.relhasrules, c.relhasrowid, c.reltablespace, c.relpersistence, c.reloptions[1], c.relispartition, c.relpartbound
 dbms_metadata | PACKAGE BODY | 837  |     FROM pg_catalog.pg_class c, pg_catalog.pg_namespace n
 dbms_metadata | PACKAGE BODY | 838  |     WHERE (c.relkind = 'r' OR c.relkind = 'p')
 dbms_metadata | PACKAGE BODY | 839  |     AND n.oid = c.relnamespace
 dbms_metadata | PACKAGE BODY | 840  |     AND c.relname = OBJNAME
 dbms_metadata | PACKAGE BODY | 841  |     AND n.nspname = SCHEMA
 dbms_metadata | PACKAGE BODY | 842  |     ORDER BY 2;
 dbms_metadata | PACKAGE BODY | 843  | 
 dbms_metadata | PACKAGE BODY | 844  |     myindexcur        SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 845  |         myunconstraintscur SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 846  |     mycheckcur        SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 847  |     result            TEXT;
 dbms_metadata | PACKAGE BODY | 848  |     obj_owneroid      OID;
 dbms_metadata | PACKAGE BODY | 849  |         myfkeycur         SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 850  |         partrelcursor     SYS_REFCURSOR;
 dbms_metadata | PACKAGE BODY | 851  |         objnspname                TEXT;
 dbms_metadata | PACKAGE BODY | 852  |         partrelid         OID;
 dbms_metadata | PACKAGE BODY | 853  |   BEGIN
 dbms_metadata | PACKAGE BODY | 854  |     SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 855  | 
 dbms_metadata | PACKAGE BODY | 856  |     OPEN relcursor;
 dbms_metadata | PACKAGE BODY | 857  |     FETCH relcursor INTO relid, relname, relnatts, obj_owneroid, relhasindex, relkind, 
 dbms_metadata | PACKAGE BODY | 858  |           relchecks, relhastriggers, relhasrules, relhasrowid,tablespaceid, tabtype,globaloptions,relispartition,relpartbound;
 dbms_metadata | PACKAGE BODY | 859  |     IF relcursor%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 860  |           CLOSE relcursor;
 dbms_metadata | PACKAGE BODY | 861  |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 862  |     ELSE
 dbms_metadata | PACKAGE BODY | 863  |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 864  |             CLOSE relcursor;
 dbms_metadata | PACKAGE BODY | 865  |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 866  |       END IF;
 dbms_metadata | PACKAGE BODY | 867  |     END IF;
 dbms_metadata | PACKAGE BODY | 868  |     CLOSE relcursor;
 dbms_metadata | PACKAGE BODY | 869  | 
 dbms_metadata | PACKAGE BODY | 870  |         IF tabtype = 'g' THEN
 dbms_metadata | PACKAGE BODY | 871  |           result := 'CREATE GLOBAL TEMPORARY TABLE '|| '"' || GET_OBJNAME(SCHEMA) || '"' ||'.' || '"' || GET_OBJNAME(OBJNAME) || '"';
 dbms_metadata | PACKAGE BODY | 872  |         ELSEIF tabtype = 't' THEN
 dbms_metadata | PACKAGE BODY | 873  |       result := 'CREATE TERPORARY TABLE '|| '"' || GET_OBJNAME(SCHEMA) || '"';
 dbms_metadata | PACKAGE BODY | 874  |         ELSEIF tabtype = 'u' THEN
 dbms_metadata | PACKAGE BODY | 875  |       result := 'CREATE UNLOGGED TABLE '|| '"' || GET_OBJNAME(SCHEMA) || '"';
 dbms_metadata | PACKAGE BODY | 876  |     ELSE
 dbms_metadata | PACKAGE BODY | 877  |       result := 'CREATE TABLE '|| '"' || GET_OBJNAME(SCHEMA) || '"' ||'.' || '"' || GET_OBJNAME(OBJNAME) || '"';
 dbms_metadata | PACKAGE BODY | 878  |     END IF;
 dbms_metadata | PACKAGE BODY | 879  | 
 dbms_metadata | PACKAGE BODY | 880  |         IF relispartition = TRUE THEN
 dbms_metadata | PACKAGE BODY | 881  |           result := result || ' PARTITION OF ' || '"' || GET_OBJNAME(SCHEMA) || '"' ||'.' || '"' || GET_OBJNAME(PARENTOBJNAME) || '" ' || pg_catalog.pg_get_expr(relpartbound, relid) || chr(10);
 dbms_metadata | PACKAGE BODY | 882  |         ELSE
 dbms_metadata | PACKAGE BODY | 883  |       --attributes
 dbms_metadata | PACKAGE BODY | 884  |       DBMS_METADATA.GET_ATTR(relid, relnatts, ddltmp);
 dbms_metadata | PACKAGE BODY | 885  |       IF ddltmp IS NULL THEN
 dbms_metadata | PACKAGE BODY | 886  |         RAISE EXCEPTION 'THE ATTRIBUTES INFORMATION DOSE NOT MATCH!';
 dbms_metadata | PACKAGE BODY | 887  |       ELSE
 dbms_metadata | PACKAGE BODY | 888  |         result := result || ddltmp;
 dbms_metadata | PACKAGE BODY | 889  |       END IF;
 dbms_metadata | PACKAGE BODY | 890  |         END IF;
 dbms_metadata | PACKAGE BODY | 891  | 
 dbms_metadata | PACKAGE BODY | 892  |         --partition
 dbms_metadata | PACKAGE BODY | 893  |         IF relkind = 'p' THEN
 dbms_metadata | PACKAGE BODY | 894  |           result := result || 'PARTITION BY ' || pg_get_partkeydef(relid) || chr(10);
 dbms_metadata | PACKAGE BODY | 895  |     END IF;
 dbms_metadata | PACKAGE BODY | 896  | 
 dbms_metadata | PACKAGE BODY | 897  |     --tablespace
 dbms_metadata | PACKAGE BODY | 898  |         IF tabtype = 'p' THEN
 dbms_metadata | PACKAGE BODY | 899  |           IF tablespaceid = 0 THEN
 dbms_metadata | PACKAGE BODY | 900  |                 result := result||'TABLESPACE '||'"'|| 'PG_DEFAULT' || '"'||chr(10);
 dbms_metadata | PACKAGE BODY | 901  |           ELSE
 dbms_metadata | PACKAGE BODY | 902  |         SELECT ts.spcname INTO tabspacename FROM pg_tablespace ts, pg_class c WHERE ts.oid = c.reltablespace 
 dbms_metadata | PACKAGE BODY | 903  |             AND c.relpersistence = 'p' AND c.oid = relid AND c.reltablespace != 0;
 dbms_metadata | PACKAGE BODY | 904  |         
 dbms_metadata | PACKAGE BODY | 905  |             IF tabspacename IS NOT NULL THEN
 dbms_metadata | PACKAGE BODY | 906  |           result := result||'TABLESPACE '||'"'||GET_OBJNAME(tabspacename)|| '"'||chr(10);
 dbms_metadata | PACKAGE BODY | 907  |             END IF;
 dbms_metadata | PACKAGE BODY | 908  |           END IF;
 dbms_metadata | PACKAGE BODY | 909  |     END IF;
 dbms_metadata | PACKAGE BODY | 910  | 
 dbms_metadata | PACKAGE BODY | 911  |     --index
 dbms_metadata | PACKAGE BODY | 912  |     IF (relhasindex) THEN
 dbms_metadata | PACKAGE BODY | 913  |       OPEN myindexcur FOR SELECT c.relname, n.nspname FROM pg_class c, pg_index i, pg_namespace n WHERE c.oid = i.indexrelid AND i.indrelid = relid
 dbms_metadata | PACKAGE BODY | 914  |                                         AND n.oid = c.relnamespace AND i.indisunique = 'f' AND i.indisprimary = 'f';
 dbms_metadata | PACKAGE BODY | 915  |       FETCH myindexcur INTO idxrelname, objnspname;
 dbms_metadata | PACKAGE BODY | 916  |       WHILE myindexcur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 917  |         ddltmp := DBMS_METADATA.GET_INDEX_DDL(idxrelname, objnspname, relid);
 dbms_metadata | PACKAGE BODY | 918  |         IF ddltmp IS NULL THEN
 dbms_metadata | PACKAGE BODY | 919  |                   CLOSE myindexcur;
 dbms_metadata | PACKAGE BODY | 920  |           RAISE EXCEPTION 'THE INDEX INFORMATION DOSE NOT MATCH!';
 dbms_metadata | PACKAGE BODY | 921  |         ELSE
 dbms_metadata | PACKAGE BODY | 922  |           result := result || ddltmp;
 dbms_metadata | PACKAGE BODY | 923  |         END IF;
 dbms_metadata | PACKAGE BODY | 924  |         FETCH myindexcur INTO idxrelname, objnspname;
 dbms_metadata | PACKAGE BODY | 925  |       END LOOP;
 dbms_metadata | PACKAGE BODY | 926  |       CLOSE myindexcur;
 dbms_metadata | PACKAGE BODY | 927  |     END IF;
 dbms_metadata | PACKAGE BODY | 928  | 
 dbms_metadata | PACKAGE BODY | 929  |         --unique constraint
 dbms_metadata | PACKAGE BODY | 930  |         IF (relhasindex) THEN
 dbms_metadata | PACKAGE BODY | 931  |       OPEN myunconstraintscur FOR SELECT c.relname, n.nspname FROM pg_class c, pg_index i, pg_namespace n WHERE c.oid = i.indexrelid AND i.indrelid = relid
 dbms_metadata | PACKAGE BODY | 932  |                                         AND n.oid = c.relnamespace AND i.indisunique = 't' AND i.indisprimary  = 'f' ;
 dbms_metadata | PACKAGE BODY | 933  |       FETCH myunconstraintscur INTO unconstraintname, objnspname;
 dbms_metadata | PACKAGE BODY | 934  |       WHILE myunconstraintscur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 935  |         ddltmp := DBMS_METADATA.GET_CONSTRAINT_DDL(unconstraintname, objnspname, relid);
 dbms_metadata | PACKAGE BODY | 936  |         IF ddltmp IS NULL THEN
 dbms_metadata | PACKAGE BODY | 937  |                   CLOSE myunconstraintscur;
 dbms_metadata | PACKAGE BODY | 938  |           RAISE EXCEPTION 'THE UNIQUE INFORMATION DOSE NOT MATCH!';
 dbms_metadata | PACKAGE BODY | 939  |         ELSE
 dbms_metadata | PACKAGE BODY | 940  |           result := result || ddltmp;
 dbms_metadata | PACKAGE BODY | 941  |         END IF;
 dbms_metadata | PACKAGE BODY | 942  |         FETCH myunconstraintscur INTO unconstraintname, objnspname;
 dbms_metadata | PACKAGE BODY | 943  |       END LOOP;
 dbms_metadata | PACKAGE BODY | 944  |       CLOSE myunconstraintscur;
 dbms_metadata | PACKAGE BODY | 945  |     END IF;
 dbms_metadata | PACKAGE BODY | 946  | 
 dbms_metadata | PACKAGE BODY | 947  |     --check
 dbms_metadata | PACKAGE BODY | 948  |     IF (relchecks > 0) THEN
 dbms_metadata | PACKAGE BODY | 949  |       OPEN mycheckcur FOR SELECT r.conname, n.nspname FROM pg_catalog.pg_constraint r , pg_namespace n WHERE r.conrelid = relid AND r.contype = 'c' AND n.oid = r.connamespace ORDER BY 1;
 dbms_metadata | PACKAGE BODY | 950  |       FETCH mycheckcur INTO chkname, objnspname;
 dbms_metadata | PACKAGE BODY | 951  |       WHILE mycheckcur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 952  |         ddltmp := DBMS_METADATA.GET_CONSTRAINT_DDL(chkname, objnspname, relid);
 dbms_metadata | PACKAGE BODY | 953  |         IF ddltmp IS NULL THEN
 dbms_metadata | PACKAGE BODY | 954  |                   CLOSE mycheckcur;
 dbms_metadata | PACKAGE BODY | 955  |           RAISE EXCEPTION 'THE CHECK INFORMATION DOSE NOT MATCH!';
 dbms_metadata | PACKAGE BODY | 956  |         ELSE
 dbms_metadata | PACKAGE BODY | 957  |           result := result || ddltmp;
 dbms_metadata | PACKAGE BODY | 958  |         END IF;
 dbms_metadata | PACKAGE BODY | 959  |         FETCH mycheckcur INTO chkname, objnspname;
 dbms_metadata | PACKAGE BODY | 960  |       END LOOP;
 dbms_metadata | PACKAGE BODY | 961  |       CLOSE mycheckcur;
 dbms_metadata | PACKAGE BODY | 962  |     END IF;
 dbms_metadata | PACKAGE BODY | 963  | 
 dbms_metadata | PACKAGE BODY | 964  |         --Foreign key constraint
 dbms_metadata | PACKAGE BODY | 965  |       OPEN myfkeycur FOR SELECT r.conname, n.nspname  FROM pg_catalog.pg_constraint r, pg_namespace n  WHERE r.conrelid = relid AND r.contype = 'f'  AND n.oid = r.connamespace ORDER BY 1;
 dbms_metadata | PACKAGE BODY | 966  |       FETCH myfkeycur INTO fkname, objnspname;
 dbms_metadata | PACKAGE BODY | 967  |       WHILE myfkeycur%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 968  |         ddltmp := DBMS_METADATA.GET_CONSTRAINT_DDL(fkname, objnspname, relid);
 dbms_metadata | PACKAGE BODY | 969  |         IF ddltmp IS NULL THEN
 dbms_metadata | PACKAGE BODY | 970  |                   CLOSE myfkeycur;
 dbms_metadata | PACKAGE BODY | 971  |           RAISE EXCEPTION 'THE FOREIGN KEY CONSTRAINT DOSE NOT MATCH!';
 dbms_metadata | PACKAGE BODY | 972  |         ELSE
 dbms_metadata | PACKAGE BODY | 973  |           result := result || ddltmp;
 dbms_metadata | PACKAGE BODY | 974  |         END IF;
 dbms_metadata | PACKAGE BODY | 975  |         FETCH myfkeycur INTO fkname, objnspname;
 dbms_metadata | PACKAGE BODY | 976  |       END LOOP;
 dbms_metadata | PACKAGE BODY | 977  |       CLOSE myfkeycur;
 dbms_metadata | PACKAGE BODY | 978  | 
 dbms_metadata | PACKAGE BODY | 979  |       IF tabtype = 'g' then
 dbms_metadata | PACKAGE BODY | 980  |             if instr(globaloptions,'true') = 0 THEN
 dbms_metadata | PACKAGE BODY | 981  |                         result := result || ' ON COMMIT PRESERVE ROWS';
 dbms_metadata | PACKAGE BODY | 982  |                 else
 dbms_metadata | PACKAGE BODY | 983  |                         result := result || ' ON COMMIT DELETE ROWS';
 dbms_metadata | PACKAGE BODY | 984  |                 end if;
 dbms_metadata | PACKAGE BODY | 985  |           END IF;
 dbms_metadata | PACKAGE BODY | 986  | 
 dbms_metadata | PACKAGE BODY | 987  |         --partition
 dbms_metadata | PACKAGE BODY | 988  |         IF relkind = 'p' THEN
 dbms_metadata | PACKAGE BODY | 989  |       OPEN partrelcursor FOR SELECT inhrelid FROM pg_inherits WHERE inhparent = relid;
 dbms_metadata | PACKAGE BODY | 990  |       FETCH partrelcursor INTO partrelid;
 dbms_metadata | PACKAGE BODY | 991  |       WHILE partrelcursor%FOUND LOOP
 dbms_metadata | PACKAGE BODY | 992  |             SET quote_all_identifiers = FALSE;
 dbms_metadata | PACKAGE BODY | 993  |         ddltmp := DBMS_METADATA.GET_TABLE_DDL(partrelid::regclass::varchar2, SCHEMA, OBJNAME);
 dbms_metadata | PACKAGE BODY | 994  |                 SET quote_all_identifiers = TRUE;
 dbms_metadata | PACKAGE BODY | 995  |         IF ddltmp IS NULL THEN
 dbms_metadata | PACKAGE BODY | 996  |                   CLOSE partrelcursor;
 dbms_metadata | PACKAGE BODY | 997  |           RAISE EXCEPTION 'THE PARTITION DOSE NOT EXISTS!';
 dbms_metadata | PACKAGE BODY | 998  |         ELSE
 dbms_metadata | PACKAGE BODY | 999  |           result := result || ddltmp;
 dbms_metadata | PACKAGE BODY | 1000 |         END IF;
 dbms_metadata | PACKAGE BODY | 1001 |         FETCH partrelcursor INTO partrelid;
 dbms_metadata | PACKAGE BODY | 1002 |       END LOOP;
 dbms_metadata | PACKAGE BODY | 1003 |       CLOSE partrelcursor;
 dbms_metadata | PACKAGE BODY | 1004 |     END IF;
 dbms_metadata | PACKAGE BODY | 1005 | 
 dbms_metadata | PACKAGE BODY | 1006 |     RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 1007 | 
 dbms_metadata | PACKAGE BODY | 1008 |     RETURN result;
 dbms_metadata | PACKAGE BODY | 1009 |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 1010 |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 1011 |       IF relcursor%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1012 |             CLOSE relcursor;
 dbms_metadata | PACKAGE BODY | 1013 |       END IF;
 dbms_metadata | PACKAGE BODY | 1014 |       IF myindexcur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1015 |             CLOSE myindexcur;
 dbms_metadata | PACKAGE BODY | 1016 |       END IF;
 dbms_metadata | PACKAGE BODY | 1017 |       IF mycheckcur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1018 |             CLOSE mycheckcur;
 dbms_metadata | PACKAGE BODY | 1019 |       END IF;
 dbms_metadata | PACKAGE BODY | 1020 |       IF myfkeycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1021 |             CLOSE myfkeycur;
 dbms_metadata | PACKAGE BODY | 1022 |       END IF;
 dbms_metadata | PACKAGE BODY | 1023 |       IF partrelcursor%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1024 |             CLOSE partrelcursor;
 dbms_metadata | PACKAGE BODY | 1025 |       END IF;
 dbms_metadata | PACKAGE BODY | 1026 |           RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 1027 |       RAISE;
 dbms_metadata | PACKAGE BODY | 1028 |   END;
 dbms_metadata | PACKAGE BODY | 1029 | 
 dbms_metadata | PACKAGE BODY | 1030 | --function GET_PACKAGE_DDL
 dbms_metadata | PACKAGE BODY | 1031 |   FUNCTION GET_PACKAGE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 1032 |   AS
 dbms_metadata | PACKAGE BODY | 1033 |   DECLARE
 dbms_metadata | PACKAGE BODY | 1034 |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 1035 |     SELECT p.oid, p.pkgowner FROM pg_package p, pg_catalog.pg_namespace n
 dbms_metadata | PACKAGE BODY | 1036 |     WHERE p.pkgname = OBJNAME
 dbms_metadata | PACKAGE BODY | 1037 |     AND n.nspname=SCHEMA
 dbms_metadata | PACKAGE BODY | 1038 |     AND n.oid = p.pkgnamespace;
 dbms_metadata | PACKAGE BODY | 1039 | 
 dbms_metadata | PACKAGE BODY | 1040 |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 1041 |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 1042 |         headddl      TEXT;
 dbms_metadata | PACKAGE BODY | 1043 |     tmpddl       TEXT;
 dbms_metadata | PACKAGE BODY | 1044 |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 1045 |         bodyddl      TEXT;
 dbms_metadata | PACKAGE BODY | 1046 |         len1         INT;
 dbms_metadata | PACKAGE BODY | 1047 |         len2         INT;
 dbms_metadata | PACKAGE BODY | 1048 |   BEGIN
 dbms_metadata | PACKAGE BODY | 1049 |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 1050 |     FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 1051 |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 1052 |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1053 |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 1054 |     ELSE
 dbms_metadata | PACKAGE BODY | 1055 |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 1056 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1057 |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 1058 |       END IF;
 dbms_metadata | PACKAGE BODY | 1059 |     END IF;
 dbms_metadata | PACKAGE BODY | 1060 | 
 dbms_metadata | PACKAGE BODY | 1061 |         SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 1062 |         SELECT pg_get_package_head(objtoid) INTO headddl;
 dbms_metadata | PACKAGE BODY | 1063 |         RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 1064 | 
 dbms_metadata | PACKAGE BODY | 1065 |     --get package context
 dbms_metadata | PACKAGE BODY | 1066 |     SELECT pkgsrc INTO tmpddl FROM pg_package WHERE oid=objtoid;
 dbms_metadata | PACKAGE BODY | 1067 |     retddl := headddl || chr(10) || 'AS' || tmpddl || ';'|| chr(10);
 dbms_metadata | PACKAGE BODY | 1068 | 
 dbms_metadata | PACKAGE BODY | 1069 |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1070 |         --Is there a package body?
 dbms_metadata | PACKAGE BODY | 1071 |         --SELECT pg_get_package_body_for_getddl(objtoid) INTO bodyddl;
 dbms_metadata | PACKAGE BODY | 1072 |         SELECT bodysrc INTO bodyddl FROM pg_package_body WHERE pkgoid = objtoid;
 dbms_metadata | PACKAGE BODY | 1073 |     IF bodyddl IS NOT NULL THEN
 dbms_metadata | PACKAGE BODY | 1074 |           len1 = LENGTH(headddl);
 dbms_metadata | PACKAGE BODY | 1075 |           len2 = instr(headddl, 'PACKAGE');
 dbms_metadata | PACKAGE BODY | 1076 |           retddl := retddl || LEFT(headddl, len2 + LENGTH('PACKAGE')) || 'BODY ' || RIGHT(headddl, len1 - len2 - LENGTH('PACKAGE')) || ' AS' || chr(10) || bodyddl || ';' || chr(10);
 dbms_metadata | PACKAGE BODY | 1077 |         END IF;
 dbms_metadata | PACKAGE BODY | 1078 | 
 dbms_metadata | PACKAGE BODY | 1079 |         RETURN retddl;
 dbms_metadata | PACKAGE BODY | 1080 |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 1081 |         WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 1082 |           IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1083 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1084 |           END IF;
 dbms_metadata | PACKAGE BODY | 1085 |           RAISE;
 dbms_metadata | PACKAGE BODY | 1086 |   END;
 dbms_metadata | PACKAGE BODY | 1087 | 
 dbms_metadata | PACKAGE BODY | 1088 |   --function GET_PACKAGE_BODY_DDL
 dbms_metadata | PACKAGE BODY | 1089 |   FUNCTION GET_PACKAGE_BODY_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 1090 |   AS
 dbms_metadata | PACKAGE BODY | 1091 |   DECLARE
 dbms_metadata | PACKAGE BODY | 1092 |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 1093 |     SELECT p.oid, p.pkgowner FROM pg_package p, pg_catalog.pg_namespace n
 dbms_metadata | PACKAGE BODY | 1094 |     WHERE p.pkgname = OBJNAME
 dbms_metadata | PACKAGE BODY | 1095 |     AND n.nspname=SCHEMA
 dbms_metadata | PACKAGE BODY | 1096 |     AND n.oid = p.pkgnamespace;
 dbms_metadata | PACKAGE BODY | 1097 | 
 dbms_metadata | PACKAGE BODY | 1098 |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 1099 |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 1100 |     tmpddl       TEXT;
 dbms_metadata | PACKAGE BODY | 1101 |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 1102 |         headddl      TEXT;
 dbms_metadata | PACKAGE BODY | 1103 |         bodyddl      TEXT;
 dbms_metadata | PACKAGE BODY | 1104 |         len1         INT;
 dbms_metadata | PACKAGE BODY | 1105 |         len2         INT;
 dbms_metadata | PACKAGE BODY | 1106 |   BEGIN
 dbms_metadata | PACKAGE BODY | 1107 |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 1108 |     FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 1109 |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 1110 |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1111 |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 1112 |     ELSE
 dbms_metadata | PACKAGE BODY | 1113 |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 1114 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1115 |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 1116 |       END IF;
 dbms_metadata | PACKAGE BODY | 1117 |     END IF;
 dbms_metadata | PACKAGE BODY | 1118 | 
 dbms_metadata | PACKAGE BODY | 1119 |     --get package body context
 dbms_metadata | PACKAGE BODY | 1120 |         SELECT bodysrc INTO bodyddl FROM pg_package_body WHERE pkgoid = objtoid;
 dbms_metadata | PACKAGE BODY | 1121 | 
 dbms_metadata | PACKAGE BODY | 1122 |         IF bodyddl IS NOT NULL THEN
 dbms_metadata | PACKAGE BODY | 1123 |           SET quote_all_identifiers = true;
 dbms_metadata | PACKAGE BODY | 1124 |           SELECT pg_get_package_head(objtoid) INTO headddl;
 dbms_metadata | PACKAGE BODY | 1125 |           RESET quote_all_identifiers;
 dbms_metadata | PACKAGE BODY | 1126 |           len1 = LENGTH(headddl);
 dbms_metadata | PACKAGE BODY | 1127 |           len2 = instr(headddl, 'PACKAGE');
 dbms_metadata | PACKAGE BODY | 1128 |           retddl := retddl || LEFT(headddl, len2 + LENGTH('PACKAGE')) || 'BODY ' || RIGHT(headddl, len1 - len2 - LENGTH('PACKAGE')) || ' AS' || chr(10) || bodyddl || ';' || chr(10);
 dbms_metadata | PACKAGE BODY | 1129 |     END IF;
 dbms_metadata | PACKAGE BODY | 1130 | 
 dbms_metadata | PACKAGE BODY | 1131 |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1132 |     RETURN retddl;
 dbms_metadata | PACKAGE BODY | 1133 |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 1134 |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 1135 |           IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1136 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1137 |           END IF;
 dbms_metadata | PACKAGE BODY | 1138 |           RAISE;
 dbms_metadata | PACKAGE BODY | 1139 |   END;
 dbms_metadata | PACKAGE BODY | 1140 | 
 dbms_metadata | PACKAGE BODY | 1141 |   --function GET_DBLINK_DDL
 dbms_metadata | PACKAGE BODY | 1142 |   FUNCTION GET_DBLINK_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 1143 |   AS
 dbms_metadata | PACKAGE BODY | 1144 |   DECLARE
 dbms_metadata | PACKAGE BODY | 1145 |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 1146 |     SELECT s.oid, s.srvowner, s.olnkisshared,s.olnkispublic, s.olnkconntype, s.olnkusingstring
 dbms_metadata | PACKAGE BODY | 1147 |         FROM pg_foreign_server s, pg_user u
 dbms_metadata | PACKAGE BODY | 1148 |     WHERE s.srvname = OBJNAME AND u.usesysid = s.srvowner;
 dbms_metadata | PACKAGE BODY | 1149 | 
 dbms_metadata | PACKAGE BODY | 1150 |     CURSOR mycur2 FOR
 dbms_metadata | PACKAGE BODY | 1151 |         SELECT umoptions
 dbms_metadata | PACKAGE BODY | 1152 |         FROM pg_foreign_server s, pg_user_mappings m
 dbms_metadata | PACKAGE BODY | 1153 |         WHERE s.srvname = OBJNAME  AND s.oid = m.srvid;
 dbms_metadata | PACKAGE BODY | 1154 | 
 dbms_metadata | PACKAGE BODY | 1155 |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 1156 |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 1157 |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 1158 |         olnkisshared BOOLEAN;
 dbms_metadata | PACKAGE BODY | 1159 |         olnkispublic BOOLEAN;
 dbms_metadata | PACKAGE BODY | 1160 |         olnkconntype INT;
 dbms_metadata | PACKAGE BODY | 1161 |         umoptions    TEXT;
 dbms_metadata | PACKAGE BODY | 1162 |         username     TEXT;
 dbms_metadata | PACKAGE BODY | 1163 |         userpwd      TEXT;
 dbms_metadata | PACKAGE BODY | 1164 |         olnkusingstring TEXT;
 dbms_metadata | PACKAGE BODY | 1165 |         authentusername TEXT;
 dbms_metadata | PACKAGE BODY | 1166 |         authentuserpwd  TEXT;
 dbms_metadata | PACKAGE BODY | 1167 |         pos       INT;
 dbms_metadata | PACKAGE BODY | 1168 |         i            INT;
 dbms_metadata | PACKAGE BODY | 1169 |         str                      TEXT;
 dbms_metadata | PACKAGE BODY | 1170 |   BEGIN
 dbms_metadata | PACKAGE BODY | 1171 |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 1172 |     FETCH mycur INTO objtoid, obj_owneroid, olnkisshared, olnkispublic, olnkconntype, olnkusingstring;
 dbms_metadata | PACKAGE BODY | 1173 |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 1174 |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1175 |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 1176 |     ELSE
 dbms_metadata | PACKAGE BODY | 1177 |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 1178 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1179 |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 1180 |       END IF;
 dbms_metadata | PACKAGE BODY | 1181 |     END IF;
 dbms_metadata | PACKAGE BODY | 1182 | 
 dbms_metadata | PACKAGE BODY | 1183 |         IF olnkconntype = 2 THEN
 dbms_metadata | PACKAGE BODY | 1184 |         OPEN mycur2;
 dbms_metadata | PACKAGE BODY | 1185 |         FETCH mycur2 INTO umoptions;
 dbms_metadata | PACKAGE BODY | 1186 |         IF mycur2%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 1187 |               CLOSE mycur2;
 dbms_metadata | PACKAGE BODY | 1188 |           RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 1189 |         END IF;
 dbms_metadata | PACKAGE BODY | 1190 | 
 dbms_metadata | PACKAGE BODY | 1191 |         --get the username from umoptions in pg_user_mapping table
 dbms_metadata | PACKAGE BODY | 1192 |         pos := 0;
 dbms_metadata | PACKAGE BODY | 1193 |         SELECT POSITION('user' IN umoptions) INTO pos;
 dbms_metadata | PACKAGE BODY | 1194 |         IF pos != 0 THEN
 dbms_metadata | PACKAGE BODY | 1195 |           i := pos;
 dbms_metadata | PACKAGE BODY | 1196 |           LOOP
 dbms_metadata | PACKAGE BODY | 1197 |             str := substr(umoptions, i + 5, 1);
 dbms_metadata | PACKAGE BODY | 1198 |                 IF str = ',' OR str = '}'THEN
 dbms_metadata | PACKAGE BODY | 1199 |                   EXIT;
 dbms_metadata | PACKAGE BODY | 1200 |                 ELSE
 dbms_metadata | PACKAGE BODY | 1201 |                   i := i + 1;
 dbms_metadata | PACKAGE BODY | 1202 |                 END IF;
 dbms_metadata | PACKAGE BODY | 1203 |           END LOOP;
 dbms_metadata | PACKAGE BODY | 1204 |           username = SUBSTR(umoptions, pos + 5, i - pos);
 dbms_metadata | PACKAGE BODY | 1205 |         END IF;
 dbms_metadata | PACKAGE BODY | 1206 |     
 dbms_metadata | PACKAGE BODY | 1207 |         --get the password from umoptions in pg_user_mapping table
 dbms_metadata | PACKAGE BODY | 1208 |         pos := 0;
 dbms_metadata | PACKAGE BODY | 1209 |         SELECT POSITION('password' IN umoptions) INTO pos;
 dbms_metadata | PACKAGE BODY | 1210 |         IF pos != 0 THEN
 dbms_metadata | PACKAGE BODY | 1211 |           i := pos;
 dbms_metadata | PACKAGE BODY | 1212 |           LOOP
 dbms_metadata | PACKAGE BODY | 1213 |             str := substr(umoptions, i + 9, 1);
 dbms_metadata | PACKAGE BODY | 1214 |                 IF str = ',' OR str = '}'THEN
 dbms_metadata | PACKAGE BODY | 1215 |                   EXIT;
 dbms_metadata | PACKAGE BODY | 1216 |                 ELSE
 dbms_metadata | PACKAGE BODY | 1217 |                   i := i + 1;
 dbms_metadata | PACKAGE BODY | 1218 |                 END IF;
 dbms_metadata | PACKAGE BODY | 1219 |           END LOOP;
 dbms_metadata | PACKAGE BODY | 1220 |           userpwd = SUBSTR(umoptions, pos + 9, i - pos);
 dbms_metadata | PACKAGE BODY | 1221 |         END IF;
 dbms_metadata | PACKAGE BODY | 1222 |     
 dbms_metadata | PACKAGE BODY | 1223 |         --get the authuser from umoptions in pg_user_mapping table
 dbms_metadata | PACKAGE BODY | 1224 |         pos := 0;
 dbms_metadata | PACKAGE BODY | 1225 |         SELECT POSITION('authuser' IN umoptions) INTO pos;
 dbms_metadata | PACKAGE BODY | 1226 |         IF pos != 0 THEN
 dbms_metadata | PACKAGE BODY | 1227 |           i := pos;
 dbms_metadata | PACKAGE BODY | 1228 |           LOOP
 dbms_metadata | PACKAGE BODY | 1229 |             str := substr(umoptions, i + 9, 1);
 dbms_metadata | PACKAGE BODY | 1230 |                 IF str = ',' OR str = '}'THEN
 dbms_metadata | PACKAGE BODY | 1231 |                   EXIT;
 dbms_metadata | PACKAGE BODY | 1232 |                 ELSE
 dbms_metadata | PACKAGE BODY | 1233 |                   i := i + 1;
 dbms_metadata | PACKAGE BODY | 1234 |                 END IF;
 dbms_metadata | PACKAGE BODY | 1235 |           END LOOP;
 dbms_metadata | PACKAGE BODY | 1236 |           authentusername = SUBSTR(umoptions, pos + 9, i - pos);
 dbms_metadata | PACKAGE BODY | 1237 |         END IF;
 dbms_metadata | PACKAGE BODY | 1238 |     
 dbms_metadata | PACKAGE BODY | 1239 |         --get the authpassword from umoptions in pg_user_mapping table
 dbms_metadata | PACKAGE BODY | 1240 |         pos := 0;
 dbms_metadata | PACKAGE BODY | 1241 |         SELECT POSITION('authpassword' IN umoptions) INTO pos;
 dbms_metadata | PACKAGE BODY | 1242 |         IF pos != 0 THEN
 dbms_metadata | PACKAGE BODY | 1243 |           i := pos;
 dbms_metadata | PACKAGE BODY | 1244 |           LOOP
 dbms_metadata | PACKAGE BODY | 1245 |             str := substr(umoptions, i + 13, 1);
 dbms_metadata | PACKAGE BODY | 1246 |                 IF str = ',' OR str = '}'THEN
 dbms_metadata | PACKAGE BODY | 1247 |                   EXIT;
 dbms_metadata | PACKAGE BODY | 1248 |                 ELSE
 dbms_metadata | PACKAGE BODY | 1249 |                   i := i + 1;
 dbms_metadata | PACKAGE BODY | 1250 |                 END IF;
 dbms_metadata | PACKAGE BODY | 1251 |           END LOOP;
 dbms_metadata | PACKAGE BODY | 1252 |           authentuserpwd = SUBSTR(umoptions, pos + 13, i - pos);
 dbms_metadata | PACKAGE BODY | 1253 |         END IF;
 dbms_metadata | PACKAGE BODY | 1254 |                 CLOSE mycur2;
 dbms_metadata | PACKAGE BODY | 1255 |         END IF;
 dbms_metadata | PACKAGE BODY | 1256 | 
 dbms_metadata | PACKAGE BODY | 1257 |         IF olnkisshared = TRUE AND olnkispublic = TRUE THEN
 dbms_metadata | PACKAGE BODY | 1258 |       retddl := 'CREATE SHARED PUBLIC DATABASE LINK '||'"'||GET_OBJNAME(OBJNAME)||'"' || chr(10);
 dbms_metadata | PACKAGE BODY | 1259 |     ELSEIF olnkisshared = TRUE THEN
 dbms_metadata | PACKAGE BODY | 1260 |           retddl := 'CREATE SHARED DATABASE LINK '||'"'||GET_OBJNAME(OBJNAME)||'"' || chr(10);
 dbms_metadata | PACKAGE BODY | 1261 |         ELSEIF olnkispublic = TRUE THEN
 dbms_metadata | PACKAGE BODY | 1262 |           retddl := 'CREATE PUBLIC DATABASE LINK '||'"'||GET_OBJNAME(OBJNAME)||'"' || chr(10);
 dbms_metadata | PACKAGE BODY | 1263 |         ELSE
 dbms_metadata | PACKAGE BODY | 1264 |           retddl := 'CREATE DATABASE LINK '||'"'||GET_OBJNAME(OBJNAME)||'"' || chr(10);
 dbms_metadata | PACKAGE BODY | 1265 |         END IF;
 dbms_metadata | PACKAGE BODY | 1266 | 
 dbms_metadata | PACKAGE BODY | 1267 |         IF olnkconntype = 2 THEN
 dbms_metadata | PACKAGE BODY | 1268 |            retddl := retddl || ' CONNECT TO '||'"'||GET_OBJNAME(username)||'"' || ' IDENTIFIED BY '|| '"'|| userpwd ||'"' || chr(10);
 dbms_metadata | PACKAGE BODY | 1269 |            IF olnkisshared = TRUE THEN
 dbms_metadata | PACKAGE BODY | 1270 |              retddl := retddl || ' AUTHENTICATED BY  '||'"'||GET_OBJNAME(authentusername)||'"' || ' IDENTIFIED BY '|| '"'|| authentuserpwd ||'"' || chr(10);
 dbms_metadata | PACKAGE BODY | 1271 |            END IF;
 dbms_metadata | PACKAGE BODY | 1272 |         ELSEIF olnkconntype = 3 THEN
 dbms_metadata | PACKAGE BODY | 1273 |            retddl := retddl || ' CONNECT TO CURRENT_USER'|| chr(10);   
 dbms_metadata | PACKAGE BODY | 1274 |         END IF;
 dbms_metadata | PACKAGE BODY | 1275 | 
 dbms_metadata | PACKAGE BODY | 1276 |     IF olnkusingstring IS NOT NULL THEN
 dbms_metadata | PACKAGE BODY | 1277 |             retddl := retddl || 'USING ' || '''' || olnkusingstring || ''''|| chr(10);
 dbms_metadata | PACKAGE BODY | 1278 |         END IF;
 dbms_metadata | PACKAGE BODY | 1279 | 
 dbms_metadata | PACKAGE BODY | 1280 |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1281 |         RETURN retddl;
 dbms_metadata | PACKAGE BODY | 1282 |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 1283 |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 1284 |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1285 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1286 |       END IF;
 dbms_metadata | PACKAGE BODY | 1287 |       IF mycur2%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1288 |             CLOSE mycur2;
 dbms_metadata | PACKAGE BODY | 1289 |       END IF;
 dbms_metadata | PACKAGE BODY | 1290 |       RAISE;
 dbms_metadata | PACKAGE BODY | 1291 |   END;
 dbms_metadata | PACKAGE BODY | 1292 | 
 dbms_metadata | PACKAGE BODY | 1293 | --function GET_SEQUENCE_DDL
 dbms_metadata | PACKAGE BODY | 1294 |   FUNCTION GET_SEQUENCE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT
 dbms_metadata | PACKAGE BODY | 1295 |   AS
 dbms_metadata | PACKAGE BODY | 1296 |   DECLARE
 dbms_metadata | PACKAGE BODY | 1297 |     CURSOR mycur FOR
 dbms_metadata | PACKAGE BODY | 1298 |     SELECT c.oid, c.relowner FROM pg_class c, pg_catalog.pg_namespace n
 dbms_metadata | PACKAGE BODY | 1299 |     WHERE c.relname = OBJNAME
 dbms_metadata | PACKAGE BODY | 1300 |     AND c.relkind = 'S'
 dbms_metadata | PACKAGE BODY | 1301 |     AND n.nspname = SCHEMA
 dbms_metadata | PACKAGE BODY | 1302 |     AND n.oid = c.relnamespace;
 dbms_metadata | PACKAGE BODY | 1303 | 
 dbms_metadata | PACKAGE BODY | 1304 |     objtoid      OID;
 dbms_metadata | PACKAGE BODY | 1305 |     retddl       TEXT;
 dbms_metadata | PACKAGE BODY | 1306 |     result       RECORD;
 dbms_metadata | PACKAGE BODY | 1307 |         seq_record       RECORD;
 dbms_metadata | PACKAGE BODY | 1308 |     stmt         TEXT;
 dbms_metadata | PACKAGE BODY | 1309 | 
 dbms_metadata | PACKAGE BODY | 1310 |     obj_owneroid  OID;
 dbms_metadata | PACKAGE BODY | 1311 |         uppername        VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1312 |         lowername    VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1313 |         upperschema  VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1314 |         lowerschema  VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1315 |         objectname   VARCHAR2(63);
 dbms_metadata | PACKAGE BODY | 1316 |         schemaname   VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1317 |   BEGIN
 dbms_metadata | PACKAGE BODY | 1318 |     OPEN mycur;
 dbms_metadata | PACKAGE BODY | 1319 |     FETCH mycur INTO objtoid, obj_owneroid;
 dbms_metadata | PACKAGE BODY | 1320 |     IF mycur%NOTFOUND THEN
 dbms_metadata | PACKAGE BODY | 1321 |           CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1322 |       RAISE EXCEPTION 'OBJECT % DOES NOT EXIST!', OBJNAME;
 dbms_metadata | PACKAGE BODY | 1323 |     ELSE
 dbms_metadata | PACKAGE BODY | 1324 |       IF(DBMS_METADATA.CHECK_PRIVILEGE(obj_owneroid) = FALSE) THEN
 dbms_metadata | PACKAGE BODY | 1325 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1326 |         RAISE EXCEPTION 'PERMISSION DENIED FOR OBJECT %! MUST BE OWNER OR DBA!',OBJNAME;
 dbms_metadata | PACKAGE BODY | 1327 |       END IF;
 dbms_metadata | PACKAGE BODY | 1328 |     END IF;
 dbms_metadata | PACKAGE BODY | 1329 | 
 dbms_metadata | PACKAGE BODY | 1330 |     IF SCHEMA LIKE 'pg_TEMP_%' THEN
 dbms_metadata | PACKAGE BODY | 1331 |       retddl := 'CREATE TEMPORARY SEQUENCE '||'"'||GET_OBJNAME(OBJNAME)||'"'||chr(10);
 dbms_metadata | PACKAGE BODY | 1332 |     ELSE
 dbms_metadata | PACKAGE BODY | 1333 |       retddl := 'CREATE SEQUENCE '||'"'||GET_OBJNAME(SCHEMA)||'"'||'.'||'"'||GET_OBJNAME(OBJNAME)||'"'||chr(10);
 dbms_metadata | PACKAGE BODY | 1334 |     END IF;
 dbms_metadata | PACKAGE BODY | 1335 | 
 dbms_metadata | PACKAGE BODY | 1336 |         uppername = UPPER(OBJNAME);
 dbms_metadata | PACKAGE BODY | 1337 |         lowername = LOWER(OBJNAME);
 dbms_metadata | PACKAGE BODY | 1338 |         IF OBJNAME = uppername THEN
 dbms_metadata | PACKAGE BODY | 1339 |            objectname =  lowername;
 dbms_metadata | PACKAGE BODY | 1340 |         ELSE
 dbms_metadata | PACKAGE BODY | 1341 |           IF OBJNAME = lowername THEN
 dbms_metadata | PACKAGE BODY | 1342 |              objectname =  uppername;
 dbms_metadata | PACKAGE BODY | 1343 |           END IF;
 dbms_metadata | PACKAGE BODY | 1344 |         END IF;
 dbms_metadata | PACKAGE BODY | 1345 | 
 dbms_metadata | PACKAGE BODY | 1346 |         upperschema = UPPER(SCHEMA);
 dbms_metadata | PACKAGE BODY | 1347 |         lowerschema = LOWER(SCHEMA);
 dbms_metadata | PACKAGE BODY | 1348 |     IF SCHEMA = upperschema THEN
 dbms_metadata | PACKAGE BODY | 1349 |           schemaname =  lowerschema;
 dbms_metadata | PACKAGE BODY | 1350 |         ELSE
 dbms_metadata | PACKAGE BODY | 1351 |           IF SCHEMA = lowerschema THEN
 dbms_metadata | PACKAGE BODY | 1352 |             schemaname =  upperschema;
 dbms_metadata | PACKAGE BODY | 1353 |           END IF;
 dbms_metadata | PACKAGE BODY | 1354 |         END IF;
 dbms_metadata | PACKAGE BODY | 1355 | 
 dbms_metadata | PACKAGE BODY | 1356 |     stmt := 'SELECT * FROM '||'"'||schemaname||'" '||'.'|| '"'||objectname||'" ';
 dbms_metadata | PACKAGE BODY | 1357 |     EXECUTE stmt INTO result;
 dbms_metadata | PACKAGE BODY | 1358 | 
 dbms_metadata | PACKAGE BODY | 1359 |         stmt := 'SELECT * FROM pg_sequence where seqrelid =' || objtoid;
 dbms_metadata | PACKAGE BODY | 1360 | 
 dbms_metadata | PACKAGE BODY | 1361 |         EXECUTE stmt INTO seq_record;
 dbms_metadata | PACKAGE BODY | 1362 |     retddl := retddl ||' MINVALUE '||seq_record.seqmin||' MAXVALUE '||seq_record.seqmax;
 dbms_metadata | PACKAGE BODY | 1363 |     retddl := retddl ||' INCREMENT BY '||seq_record.seqincrement ||chr(10);
 dbms_metadata | PACKAGE BODY | 1364 | 
 dbms_metadata | PACKAGE BODY | 1365 |     IF result.is_called THEN
 dbms_metadata | PACKAGE BODY | 1366 |       retddl := retddl ||'START WITH '||result.last_value + seq_record.seqincrement ||' CACHE '||seq_record.seqcache;
 dbms_metadata | PACKAGE BODY | 1367 |     ELSE
 dbms_metadata | PACKAGE BODY | 1368 |       retddl := retddl ||'START WITH '||seq_record.seqstart ||' CACHE '||seq_record.seqcache;
 dbms_metadata | PACKAGE BODY | 1369 |     END IF;
 dbms_metadata | PACKAGE BODY | 1370 | 
 dbms_metadata | PACKAGE BODY | 1371 |     IF seq_record.seqcycle THEN
 dbms_metadata | PACKAGE BODY | 1372 |       retddl := retddl || ' CYCLE '||chr(10);
 dbms_metadata | PACKAGE BODY | 1373 |     ELSE
 dbms_metadata | PACKAGE BODY | 1374 |       retddl := retddl || ' NOCYCLE '||chr(10);
 dbms_metadata | PACKAGE BODY | 1375 |     END IF;
 dbms_metadata | PACKAGE BODY | 1376 | 
 dbms_metadata | PACKAGE BODY | 1377 |     retddl := retddl || 'NOORDER NOKEEP NOSCALE;'||chr(10);
 dbms_metadata | PACKAGE BODY | 1378 | 
 dbms_metadata | PACKAGE BODY | 1379 |     CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1380 |     RETURN retddl;
 dbms_metadata | PACKAGE BODY | 1381 |   EXCEPTION
 dbms_metadata | PACKAGE BODY | 1382 |     WHEN OTHERS THEN
 dbms_metadata | PACKAGE BODY | 1383 |       IF mycur%ISOPEN THEN
 dbms_metadata | PACKAGE BODY | 1384 |             CLOSE mycur;
 dbms_metadata | PACKAGE BODY | 1385 |       END IF;
 dbms_metadata | PACKAGE BODY | 1386 |       RAISE;
 dbms_metadata | PACKAGE BODY | 1387 |   END;
 dbms_metadata | PACKAGE BODY | 1388 | 
 dbms_metadata | PACKAGE BODY | 1389 |   FUNCTION GET_DDL(OBJTYPE VARCHAR2(63), OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63) DEFAULT NULL, MODEL VARCHAR2(63) DEFAULT NULL, VERSION VARCHAR2(63) DEFAULT NULL, TRANSFORM VARCHAR2(63) DEFAULT NULL) 
 dbms_metadata | PACKAGE BODY | 1390 |   RETURN CLOB IS
 dbms_metadata | PACKAGE BODY | 1391 |     ddl          CLOB;
 dbms_metadata | PACKAGE BODY | 1392 |     SCHNAME      VARCHAR2(63);
 dbms_metadata | PACKAGE BODY | 1393 |         username         VARCHAR2(63);
 dbms_metadata | PACKAGE BODY | 1394 |         uppername        VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1395 |         lowername    VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1396 |         upperschema  VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1397 |         lowerschema  VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1398 |         objectname      VARCHAR(63);
 dbms_metadata | PACKAGE BODY | 1399 |   BEGIN
 dbms_metadata | PACKAGE BODY | 1400 |     IF SCHEMA IS NULL THEN
 dbms_metadata | PACKAGE BODY | 1401 |            SELECT current_user INTO username;
 dbms_metadata | PACKAGE BODY | 1402 |            IF username = 'sys'OR username = 'system' THEN
 dbms_metadata | PACKAGE BODY | 1403 |              SCHNAME = 'public';
 dbms_metadata | PACKAGE BODY | 1404 |            ELSEIF is_supper_user(username) THEN
 dbms_metadata | PACKAGE BODY | 1405 |              SCHNAME = 'public';
 dbms_metadata | PACKAGE BODY | 1406 |            ELSE
 dbms_metadata | PACKAGE BODY | 1407 |                  SELECT current_schema INTO SCHNAME;
 dbms_metadata | PACKAGE BODY | 1408 |            END IF;
 dbms_metadata | PACKAGE BODY | 1409 |     ELSE
 dbms_metadata | PACKAGE BODY | 1410 |       SCHNAME := SCHEMA;
 dbms_metadata | PACKAGE BODY | 1411 |           upperschema = UPPER(SCHNAME);
 dbms_metadata | PACKAGE BODY | 1412 |           lowerschema = LOWER(SCHNAME);
 dbms_metadata | PACKAGE BODY | 1413 |       IF SCHNAME = upperschema THEN
 dbms_metadata | PACKAGE BODY | 1414 |             SCHNAME =  lowerschema;
 dbms_metadata | PACKAGE BODY | 1415 |           ELSE
 dbms_metadata | PACKAGE BODY | 1416 |             IF SCHNAME = lowerschema THEN
 dbms_metadata | PACKAGE BODY | 1417 |               SCHNAME =  upperschema;
 dbms_metadata | PACKAGE BODY | 1418 |              END IF;
 dbms_metadata | PACKAGE BODY | 1419 |           END IF;
 dbms_metadata | PACKAGE BODY | 1420 |     END IF;
 dbms_metadata | PACKAGE BODY | 1421 | 
 dbms_metadata | PACKAGE BODY | 1422 |         uppername = UPPER(OBJNAME);
 dbms_metadata | PACKAGE BODY | 1423 |         lowername = LOWER(OBJNAME);
 dbms_metadata | PACKAGE BODY | 1424 |         IF OBJNAME = uppername THEN
 dbms_metadata | PACKAGE BODY | 1425 |            objectname =  lowername;
 dbms_metadata | PACKAGE BODY | 1426 |         ELSE
 dbms_metadata | PACKAGE BODY | 1427 |           IF OBJNAME = lowername THEN
 dbms_metadata | PACKAGE BODY | 1428 |              objectname =  uppername;
 dbms_metadata | PACKAGE BODY | 1429 |           END IF;
 dbms_metadata | PACKAGE BODY | 1430 |         END IF;
 dbms_metadata | PACKAGE BODY | 1431 | 
 dbms_metadata | PACKAGE BODY | 1432 |     CASE
 dbms_metadata | PACKAGE BODY | 1433 |     WHEN  OBJTYPE = 'VIEW' THEN
 dbms_metadata | PACKAGE BODY | 1434 |       ddl := DBMS_METADATA.GET_VIEW_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1435 |         WHEN  OBJTYPE = 'FUNCTION' THEN
 dbms_metadata | PACKAGE BODY | 1436 |       ddl := DBMS_METADATA.GET_FUNC_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1437 |     WHEN  OBJTYPE = 'PROCEDURE' THEN
 dbms_metadata | PACKAGE BODY | 1438 |       ddl := DBMS_METADATA.GET_PROCEDURE_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1439 |     WHEN  OBJTYPE = 'TRIGGER' THEN
 dbms_metadata | PACKAGE BODY | 1440 |       ddl := DBMS_METADATA.GET_TRIGGER_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1441 |     WHEN OBJTYPE = 'TABLESPACE' THEN
 dbms_metadata | PACKAGE BODY | 1442 |       ddl := DBMS_METADATA.GET_TABLESPACE_DDL(objectname, SCHEMA);
 dbms_metadata | PACKAGE BODY | 1443 |     WHEN OBJTYPE = 'INDEX' THEN
 dbms_metadata | PACKAGE BODY | 1444 |       ddl := DBMS_METADATA.GET_INDEX_DDL(objectname, SCHNAME);  
 dbms_metadata | PACKAGE BODY | 1445 |     WHEN OBJTYPE = 'CONSTRAINT' THEN
 dbms_metadata | PACKAGE BODY | 1446 |       ddl := DBMS_METADATA.GET_CONSTRAINT_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1447 |     WHEN OBJTYPE = 'REF_CONSTRAINT' THEN
 dbms_metadata | PACKAGE BODY | 1448 |       ddl := DBMS_METADATA.GET_REF_CONSTRAINT_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1449 |     WHEN OBJTYPE = 'SEQUENCE' THEN
 dbms_metadata | PACKAGE BODY | 1450 |       ddl := DBMS_METADATA.GET_SEQUENCE_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1451 |     WHEN  OBJTYPE = 'TABLE' THEN
 dbms_metadata | PACKAGE BODY | 1452 |       ddl := DBMS_METADATA.GET_TABLE_DDL(objectname, SCHNAME, NULL);      
 dbms_metadata | PACKAGE BODY | 1453 |     WHEN OBJTYPE = 'PACKAGE' THEN
 dbms_metadata | PACKAGE BODY | 1454 |       ddl := DBMS_METADATA.GET_PACKAGE_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1455 |     WHEN OBJTYPE = 'PACKAGE_BODY' THEN
 dbms_metadata | PACKAGE BODY | 1456 |       ddl := DBMS_METADATA.GET_PACKAGE_BODY_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1457 |     WHEN OBJTYPE = 'DB_LINK' THEN
 dbms_metadata | PACKAGE BODY | 1458 |       ddl := DBMS_METADATA.GET_DBLINK_DDL(objectname, SCHNAME);
 dbms_metadata | PACKAGE BODY | 1459 |     ELSE
 dbms_metadata | PACKAGE BODY | 1460 |       RAISE EXCEPTION 'INVALID INPUT VALUE % IN FUNCTION DBMS_METADATA.GET_DDL', OBJTYPE;
 dbms_metadata | PACKAGE BODY | 1461 |     END CASE;
 dbms_metadata | PACKAGE BODY | 1462 |     RETURN ddl;
 dbms_metadata | PACKAGE BODY | 1463 |   END;
 dbms_metadata | PACKAGE BODY | 1464 | END;
 dbms_random   | PACKAGE      | 1    | PACKAGE dbms_random IS
 dbms_random   | PACKAGE      | 2    | 
 dbms_random   | PACKAGE      | 3    |     PROCEDURE INITIALIZE (
 dbms_random   | PACKAGE      | 4    |         val IN INTEGER
