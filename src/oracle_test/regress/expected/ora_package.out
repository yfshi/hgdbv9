--test LOOP
create or replace package test_complex_package IS
  type mds is record(id integer,name varchar2(256));
  gvar mds;
  function test_f(var1 mds default gvar) return mds;
  function change_gvar(id integer,name varchar2) return integer;
  function return_id(id integer default gvar.id) return integer;
end;
/
create or replace package body test_complex_package IS
 function test_f(var1 mds default gvar) return mds IS
 BEGIN
	return var1;
 end;
 function change_gvar(id integer,name varchar2) return integer IS
 BEGIN
   gvar.id := id;
   gvar.name := name;
   return id;
 end;
 function return_id(id integer default gvar.id) return integer is
 begin
	return id;
 end;
BEGIN
  gvar.id := 1;
  gvar.name := 'welcome';
end;
/
create or replace function test_complex_f(id integer,var1 test_complex_package.mds default test_complex_package.gvar) return test_complex_package.mds IS
BEGIN
    var1.id := var1.id + 1;
	return var1;
end;
/
create table test_mds(id integer primary key,name varchar2(256));
DECLARE
  var1 integer;
  var2 varchar2(256);
BEGIN
 for var1 in 1 .. 10 LOOP
    var2 := var1 || ' yy';
    insert into test_mds values(var1, var2);
 end loop;
end;
/
select test_complex_package.change_gvar(id,name), test_complex_package.test_f,test_complex_f(id) from test_mds order by id;
 change_gvar |    test_f    | test_complex_f 
-------------+--------------+----------------
           1 | (1,"1 yy")   | (2,"1 yy")
           2 | (2,"2 yy")   | (3,"2 yy")
           3 | (3,"3 yy")   | (4,"3 yy")
           4 | (4,"4 yy")   | (5,"4 yy")
           5 | (5,"5 yy")   | (6,"5 yy")
           6 | (6,"6 yy")   | (7,"6 yy")
           7 | (7,"7 yy")   | (8,"7 yy")
           8 | (8,"8 yy")   | (9,"8 yy")
           9 | (9,"9 yy")   | (10,"9 yy")
          10 | (10,"10 yy") | (11,"10 yy")
(10 rows)

create or replace function test_complex_ff(id integer default test_complex_package.gvar.id) return integer IS
BEGIN
	return id;
end;
/
create view test_complex_view as
select test_complex_package.change_gvar(id,name),test_complex_package.return_id,test_complex_ff from test_mds order by id;
create view test_complex_view1 as
select test_complex_package.change_gvar(id,name),test_complex_package.return_id,test_complex_ff from test_mds where id = test_complex_ff() order by id;
create view test_complex_view2 as
select test_complex_package.change_gvar(id,name),test_complex_package.return_id,test_complex_ff  from test_mds where id = test_complex_package.return_id order by id;
select  * from test_complex_view;
