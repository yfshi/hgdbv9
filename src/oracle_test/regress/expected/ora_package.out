 dbms_random   | PACKAGE BODY | 1    | PACKAGE BODY dbms_random IS
 dbms_random   | PACKAGE BODY | 2    | 
 dbms_random   | PACKAGE BODY | 3    | 
 dbms_random   | PACKAGE BODY | 4    | PROCEDURE INITIALIZE (
 dbms_random   | PACKAGE BODY | 5    |     val IN INTEGER
 dbms_random   | PACKAGE BODY | 6    | ) IS
 dbms_random   | PACKAGE BODY | 7    | BEGIN
 dbms_random   | PACKAGE BODY | 8    |     select setseed(val);
 dbms_random   | PACKAGE BODY | 9    | END INITIALIZE;
 dbms_random   | PACKAGE BODY | 10   | 
 dbms_random   | PACKAGE BODY | 11   | FUNCTION NORMAL RETURN NUMBER IS
 dbms_random   | PACKAGE BODY | 12   | BEGIN
 dbms_random   | PACKAGE BODY | 13   |     RETURN pg_catalog.random();
