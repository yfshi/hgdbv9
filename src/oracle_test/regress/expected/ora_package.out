 dbms_metadata | PACKAGE      | 18   |   FUNCTION GET_DBLINK_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT;
 dbms_metadata | PACKAGE      | 19   |   FUNCTION GET_SEQUENCE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT;
