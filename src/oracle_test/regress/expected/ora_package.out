 dbms_job      | PACKAGE BODY | 268  |     job IN INTEGER,
 dbms_job      | PACKAGE BODY | 269  |     what IN VARCHAR2
 dbms_job      | PACKAGE BODY | 270  | ) IS
 dbms_job      | PACKAGE BODY | 271  | BEGIN
 dbms_job      | PACKAGE BODY | 272  |   /* BEGIN - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 273  |   sys.what(job,
 dbms_job      | PACKAGE BODY | 274  |            what);
 dbms_job      | PACKAGE BODY | 275  |   /* END - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 276  | END what;
 dbms_job      | PACKAGE BODY | 277  | 
 dbms_job      | PACKAGE BODY | 278  | 
 dbms_job      | PACKAGE BODY | 279  | 
 dbms_job      | PACKAGE BODY | 280  | 
 dbms_job      | PACKAGE BODY | 281  | PROCEDURE isubmit(
 dbms_job      | PACKAGE BODY | 282  |     job IN INTEGER,
 dbms_job      | PACKAGE BODY | 283  |     what IN VARCHAR2,
 dbms_job      | PACKAGE BODY | 284  |     next_date IN DATE,
 dbms_job      | PACKAGE BODY | 285  |     interval IN VARCHAR2 DEFAULT 'null',
 dbms_job      | PACKAGE BODY | 286  |     no_parse IN BOOLEAN DEFAULT FALSE
 dbms_job      | PACKAGE BODY | 287  | ) IS
 dbms_job      | PACKAGE BODY | 288  |     
 dbms_job      | PACKAGE BODY | 289  |     current_database_name VARCHAR2(128);
 dbms_job      | PACKAGE BODY | 290  |     current_user_varchar VARCHAR2(128);
 dbms_job      | PACKAGE BODY | 291  |     client_encoding_varchar VARCHAR2(100);
 dbms_job      | PACKAGE BODY | 292  |     lc_collate_varchar VARCHAR2(100);
 dbms_job      | PACKAGE BODY | 293  |     datestyle_varchar VARCHAR2(100);
 dbms_job      | PACKAGE BODY | 294  |     nls_env_varchar VARCHAR2(300);
 dbms_job      | PACKAGE BODY | 295  |     
 dbms_job      | PACKAGE BODY | 296  |     ivorysql_enable_emptystring_to_null_varchar text;
 dbms_job      | PACKAGE BODY | 297  |     next_date_to_text text;
 dbms_job      | PACKAGE BODY | 298  | 
 dbms_job      | PACKAGE BODY | 299  |     result_datetime pg_catalog.timestamptz;
 dbms_job      | PACKAGE BODY | 300  |     has_keyword BOOLEAN;
 dbms_job      | PACKAGE BODY | 301  |     now_future BOOLEAN := FALSE;
 dbms_job      | PACKAGE BODY | 302  |     interval_expression_jobenabled BOOLEAN := TRUE;
 dbms_job      | PACKAGE BODY | 303  |     interval_expression_failures INTEGER := 0;
 dbms_job      | PACKAGE BODY | 304  |     fixed_sysdate TIMESTAMP;    
 dbms_job      | PACKAGE BODY | 305  | BEGIN
 dbms_job      | PACKAGE BODY | 306  |     set nls_date_format='YYYY-MM-DD HH24:MI:SS';
 dbms_job      | PACKAGE BODY | 307  |     fixed_sysdate := sysdate;
 dbms_job      | PACKAGE BODY | 308  | 
 dbms_job      | PACKAGE BODY | 309  |     IF next_date >= fixed_sysdate THEN
 dbms_job      | PACKAGE BODY | 310  |         now_future := TRUE;
 dbms_job      | PACKAGE BODY | 311  |     END IF;
 dbms_job      | PACKAGE BODY | 312  | 
 dbms_job      | PACKAGE BODY | 313  |     SELECT current_user INTO current_user_varchar;
 dbms_job      | PACKAGE BODY | 314  |     SELECT current_database() INTO current_database_name;
 dbms_job      | PACKAGE BODY | 315  |     SELECT current_setting('client_encoding') INTO client_encoding_varchar;
 dbms_job      | PACKAGE BODY | 316  |     SELECT current_setting('lc_collate') INTO lc_collate_varchar;
 dbms_job      | PACKAGE BODY | 317  |     SELECT current_setting('datestyle') INTO datestyle_varchar;
 dbms_job      | PACKAGE BODY | 318  | 
 dbms_job      | PACKAGE BODY | 319  |     nls_env_varchar := 'client_encoding: ' || current_setting('client_encoding') || ', lc_collate: ' || current_setting('lc_collate') || ', datestyle: ' || current_setting('datestyle');
 dbms_job      | PACKAGE BODY | 320  | 
 dbms_job      | PACKAGE BODY | 321  | 
 dbms_job      | PACKAGE BODY | 322  |     SELECT current_setting('ivorysql.enable_emptystring_to_null') INTO ivorysql_enable_emptystring_to_null_varchar;
 dbms_job      | PACKAGE BODY | 323  |         
 dbms_job      | PACKAGE BODY | 324  |     SELECT TO_CHAR(next_date, 'YYYY-MM-DD HH24:MI:SS') INTO next_date_to_text;
 dbms_job      | PACKAGE BODY | 325  | 
 dbms_job      | PACKAGE BODY | 326  |     set ivorysql.enable_emptystring_to_null=off;
 dbms_job      | PACKAGE BODY | 327  | 
 dbms_job      | PACKAGE BODY | 328  |     has_keyword := interval::text ILIKE '%FREQ%' OR 
 dbms_job      | PACKAGE BODY | 329  |                    interval::text ILIKE '%INTERVAL%' OR
 dbms_job      | PACKAGE BODY | 330  |                    interval::text ILIKE '%ByMONTH%' OR
 dbms_job      | PACKAGE BODY | 331  |                    interval::text ILIKE '%BYMONTHDAY%' OR
 dbms_job      | PACKAGE BODY | 332  |                    interval::text ILIKE '%BYHOUR%' OR
 dbms_job      | PACKAGE BODY | 333  |                    interval::text ILIKE '%BYMINUTE%' OR
 dbms_job      | PACKAGE BODY | 334  |                    interval::text ILIKE '%BYSECOND%';
 dbms_job      | PACKAGE BODY | 335  | 
 dbms_job      | PACKAGE BODY | 336  |     IF has_keyword THEN
 dbms_job      | PACKAGE BODY | 337  |         IF now_future THEN
 dbms_job      | PACKAGE BODY | 338  |             result_datetime := evaluate_calendar_string(interval::text, next_date_to_text::timestamp, next_date_to_text::timestamp, true);
 dbms_job      | PACKAGE BODY | 339  |         ELSE
 dbms_job      | PACKAGE BODY | 340  |             result_datetime := evaluate_calendar_string(interval::text, next_date_to_text::timestamp, NULL, true);
 dbms_job      | PACKAGE BODY | 341  |         END IF;    
 dbms_job      | PACKAGE BODY | 342  | 
 dbms_job      | PACKAGE BODY | 343  |             /* BEGIN - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 344  |             /*
 dbms_job      | PACKAGE BODY | 345  |              * call sys.insert_pgagent_tables2 procedure to operator the tables in schema pgagent.
 dbms_job      | PACKAGE BODY | 346  |              * because sys.insert_pgagent_tables is runed with the Owner rights (DEFINER), if a user
 dbms_job      | PACKAGE BODY | 347  |              * call the package dbms_job to create a job, the user can't operator the objects
 dbms_job      | PACKAGE BODY | 348  |              * in schema pgagent.
 dbms_job      | PACKAGE BODY | 349  |              */
 dbms_job      | PACKAGE BODY | 350  |         sys.insert_pgagent_tables2(true,
 dbms_job      | PACKAGE BODY | 351  |                                          result_datetime::pg_catalog.timestamptz,
 dbms_job      | PACKAGE BODY | 352  |                                          no_parse,
 dbms_job      | PACKAGE BODY | 353  |                                          current_user_varchar,
 dbms_job      | PACKAGE BODY | 354  |                                          0,
 dbms_job      | PACKAGE BODY | 355  |                                          nls_env_varchar,
 dbms_job      | PACKAGE BODY | 356  |                                                                  what,
 dbms_job      | PACKAGE BODY | 357  |                                                                  current_database_name,
 dbms_job      | PACKAGE BODY | 358  |                                                                  interval,
 dbms_job      | PACKAGE BODY | 359  |                                                                  true,
 dbms_job      | PACKAGE BODY | 360  |                                                                  NULL,
 dbms_job      | PACKAGE BODY | 361  |                                                                  true,
 dbms_job      | PACKAGE BODY | 362  |                                                                  job);
 dbms_job      | PACKAGE BODY | 363  |         /* END - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 364  |     ELSE
 dbms_job      | PACKAGE BODY | 365  | 
 dbms_job      | PACKAGE BODY | 366  |         BEGIN
 dbms_job      | PACKAGE BODY | 367  | 
 dbms_job      | PACKAGE BODY | 368  |             result_datetime := sys.evaluate_next_schedule_expression(interval::text);
 dbms_job      | PACKAGE BODY | 369  |         EXCEPTION
 dbms_job      | PACKAGE BODY | 370  |             WHEN others THEN
 dbms_job      | PACKAGE BODY | 371  |                 
 dbms_job      | PACKAGE BODY | 372  |             RAISE EXCEPTION 'IVY-27465: invalid value %s for attribute REPEAT_INTERVAL',interval;
 dbms_job      | PACKAGE BODY | 373  |         END;
 dbms_job      | PACKAGE BODY | 374  | 
 dbms_job      | PACKAGE BODY | 375  |         IF result_datetime <= fixed_sysdate THEN
 dbms_job      | PACKAGE BODY | 376  |             interval_expression_jobenabled := false;
 dbms_job      | PACKAGE BODY | 377  |             interval_expression_failures := 1;
 dbms_job      | PACKAGE BODY | 378  |         END IF;
 dbms_job      | PACKAGE BODY | 379  | 
 dbms_job      | PACKAGE BODY | 380  |         IF now_future THEN
 dbms_job      | PACKAGE BODY | 381  |             result_datetime  := next_date::timestamp;
 dbms_job      | PACKAGE BODY | 382  |         END IF;
 dbms_job      | PACKAGE BODY | 383  | 
 dbms_job      | PACKAGE BODY | 384  |             /* BEGIN - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 385  |             /*
 dbms_job      | PACKAGE BODY | 386  |              * call sys.insert_pgagent_tables2 procedure to operator the tables in schema pgagent.
 dbms_job      | PACKAGE BODY | 387  |              * because sys.insert_pgagent_tables is runed with the Owner rights (DEFINER), if a user
 dbms_job      | PACKAGE BODY | 388  |              * call the package dbms_job to create a job, the user can't operator the objects
 dbms_job      | PACKAGE BODY | 389  |              * in schema pgagent.
 dbms_job      | PACKAGE BODY | 390  |              */
 dbms_job      | PACKAGE BODY | 391  |         sys.insert_pgagent_tables2(interval_expression_jobenabled,
 dbms_job      | PACKAGE BODY | 392  |                                          result_datetime::pg_catalog.timestamptz,
 dbms_job      | PACKAGE BODY | 393  |                                          no_parse,
 dbms_job      | PACKAGE BODY | 394  |                                          current_user_varchar,
 dbms_job      | PACKAGE BODY | 395  |                                          interval_expression_failures,
 dbms_job      | PACKAGE BODY | 396  |                                          nls_env_varchar,
 dbms_job      | PACKAGE BODY | 397  |                                                                  what,
 dbms_job      | PACKAGE BODY | 398  |                                                                  current_database_name,
 dbms_job      | PACKAGE BODY | 399  |                                                                  interval,
 dbms_job      | PACKAGE BODY | 400  |                                                                  next_date::text::pg_catalog.timestamptz,
 dbms_job      | PACKAGE BODY | 401  |                                                                  false,
 dbms_job      | PACKAGE BODY | 402  |                                                                  job);
 dbms_job      | PACKAGE BODY | 403  |         /* END - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 404  |     END IF;
 dbms_job      | PACKAGE BODY | 405  | 
 dbms_job      | PACKAGE BODY | 406  |     EXECUTE 'SET ivorysql.enable_emptystring_to_null = ' || quote_literal(ivorysql_enable_emptystring_to_null_varchar);
 dbms_job      | PACKAGE BODY | 407  |     
 dbms_job      | PACKAGE BODY | 408  | END isubmit;
 dbms_job      | PACKAGE BODY | 409  | 
 dbms_job      | PACKAGE BODY | 410  | 
 dbms_job      | PACKAGE BODY | 411  | 
 dbms_job      | PACKAGE BODY | 412  | PROCEDURE user_export (
 dbms_job      | PACKAGE BODY | 413  |     job IN INTEGER,
 dbms_job      | PACKAGE BODY | 414  |     mycall IN OUT VARCHAR2
 dbms_job      | PACKAGE BODY | 415  | ) IS
 dbms_job      | PACKAGE BODY | 416  |     v_what VARCHAR2(4000);
 dbms_job      | PACKAGE BODY | 417  |     v_next_date VARCHAR2(100);
 dbms_job      | PACKAGE BODY | 418  |     v_interval VARCHAR2(100);
 dbms_job      | PACKAGE BODY | 419  |     v_no_parse VARCHAR2(10);
 dbms_job      | PACKAGE BODY | 420  |     v_job_count NUMBER;
 dbms_job      | PACKAGE BODY | 421  | BEGIN
 dbms_job      | PACKAGE BODY | 422  |   /* BEGIN - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 423  |   sys.user_export(job,
 dbms_job      | PACKAGE BODY | 424  |                   mycall);
 dbms_job      | PACKAGE BODY | 425  |   /* END - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 426  | END user_export;
 dbms_job      | PACKAGE BODY | 427  | 
 dbms_job      | PACKAGE BODY | 428  | 
 dbms_job      | PACKAGE BODY | 429  | 
 dbms_job      | PACKAGE BODY | 430  | PROCEDURE user_export (
 dbms_job      | PACKAGE BODY | 431  |     job IN INTEGER,
 dbms_job      | PACKAGE BODY | 432  |     mycall IN OUT VARCHAR2,
 dbms_job      | PACKAGE BODY | 433  |     myinst IN OUT VARCHAR2
 dbms_job      | PACKAGE BODY | 434  | ) IS
 dbms_job      | PACKAGE BODY | 435  | BEGIN
 dbms_job      | PACKAGE BODY | 436  |   /* BEGIN - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 437  |   sys.user_export(job,
 dbms_job      | PACKAGE BODY | 438  |                   mycall,
 dbms_job      | PACKAGE BODY | 439  |                           myinst);
 dbms_job      | PACKAGE BODY | 440  |   /* END - BUG#M0000412 */
 dbms_job      | PACKAGE BODY | 441  | END user_export;
 dbms_job      | PACKAGE BODY | 442  | 
 dbms_job      | PACKAGE BODY | 443  | END;
 dbms_standard | PACKAGE      | 1    | PACKAGE dbms_standard IS
 dbms_standard | PACKAGE      | 2    | 
 dbms_standard | PACKAGE      | 3    |          procedure raise_application_error(num integer, msg varchar2,
 dbms_standard | PACKAGE      | 4    |       keeperrorstack boolean default FALSE);
 dbms_standard | PACKAGE      | 5    | end;
 dbms_standard | PACKAGE BODY | 1    | PACKAGE BODY dbms_standard IS
 dbms_standard | PACKAGE BODY | 2    | 
 dbms_standard | PACKAGE BODY | 3    |          procedure raise_application_error(num integer, msg varchar2,
 dbms_standard | PACKAGE BODY | 4    |       keeperrorstack boolean default FALSE) IS
 dbms_standard | PACKAGE BODY | 5    |          BEGIN
 dbms_standard | PACKAGE BODY | 6    |                 -- num valid is -20000 and -20999
 dbms_standard | PACKAGE BODY | 7    |                 IF (num < -20999 or num > -20000) then
 dbms_standard | PACKAGE BODY | 8    |                         plisql_raise_application_error(-21000, 'IVY-21000: error number argument to raise_application_error of ' || num || ' is out of range', false);
 dbms_standard | PACKAGE BODY | 9    |                 else
 dbms_standard | PACKAGE BODY | 10   |                         plisql_raise_application_error(num, msg, keeperrorstack);
 dbms_standard | PACKAGE BODY | 11   |                 END if;
 dbms_standard | PACKAGE BODY | 12   |          end;
 dbms_standard | PACKAGE BODY | 13   | end;
