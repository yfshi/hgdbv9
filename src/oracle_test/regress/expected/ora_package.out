 dbms_standard | PACKAGE      | 1    | PACKAGE dbms_standard IS
 dbms_standard | PACKAGE      | 2    | 
 dbms_standard | PACKAGE      | 3    |          procedure raise_application_error(num integer, msg varchar2,
 dbms_standard | PACKAGE      | 4    |       keeperrorstack boolean default FALSE);
 dbms_standard | PACKAGE      | 5    | end;
 dbms_standard | PACKAGE BODY | 1    | PACKAGE BODY dbms_standard IS
 dbms_standard | PACKAGE BODY | 2    | 
 dbms_standard | PACKAGE BODY | 3    |          procedure raise_application_error(num integer, msg varchar2,
 dbms_standard | PACKAGE BODY | 4    |       keeperrorstack boolean default FALSE) IS
 dbms_standard | PACKAGE BODY | 5    |          BEGIN
 dbms_standard | PACKAGE BODY | 6    |                 -- num valid is -20000 and -20999
 dbms_standard | PACKAGE BODY | 7    |                 IF (num < -20999 or num > -20000) then
 dbms_standard | PACKAGE BODY | 8    |                         plisql_raise_application_error(-21000, 'IVY-21000: error number argument to raise_application_error of ' || num || ' is out of range', false);
 dbms_standard | PACKAGE BODY | 9    |                 else
 dbms_standard | PACKAGE BODY | 10   |                         plisql_raise_application_error(num, msg, keeperrorstack);
 dbms_standard | PACKAGE BODY | 11   |                 END if;
 dbms_standard | PACKAGE BODY | 12   |          end;
 dbms_standard | PACKAGE BODY | 13   | end;
