--test package references package
create or replace package pkg is
var1 mds%rowtype;
function test(id integer, var2 out mds%rowtype) return mds%rowtype;
end;
/
create or replace package body pkg is
 function test(id integer, var2 out mds%rowtype) return mds%rowtype is
  var3 mds%rowtype;
 begin
   var2.id := 1;
   var2.name := 'a out name';
   var3.id := var2.id + 1;
   var3.name := var2.name || 'change';
   return var3;
 end;
end;
 /
create or replace package pkg1 is
 var1 mds%rowtype;
 var2 pkg.var1%type;
 function test(id integer, var3 out mds%rowtype) return mds%rowtype;
end;
/
create or replace package body pkg1 is
  function test(id integer, var3  out mds%rowtype) return mds%rowtype is
  var4 mds%rowtype;
  begin
    var3.id := 0;
    var3.name := 'a pkg1 name';
    var4.id := var3.id + 1;
    var4.name := var3.name || 'pkg1';
    return var4;
  end;
end;
/
--invok
declare
  var1 pkg1.var1%type;
  var2 pkg.var1%type;
  var3 pkg1.var2%type;
  var4 pkg.var1%rowtype;
begin
  var4 := pkg.test(23,var2);
  var3 := pkg1.test(23,var1);
  raise info 'var2=%,var4=%',var2,var4;
  raise info 'var1=%,var3=%',var1,var3;
end;
/
INFO:  var2=(1,"a out name"),var4=(2,"a out namechange")
INFO:  var1=(0,"a pkg1 name"),var3=(1,"a pkg1 namepkg1")
--again
declare
  var1 pkg1.var1%type;
  var2 pkg.var1%type;
  var3 pkg1.var2%type;
  var4 pkg.var1%rowtype;
begin
  var4 := pkg.test(23,var2);
  var3 := pkg1.test(23,var1);
  raise info 'var2=%,var4=%',var2,var4;
  raise info 'var1=%,var3=%',var1,var3;
end;
/
INFO:  var2=(1,"a out name"),var4=(2,"a out namechange")
INFO:  var1=(0,"a pkg1 name"),var3=(1,"a pkg1 namepkg1")
