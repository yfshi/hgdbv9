 dbms_random   | PACKAGE BODY | 23   |     val IN INTEGER
 dbms_random   | PACKAGE BODY | 24   | ) IS
 dbms_random   | PACKAGE BODY | 25   | BEGIN
 dbms_random   | PACKAGE BODY | 26   |     select setseed(val);
 dbms_random   | PACKAGE BODY | 27   | END SEED;
 dbms_random   | PACKAGE BODY | 28   | 
 dbms_random   | PACKAGE BODY | 29   | PROCEDURE SEED (
 dbms_random   | PACKAGE BODY | 30   |     val IN VARCHAR2(2000)
 dbms_random   | PACKAGE BODY | 31   | ) IS
 dbms_random   | PACKAGE BODY | 32   | BEGIN
