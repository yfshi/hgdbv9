 dbms_metadata | PACKAGE      | 2    | 
 dbms_metadata | PACKAGE      | 3    |   FUNCTION GET_OBJNAME(ori_name IN VARCHAR(63)) RETURN VARCHAR(63);
 dbms_metadata | PACKAGE      | 4    |   FUNCTION CHECK_PRIVILEGE(owneroid IN OID) RETURN BOOLEAN;
 dbms_metadata | PACKAGE      | 5    |   FUNCTION is_supper_user(username IN VARCHAR2(63)) RETURN BOOLEAN;
 dbms_metadata | PACKAGE      | 6    |   FUNCTION GET_VIEW_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT;
 dbms_metadata | PACKAGE      | 7    |   FUNCTION GET_FUNC_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT;
 dbms_metadata | PACKAGE      | 8    |   FUNCTION GET_PROCEDURE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT;
 dbms_metadata | PACKAGE      | 9    |   FUNCTION GET_TRIGGER_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT;
 dbms_metadata | PACKAGE      | 10   |   FUNCTION GET_TABLESPACE_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63)) RETURN TEXT;
 dbms_metadata | PACKAGE      | 11   |   FUNCTION GET_INDEX_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT;
 dbms_metadata | PACKAGE      | 12   |   FUNCTION GET_CONSTRAINT_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT;
 dbms_metadata | PACKAGE      | 13   |   FUNCTION GET_REF_CONSTRAINT_DDL(OBJNAME VARCHAR2(63), SCHEMA VARCHAR2(63), TABOID OID DEFAULT 0) RETURN TEXT;
 dbms_metadata | PACKAGE      | 14   |   PROCEDURE GET_ATTR(TABOID IN OID, ATTRCNT IN INT, BUF OUT VARCHAR2(8000));
