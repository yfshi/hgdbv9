 dbms_metadata | PACKAGE BODY | 1459 |     ELSE
 dbms_metadata | PACKAGE BODY | 1460 |       RAISE EXCEPTION 'INVALID INPUT VALUE % IN FUNCTION DBMS_METADATA.GET_DDL', OBJTYPE;
 dbms_metadata | PACKAGE BODY | 1461 |     END CASE;
 dbms_metadata | PACKAGE BODY | 1462 |     RETURN ddl;
 dbms_metadata | PACKAGE BODY | 1463 |   END;
 dbms_metadata | PACKAGE BODY | 1464 | END;
