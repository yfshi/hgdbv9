 dbms_job      | PACKAGE BODY | 36   | 
 dbms_job      | PACKAGE BODY | 37   |     IF next_date >= fixed_sysdate THEN
 dbms_job      | PACKAGE BODY | 38   |         now_future := TRUE;
 dbms_job      | PACKAGE BODY | 39   |         result_datetime := next_date;
 dbms_job      | PACKAGE BODY | 40   |     END IF;
