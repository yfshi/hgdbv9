-- create test table, deleting partitions and subpartitions individually
CREATE TABLE TEST_COMPISE_WITH_TEMP(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY RANGE(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION TMP1 VALUES LESS THAN(20),
 SUBPARTITION TMP2 VALUES LESS THAN(30)
)
(
 PARTITION p1 VALUES LESS THAN(10) (SUBPARTITION S1 VALUES LESS THAN(20), SUBPARTITION S2 VALUES LESS THAN(30)),
 PARTITION p2 VALUES LESS THAN(20),
 PARTITION p3 VALUES LESS THAN(30) (SUBPARTITION VALUES LESS THAN(20), SUBPARTITION VALUES LESS THAN(30)),
 PARTITION VALUES LESS THAN(40),
 PARTITION VALUES LESS THAN(50)
);
SELECT partrelid::regclass, automatic, composite, seqno, interval_expr, subpart_template
 FROM pg_ora_part_tables WHERE partrelid = 'test_compise_with_temp'::regclass;
       partrelid        | automatic | composite | seqno | interval_expr |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             subpart_template                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
------------------------+-----------+-----------+-------+---------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 test_compise_with_temp | f         | t         |     5 |               | {ORASUBPARTITIONTEMPLATESPEC :subpartitons_desc ({ORAPARTITIONBOUNDSPEC :partition_name tmp1 :tablespace_name <> :bound {PARTITIONBOUNDSPEC :strategy r :is_default false :modulus 0 :remainder 0 :listdatums <> :lowerdatums <> :upperdatums ({PARTITIONRANGEDATUM :kind 0 :value {CONST :consttype 23 :consttypmod -1 :constcollid 0 :constlen 4 :constbyval true :constisnull false :location 158 :constencoding -1 :constvalue 4 [ 20 0 0 0 0 0 0 0 ]} :location 158}) :location 153} :subpart_bound <>} {ORAPARTITIONBOUNDSPEC :partition_name tmp2 :tablespace_name <> :bound {PARTITIONBOUNDSPEC :strategy r :is_default false :modulus 0 :remainder 0 :listdatums <> :lowerdatums <> :upperdatums ({PARTITIONRANGEDATUM :kind 0 :value {CONST :consttype 23 :consttypmod -1 :constcollid 0 :constlen 4 :constbyval true :constisnull false :location 199 :constencoding -1 :constvalue 4 [ 30 0 0 0 0 0 0 0 ]} :location 199}) :location 194} :subpart_bound <>}) :hash_subpartition_quantity 0}
(1 row)

