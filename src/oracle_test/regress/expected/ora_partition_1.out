--
-- add_table_partition clause
--
-- Testing some other scenarios, the issues currently being fixed.
-- sys_p1 is already explicitly occupied, so seqno will be incremented automatically.
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC
(
 PARTITION sys_p1 VALUES(1,2,3),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9),
 PARTITION VALUES(10,11)
);
