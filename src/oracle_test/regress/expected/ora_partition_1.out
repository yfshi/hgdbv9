-- a single hash subpartition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A)
SUBPARTITION  BY HASH(B)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1, SUBPARTITION S2),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION, SUBPARTITION)
);
SELECT relid, parentrelid, level, isleaf, pg_catalog.pg_get_expr(c.relpartbound, c.oid) as bound 
FROM pg_partition_tree('par_test') t, pg_class c
WHERE t.relid=c.oid;
         relid         | parentrelid | level | isleaf |                  bound                   
-----------------------+-------------+-------+--------+------------------------------------------
 par_test              |             |     0 | f      | 
 par_test_p1           | par_test    |     1 | f      | FOR VALUES IN (1, 2, 3)
 par_test_p2           | par_test    |     1 | f      | FOR VALUES IN (4, 5, 6)
 par_test_p3           | par_test    |     1 | f      | FOR VALUES IN (7, 8, 9)
 par_test_p1_s1        | par_test_p1 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 0)
 par_test_p1_s2        | par_test_p1 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 1)
 par_test_p2_sys_subp1 | par_test_p2 |     2 | t      | FOR VALUES WITH (modulus 1, remainder 0)
 par_test_p3_sys_subp2 | par_test_p3 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 0)
 par_test_p3_sys_subp3 | par_test_p3 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 1)
(9 rows)

