------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ((((a > 100) AND (a IS NOT NULL)) OR (((a = 100) AND (a IS NOT NULL)) AND ((b > 200) OR (b IS NULL))) OR (((a = 100) AND (a IS NOT NULL)) AND ((b = 200) AND (b IS NOT NULL)) AND ((c > 400) OR (c IS NULL))) OR (((a = 100) AND (a IS NOT NULL)) AND ((b = 200) AND (b IS NOT NULL)) AND ((c = 400) AND (c IS NOT NULL)) AND ((d >= 500) OR (d IS NULL)))) AND (((a < 500) AND (a IS NOT NULL)) OR (((a = 500) AND (a IS NOT NULL)) AND ((b <= 200) AND (b IS NOT NULL)))))
