-- MAXVALUE range subpatition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
SUBPARTITION  BY RANGE(B)
PARTITIONS 3;
SELECT relid, parentrelid, level, isleaf, pg_catalog.pg_get_expr(c.relpartbound, c.oid) as bound 
FROM pg_partition_tree('par_test') t, pg_class c
WHERE t.relid=c.oid;
           relid           |   parentrelid   | level | isleaf |                  bound                   
---------------------------+-----------------+-------+--------+------------------------------------------
 par_test                  |                 |     0 | f      | 
 par_test_sys_p1           | par_test        |     1 | f      | FOR VALUES WITH (modulus 3, remainder 0)
 par_test_sys_p2           | par_test        |     1 | f      | FOR VALUES WITH (modulus 3, remainder 1)
 par_test_sys_p3           | par_test        |     1 | f      | FOR VALUES WITH (modulus 3, remainder 2)
