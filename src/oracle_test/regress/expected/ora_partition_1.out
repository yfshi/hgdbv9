DROP TABLE PAR_TEST;
--
-- set_subpartition_template clause
--
-- ORA-14602: SUBPARTITION TEMPLATE is legal only for a composite partitioned table
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION P1 VALUES LESS THAN (10),
 PARTITION P2 VALUES LESS THAN (20)
);
-- error
ALTER TABLE PAR_TEST SET SUBPARTITION TEMPLATE
(
	SUBPARTITION P1_1 VALUES LESS THAN(11),
	SUBPARTITION P1_2 VALUES LESS THAN(15)
);
ERROR:  SUBPARTITION TEMPLATE is legal only for a composite partitioned table
-- error
ALTER TABLE PAR_TEST SET SUBPARTITION TEMPLATE ();
ERROR:  SUBPARTITION TEMPLATE is legal only for a composite partitioned table
DROP TABLE PAR_TEST;
-- Adding a sub-partition will fail if there are errors in the sub-partition template.
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION BY LIST(B)
(
 PARTITION P1 VALUES LESS THAN (10) (SUBPARTITION P1_1 VALUES(11), SUBPARTITION P1_2 VALUES(15)),
 PARTITION P2 VALUES LESS THAN (20)
);
-- ok
ALTER TABLE PAR_TEST SET SUBPARTITION TEMPLATE ();
SELECT partrelid::regclass, automatic, composite, seqno, interval_expr, subpart_template
FROM pg_ora_part_tables
WHERE partrelid = 'par_test'::regclass;
