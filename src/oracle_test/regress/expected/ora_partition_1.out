CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A)
SUBPARTITION BY RANGE(B)
(
 PARTITION P1 VALUES(1,2,3)(SUBPARTITION S1 VALUES LESS THAN(3), SUBPARTITION S2 VALUES LESS THAN(5)),
 PARTITION P2 VALUES(4,5,6)(SUBPARTITION S3 VALUES LESS THAN(5), SUBPARTITION S4 VALUES LESS THAN(10)),
 PARTITION P3 VALUES(7,8,9)
);
