-- Different from Oracle
-- ERROR:  cannot use "list" partition strategy with more than one column
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A,B)
SUBPARTITION  BY RANGE(B)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1 VALUES LESS THAN(2), SUBPARTITION S2 VALUES LESS THAN(3)),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION VALUES LESS THAN(8), SUBPARTITION VALUES LESS THAN(9))
);
ERROR:  cannot use "list" partition strategy with more than one column
-- If no subpartition description and subpartition templateis specified, a default subpartition will be created.
-- MAXVALUE range subpatition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A)
SUBPARTITION  BY RANGE(B)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1 VALUES LESS THAN(2), SUBPARTITION S2 VALUES LESS THAN(3)),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION VALUES LESS THAN(8), SUBPARTITION VALUES LESS THAN(9))
);
SELECT relid, parentrelid, level, isleaf, pg_catalog.pg_get_expr(c.relpartbound, c.oid) as bound 
FROM pg_partition_tree('par_test') t, pg_class c
WHERE t.relid=c.oid;
         relid         | parentrelid | level | isleaf |                  bound                   
-----------------------+-------------+-------+--------+------------------------------------------
 par_test              |             |     0 | f      | 
 par_test_p1           | par_test    |     1 | f      | FOR VALUES IN (1, 2, 3)
 par_test_p2           | par_test    |     1 | f      | FOR VALUES IN (4, 5, 6)
 par_test_p3           | par_test    |     1 | f      | FOR VALUES IN (7, 8, 9)
 par_test_p1_s1        | par_test_p1 |     2 | t      | FOR VALUES FROM (MINVALUE) TO (2)
 par_test_p1_s2        | par_test_p1 |     2 | t      | FOR VALUES FROM (2) TO (3)
 par_test_p2_sys_subp1 | par_test_p2 |     2 | t      | FOR VALUES FROM (MINVALUE) TO (MAXVALUE)
 par_test_p3_sys_subp2 | par_test_p3 |     2 | t      | FOR VALUES FROM (MINVALUE) TO (8)
 par_test_p3_sys_subp3 | par_test_p3 |     2 | t      | FOR VALUES FROM (8) TO (9)
(9 rows)

DROP TABLE PAR_TEST;
-- DEFAULT list subpartition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A)
SUBPARTITION  BY LIST(B)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1 VALUES(2), SUBPARTITION S2 VALUES(3)),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION VALUES(8), SUBPARTITION VALUES(9))
);
SELECT relid, parentrelid, level, isleaf, pg_catalog.pg_get_expr(c.relpartbound, c.oid) as bound 
FROM pg_partition_tree('par_test') t, pg_class c
WHERE t.relid=c.oid;
         relid         | parentrelid | level | isleaf |          bound          
-----------------------+-------------+-------+--------+-------------------------
 par_test              |             |     0 | f      | 
 par_test_p1           | par_test    |     1 | f      | FOR VALUES IN (1, 2, 3)
 par_test_p2           | par_test    |     1 | f      | FOR VALUES IN (4, 5, 6)
 par_test_p3           | par_test    |     1 | f      | FOR VALUES IN (7, 8, 9)
 par_test_p1_s1        | par_test_p1 |     2 | t      | FOR VALUES IN (2)
 par_test_p1_s2        | par_test_p1 |     2 | t      | FOR VALUES IN (3)
 par_test_p2_sys_subp1 | par_test_p2 |     2 | t      | DEFAULT
 par_test_p3_sys_subp2 | par_test_p3 |     2 | t      | FOR VALUES IN (8)
 par_test_p3_sys_subp3 | par_test_p3 |     2 | t      | FOR VALUES IN (9)
(9 rows)

