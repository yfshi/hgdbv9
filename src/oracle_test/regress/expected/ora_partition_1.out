DROP TABLE PAR_TEST;
-- list-range with multi subpartition keys.
CREATE TABLE PAR_TEST(A INT, B varchar2(64), C date)
PARTITION BY LIST(A) AUTOMATIC
SUBPARTITION  BY RANGE(B,C)
SUBPARTITION TEMPLATE
(
 SUBPARTITION P1 VALUES LESS THAN('cat', date'3000-1-1'),
 SUBPARTITION P2 VALUES LESS THAN('fish', date'3000-6-1'),
 SUBPARTITION P3 VALUES LESS THAN('zebu', date'3000-12-1')
)
(
 PARTITION P1 VALUES(1,2,3),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9),
 PARTITION P4 VALUES(10,11)
);
