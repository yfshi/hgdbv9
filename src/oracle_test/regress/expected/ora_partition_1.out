-- HASH COMPOSITE PARTITION
--
-- If no subpartition description and subpartition templateis specified, a default subpartition will be created.
-- MAXVALUE range subpatition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
SUBPARTITION  BY RANGE(B)
(
 PARTITION P1 (SUBPARTITION S1 VALUES LESS THAN(2), SUBPARTITION S2 VALUES LESS THAN(3)),
 PARTITION P2,
 PARTITION P3 (SUBPARTITION VALUES LESS THAN(8), SUBPARTITION VALUES LESS THAN(9))
);
