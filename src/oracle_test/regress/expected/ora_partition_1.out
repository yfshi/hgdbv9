--
-- PARTITION OF for Oracle partition tables is not allowed.
--
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC
SUBPARTITION  BY RANGE(B)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1 VALUES LESS THAN(10), SUBPARTITION S2 VALUES LESS THAN(20)),
 PARTITION P2 VALUES(4,5,6) (SUBPARTITION S3 VALUES LESS THAN(10), SUBPARTITION S4 VALUES LESS THAN(20)),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION S5 VALUES LESS THAN(10), SUBPARTITION S6 VALUES LESS THAN(20)),
 PARTITION P4 VALUES(10,11)
);
-- PARTITION OF
CREATE TABLE P5 PARTITION OF par_test FOR VALUES IN(100);
ERROR:  Oracle partition table do not support this command
CREATE TABLE P6 PARTITION OF par_test_p1 FOR VALUES FROM (100) TO (110);
ERROR:  Oracle partition table do not support this command
CREATE TABLE P7 PARTITION OF par_test_p1_s1 FOR VALUES FROM (100) TO (110);
ERROR:  Oracle partition table do not support this command
-- INHERITS
CREATE TABLE P6() INHERITS (par_test);
ERROR:  cannot inherit from partitioned table "par_test"
CREATE TABLE P6() INHERITS (par_test_p1);
ERROR:  cannot inherit from partitioned table "par_test_p1"
CREATE TABLE P6() INHERITS (par_test_p1_s1);
ERROR:  cannot inherit from partition "par_test_p1_s1"
DROP TABLE PAR_TEST;
--
-- TODO: STROE IN clause is only syntax compatible
--
-- SUBPARTITIONS Iconst opt_store_in_clause within subpartition desc
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY HASH(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION TMP1,
 SUBPARTITION TMP2
)
(
 PARTITION p1 VALUES LESS THAN(10) (SUBPARTITION S1, SUBPARTITION S2),
 PARTITION p2 VALUES LESS THAN(20) SUBPARTITIONS 3 STORE IN (mytest_partiton_1, mytest_partiton_2),
 PARTITION p3 VALUES LESS THAN(30)
);
DROP TABLE PAR_TEST;
-- SUBPARTITIONS Iconst opt_store_in_clause within subpartition template
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY HASH(B)
SUBPARTITIONS 4 STORE IN (mytest_partiton_1, mytest_partiton_2)
(
 PARTITION p1 VALUES LESS THAN(10) (SUBPARTITION S1, SUBPARTITION S2),
 PARTITION p2 VALUES LESS THAN(20) SUBPARTITIONS 3 STORE IN (mytest_partiton_2, mytest_partiton_3),
 PARTITION p3 VALUES LESS THAN(30)
);
DROP TABLE PAR_TEST;
-- AUTOMATIC opt_store_in_clause
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC STORE IN (mytest_partiton_1, mytest_partiton_2)
(
 PARTITION P1 VALUES(1,2,3),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9),
 PARTITION P4 VALUES(10,11)
);
-- ALTER TABLE SET STORE IN 
ALTER TABLE PAR_TEST SET STORE IN (mytest_partiton_2, mytest_partiton_3);
ERROR:  the MODIFY clause for Oracle partition is not yet supported
ALTER TABLE PAR_TEST SET STORE IN ();
ERROR:  the MODIFY clause for Oracle partition is not yet supported
DROP TABLE PAR_TEST;
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC STORE IN (mytest_partiton_1, mytest_partiton_2)
SUBPARTITION  BY RANGE(B)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1 VALUES LESS THAN(2), SUBPARTITION S2 VALUES LESS THAN(4)),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION VALUES LESS THAN(8), SUBPARTITION VALUES LESS THAN(10)),
 PARTITION P4 VALUES(10,11)
);
DROP TABLE PAR_TEST;
-- PARTITIONS Iconst opt_store_in_clause
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
PARTITIONS 10 STORE IN (mytest_partiton_1, mytest_partiton_2);
DROP TABLE PAR_TEST;
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
SUBPARTITION  BY HASH(B)
SUBPARTITIONS 4 STORE IN (mytest_partiton_1, mytest_partiton_2)
PARTITIONS 5 STORE IN (mytest_partiton_1, mytest_partiton_3);
DROP TABLE PAR_TEST;
--
-- INTERVAL partition
--
-- simple partition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A) INTERVAL(10)
(
 PARTITION P1 VALUES LESS THAN(10),
 PARTITION P2 VALUES LESS THAN(30),
 PARTITION P3 VALUES LESS THAN(55)
);
