-- some error attach operator
CREATE TABLE par_test_1 (
    a integer,
    b number,
    c varchar2(128 char)
)
PARTITION BY LIST (c);
CREATE TABLE par_test_1_1 (
    a integer,
    b number,
    c varchar2(128 char)
);
ALTER TABLE par_test_1 ATTACH PARTITION par_test_1_1 FOR VALUES IN ('AAA', 'aaa');
-- attach lost partition name
ALTER TABLE ONLY par_test ATTACH PARTITION par_test_1 FOR VALUES FROM (MINVALUE, MINVALUE) TO (10, '10');
ERROR:  attach lost partition name
-- relation "par_test_1" currently being attached may have children
ALTER TABLE ONLY par_test ATTACH PARTITION par_test_1 FOR VALUES FROM (MINVALUE, MINVALUE) TO (10, '10') WITH P1;
ERROR:  relation "par_test_1" currently being attached may have children
-- is already a partition
ALTER TABLE ONLY par_test ATTACH PARTITION par_test_1_1 FOR VALUES FROM (MINVALUE, MINVALUE) TO (10, '10') WITH P1;
ERROR:  "par_test_1_1" is already a partition
DROP TABLE par_test_1;
CREATE TABLE par_test_1_2 (
    a integer,
    b number,
    c varchar2(128 char)
);
-- cannot attach a non-partitioned relation "par_test_1_2" as partition of Oracle composite partitioned tables "par_test"
ALTER TABLE ONLY par_test ATTACH PARTITION par_test_1_2 FOR VALUES FROM (MINVALUE, MINVALUE) TO (10, '10') WITH P1;
ERROR:  cannot attach a non-partitioned relation "par_test_1_2" as partition of Oracle composite partitioned tables "par_test"
