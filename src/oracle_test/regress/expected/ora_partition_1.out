-- OK
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY HASH(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION TMP1,
 SUBPARTITION TMP2 
)
(
 PARTITION p1 VALUES LESS THAN(10),
 PARTITION p2 VALUES LESS THAN(20),
 PARTITION p3 VALUES LESS THAN(30)
);
SELECT relid, parentrelid, level, isleaf, pg_catalog.pg_get_expr(c.relpartbound, c.oid) as bound 
FROM pg_partition_tree('par_test') t, pg_class c
WHERE t.relid=c.oid;
      relid       | parentrelid | level | isleaf |                  bound                   
------------------+-------------+-------+--------+------------------------------------------
 par_test         |             |     0 | f      | 
 par_test_p1      | par_test    |     1 | f      | FOR VALUES FROM (MINVALUE) TO (10)
 par_test_p2      | par_test    |     1 | f      | FOR VALUES FROM (10) TO (20)
 par_test_p3      | par_test    |     1 | f      | FOR VALUES FROM (20) TO (30)
 par_test_p1_tmp1 | par_test_p1 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 0)
 par_test_p1_tmp2 | par_test_p1 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 1)
 par_test_p2_tmp1 | par_test_p2 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 0)
 par_test_p2_tmp2 | par_test_p2 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 1)
 par_test_p3_tmp1 | par_test_p3 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 0)
 par_test_p3_tmp2 | par_test_p3 |     2 | t      | FOR VALUES WITH (modulus 2, remainder 1)
(10 rows)

