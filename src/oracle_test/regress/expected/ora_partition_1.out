-- not a composite partition but subpartition description specified
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
(PARTITION P1 (SUBPARTITION SUBP1 VALUES LESS THAN(11), SUBPARTITION SUBP2 VALUES LESS THAN(15)),
 PARTITION P2 (SUBPARTITION SUBP1 VALUES LESS THAN(11), SUBPARTITION SUBP2 VALUES LESS THAN(15)));
ERROR:  this physical attribute may not be specified for a table partition
HINT:  Not a composite partition but subpartition description specified.
--
-- SUBPARTITION TEMPLATE
--
-- OK
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY RANGE(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION TMP1 VALUES LESS THAN(20),
 SUBPARTITION TMP2 VALUES LESS THAN(30)
)
(
 PARTITION p1 VALUES LESS THAN(10) (SUBPARTITION S1 VALUES LESS THAN(20), SUBPARTITION S2 VALUES LESS THAN(30)),
 PARTITION p2 VALUES LESS THAN(20),
 PARTITION p3 VALUES LESS THAN(30) (SUBPARTITION VALUES LESS THAN(20), SUBPARTITION VALUES LESS THAN(30))
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
         relid         | parentrelid | level | isleaf 
-----------------------+-------------+-------+--------
 par_test              |             |     0 | f
 par_test_p1           | par_test    |     1 | f
 par_test_p2           | par_test    |     1 | f
 par_test_p3           | par_test    |     1 | f
 par_test_p1_s1        | par_test_p1 |     2 | t
 par_test_p1_s2        | par_test_p1 |     2 | t
 par_test_p2_tmp1      | par_test_p2 |     2 | t
 par_test_p2_tmp2      | par_test_p2 |     2 | t
 par_test_p3_sys_subp1 | par_test_p3 |     2 | t
 par_test_p3_sys_subp2 | par_test_p3 |     2 | t
(10 rows)

