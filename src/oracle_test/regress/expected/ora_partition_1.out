-- datetime datatype interval expr
CREATE TABLE PAR_TEST(A DATE, B INT)
PARTITION BY RANGE(A) INTERVAL(NUMTOYMINTERVAL(1, 'YEAR'))
(
 PARTITION P1 VALUES LESS THAN(date'1990-1-1'),
 PARTITION P2 VALUES LESS THAN(date'2000-2-1'),
 PARTITION P3 VALUES LESS THAN(date'2010-3-1'),
 PARTITION P4 VALUES LESS THAN(date'2020-4-1'),
 PARTITION P5 VALUES LESS THAN(date'2030-5-20')
);
