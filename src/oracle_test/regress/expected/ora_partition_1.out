-- create test tables.
CREATE TABLE TEST_RANGE(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION p1 VALUES LESS THAN(10),
 PARTITION p2 VALUES LESS THAN(20),
 PARTITION p3 VALUES LESS THAN(30)
);
CREATE TABLE TEST_LIST(A INT, B INT)
PARTITION BY LIST(A)
(
 PARTITION p1 VALUES(10,11),
 PARTITION p2 VALUES(20,21),
 PARTITION p3 VALUES(30,31)
);
CREATE TABLE TEST_HASH(A INT, B INT)
PARTITION BY HASH(A)
(
 PARTITION p1,
 PARTITION p2,
 PARTITION p3
);
CREATE TABLE TEST_COMPISE_WITH_TEMP(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY RANGE(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION TMP1 VALUES LESS THAN(20),
 SUBPARTITION TMP2 VALUES LESS THAN(30)
)
(
 PARTITION p1 VALUES LESS THAN(10) (SUBPARTITION S1 VALUES LESS THAN(20), SUBPARTITION S2 VALUES LESS THAN(30)),
 PARTITION p2 VALUES LESS THAN(20),
 PARTITION p3 VALUES LESS THAN(30) (SUBPARTITION VALUES LESS THAN(20), SUBPARTITION VALUES LESS THAN(30))
);
CREATE TABLE TEST_COMPISE_NO_TEMP(A INT, B INT)
PARTITION BY RANGE(A)
SUBPARTITION  BY RANGE(B)
(
 PARTITION p1 VALUES LESS THAN(10) (SUBPARTITION S1 VALUES LESS THAN(20), SUBPARTITION S2 VALUES LESS THAN(30)),
 PARTITION p2 VALUES LESS THAN(20),
 PARTITION p3 VALUES LESS THAN(30) (SUBPARTITION VALUES LESS THAN(20), SUBPARTITION VALUES LESS THAN(30))
);
