-- composite automatic list partition with subpartition template.
-- list-hash
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC
SUBPARTITION  BY HASH(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION P1,
 SUBPARTITION P2,
 SUBPARTITION P3
)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1, SUBPARTITION S2),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION, SUBPARTITION),
 PARTITION P4 VALUES(10,11)
);
SELECT partrelid::regclass, automatic, composite, seqno, interval_expr, subpart_template
FROM pg_ora_part_tables
WHERE partrelid = 'par_test'::regclass;
 partrelid | automatic | composite | seqno | interval_expr |                                                                                                                                                                         subpart_template                                                                                                                                                                          
-----------+-----------+-----------+-------+---------------+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 par_test  | t         | t         |     3 |               | {ORASUBPARTITIONTEMPLATESPEC :subpartitons_desc ({ORAPARTITIONBOUNDSPEC :partition_name p1 :tablespace_name <> :bound <> :subpart_bound <>} {ORAPARTITIONBOUNDSPEC :partition_name p2 :tablespace_name <> :bound <> :subpart_bound <>} {ORAPARTITIONBOUNDSPEC :partition_name p3 :tablespace_name <> :bound <> :subpart_bound <>}) :hash_subpartition_quantity 0}
(1 row)

