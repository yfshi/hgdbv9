ALTER TABLE ONLY par_test ATTACH PARTITION par_test_1 FOR VALUES FROM (MINVALUE, MINVALUE) TO (10, '10') WITH P1;
ERROR:  attach relation has strategy "h" but subpartition strategy of Oracle composite partitioned table is "l"
