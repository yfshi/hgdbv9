--
-- Tests for Oracle partition table
--
--
-- RANGE PARTITION
--
-- Invalid partitioning strategy
-- ERROR:  syntax error at or near "aaa"
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY aaa(A)
(
 PARTITION P1 VALUES LESS THAN(10),
 PARTITION P2 VALUES LESS THAN(20)
);
ERROR:  syntax error at or near "aaa"
LINE 2: PARTITION BY aaa(A)
                     ^
-- Invalid range partition description syntax missing LESS THAN
-- ERROR:  syntax error at or near "("
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION P1 VALUES(10),
 PARTITION P2 VALUES(20)
);
ERROR:  syntax error at or near "("
LINE 4:  PARTITION P1 VALUES(10),
                            ^
-- not a composite partition but subpartition description specified
-- ORA-14020
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION P1 VALUES LESS THAN(10) (SUBPARTITION P1_1 VALUES LESS THAN(11)),
 PARTITION P2 VALUES LESS THAN(20) (SUBPARTITION P2_1 VALUES LESS THAN(11))
);
ERROR:  this physical attribute may not be specified for a table partition
HINT:  Not a composite partition but subpartition description specified.
-- ORA-14013: duplicate partition name
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION P1 VALUES LESS THAN (10),
 PARTITION P1 VALUES LESS THAN (20)
);
ERROR:  duplicate partition name "p1"
-- ORA-14159: duplicate subpartition name
-- In the same partition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A) SUBPARTITION BY RANGE(B)
(
 PARTITION P1 VALUES LESS THAN (10) (SUBPARTITION P1_1 VALUES LESS THAN(11), SUBPARTITION P1_1 VALUES LESS THAN(15)),
 PARTITION P2 VALUES LESS THAN (20)
);
ERROR:  duplicate subpartition name "p1_1"
-- ORA-14159: duplicate subpartition name
-- not in the same partition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A) SUBPARTITION BY RANGE(B)
(
 PARTITION P1 VALUES LESS THAN (10) (SUBPARTITION SUBP1 VALUES LESS THAN(11), SUBPARTITION SUBP2 VALUES LESS THAN(15)),
 PARTITION P2 VALUES LESS THAN (20) (SUBPARTITION SUBP1 VALUES LESS THAN(11), SUBPARTITION SUBP3 VALUES LESS THAN(15))
);
ERROR:  duplicate subpartition name "subp1"
-- ORA-14159: duplicate subpartition name
-- In the same partition table, partitions and subpartitions cannot have the same name.
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A) SUBPARTITION BY RANGE(B)
(
 PARTITION P1 VALUES LESS THAN (10) (SUBPARTITION P2 VALUES LESS THAN(11), SUBPARTITION AAA VALUES LESS THAN(15)),
 PARTITION P2 VALUES LESS THAN (20) 
);
ERROR:  duplicate subpartition name "p2"
-- Relation name of the partition or subpartition is already occupied by another table,
-- and we automatically choose a non-conflicting partition or subpartition name.
CREATE TABLE PAR_TEST_P1(A INT);
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION P1 VALUES LESS THAN (10),
 PARTITION P2 VALUES LESS THAN (20) 
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
     relid     | parentrelid | level | isleaf 
---------------+-------------+-------+--------
 par_test      |             |     0 | f
 par_test_p1_1 | par_test    |     1 | t
 par_test_p2   | par_test    |     1 | t
(3 rows)

DROP TABLE PAR_TEST;
CREATE TABLE PAR_TEST_P1_1_P1_1(A INT);
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A) SUBPARTITION BY RANGE(B)
(
 PARTITION P1 VALUES LESS THAN (10) (SUBPARTITION p1_1 VALUES LESS THAN(11), SUBPARTITION p1_2 VALUES LESS THAN(15)),
 PARTITION P2 VALUES LESS THAN (20) 
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
         relid         |  parentrelid  | level | isleaf 
-----------------------+---------------+-------+--------
 par_test              |               |     0 | f
 par_test_p1_1         | par_test      |     1 | f
 par_test_p2           | par_test      |     1 | f
 par_test_p1_1_p1_1_1  | par_test_p1_1 |     2 | t
 par_test_p1_1_p1_2    | par_test_p1_1 |     2 | t
 par_test_p2_sys_subp1 | par_test_p2   |     2 | t
(6 rows)

DROP TABLE PAR_TEST;
DROP TABLE PAR_TEST_P1;
DROP TABLE PAR_TEST_P1_1_P1_1;
-- The relation name of a partition or subpartition is occupied by a
-- previous partition or subpartition in the same partition statement.
CREATE TABLE PAR_TEST_P(A int);
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION P VALUES LESS THAN (10),
 PARTITION P_1 VALUES LESS THAN (20) 
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
     relid      | parentrelid | level | isleaf 
----------------+-------------+-------+--------
 par_test       |             |     0 | f
 par_test_p_1   | par_test    |     1 | t
 par_test_p_1_1 | par_test    |     1 | t
(3 rows)

DROP TABLE PAR_TEST;
DROP TABLE PAR_TEST_P;
CREATE TABLE PAR_TEST_P1_S1(A INT);
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A) SUBPARTITION BY RANGE(B)
(
 PARTITION P1 VALUES LESS THAN (10) (SUBPARTITION S1 VALUES LESS THAN(11), SUBPARTITION S1_1 VALUES LESS THAN(15)),
 PARTITION P2 VALUES LESS THAN (20) (SUBPARTITION S1_1_1 VALUES LESS THAN(11), SUBPARTITION S1_1_1_1 VALUES LESS THAN(15))
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
        relid         | parentrelid | level | isleaf 
----------------------+-------------+-------+--------
 par_test             |             |     0 | f
 par_test_p1          | par_test    |     1 | f
 par_test_p2          | par_test    |     1 | f
 par_test_p1_s1_1     | par_test_p1 |     2 | t
 par_test_p1_s1_1_1   | par_test_p1 |     2 | t
 par_test_p2_s1_1_1   | par_test_p2 |     2 | t
 par_test_p2_s1_1_1_1 | par_test_p2 |     2 | t
(7 rows)

DROP TABLE PAR_TEST;
DROP TABLE PAR_TEST_P1_S1;
-- Ignore the partition name
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION VALUES LESS THAN (10),
 PARTITION P2 VALUES LESS THAN (20),
 PARTITION VALUES LESS THAN (30)
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
      relid      | parentrelid | level | isleaf 
-----------------+-------------+-------+--------
 par_test        |             |     0 | f
 par_test_sys_p1 | par_test    |     1 | t
 par_test_p2     | par_test    |     1 | t
 par_test_sys_p2 | par_test    |     1 | t
(4 rows)

DROP TABLE PAR_TEST;
-- RANGE partitioning must have the same number of partition keys as partition boundary values.
-- ORA-14017 & ORA-14018
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A, B)
(
 PARTITION VALUES LESS THAN (10),
 PARTITION P2 VALUES LESS THAN (20),
 PARTITION VALUES LESS THAN (30)
);
ERROR:  partition bound list contains too few elements
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY RANGE(A)
(
 PARTITION VALUES LESS THAN (10, 11),
 PARTITION P2 VALUES LESS THAN (20, 21),
 PARTITION VALUES LESS THAN (30, 29)
);
ERROR:  partition bound list contains too many elements
--
-- LIST PARTITION
--
-- ORA-14318 DEFAULT partition must be last partition specified
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A)
(PARTITION P1 VALUES (DEFAULT), PARTITION P2 VALUES (10));
ERROR:  DEFAULT partition must be last partition specified
-- Ignore the partition name
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A)
(
 PARTITION VALUES (10),
 PARTITION P2 VALUES (20),
 PARTITION VALUES (30)
);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
      relid      | parentrelid | level | isleaf 
-----------------+-------------+-------+--------
 par_test        |             |     0 | f
 par_test_sys_p1 | par_test    |     1 | t
 par_test_p2     | par_test    |     1 | t
 par_test_sys_p2 | par_test    |     1 | t
(4 rows)

DROP TABLE PAR_TEST;
--
-- HASH PARTITION
--
-- Hash partitioning means that a tuple can always find a leaf node to insert into
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
(PARTITION P1,
 PARTITION P2);
INSERT INTO PAR_TEST SELECT GENERATE_SERIES(1,100), GENERATE_SERIES(1,100);
SELECT COUNT(*) FROM PAR_TEST;
 count 
-------
   100
(1 row)

SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
    relid    | parentrelid | level | isleaf 
-------------+-------------+-------+--------
 par_test    |             |     0 | f
 par_test_p1 | par_test    |     1 | t
 par_test_p2 | par_test    |     1 | t
(3 rows)

DROP TABLE PAR_TEST;
-- Ignore the partition name
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY HASH(A)
(PARTITION,
 PARTITION P2,
 PARTITION);
SELECT relid, parentrelid, level, isleaf FROM pg_partition_tree('par_test');
      relid      | parentrelid | level | isleaf 
-----------------+-------------+-------+--------
 par_test        |             |     0 | f
 par_test_sys_p1 | par_test    |     1 | t
 par_test_p2     | par_test    |     1 | t
 par_test_sys_p2 | par_test    |     1 | t
(4 rows)

