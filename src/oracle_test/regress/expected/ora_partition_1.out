--
-- Oracle AUTOMATIC list partition
--
-- ORA-14851:DEFAULT [sub]partition cannot be specified for AUTOLIST [sub]partitioned objects
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC
(
 PARTITION P1 VALUES(1,2,3),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9),
 PARTITION P4 VALUES(10,11),
 PARTITION P5 VALUES(DEFAULT)
);
ERROR:  DEFAULT [sub]partition cannot be specified for AUTOLIST [sub]partitioned objects
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC
SUBPARTITION  BY HASH(B)
SUBPARTITION TEMPLATE
(
 SUBPARTITION P1,
 SUBPARTITION P2,
 SUBPARTITION P3
)
(
 PARTITION P1 VALUES(1,2,3) (SUBPARTITION S1, SUBPARTITION S2),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9) (SUBPARTITION, SUBPARTITION),
 PARTITION P4 VALUES(10,11),
 PARTITION P5 VALUES(DEFAULT)
);
ERROR:  DEFAULT [sub]partition cannot be specified for AUTOLIST [sub]partitioned objects
-- simple automatic list partition
CREATE TABLE PAR_TEST(A INT, B INT)
PARTITION BY LIST(A) AUTOMATIC
(
 PARTITION P1 VALUES(1,2,3),
 PARTITION P2 VALUES(4,5,6),
 PARTITION P3 VALUES(7,8,9),
 PARTITION P4 VALUES(10,11)
);
SELECT partrelid::regclass, automatic, composite, seqno, interval_expr, subpart_template
FROM pg_ora_part_tables
WHERE partrelid = 'par_test'::regclass;
 partrelid | automatic | composite | seqno | interval_expr | subpart_template 
-----------+-----------+-----------+-------+---------------+------------------
 par_test  | t         | f         |     1 |               | 
(1 row)

SELECT relid, parentrelid, level, isleaf, pg_catalog.pg_get_expr(c.relpartbound, c.oid) as bound
FROM pg_partition_tree('par_test') t, pg_class c
WHERE t.relid=c.oid;
    relid    | parentrelid | level | isleaf |          bound          
-------------+-------------+-------+--------+-------------------------
 par_test    |             |     0 | f      | 
 par_test_p1 | par_test    |     1 | t      | FOR VALUES IN (1, 2, 3)
 par_test_p2 | par_test    |     1 | t      | FOR VALUES IN (4, 5, 6)
 par_test_p3 | par_test    |     1 | t      | FOR VALUES IN (7, 8, 9)
 par_test_p4 | par_test    |     1 | t      | FOR VALUES IN (10, 11)
(5 rows)

