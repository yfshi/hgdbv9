 Index Only Scan using pg_class_relname_nsp_index on pg_class
   Index Cond: (relname = $0)
   InitPlan 1 (returns $0)
     ->  Limit
           ->  Sort
                 Sort Key: v_oct_2.id DESC
                 ->  Subquery Scan on v_oct_2
                       ->  HashAggregate
                             Group Key: (((pg_class_1.oid)::varchar2(10))::number), ((ora_case_trans((pg_class_1.relname)::varchar2))::varchar2(128))
                             ->  Append
                                   ->  Seq Scan on pg_class pg_class_1
                                   ->  Seq Scan on pg_proc
(12 rows)

	select name from v_oct_1
	where name = (select name from v_oct_2 order by id desc limit 1);
   name   
