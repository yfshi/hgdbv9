/* use object test */
CREATE SCHEMA test6;
CREATE TABLE test6.t(a int);
INSERT INTO test6.t VALUES (1);
CREATE SCHEMA test7;
CREATE TABLE test7.t(a int);
INSERT INTO test7.t VALUES (2);
USE test6;
SELECT a FROM t;
 a 
---
 1
(1 row)

USE test7;
SELECT a FROM t;
 a 
---
 2
(1 row)

DROP SCHEMA test6 CASCADE;
NOTICE:  drop cascades to table test6.t
DROP SCHEMA test7 CASCADE;
NOTICE:  drop cascades to table t
/*use function test*/
CREATE FUNCTION pg_catalog.sche_f(a int)
    RETURNS INT
    RETURN 1;
CREATE SCHEMA sctest8;
CREATE FUNCTION sctest8.sche_f(a int)
    RETURNS INT
    RETURN 2;
USE  sctest8;
SELECT sche_f(0);
 sche_f 
--------
      2
(1 row)

