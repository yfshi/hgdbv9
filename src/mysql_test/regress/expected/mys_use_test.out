SET mysql.create_database_mode=schema;
CREATE SCHEMA test1;
USE test1;
SELECT  current_schema();
 current_schema 
----------------
 test1
(1 row)

DROP SCHEMA test1;
CREATE DATABASE test1;
USE test1;
SELECT  current_schema();
 current_schema 
----------------
 test1
(1 row)

DROP SCHEMA test1;
