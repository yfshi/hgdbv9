SELECT BOOLTBL1.*
   FROM BOOLTBL1
   WHERE f1 = CAST('true' AS bool);
 f1 
----
 t
 t
 t
(3 rows)

SELECT BOOLTBL1.*
   FROM BOOLTBL1
   WHERE f1 <> CAST('false' AS bool);
 f1 
----
 t
 t
 t
(3 rows)

SELECT BOOLTBL1.*
   FROM BOOLTBL1
   WHERE booleq(CAST('false' AS bool), f1);
 f1 
