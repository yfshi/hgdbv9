(3 rows)

SELECT i.f1, i.f1 * int2 '2' AS x FROM INT2_TBL i;
   f1   |   x    
--------+--------
      0 |      0
   1234 |   2468
  -1234 |  -2468
     35 |     70
  32767 |  65534
 -32767 | -65534
(6 rows)

SELECT i.f1, i.f1 * int2 '2' AS x FROM INT2_TBL i
WHERE abs(f1) < 16384;
  f1   |   x   
-------+-------
     0 |     0
  1234 |  2468
 -1234 | -2468
    35 |    70
(4 rows)

SELECT i.f1, i.f1 * int4 '2' AS x FROM INT2_TBL i;
