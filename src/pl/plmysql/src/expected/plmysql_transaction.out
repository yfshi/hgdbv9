CREATE TABLE test1 (a int, b text);
CREATE PROCEDURE transaction_test1(x int, y text)
LANGUAGE plmysql
AS $$
BEGIN
    FOR i IN 0..x LOOP
        INSERT INTO test1 (a, b) VALUES (i, y);
        IF i % 2 = 0 THEN
            COMMIT;
        ELSE
            ROLLBACK;
        END IF;
    END LOOP;
END
$$;
CALL transaction_test1(9, 'foo');
SELECT * FROM test1;
 a |  b  
---+-----
 0 | foo
 2 | foo
 4 | foo
 6 | foo
 8 | foo
(5 rows)

TRUNCATE test1;
DO
LANGUAGE plmysql
$$
BEGIN
    FOR i IN 0..9 LOOP
        INSERT INTO test1 (a) VALUES (i);
        IF i % 2 = 0 THEN
            COMMIT;
        ELSE
            ROLLBACK;
        END IF;
    END LOOP;
END
$$;
SELECT * FROM test1;
 a | b 
---+---
 0 | 
 2 | 
 4 | 
 6 | 
 8 | 
(5 rows)

