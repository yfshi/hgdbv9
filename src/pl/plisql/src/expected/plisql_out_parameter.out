create or replace function test_number(id integer,number1 out number, number2 out number[],number3 number) return number as
declare
  mds number(4,2)[3];
begin
  mds[0] := 23.34;
  mds[1] := 24.34;
  mds[2] := 25.34;
  number1 := 3.14;
  number2 := mds;
