create table test_tb(id integer,name text);
DECLARE
  var1 text;
BEGIN
  for var2 in 1 .. 100 LOOP
    var1 := 'sfds';
    for var3 in 1 .. 2000 LOOP
	   var1 := var1 || '1';
	end loop;
	insert into test_tb values(var2,var1);
 end loop;
end;
/
create or replace function test_f2(id integer,name1 varchar2, name out varchar2) return integer IS
  var1 varchar2(4000);
  ret integer;
BEGIN
  name := 'welcome to beigjin';
  return id;
end;
/
create or replace function test_f1(id integer,name1 varchar2, name out varchar2) return integer IS
  ret integer;
BEGIN
  ret := test_f2(id,name1, name);
  return id;
end;
/
create or replace function test_f0(id integer, name1 varchar2) return integer IS
  var1 integer;
  var2 varchar2(4000);
  ret integer;
BEGIN
  var1 := test_f1(id,name1, var2);
  return id;
end;
/
