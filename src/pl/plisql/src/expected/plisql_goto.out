-- label in inner scope are invisible
begin
  <<aaa>>raise notice 'aaa';
  begin
    <<bbb>>raise notice '1_bbb';
    <<bbb>>raise notice '1_bbb';
  end;
  goto bbb;
  <<bbb>>raise notice 'bbb';
end;
/
NOTICE:  aaa
NOTICE:  1_bbb
NOTICE:  1_bbb
NOTICE:  bbb
-- inner scope overflow outter scope
begin
  <<aaa>>raise notice 'aaa';
  <<aaa>>raise notice 'aaa';
  begin
    begin
      goto aaa;
    end;
    <<aaa>>raise notice '1_aaa';
  end;
end;
/
NOTICE:  aaa
NOTICE:  aaa
NOTICE:  1_aaa
-- error: jump to the same-named labels
begin
  <<aaa>>raise notice 'aaa';
  goto bbb;
  <<bbb>>raise notice 'bbb';
  <<bbb>>raise notice 'ccc';
end;
/
