INFO:  sqlcode 1 = 1
INFO:  sqlerrm 1 = User-Defined Exception
INFO:  sqlcode 2 = 0
INFO:  sqlerrm 2 = IVY-0000: normal, successful completion
create or replace function test_f(id integer) return integer is
begin
  raise info '%','sqlcode func = ' || sqlcode;
  raise info '%','sqlerrm func = ' || sqlerrm;
  return 1;
end;
/
