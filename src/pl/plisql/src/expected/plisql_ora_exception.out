CREATE  PROCEDURE account_status (
  due_date DATE,
  today    DATE
) AUTHID DEFINER
IS
  var1 exception;
  PRAGMA EXCEPTION_INIT(var1, 20000);
BEGIN
  IF due_date < today THEN                   -- explicitly raise exception
    raise var1;
  END IF;
END;
