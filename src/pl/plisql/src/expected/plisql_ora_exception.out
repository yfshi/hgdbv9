declare
  var1 integer;
begin
  declare
     var2 exception;
     var3 integer;
  begin
     raise var2;
  exception
  when var2 then
     raise info '%','sqlcode 1 = ' || sqlcode;
     raise info '%','sqlerrm 1 = ' || sqlerrm;
     var3 := test_f(23);
   end;
   raise info '%','sqlcode 2 = ' || sqlcode;
   raise info '%','sqlerrm 2 = ' || sqlerrm;
end;
