CREATE OR REPLACE FUNCTION f_plsql_unit RETURN VARCHAR2
IS
    v_result VARCHAR2(128);
BEGIN
    IF $$PLSQL_UNIT = 'f_plsql_unit' THEN
        RAISE NOTICE 'This is a debug function';
    END IF;
    v_result := 'From: ' || $$PLSQL_UNIT;
    RETURN v_result;
END;
/
