-- 4. trigger
CREATE OR REPLACE TRIGGER plsql_unit_trig
AFTER INSERT ON plsql_unit_test
FOR EACH ROW
BEGIN
    INSERT INTO plsql_unit_tb VALUES($$PLSQL_UNIT, $$PLSQL_UNIT_TYPE);
END;
/
