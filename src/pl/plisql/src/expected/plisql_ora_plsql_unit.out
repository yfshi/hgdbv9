SET SERVEROUTPUT ON;
-- 1. normal function
CREATE OR REPLACE FUNCTION "f_plsql_unit"
RETURN NUMBER IS
    v_func VARCHAR2(100) := $$PLSQL_UNIT;
    v_type VARCHAR2(100) := $$PLSQL_UNIT_TYPE;
BEGIN
    DBMS_OUTPUT.PUT_LINE('$$PLSQL_UNIT = ' || v_func);
    DBMS_OUTPUT.PUT_LINE('$$PLSQL_UNIT_TYPE = ' || v_type);
    return 1;
END;
/
