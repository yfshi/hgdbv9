CREATE OR REPLACE FUNCTION f_plsql_unit 
RETURN VARCHAR2 
IS
    v_sql VARCHAR2(4000);
    v_result VARCHAR2(100);
BEGIN
    v_sql := '
        BEGIN
        DBMS_OUTPUT.PUT_LINE(''Exec: ' || $$PLSQL_UNIT || ''');
        :result := ''From: ' || $$PLSQL_UNIT || ''';
        END;
    ';
    EXECUTE IMMEDIATE v_sql USING OUT v_result;
    RETURN v_result;
END;
/
