# Compiler and flags
CC = gcc
CFLAGS = -std=c99 -Wall -Wextra -g -O0 -fPIC \
         -DFRONTEND -DTECC_TEST_INTEGRATION \
         -I../../../../../src/include \
         -I../../../../../src/interfaces/libpq \
         -I../../../../../src/interfaces/libpq/tecc_processor \
         -I../../../../../src/interfaces/libpq/frontend_parser \
         -I../../../../../src/interfaces/libpq/tecc_libpq_integration \
         -I../../../../../src/interfaces/libpq/tecc_cache \
         -I../../../../../src/interfaces/libpq/tecc_common \
         -I./include

# Linker flags
LDFLAGS = -lm

# Source files
SRCS = test_encrypted_field.c

# Object files
OBJS = $(SRCS:.c=.o)

# Target executable
TARGET = test_encrypted_field

# Default target
all: $(TARGET)

# Build executable
$(TARGET): $(OBJS)
	$(CC) -o $@ $^ $(LDFLAGS)

# Compile source files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Clean build artifacts
clean:
	rm -f $(OBJS) $(TARGET)

# Run test
test: all
	@echo "Running encrypted field test..."
	./$(TARGET)

# Help target
help:
	@echo "Available targets:"
	@echo "  all    - Build the test program (default)"
	@echo "  clean  - Remove build artifacts"
	@echo "  test   - Build and run test"
	@echo "  help   - Show this help message"

.PHONY: all clean test help
# End - ReqID:TECC4.0