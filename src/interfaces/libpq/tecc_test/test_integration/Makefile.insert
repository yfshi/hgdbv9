# Makefile for INSERT encrypted columns test program
CC = gcc
CFLAGS = -std=c99 -Wall -Wextra -g -O0 -fPIC \
         -DFRONTEND -DTECC_TEST_INTEGRATION \
         -I../../../../../src/include \
         -I../../../../../src/interfaces/libpq \
         -I../../../../../src/interfaces/libpq/tecc_processor \
         -I../../../../../src/interfaces/libpq/frontend_parser \
         -I../../../../../src/interfaces/libpq/tecc_libpq_integration \
         -I../../../../../src/interfaces/libpq/tecc_cache \
         -I../../../../../src/interfaces/libpq/tecc_common

# Target executable
TARGET = test_insert_encrypted

# Default target
all: $(TARGET)

# Build executable
$(TARGET): test_insert_encrypted.o
	$(CC) -o $@ $^ -lm

# Compile source file
test_insert_encrypted.o: test_insert_encrypted.c
	$(CC) $(CFLAGS) -c $< -o $@

# Clean build artifacts
clean:
	rm -f test_insert_encrypted.o $(TARGET)

# Run test
run: all
	@echo "Running INSERT with encrypted columns test..."
	./$(TARGET)

.PHONY: all clean run