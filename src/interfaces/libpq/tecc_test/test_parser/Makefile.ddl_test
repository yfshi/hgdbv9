# Simple Makefile for DDL parser tests
# Usage: make -f Makefile.ddl_test

CC = gcc
CFLAGS = -I../../../../src/include -I../../frontend_parser -I. -DFRONTEND=1 -DFRONTEND_PARSER=1 -g -O0
LDFLAGS = -L../../../../src/interfaces/libpq -lpq

# Source files
SRCS = test_parser_ddl.c
OBJS = $(SRCS:.c=.o)
TARGET = test_parser_ddl

# Parser source files (simplified - actual implementation may vary)
PARSER_SRCS = ../../frontend_parser/fe_adapter.c \
              ../../frontend_parser/tecc_nodes.c \
              ../../frontend_parser/feparser_memutils_simple.c

PARSER_OBJS = $(PARSER_SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS) $(PARSER_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(PARSER_OBJS) $(TARGET)

test: $(TARGET)
	./$(TARGET)

.PHONY: all clean test