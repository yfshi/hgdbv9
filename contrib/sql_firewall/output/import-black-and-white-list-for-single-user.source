(3 rows)

-- S04 expressions, CASE, COALESCE
SELECT full_name, CASE WHEN salary >= 145000 THEN 'senior' ELSE 'standard' END band,
       coalesce(profile->>'level','unknown') AS level FROM employee;
     full_name     |   band   |  level  
-------------------+----------+---------
 Ada Lovelace      | senior   | 5
 Grace Hopper      | senior   | unknown
