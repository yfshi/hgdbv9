--
-- Test INSERT
--
-- I01 single row, defaults
INSERT INTO department(code, name) VALUES ('ENG', 'Engineering');
-- I02 explicit values
INSERT INTO department(code, name, budget) VALUES ('OPS', 'Operations', 250000);
-- I03 multi-row insert
INSERT INTO department(code, name, budget) VALUES
 ('HR', 'People', 90000), ('FIN', 'Finance', 120000), ('SALES', 'Sales', 180000);
-- I04 DEFAULT VALUES into a compatible temporary table
INSERT INTO default_probe DEFAULT VALUES;
-- I05 INSERT ... SELECT
INSERT INTO project(name, priority, cost)
SELECT 'Project-' || code, 'medium'::priority_level, budget / 10 FROM department;
-- I06 explicit identity override
INSERT INTO employee(employee_id, department_id, email, full_name, salary, skills, profile)
OVERRIDING SYSTEM VALUE
VALUES (1001, (SELECT department_id FROM department WHERE code='ENG'),
        'ada@example.test', 'Ada Lovelace', 150000,
        ARRAY['sql','math'], '{"level":5,"remote":true}');
-- I07 RETURNING
INSERT INTO employee(department_id, email, full_name, salary)
VALUES ((SELECT department_id FROM department WHERE code='ENG'),
        'grace@example.test', 'Grace Hopper', 145000)
RETURNING employee_id, name_key;
 employee_id |   name_key   
-------------+--------------
           1 | grace hopper
(1 row)

-- I08 multi-row with scalar subquery
INSERT INTO employee(department_id, email, full_name, salary, status) VALUES
 ((SELECT department_id FROM department WHERE code='OPS'), 'linus@example.test', 'Linus Torvalds', 130000, 'active'),
 ((SELECT department_id FROM department WHERE code='HR'), 'margaret@example.test', 'Margaret Hamilton', 155000, 'leave'),
 ((SELECT department_id FROM department WHERE code='FIN'), 'edsger@example.test', 'Edsger Dijkstra', 140000, 'active');
-- I09 NULL and composite value
INSERT INTO project(name, priority, cost, address)
VALUES ('No-address', 'low', 0, NULL),
       ('HQ', 'high', 50000, ROW('1 Main St','Hangzhou','310000'));
-- I10 partition routing
INSERT INTO audit_log(happened_on, actor, payload) VALUES
 ('2025-06-01','tester','{"source":"partition"}'),
 ('2030-01-01','tester','{"source":"default"}');
-- I11 ON CONFLICT DO NOTHING
INSERT INTO department(code, name) VALUES ('ENG', 'Duplicate')
ON CONFLICT (code) DO NOTHING;
ERROR:  INSERT with ON CONFLICT clause cannot be used with table that has INSERT or UPDATE rules
-- I12 ON CONFLICT DO UPDATE
INSERT INTO department(code, name, budget) VALUES ('OPS','Ops renamed',275000)
ON CONFLICT (code) DO UPDATE
SET name = EXCLUDED.name, budget = EXCLUDED.budget
RETURNING department_id, budget;
ERROR:  INSERT with ON CONFLICT clause cannot be used with table that has INSERT or UPDATE rules
-- I13 CTE insert
WITH new_rows(email, full_name) AS (
  VALUES ('barbara@example.test','Barbara Liskov'),
         ('donald@example.test','Donald Knuth')
)
INSERT INTO employee(department_id,email,full_name,salary)
SELECT d.department_id,n.email,n.full_name,125000
FROM new_rows n CROSS JOIN department d WHERE d.code='ENG';
--
-- Test SELECT
--
-- S01 constant
SELECT 1 AS one;
 one 
-----
   1
(1 row)

-- S02 all rows
SELECT department_id, code, name, budget FROM department ORDER BY department_id;
 department_id | code  |    name     |  budget   
---------------+-------+-------------+-----------
             1 | ENG   | Engineering |      0.00
             2 | OPS   | Operations  | 250000.00
             3 | HR    | People      |  90000.00
             4 | FIN   | Finance     | 120000.00
             5 | SALES | Sales       | 180000.00
(5 rows)

-- S03 projection/filter
SELECT code, name FROM department WHERE budget >= 100000;
