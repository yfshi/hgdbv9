-- S15 LATERAL
SELECT d.code, x.full_name
FROM department d
LEFT JOIN LATERAL (
  SELECT full_name FROM employee e WHERE e.department_id=d.department_id
  ORDER BY salary DESC LIMIT 1
) x ON true;
