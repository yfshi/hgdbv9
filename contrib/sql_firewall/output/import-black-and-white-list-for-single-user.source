/**
 * batch import white and black list sql clause to specified user, the test is four step.
 *
 * first step: create the relative oject, then bacth imposrt white list sql clause to specified user, 
 * then execute these sql, and these sql is no warning and error.
 *
 * second step: switch user, and execute these sql, and these sql is always warning and error.
 *
 * thrid step: drop all object that created by first step. and recreate these relative object, then batch import * black list to specified user, and then excute these sql, and the sql clause always generated warning or error.
 *
 * four step: swith user, and excute these sql clause always generated warning or error. the final turn off
 * sql_firewall.firewall, and cleare all obeject by created in these step.
 * 
 *
 **/
/*
 * first part: batch import white list sql to specified user.
 * expected: no warning or error will be generated.
 *
 */
--
-- first part: 1. turn off sql_firewall.firewall, then create the relative object 
--
ALTER SYSTEM SET sql_firewall.firewall to 'disabled';
SELECT hg_security.import_white_list('SELECT pg_reload_conf();');
 import_white_list 
-------------------
 t
(1 row)

SELECT hg_security.import_white_list('SELECT pg_sleep(1);');
