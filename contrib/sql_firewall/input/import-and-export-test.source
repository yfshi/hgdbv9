--
-- first part: 1. turn off sql_firewall.firewall, then create the relative object 
--
ALTER SYSTEM SET sql_firewall.firewall to 'disabled';
SELECT hg_security.import_white_list('SELECT pg_reload_conf();');
SELECT hg_security.import_white_list('SELECT pg_sleep(1);');
SELECT pg_reload_conf();
SELECT pg_sleep(1);

\c - sqlfirewallsuperuser

CREATE ROLE case_owner NOLOGIN;
CREATE GROUP case_group NOLOGIN;
CREATE USER case_user PASSWORD 'Case-only-password-42' NOSUPERUSER NOCREATEDB;
CREATE SCHEMA case_lab AUTHORIZATION CURRENT_USER;
CREATE SCHEMA case_alt AUTHORIZATION CURRENT_USER;
SET search_path = "$user", public, case_lab;

CREATE TABLE department (
  department_id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  code text NOT NULL UNIQUE,
  name text NOT NULL,
  budget numeric(14,2) NOT NULL DEFAULT 0 CHECK (budget >= 0),
  created_at timestamptz NOT NULL DEFAULT clock_timestamp()
);

CREATE TABLE employee (
  employee_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  department_id integer REFERENCES department(department_id),
  manager_id bigint REFERENCES employee(employee_id) DEFERRABLE INITIALLY DEFERRED,
  email text NOT NULL UNIQUE,
  full_name text NOT NULL,
  salary numeric(12,2) CHECK (salary >= 0),
  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','leave','closed')),
  skills text[] NOT NULL DEFAULT '{}',
  profile jsonb NOT NULL DEFAULT '{}',
  hired_on date NOT NULL DEFAULT CURRENT_DATE,
  name_key text GENERATED ALWAYS AS (lower(full_name)) STORED
);

CREATE TABLE audit_log (
  log_id bigint GENERATED ALWAYS AS IDENTITY,
  happened_on date NOT NULL,
  actor text,
  payload jsonb,
  PRIMARY KEY (log_id, happened_on)
) PARTITION BY RANGE (happened_on);
CREATE TABLE audit_log_2025 PARTITION OF audit_log
  FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
CREATE TABLE audit_log_default PARTITION OF audit_log DEFAULT;

CREATE SEQUENCE ticket_seq START WITH 100 INCREMENT BY 5 MINVALUE 100 CACHE 10;

CREATE DOMAIN positive_money AS numeric(12,2)
  DEFAULT 0 NOT NULL CHECK (VALUE >= 0);

CREATE TYPE priority_level AS ENUM ('low', 'medium', 'high');
CREATE TYPE address_type AS (street text, city text, zip text);
CREATE TABLE project (
  project_id integer PRIMARY KEY DEFAULT nextval('ticket_seq'),
  name text NOT NULL,
  priority priority_level NOT NULL DEFAULT 'medium',
  cost positive_money,
  address address_type
);

CREATE FUNCTION add_tax(n numeric, rate numeric DEFAULT 0.10)
RETURNS numeric LANGUAGE sql IMMUTABLE PARALLEL SAFE
RETURN round(n * (1 + rate), 2);

CREATE PROCEDURE raise_department_budget(p_code text, p_amount numeric)
LANGUAGE plpgsql AS $$
BEGIN
  UPDATE department SET budget = budget + p_amount WHERE code = p_code;
END $$;

CREATE FUNCTION employee_audit_fn() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  INSERT INTO audit_log(happened_on, actor, payload)
  VALUES (CURRENT_DATE, current_user,
          jsonb_build_object('op', TG_OP, 'employee_id', NEW.employee_id));
  RETURN NEW;
END $$;

CREATE TRIGGER employee_audit_trg
AFTER INSERT OR UPDATE ON employee
FOR EACH ROW EXECUTE FUNCTION employee_audit_fn();

CREATE INDEX employee_department_idx ON employee(department_id);
CREATE INDEX employee_active_salary_idx ON employee(salary DESC)
  INCLUDE (full_name) WHERE status = 'active';
CREATE INDEX employee_profile_gin_idx ON employee USING gin(profile);

CREATE VIEW active_employee_v AS
SELECT employee_id, department_id, full_name, salary
FROM employee WHERE status = 'active'
WITH LOCAL CHECK OPTION;

CREATE MATERIALIZED VIEW department_rollup_mv AS
SELECT d.department_id, d.code, count(e.*) AS employee_count,
       coalesce(sum(e.salary), 0) AS payroll
FROM department d LEFT JOIN employee e USING (department_id)
GROUP BY d.department_id, d.code
WITH DATA;
CREATE UNIQUE INDEX department_rollup_mv_pk
  ON department_rollup_mv(department_id);

CREATE STATISTICS employee_dep_status_stats (dependencies, ndistinct)
ON department_id, status FROM employee;

ALTER TABLE employee ENABLE ROW LEVEL SECURITY;
CREATE POLICY employee_read_policy ON employee FOR SELECT TO PUBLIC
USING (status <> 'closed');
CREATE POLICY employee_write_policy ON employee FOR UPDATE TO PUBLIC
USING (status <> 'closed') WITH CHECK (salary >= 0);

CREATE TABLE rule_sink(message text, created_at timestamptz DEFAULT now());
CREATE RULE department_notice AS ON INSERT TO department
DO ALSO INSERT INTO rule_sink(message) VALUES ('department inserted: ' || NEW.code);

CREATE TEMP TABLE default_probe(id bigint GENERATED ALWAYS AS IDENTITY, note text DEFAULT 'defaulted');

CREATE TEMP TABLE copy_probe(id integer, note text);

CREATE TEXT SEARCH CONFIGURATION case_ts_cfg (COPY = pg_catalog.simple);

CREATE TEXT SEARCH DICTIONARY case_ts_dict (TEMPLATE = simple, STOPWORDS = 'english');


CREATE FUNCTION case_int_to_text(integer) RETURNS text LANGUAGE sql IMMUTABLE STRICT RETURN $1::text;
CREATE CAST (integer AS text) WITH FUNCTION case_int_to_text(integer) AS ASSIGNMENT;


CREATE AGGREGATE case_sum(integer) (SFUNC = int4pl, STYPE = integer, INITCOND = '0');

CREATE FUNCTION case_int_eq(integer,integer) RETURNS boolean LANGUAGE sql IMMUTABLE STRICT RETURN $1=$2;
CREATE OPERATOR === (LEFTARG=integer, RIGHTARG=integer, FUNCTION=case_int_eq);

CREATE FOREIGN DATA WRAPPER case_fdw NO HANDLER;

CREATE SERVER case_server FOREIGN DATA WRAPPER case_fdw OPTIONS (host 'example.invalid');

CREATE USER MAPPING FOR CURRENT_USER SERVER case_server OPTIONS (user 'case_remote');

CREATE FOREIGN TABLE case_foreign_table(id integer, note text)
SERVER case_server OPTIONS (schema_name 'public', table_name 'remote_case');
ALTER FOREIGN TABLE case_foreign_table ADD COLUMN extra text;

CREATE DEFAULT CONVERSION case_utf8_to_latin1
FOR 'UTF8' TO 'LATIN1' FROM pg_catalog.utf8_to_iso8859_1;
ALTER CONVERSION case_utf8_to_latin1 RENAME TO case_utf8_to_latin1_v2;
DROP CONVERSION case_utf8_to_latin1_v2;

CREATE ACCESS METHOD case_heap TYPE TABLE HANDLER heap_tableam_handler;
COMMENT ON ACCESS METHOD case_heap IS 'test access method alias';
DROP ACCESS METHOD case_heap;

CREATE FUNCTION case_ddl_event_fn() RETURNS event_trigger LANGUAGE plpgsql AS $$
BEGIN RAISE NOTICE 'DDL tag=%', tg_tag; END $$;
CREATE EVENT TRIGGER case_ddl_event ON ddl_command_end
WHEN TAG IN ('CREATE TABLE') EXECUTE FUNCTION case_ddl_event_fn();

