INSERT INTO employee(employee_id, department_id, email, full_name, salary, skills, profile)
OVERRIDING SYSTEM VALUE
VALUES (1001, (SELECT department_id FROM department WHERE code='ENG'),
        'ada@example.test', 'Ada Lovelace', 150000,
        ARRAY['sql','math'], '{"level":5,"remote":true}');
