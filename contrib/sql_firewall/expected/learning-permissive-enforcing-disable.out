BEGIN ISOLATION LEVEL READ COMMITTED READ WRITE;
SET CONSTRAINTS ALL DEFERRED;
DECLARE employee_cursor SCROLL CURSOR FOR SELECT employee_id,full_name FROM employee ORDER BY employee_id;
