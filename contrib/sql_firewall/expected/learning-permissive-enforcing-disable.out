-- R001 Node: CreateSubscriptionStmt / AlterSubscriptionStmt / DropSubscriptionStmt
-- Replace the conninfo and publication with a reachable test publisher.
CREATE SUBSCRIPTION case_subscription
CONNECTION 'host=127.0.0.1 port=5432 dbname=postgres user=replicator'
PUBLICATION case_publication
WITH (
    connect = false,
    create_slot = false,
    enabled = false,
    slot_name = NONE
);
WARNING:  tables were not subscribed, you will have to run ALTER SUBSCRIPTION ... REFRESH PUBLICATION to subscribe the tables
ALTER SUBSCRIPTION case_subscription SET (streaming=false);
ALTER SUBSCRIPTION case_subscription DISABLE;
ALTER SUBSCRIPTION case_subscription RENAME TO case_subscription_v2;
DROP SUBSCRIPTION case_subscription_v2;
