-- A014 Node: AlterRoleSetStmt
ALTER ROLE case_user IN DATABASE :DBNAME SET application_name='postgres-case-role';
-- A015 Node: AlterGroupStmt
ALTER GROUP case_group ADD USER case_user;
ALTER GROUP case_group DROP USER case_user;
-- A016 Node: CommentStmt
COMMENT ON TABLE employee IS 'SQL regression test employee table';
