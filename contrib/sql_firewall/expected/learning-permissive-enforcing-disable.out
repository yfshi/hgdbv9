(1 row)

MOVE LAST FROM employee_cursor;
CLOSE employee_cursor;
SAVEPOINT case_sp;
UPDATE department SET budget=budget WHERE code='ENG';
ROLLBACK TO SAVEPOINT case_sp;
RELEASE SAVEPOINT case_sp;
COMMIT;
