-- A001 Node: AlterTableStmt
ALTER TABLE project ADD COLUMN description text DEFAULT 'n/a';
ALTER TABLE project ALTER COLUMN description SET DEFAULT 'n/a';
ALTER TABLE project ALTER COLUMN description SET NOT NULL;
ALTER TABLE project ALTER COLUMN description TYPE varchar(500);
ALTER TABLE project ADD CONSTRAINT project_name_nonempty CHECK (length(name)>0) NOT VALID;
ALTER TABLE project VALIDATE CONSTRAINT project_name_nonempty;
ALTER TABLE project DROP CONSTRAINT project_name_nonempty;
ALTER TABLE project ALTER COLUMN description DROP DEFAULT;
ALTER TABLE project ALTER COLUMN description DROP NOT NULL;
ALTER TABLE project DROP COLUMN description;
ALTER TABLE employee DISABLE TRIGGER employee_audit_trg;
ALTER TABLE employee ENABLE TRIGGER employee_audit_trg;
ALTER TABLE employee FORCE ROW LEVEL SECURITY;
ALTER TABLE employee NO FORCE ROW LEVEL SECURITY;
-- A002 Node: RenameStmt
ALTER TABLE rule_sink RENAME COLUMN message TO event_message;
ALTER TABLE rule_sink RENAME COLUMN event_message TO message;
ALTER INDEX employee_department_idx RENAME TO employee_dep_idx;
ALTER INDEX employee_dep_idx RENAME TO employee_department_idx;
-- A003 Node: AlterObjectSchemaStmt
ALTER TABLE rule_sink SET SCHEMA case_alt;
ALTER TABLE case_alt.rule_sink SET SCHEMA case_lab;
