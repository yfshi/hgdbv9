BEGIN;
SAVEPOINT depends_error;
ALTER FUNCTION add_tax(numeric,numeric) DEPENDS ON EXTENSION plpgsql;
ROLLBACK TO SAVEPOINT depends_error;
COMMIT;
-- A011 Node: AlterPolicyStmt
ALTER POLICY employee_read_policy ON employee TO PUBLIC USING (status IN ('active','leave'));
-- A012 Node: AlterStatsStmt
ALTER STATISTICS employee_dep_status_stats SET STATISTICS 500;
-- A013 Node: AlterRoleStmt
ALTER ROLE case_user SET statement_timeout='5s';
