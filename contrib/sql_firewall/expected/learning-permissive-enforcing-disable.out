ALTER SEQUENCE ticket_seq INCREMENT BY 10 RESTART WITH 1000 CACHE 5;
-- A006 Node: AlterDomainStmt
ALTER DOMAIN positive_money ADD CONSTRAINT positive_money_ceiling CHECK (VALUE < 100000000) NOT VALID;
ALTER DOMAIN positive_money VALIDATE CONSTRAINT positive_money_ceiling;
ALTER DOMAIN positive_money DROP CONSTRAINT positive_money_ceiling;
-- A007 Node: AlterEnumStmt
ALTER TYPE priority_level ADD VALUE IF NOT EXISTS 'urgent' AFTER 'high';
ALTER TYPE priority_level RENAME VALUE 'urgent' TO 'critical';
-- A008 Node: AlterCompositeTypeStmt
