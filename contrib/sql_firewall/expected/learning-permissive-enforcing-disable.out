--
-- Test UPDATE
--
-- U01 one row
UPDATE department SET budget=budget+1000 WHERE code='HR';
-- U02 multiple columns
UPDATE employee SET salary=salary*1.02, profile=profile || '{"reviewed":true}' WHERE email='ada@example.test';
-- U03 UPDATE ... FROM
UPDATE employee e SET salary=e.salary+500
FROM department d WHERE e.department_id=d.department_id AND d.code='ENG';
-- U04 scalar subquery
UPDATE department d SET budget=(SELECT coalesce(sum(e.salary),0) FROM employee e WHERE e.department_id=d.department_id);
WARNING:  Prohibited high-risk SQL statement, it is being executed in permissive mode.
DETAIL:  SQL statement: UPDATE department d SET budget=(SELECT coalesce(sum(e.salary),0) FROM employee e WHERE e.department_id=d.department_id);
-- U05 RETURNING
UPDATE employee SET status='active' WHERE status='leave' RETURNING employee_id,status;
 employee_id | status 
-------------+--------
           3 | active
(1 row)

-- U06 row assignment
UPDATE department SET (name,budget)=('Human Resources',budget+100) WHERE code='HR';
-- U07 JSON path and array append
UPDATE employee SET profile=jsonb_set(profile,'{last_case}','"U07"'), skills=array_append(skills,'testing')
WHERE email='grace@example.test';
-- U08 writable CTE
WITH raised AS (
 UPDATE employee SET salary=salary+250 WHERE salary<135000 RETURNING department_id
)
UPDATE department d SET budget=budget+100
WHERE d.department_id IN (SELECT department_id FROM raised);
-- U09 update through simple view
UPDATE active_employee_v SET salary=salary+10 WHERE full_name='Ada Lovelace';
--
-- Test DELETE
--
-- Seed disposable rows
INSERT INTO employee(department_id,email,full_name,salary,status)
SELECT department_id,'delete1@example.test','Delete One',1,'active' FROM department WHERE code='HR';
INSERT INTO employee(department_id,email,full_name,salary,status)
SELECT department_id,'delete2@example.test','Delete Two',2,'closed' FROM department WHERE code='HR';
INSERT INTO employee(department_id,email,full_name,salary,status)
SELECT department_id,'delete3@example.test','Delete Three',3,'closed' FROM department WHERE code='OPS';
-- D01 simple predicate
DELETE FROM employee WHERE email='delete1@example.test';
-- D02 RETURNING
DELETE FROM employee WHERE email='delete2@example.test' RETURNING employee_id,email;
 employee_id |        email         
-------------+----------------------
           8 | delete2@example.test
(1 row)

-- D03 USING join
DELETE FROM employee e USING department d
WHERE e.department_id=d.department_id AND d.code='OPS' AND e.email LIKE 'delete%';
-- D04 IN subquery
DELETE FROM audit_log WHERE log_id IN (SELECT log_id FROM audit_log WHERE actor='nobody');
-- D05 EXISTS correlated
DELETE FROM project p WHERE EXISTS (SELECT 1 FROM project p2 WHERE p2.project_id=p.project_id AND p2.name='never');
-- D06 CTE-driven
WITH doomed AS (SELECT project_id FROM project WHERE name='No-address')
DELETE FROM project p USING doomed d WHERE p.project_id=d.project_id;
-- D07 delete from partitioned parent
DELETE FROM audit_log WHERE happened_on='2030-01-01';
-- D08 delete all rows in temp table
DELETE FROM default_probe;
WARNING:  Prohibited high-risk SQL statement, it is being executed in permissive mode.
DETAIL:  SQL statement: DELETE FROM default_probe;
-- D09 no-match boundary
DELETE FROM employee WHERE employee_id=-9223372036854775808;
