-- V003 Node: CreateEventTrigStmt / AlterEventTrigStmt
CREATE FUNCTION case_ddl_event_fn() RETURNS event_trigger LANGUAGE plpgsql AS $$
BEGIN RAISE NOTICE 'DDL tag=%', tg_tag; END $$;
CREATE EVENT TRIGGER case_ddl_event ON ddl_command_end
WHEN TAG IN ('CREATE TABLE') EXECUTE FUNCTION case_ddl_event_fn();
ALTER EVENT TRIGGER case_ddl_event DISABLE;
ALTER EVENT TRIGGER case_ddl_event ENABLE;
ALTER EVENT TRIGGER case_ddl_event OWNER TO CURRENT_USER;
DROP EVENT TRIGGER case_ddl_event;
DROP FUNCTION case_ddl_event_fn();
-- V004 Node: CreateOpFamilyStmt / CreateOpClassStmt / AlterOpFamilyStmt / DropOpClassStmt / DropOpFamilyStmt
CREATE OPERATOR FAMILY case_int4_family USING btree;
CREATE OPERATOR CLASS case_int4_ops
FOR TYPE integer
USING btree
FAMILY case_int4_family AS
    OPERATOR 1 <  (integer,integer),
    OPERATOR 2 <= (integer,integer),
    OPERATOR 3 =  (integer,integer),
    OPERATOR 4 >= (integer,integer),
    OPERATOR 5 >  (integer,integer),
    FUNCTION 1 btint4cmp(integer,integer);
ALTER OPERATOR FAMILY case_int4_family USING btree
ADD OPERATOR 1 < (integer, smallint);
ALTER OPERATOR FAMILY case_int4_family USING btree
DROP OPERATOR 1 (integer, smallint);
DROP OPERATOR CLASS case_int4_ops USING btree;
DROP OPERATOR FAMILY case_int4_family USING btree;
