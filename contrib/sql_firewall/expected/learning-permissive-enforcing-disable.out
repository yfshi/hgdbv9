-- I01 single row, defaults
INSERT INTO department(code, name) VALUES ('ENG', 'Engineering');
-- I02 explicit values
INSERT INTO department(code, name, budget) VALUES ('OPS', 'Operations', 250000);
-- I03 multi-row insert
INSERT INTO department(code, name, budget) VALUES
 ('HR', 'People', 90000), ('FIN', 'Finance', 120000), ('SALES', 'Sales', 180000);
-- I04 DEFAULT VALUES into a compatible temporary table
CREATE TEMP TABLE default_probe(id bigint GENERATED ALWAYS AS IDENTITY, note text DEFAULT 'defaulted');
INSERT INTO default_probe DEFAULT VALUES;
-- I05 INSERT ... SELECT
INSERT INTO project(name, priority, cost)
SELECT 'Project-' || code, 'medium'::priority_level, budget / 10 FROM department;
