-- Test  Grant / Revoke
--
-- P001 Node: GrantStmt / RevokeStmt
GRANT USAGE ON SCHEMA case_lab TO case_group;
GRANT SELECT, INSERT(email,full_name) ON employee TO case_group WITH GRANT OPTION;
REVOKE GRANT OPTION FOR SELECT ON employee FROM case_group;
