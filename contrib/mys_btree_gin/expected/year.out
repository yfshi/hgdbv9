-- year check
SELECT set_config('search_path', 'ivymy, '||current_setting('search_path'), false);
       set_config       
------------------------
 ivymy, "$user", public
(1 row)

CREATE TABLE yeartest(y YEAR);
\copy yeartest from 'data/year.data'
SET enable_seqscan=on;
SELECT count(*) FROM yeartest WHERE y <  '2016';
 count 
-------
   357
(1 row)

SELECT count(*) FROM yeartest WHERE y <= '2016';
 count 
-------
   362
(1 row)

SELECT count(*) FROM yeartest WHERE y  = '2016';
 count 
-------
     5
(1 row)

SELECT count(*) FROM yeartest WHERE y >= '2016';
 count 
-------
   187
(1 row)

SELECT count(*) FROM yeartest WHERE y >  '2016';
 count 
-------
   182
(1 row)

CREATE INDEX yearidx on yeartest USING gin(y);
SET enable_seqscan=off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM yeartest WHERE y <  '2016';
                   QUERY PLAN                   
------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on yeartest
         Recheck Cond: (y < '2016'::"year")
         ->  Bitmap Index Scan on yearidx
               Index Cond: (y < '2016'::"year")
(5 rows)

