		where nspname = 'ddd';
	select oid into tableoid from pg_class 
		where relname = 't1' and relnamespace = schemaoid;

	histname := 'hist_'::text || tableoid::text ;
	FOR result IN EXECUTE format('select * from hg_security.%I;',histname) LOOP
		raise notice '%',result;
	END LOOP;
END $$;
