select * from bar where f1 in (select f1 from foo) for share;
                     QUERY PLAN                     
----------------------------------------------------
 LockRows
   Output: bar.f1, bar.f2, bar.ctid, foo.ctid
   ->  Hash Join
         Output: bar.f1, bar.f2, bar.ctid, foo.ctid
         Inner Unique: true
         Hash Cond: (bar.f1 = foo.f1)
         ->  Seq Scan on public.bar
               Output: bar.f1, bar.f2, bar.ctid
         ->  Hash
               Output: foo.ctid, foo.f1
               ->  HashAggregate
                     Output: foo.ctid, foo.f1
