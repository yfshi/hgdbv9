-- datetime check
SET NLS_TIMESTAMP_FORMAT='YYYY-MM-DD HH24:MI:SS.FF9';
CREATE TABLE datetimetmp (a datetime);
\copy datetimetmp from 'data/datetime.data'
SET enable_seqscan=on;
SELECT count(*) FROM datetimetmp WHERE a <  '2004-10-26 08:55:08';
 count 
-------
   270
(1 row)

SELECT count(*) FROM datetimetmp WHERE a <= '2004-10-26 08:55:08';
 count 
-------
   271
(1 row)

SELECT count(*) FROM datetimetmp WHERE a  = '2004-10-26 08:55:08';
 count 
-------
     1
(1 row)

SELECT count(*) FROM datetimetmp WHERE a >= '2004-10-26 08:55:08';
 count 
-------
   274
(1 row)

SELECT count(*) FROM datetimetmp WHERE a >  '2004-10-26 08:55:08';
 count 
-------
   273
(1 row)

SELECT count(*) FROM datetimetmp WHERE a <> '2004-10-26 08:55:08';
 count 
-------
   543
(1 row)

SELECT a, a <-> '2004-10-26 08:55:08' FROM datetimetmp ORDER BY a <-> '2004-10-26 08:55:08' LIMIT 3;
          a          |        ?column?        
---------------------+------------------------
 2004-10-26 08:55:08 | @ 0
 2004-10-31 06:35:03 | @ 4.977995 secs
 2004-11-29 20:12:43 | @ 1 min 43.115735 secs
(3 rows)

CREATE INDEX mysdatetimeidx ON datetimetmp USING gist ( a );
SET enable_seqscan=off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM datetimetmp WHERE a <  '2004-10-26 08:55:08'::datetime;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on datetimetmp
         Recheck Cond: (a < '2004-10-26 08:55:08'::datetime)
         ->  Bitmap Index Scan on mysdatetimeidx
               Index Cond: (a < '2004-10-26 08:55:08'::datetime)
(5 rows)

