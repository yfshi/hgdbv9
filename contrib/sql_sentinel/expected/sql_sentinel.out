--fail:match length
select length('abc');
ERROR:  SQL injection attack detected: rules=sensitive_fun
--fail:match length
DO $$
BEGIN
	FOR i IN 1..100 LOOP
	PERFORM length('abcd');
	END LOOP;
END $$;
ERROR:  SQL injection attack detected: rules=sensitive_fun
CONTEXT:  SQL statement "SELECT length('abcd')"
PL/pgSQL function inline_code_block line 4 at PERFORM
create table t1 (id int);
insert into t1 values(1);
--fail:match length
update t1 set id=2 where length('abcd') = 4;
ERROR:  SQL injection attack detected: rules=sensitive_fun
--fail: match stacked_query
select 1\; select 2;
ERROR:  SQL injection attack detected: rules=stack_qry
ALTER SYSTEM SET sql_sentinel.intercept_target = "taut_const, sensitive_fun, stack_qry, catalog, union, comment";
select pg_reload_conf();
 pg_reload_conf 
----------------
 t
