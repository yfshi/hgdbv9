--
-- HMAC-SHA1
--
SELECT encode(hmac(
'Hi There',
decode('0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b', 'hex'),
'sm3'), 'hex');
                              encode                              
------------------------------------------------------------------
 12d66c84b4a40ad8035c263e419bd43c7e52fb438b930eba0c94e34cdb9b63f3
(1 row)

-- 2
SELECT encode(hmac(
'Jefe',
'what do ya want for nothing?',
'sm3'), 'hex');
                              encode                              
------------------------------------------------------------------
 02a361cd5cfcf0ee3ec522732c2f3ba18963ab19b13aadb222d0a713274d7a70
(1 row)

-- 3
SELECT encode(hmac(
decode('dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd', 'hex'),
decode('aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'hex'),
'sm3'), 'hex');
                              encode                              
------------------------------------------------------------------
 7bfeba1b1518329f73aad171e89009fc41d43b66de11e779b5615bfbf0b85973
(1 row)

