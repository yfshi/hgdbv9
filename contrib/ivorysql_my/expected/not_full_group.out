SELECT 1 AS one,a,count(b) FROM test_having HAVING a > 1;
 one | a | count 
-----+---+-------
(0 rows)

--no rows
SELECT 1 AS one,a,count(b) FROM test_having where b > 0  HAVING a > 1;
 one | a | count 
-----+---+-------
(0 rows)

--8 rows
SELECT 1 AS one,a FROM test_having HAVING a > 1 ORDER BY a;
 one | a 
