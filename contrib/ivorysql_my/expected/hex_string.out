create table hex_test as select 0x11;
\d hex_test
                Table "public.hex_test"
  Column  |   Type    | Collation | Nullable | Default 
----------+-----------+-----------+----------+---------
 ?column? | varbinary |           |          | 

drop table hex_test;
set mysql.cast_to_char = on;
