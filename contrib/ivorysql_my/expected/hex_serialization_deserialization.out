--
-- stringtonode_regression.sql
--
-- Purpose:
--   Verify StringToNode() can deserialize nodes stored in pg_attrdef.adbin.
--
-- Test Flow:
--   1. Create table with various default expressions.
--   2. Verify pg_attrdef.adbin exists.
--   3. Verify pg_get_expr() can deparse adbin.
--   4. Insert default row.
--
set mysql.use_mysql_bit_literal = on;
DROP TABLE IF EXISTS test_stringtonode_default;
NOTICE:  table "test_stringtonode_default" does not exist, skipping
CREATE TABLE test_stringtonode_default
(
    --------------------------------------------------------------------
    -- basic const
    --------------------------------------------------------------------
    id              int             DEFAULT 1,
    --------------------------------------------------------------------
    -- ordinary text const
    --------------------------------------------------------------------
    c_text          text            DEFAULT 'abc',
    --------------------------------------------------------------------
    -- MySQL hex literal
    --------------------------------------------------------------------
    c_hex           bytea           DEFAULT x'41ff00',
    --------------------------------------------------------------------
    -- bit literal
    --------------------------------------------------------------------
    c_bit1          bit(1)          DEFAULT b'0',
    c_bit8          bit(8)          DEFAULT b'00000001',
    oa2415     ivymy.mysbit(1)      DEFAULT b'1'
);
--
-- Step 1
-- Verify adbin content generated by nodeToString()
--
-- SELECT
--     a.attnum,
--     a.attname,
--     d.adbin
-- FROM pg_catalog.pg_attrdef d
-- JOIN pg_catalog.pg_attribute a
--   ON a.attrelid = d.adrelid
--  AND a.attnum   = d.adnum
-- WHERE d.adrelid = 'test_stringtonode_default'::regclass
-- ORDER BY a.attnum;
--
-- Step 2
-- Verify StringToNode() + pg_get_expr()
--
-- If StringToNode() cannot recognize a node,
-- pg_get_expr() will usually fail here.
--
SELECT
    a.attnum,
    a.attname,
    pg_catalog.pg_get_expr(d.adbin, d.adrelid) AS default_expr
FROM pg_catalog.pg_attrdef d
JOIN pg_catalog.pg_attribute a
  ON a.attrelid = d.adrelid
 AND a.attnum   = d.adnum
WHERE d.adrelid = 'test_stringtonode_default'::regclass
ORDER BY a.attnum;
 attnum | attname | default_expr 
--------+---------+--------------
      1 | id      | 1
      2 | c_text  | 'abc'::text
      3 | c_hex   | 0x41ff00
      4 | c_bit1  | 0x00
      5 | c_bit8  | 0x01
      6 | oa2415  | 0x01
(6 rows)

--
-- Step 3
-- Execute defaults
--
INSERT INTO test_stringtonode_default
DEFAULT VALUES;
--
-- Step 4
-- Verify actual values
--
SELECT
    id,
    c_text,
    encode(c_hex, 'hex') AS c_hex,
    c_bit1,
    c_bit8,
    oa2415
FROM test_stringtonode_default;
 id | c_text | c_hex  | c_bit1 | c_bit8 | oa2415 
----+--------+--------+--------+--------+--------
  1 | abc    | 41ff00 | 0x00   | 0x01   | 0x01
(1 row)

--
-- Expected Result
--
-- id      = 1
-- c_text  = abc
-- c_hex   = 41ff00
-- c_bit1  = 0x00
-- c_bit8  = 0x01
-- oa2415  = 0x01
--
-- Step 5
-- Direct catalog inspection
--
-- Useful when debugging StringToNode()
--
-- SELECT
--     a.attname,
--     d.adbin,
--     pg_catalog.pg_get_expr(d.adbin, d.adrelid) AS adsrc
-- FROM pg_catalog.pg_attrdef d
-- JOIN pg_catalog.pg_attribute a
--   ON a.attrelid = d.adrelid
--  AND a.attnum   = d.adnum
-- WHERE d.adrelid = 'test_stringtonode_default'::regclass
-- ORDER BY a.attnum;
DROP TABLE test_stringtonode_default;
CREATE TABLE `bpm_form` (
  fields varchar(5000) COLLATE utf8mb4_unicode_ci NOT NULL 
);
select * from bpm_form;
 fields 
--------
(0 rows)

drop table bpm_form;
reset mysql.use_mysql_bit_literal;
