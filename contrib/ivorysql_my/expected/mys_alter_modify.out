-- #
-- # Bug#18038  MySQL server corrupts binary columns data
-- #
CREATE TABLE t1 (s CHAR(8) BINARY);
ERROR:  syntax error at or near "BINARY"
LINE 1: CREATE TABLE t1 (s CHAR(8) BINARY);
                                   ^
INSERT INTO t1 VALUES ('test');
ERROR:  relation "t1" does not exist
LINE 1: INSERT INTO t1 VALUES ('test');
                    ^
SELECT LENGTH(s) FROM t1;
ERROR:  relation "t1" does not exist
LINE 1: SELECT LENGTH(s) FROM t1;
                              ^
ALTER TABLE t1 MODIFY s CHAR(10) BINARY;
ERROR:  syntax error at or near "BINARY"
LINE 1: ALTER TABLE t1 MODIFY s CHAR(10) BINARY;
                                         ^
SELECT LENGTH(s) FROM t1;
ERROR:  relation "t1" does not exist
LINE 1: SELECT LENGTH(s) FROM t1;
                              ^
DROP TABLE t1;
ERROR:  table "t1" does not exist
CREATE TABLE t1 (s BINARY(8));
INSERT INTO t1 VALUES ('test');
SELECT LENGTH(s) FROM t1;
 LENGTH 
--------
      8
(1 row)

SELECT HEX(s) FROM t1;
       HEX        
------------------
 7465737400000000
(1 row)

ALTER TABLE t1 MODIFY s BINARY(10);
SELECT HEX(s) FROM t1;
         HEX          
----------------------
 74657374000000000000
(1 row)

SELECT LENGTH(s) FROM t1;
 LENGTH 
--------
     10
(1 row)

