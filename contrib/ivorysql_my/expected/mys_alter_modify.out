-- modify then update set
create table t1 (a int not null primary key);
insert into t1 values (10);
alter table t1 modify a int auto_increment;
show create table t1;
 Table |               Create Table               
-------+------------------------------------------
 t1    | CREATE TABLE "t1" (                     +
       |     "a" integer NOT NULL AUTO_INCREMENT,+
       |     CONSTRAINT "t1_pkey" PRIMARY KEY (a)+
       | ) AUTO_INCREMENT=11
(1 row)

update t1 set a = 5 where a = 10;
select * from t1 order by a;
 a 
---
 5
(1 row)

show create table t1;
 Table |               Create Table               
-------+------------------------------------------
 t1    | CREATE TABLE "t1" (                     +
       |     "a" integer NOT NULL AUTO_INCREMENT,+
       |     CONSTRAINT "t1_pkey" PRIMARY KEY (a)+
       | ) AUTO_INCREMENT=11
(1 row)

insert into t1 values();
select * from t1 order by a;
 a  
----
  5
 11
(2 rows)

update t1 set a = 20;
ERROR:  duplicate key value violates unique constraint "t1_pkey"
DETAIL:  Key (a)=(20) already exists.
update t1 set a = 20 where a = 5;
select * from t1 order by a;
 a  
----
 11
 20
(2 rows)

drop table t1;
create table t1 (a int not null primary key);
insert into t1 values (10);
alter table t1 modify a int auto_increment;
