alter table t1
drop column to_be_deleted,
change column col2 fourth varchar(30) not null after col3,
modify column col6 int not null first;
show create table t1;
 Table |                 Create Table                 
-------+----------------------------------------------
 t1    | CREATE TABLE "t1" (                         +
       |     "col1" integer NOT NULL AUTO_INCREMENT, +
       |     "fourth" character varying(30) NOT NULL,+
       |     "col3" character varying(20) NOT NULL,  +
       |     "col4" character varying(4) NOT NULL,   +
       |     "col5" t1_col5_anonymous_enum NOT NULL, +
       |     "col6" integer NOT NULL,                +
       |     CONSTRAINT "t1_pkey" PRIMARY KEY (col1) +
       | ) AUTO_INCREMENT=3
(1 row)

select * from t1;
