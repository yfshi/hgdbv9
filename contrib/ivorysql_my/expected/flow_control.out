-- IF
select if (1 > 2, 2, 3); -- 3
 if 
----
  3
(1 row)

select if (1 < 2, 'yes', 'no'); -- yes
 if  
-----
 yes
(1 row)

select if (strcmp('test', 'test1'), 'no', 'yes'); -- no
 if 
----
 no
(1 row)

select if (NULL, 'yes', 'no'); -- 'no'
 if 
----
 no
(1 row)

select if (NULL, NULL, NULL); -- NULL
 if 
----
 
(1 row)

-- ISNULL
select isnull(1);   -- 0
 isnull 
--------
      0
(1 row)

select isnull(0);   -- 0
 isnull 
--------
      0
(1 row)

select isnull(NULL);    -- 1
 isnull 
--------
      1
(1 row)

select isnull(1 + 1);   -- 0
 isnull 
--------
      0
(1 row)

select isnull(1 / 0);   -- 1
WARNING:  Division by 0
 isnull 
--------
