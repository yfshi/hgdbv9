-- always ok in mysql
drop table t;
create table t(a int);
insert into t values (1);
insert into t values (2);
select count(*) from t order by a;
 count 
-------
     2
(1 row)

-- mysql not support this synatx, pg should error
drop table t;
create table t (x int);
insert into t values (0);
insert into t values (1);
insert into t values (2);
insert into t values (3);
insert into t values (4);
select rank(x) within group (order by x) from t;
ERROR:  column "t.x" must appear in the GROUP BY clause or be used in an aggregate function
LINE 1: select rank(x) within group (order by x) from t;
                    ^
DETAIL:  Direct arguments of an ordered-set aggregate must use only grouped columns.
set sql_mode = '';
WARNING:  Changing sql mode 'NO_AUTO_CREATE_USER' is deprecated. It will be removed in a future release.
select rank(x) within group (order by x) from t;
ERROR:  column "t.x" must appear in the GROUP BY clause or be used in an aggregate function
LINE 1: select rank(x) within group (order by x) from t;
                    ^
DETAIL:  Direct arguments of an ordered-set aggregate must use only grouped columns.
reset sql_mode;
