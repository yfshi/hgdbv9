-- ============================================================
-- 9. NULL behavior tests
-- ============================================================
CREATE TABLE regexp_test_null (
    id      INT PRIMARY KEY,
    txt     TEXT,
    pattern TEXT
);
INSERT INTO regexp_test_null (id, txt, pattern) VALUES
    (1, 'abc',  'abc'),
    (2, '123',  '^[0-9]+$'),
    (3, NULL,   'abc'),
    (4, 'abc',  NULL),
    (5, NULL,   NULL),
    (6, '',     '^$');
SELECT '9.1 REGEXP with nullable input/pattern' AS section;
                section                 
----------------------------------------
 9.1 REGEXP with nullable input/pattern
(1 row)

SELECT id, txt, pattern, txt REGEXP pattern AS regexp_result
FROM regexp_test_null
ORDER BY id;
 id | txt | pattern  | regexp_result 
----+-----+----------+---------------
  1 | abc | abc      | t
  2 | 123 | ^[0-9]+$ | t
  3 |     | abc      | 
  4 | abc |          | 
  5 |     |          | 
  6 |     | ^$       | t
(6 rows)

SELECT '9.2 RLIKE with nullable input/pattern' AS section;
                section                
---------------------------------------
 9.2 RLIKE with nullable input/pattern
(1 row)

SELECT id, txt, pattern, txt RLIKE pattern AS rlike_result
FROM regexp_test_null
ORDER BY id;
 id | txt | pattern  | rlike_result 
----+-----+----------+--------------
  1 | abc | abc      | t
  2 | 123 | ^[0-9]+$ | t
  3 |     | abc      | 
  4 | abc |          | 
  5 |     |          | 
  6 |     | ^$       | t
(6 rows)

SELECT '9.3 NOT REGEXP with nullable input/pattern' AS section;
                  section                   
--------------------------------------------
 9.3 NOT REGEXP with nullable input/pattern
(1 row)

SELECT id, txt, pattern, txt NOT REGEXP pattern AS not_regexp_result
FROM regexp_test_null
ORDER BY id;
 id | txt | pattern  | not_regexp_result 
----+-----+----------+-------------------
  1 | abc | abc      | f
  2 | 123 | ^[0-9]+$ | f
  3 |     | abc      | 
  4 | abc |          | 
  5 |     |          | 
  6 |     | ^$       | f
(6 rows)

