  2 | abcd             | t
  4 | abc123           | t
 10 | [abc]            | t
 22 | abcabc           | t
  3 | 123              | f
  5 | hello world      | f
  6 | foo.bar          | f
  7 | a+b              | f
  8 | a*b              | f
  9 | a?b              | f
