SELECT '10.2 Pattern from column value' AS section;
            section             
--------------------------------
 10.2 Pattern from column value
(1 row)

SELECT n.id, n.txt, n.pattern
FROM regexp_test_null n
WHERE n.txt IS NOT NULL
  AND n.pattern IS NOT NULL
  AND n.txt RLIKE n.pattern
ORDER BY n.id;
 id | txt | pattern  
----+-----+----------
  1 | abc | abc
  2 | 123 | ^[0-9]+$
  6 |     | ^$
(3 rows)

-- ============================================================
-- 11. Usage in CASE / ORDER BY / subquery
-- ============================================================
SELECT '11.1 CASE expression with REGEXP/RLIKE/NOT REGEXP' AS section;
                      section                      
---------------------------------------------------
 11.1 CASE expression with REGEXP/RLIKE/NOT REGEXP
(1 row)

SELECT id,
       txt,
       CASE
           WHEN txt REGEXP '^[0-9]+$' THEN 'digits'
           WHEN txt RLIKE 'abc' THEN 'contains_abc'
           WHEN txt NOT REGEXP '^$' THEN 'other_nonempty'
           ELSE 'empty_or_null'
       END AS category
FROM regexp_test_text
ORDER BY id;
 id |       txt        |    category    
----+------------------+----------------
  1 | abc              | contains_abc
  2 | abcd             | contains_abc
  3 | 123              | digits
  4 | abc123           | contains_abc
  5 | hello world      | other_nonempty
  6 | foo.bar          | other_nonempty
  7 | a+b              | other_nonempty
  8 | a*b              | other_nonempty
  9 | a?b              | other_nonempty
 10 | [abc]            | contains_abc
 11 | (test)           | other_nonempty
 12 | ^anchor          | other_nonempty
 13 | end$             | other_nonempty
 14 |                  | empty_or_null
 15 |                  | other_nonempty
 16 | line1\nline2     | other_nonempty
 17 | 中文             | other_nonempty
 18 | ÄÖÜ              | other_nonempty
 19 | user@example.com | other_nonempty
 20 | 2024-01-01       | other_nonempty
 21 | aaa              | other_nonempty
 22 | abcabc           | contains_abc
 23 | 0                | digits
 24 | NULL             | other_nonempty
(24 rows)

SELECT '11.2 ORDER BY regex boolean result' AS section;
              section               
------------------------------------
 11.2 ORDER BY regex boolean result
(1 row)

SELECT id, txt, (txt REGEXP 'abc') AS matched
FROM regexp_test_text
ORDER BY (txt REGEXP 'abc') DESC, id;
 id |       txt        | matched 
----+------------------+---------
