/*
 * test mysql longblob type operator between and
 */
-- parameter settings
set ivorysql.compatible_mode to mysql;
set mysql.enable_character_blob to on;
\pset null 'NULL'
-- clean environment
DROP TABLE IF EXISTS my_longblob_t1;
CREATE TABLE my_longblob_t1(
  c1  longblob
);
INSERT INTO my_longblob_t1 VALUES ('123'), ('12345'), ('abc');
--------------------------------------------------------------------------------
-- should get (123)
SELECT * from my_longblob_t1 WHERE c1 BETWEEN '12' AND '1234';
 c1  
-----
 123
(1 row)

-- should get {123, 12345}
SELECT * from my_longblob_t1 WHERE c1 BETWEEN '12' AND '12346';
  c1   
-------
 123
 12345
(2 rows)

-- should get empty
SELECT * from my_longblob_t1 WHERE c1 BETWEEN '124' AND '999';
 c1 
----
(0 rows)

