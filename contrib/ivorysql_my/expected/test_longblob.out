/*
 * MySQL longblob type operator greater than test.
 */
-- parameter settings
set ivorysql.compatible_mode to mysql;
-- clean environment
DROP TABLE IF EXISTS my_longblob_t1;
CREATE TABLE my_longblob_t1(
  c1  longblob,
  c2  longblob,
  c3  longblob,
  c4  longblob,
  c5  longblob,
  c6  longblob,
  c7  longblob,
  c8  longblob,
  c9  longblob,
  c10 longblob,
  c11 longblob
);
INSERT INTO my_longblob_t1 values('123', '123', '1234', '', null, '1234', 'abcd', 'ABCD', '', null, NULL);
--------------------------------------------------------------------------------
-- TODO[TD015]: should get (1, 0, 1, 0, 0, 0, 0, 0, 1, NULL, NULL, NULL), but get (t, f, t, f, f, f, f, f, t, , , )
select
  c1 = c2,
