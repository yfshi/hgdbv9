DISCARD ALL;
/*
 * test mysql longblob type index.
 */
-- parameter settings
set ivorysql.compatible_mode to mysql;
set enable_seqscan = off;
set mysql.enable_character_blob to on;
\pset null 'NULL'
-- clean environment
DROP TABLE IF EXISTS my_longblob_t01;
CREATE TABLE my_longblob_t01(
  c1 longblob,
  c2 longblob,
  c3 longblob,
  c4 longblob
);
INSERT INTO my_longblob_t01 VALUES ('abcdefghij', 'bcdefghijk', 'cdefghijkl', 'defghijklm');
INSERT INTO my_longblob_t01 VALUES ('abcdefghij', 'bcdefghijk', 'cdefghijkl', 'defghijklm');
INSERT INTO my_longblob_t01 VALUES ('abcdefghij', 'bcdefghijk', 'cdefghijkl', 'defghijklm');
--------------------------------------------------------------------------------
-- case: gin
create index my_longblob_t01_gin on my_longblob_t01 using gin(c1);
select c1 from my_longblob_t01 where c1 = 'abcdefghij';
     c1     
------------
 abcdefghij
 abcdefghij
 abcdefghij
(3 rows)

explain select c1 from my_longblob_t01 where c1 = 'abcdefghij';
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Bitmap Heap Scan on my_longblob_t01  (cost=8.01..12.02 rows=1 width=32)
   Recheck Cond: (c1 = 'abcdefghij'::longblob)
   ->  Bitmap Index Scan on my_longblob_t01_gin  (cost=0.00..8.01 rows=1 width=0)
         Index Cond: (c1 = 'abcdefghij'::longblob)
(4 rows)

-- case: brin
create index my_longblob_t01_brin on my_longblob_t01 using brin(c2);
select c2 from my_longblob_t01 where c2 = 'bcdefghijk';
     c2     
------------
 bcdefghijk
 bcdefghijk
 bcdefghijk
(3 rows)

explain select c2 from my_longblob_t01 where c2 = 'bcdefghijk';
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Bitmap Heap Scan on my_longblob_t01  (cost=12.03..16.07 rows=1 width=32)
   Recheck Cond: (c2 = 'bcdefghijk'::longblob)
   ->  Bitmap Index Scan on my_longblob_t01_brin  (cost=0.00..12.03 rows=3 width=0)
         Index Cond: (c2 = 'bcdefghijk'::longblob)
(4 rows)

-- case: btree
create index my_longblob_t01_btree on my_longblob_t01 using btree(c3);
select c3 from my_longblob_t01 where c3 = 'cdefghijkl';
     c3     
------------
 cdefghijkl
 cdefghijkl
 cdefghijkl
(3 rows)

explain select c3 from my_longblob_t01 where c3 = 'cdefghijkl';
                                            QUERY PLAN                                             
---------------------------------------------------------------------------------------------------
 Index Only Scan using my_longblob_t01_btree on my_longblob_t01  (cost=0.13..8.15 rows=1 width=32)
   Index Cond: (c3 = 'cdefghijkl'::longblob)
(2 rows)

-- case: hash
create index my_longblob_t01_hash on my_longblob_t01 using hash(c4);
select c4 from my_longblob_t01 where c4 = 'defghijklm';
     c4     
------------
 defghijklm
 defghijklm
 defghijklm
(3 rows)

explain select c4 from my_longblob_t01 where c4 = 'defghijklm';
                                          QUERY PLAN                                          
----------------------------------------------------------------------------------------------
 Index Scan using my_longblob_t01_hash on my_longblob_t01  (cost=0.00..12.02 rows=1 width=32)
   Index Cond: (c4 = 'defghijklm'::longblob)
(2 rows)

