 new_year_eve 
--------------
 23:59:59
(1 row)

drop table if exists t1;
NOTICE:  table "t1" does not exist, skipping
SET sql_mode = default;
-- #
-- # Test of date_format()
-- #
create table t1 (d date);
insert into t1 values ('2004-07-14'),('2005-07-14');
select date_format(d,'%d') from t1 order by 1;
 date_format 
-------------
 14
 14
(2 rows)

drop table t1;
-- #
-- # Test of locale dependent date format (WL#2928 Date Translation NRE)
-- #
set names latin1;
select date_format('2004-01-01','%W (%a), %e %M (%b) %Y');
             date_format              
--------------------------------------
 Thursday (Thu), 1 January (Jan) 2004
(1 row)

set lc_time_names=ru_RU;
set names koi8r;
select date_format('2004-01-01','%W (%a), %e %M (%b) %Y');
            date_format             
------------------------------------
 Четверг (Чтв), 1 Января (Янв) 2004
(1 row)

set lc_time_names=de_DE;
set names latin1;
select date_format('2004-01-01','%W (%a), %e %M (%b) %Y');
             date_format              
--------------------------------------
 Donnerstag (Do), 1 Januar (Jan) 2004
(1 row)

set names latin1;
set lc_time_names=en_US;
-- #
-- # Bug #14016 
-- #
create table t1 (f1 datetime);
insert into t1 (f1) values ('2005-01-01');
insert into t1 (f1) values ('2005-02-01');
select date_format(f1, '%m') as d1, date_format(f1, '%M') as d2 from t1 order by date_format(f1, '%M');
 d1 |    d2    
----+----------
 02 | February
 01 | January
(2 rows)

drop table t1;
-- #
-- # Bug#20729:  Bad date_format() call makes mysql server crash
-- #
SELECT DATE_FORMAT('%Y-%m-%d %H:%i:%s', 1151414896);
ERROR:  function DATE_FORMAT(unknown, integer) does not exist
LINE 1: SELECT DATE_FORMAT('%Y-%m-%d %H:%i:%s', 1151414896);
               ^
HINT:  No function matches the given name and argument types. You might need to add explicit type casts.
-- #
-- # Bug #41470: DATE_FORMAT() crashes the complete server with a valid date
-- #
-- # show that these two do not crash the server:
SELECT DATE_FORMAT('0000-01-01','%W %d %M %Y') as valid_date;
        valid_date        
--------------------------
 Saturday 01 January 0000
(1 row)

SELECT DATE_FORMAT('0000-02-28','%W %d %M %Y') as valid_date;
       valid_date        
-------------------------
 Monday 28 February 0000
(1 row)

-- # show that date within the Gregorian range render correct results: (THU)
SELECT DATE_FORMAT('2009-01-01','%W %d %M %Y') as valid_date;
        valid_date        
--------------------------
 Thursday 01 January 2009
(1 row)

