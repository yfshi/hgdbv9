/* Begin - bug#z6503 */
select 
convert(1000.00, decimal(5,2)) , 
convert(12345.67, decimal(5,2)), 
convert(-1000.00, decimal(5,2));
WARNING:  Truncated incorrect DECIMAL value: '1000.00'
WARNING:  Truncated incorrect DECIMAL value: '12345.67'
WARNING:  Truncated incorrect DECIMAL value: '-1000.00'
 numeric | numeric | numeric 
---------+---------+---------
  999.99 |  999.99 | -999.99
(1 row)

select convert(123.456, decimal(10,10)) , 
convert(1234.567, decimal(5,2));
WARNING:  Truncated incorrect DECIMAL value: '123.456'
WARNING:  Truncated incorrect DECIMAL value: '1234.567'
   numeric    | numeric 
--------------+---------
 0.9999999999 |  999.99
(1 row)

/* End - bug#z6503 */
