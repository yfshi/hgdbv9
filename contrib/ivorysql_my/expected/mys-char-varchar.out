/* Begin OA#2701 */
CREATE TABLE biz_case_extra_charge_detail (
    charge_result varchar(64),
    charge_count varchar(64),
    charge_sum_money varchar(64)
);
INSERT INTO
	biz_case_extra_charge_detail
VALUES
('已收费',   '1',   '100.00'),
('退费中',   '2',   '50.00'),
('发送失败', '3',   '20.00'),
('已收费',   'Y',   '200.00'),
('退费中',   'Z',   '300.00'),
('已收费',   '*',   '400.00'),
('退费中',   'X',   '500.00'),
('已收费',   '(',   '600.00'),
('退费中',   ')',   '700.00'),
('已收费',   'ABC', '800.00');
SELECT COUNT(
           CASE
               WHEN charge_result = '发送失败'
                    AND charge_count > 0
               THEN 1
           END
       ) AS failed_count
FROM biz_case_extra_charge_detail
WHERE charge_count NOT REGEXP '[YZ*X()]';
 failed_count 
--------------
            1
(1 row)

SELECT COUNT(
           CASE
               WHEN charge_result = '发送失败'
                    AND charge_count > 0.5
               THEN 1
           END
       ) AS failed_count
FROM biz_case_extra_charge_detail
WHERE charge_count NOT REGEXP '[YZ*X()]';
 failed_count 
--------------
            1
(1 row)

SELECT SUM(
           CASE
               WHEN charge_result IN ('已收费', '退费中')
               THEN charge_sum_money
               ELSE 0
           END
       ) AS total_money
FROM biz_case_extra_charge_detail
WHERE charge_count NOT REGEXP '[YZ*X()]';
 total_money 
-------------
         950
(1 row)

