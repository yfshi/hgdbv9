--user define  variable used in user function
create or replace function func(id int) returns int as $$
declare
	var int;
begin
	var = @var + func1(@var);
	return var;
end;
$$ language plmysql;
create or replace function func1(id int) returns int as $$
declare
	var int;
	var1 int;
begin
	set var = @var + id, var1 = sum(@var);
	return var;
end;
$$ language plmysql;
set @var = 1;
select func(1); --3
