-- did not support expr
create table t_create_uk(a int, b int, c varchar(20),  unique key(a+10));
ERROR:  syntax error at or near "+"
LINE 1: ...t_create_uk(a int, b int, c varchar(20),  unique key(a+10));
                                                                 ^
create table t_create_uk(a int, b int, c varchar(20),  unique key((a+10)));
ERROR:  expressions are not supported in unique constraints
LINE 1: ...e table t_create_uk(a int, b int, c varchar(20),  unique key...
                                                             ^
