ALTER TEXT SEARCH TEMPLATE NAME RENAME TO NAME1;
ALTER TEXT SEARCH TEMPLATE NAME1 SET SCHEMA SC;
DROP TEXT SEARCH TEMPLATE SC.NAME1;
DROP FUNCTION TRANSFER(internal, internal,internal,internal);
DROP SCHEMA SC;
