CREATE OPERATOR === (
LEFTARG = int,
RIGHTARG = int,
FUNCTION = int4eq,
COMMUTATOR = ===,
NEGATOR = !==,
HASHES, MERGES
);
CREATE SCHEMA SC;
ALTER OPERATOR ===(int, int) set SCHEMA SC;
drop OPERATOR SC.===(int, int);
DROP SCHEMA SC;
