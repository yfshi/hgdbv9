SELECT 1 AS result WHERE -1!=+1;
 result 
--------
      1
(1 row)

SELECT 1 AS result WHERE -1!=1;
 result 
--------
      1
(1 row)

SELECT 1 AS result WHERE 1!=-1;
 result 
--------
      1
(1 row)

