/* Begin - bug#z5412 */
create table t_precedence (
    a int4,
    b integer default 10,
    c integer signed
);
insert into t_precedence (a,c) values (5,2);
-- precedence of & is higher than |
select (a << 1) | (b >> 1) & c from t_precedence; -- 10
 ?column? 
----------
 10
(1 row)

select (a << 1) | ((b >> 1) & c) from t_precedence; -- 10
 ?column? 
----------
 10
(1 row)

drop table t_precedence;
/* End - bug#z5412 */
