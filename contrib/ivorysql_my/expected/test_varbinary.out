 \x6162636465666768696a
 \x6162636465666768696a
(3 rows)

select c1 from my_varbinary_t1 where c1 = cast('abcdefghij' as binary(10));
           c1           
------------------------
 \x6162636465666768696a
 \x6162636465666768696a
 \x6162636465666768696a
(3 rows)

