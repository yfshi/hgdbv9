select c1 div c1, c1 div c2, c1 div c3, c1 div c4, c1 div c5, c5 div c6, c5 div c7, c5 div c8, c7 div c8 from my_binary_t2;
 ?column? | ?column? | ?column? | ?column? | ?column? | ?column? | ?column? | ?column? | ?column? 
