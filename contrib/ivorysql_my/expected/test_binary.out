DISCARD ALL;
/*
 * MySQL binary type test.
 */
-- parameter settings
set ivorysql.compatible_mode to mysql;
set mysql.enable_character_blob to on;
\pset null 'NULL'
-- clean environment
DROP TABLE IF EXISTS
  my_binary_t1,
  my_binary_t2,
  my_binary_t3,
  my_binary_t4,
  my_binary_t5,
  my_binary_t6,
  my_binary_t7,
  my_binary_t8
;
NOTICE:  table "my_binary_t1" does not exist, skipping
NOTICE:  table "my_binary_t2" does not exist, skipping
NOTICE:  table "my_binary_t3" does not exist, skipping
NOTICE:  table "my_binary_t4" does not exist, skipping
NOTICE:  table "my_binary_t5" does not exist, skipping
NOTICE:  table "my_binary_t6" does not exist, skipping
NOTICE:  table "my_binary_t7" does not exist, skipping
NOTICE:  table "my_binary_t8" does not exist, skipping
CREATE TABLE my_binary_t1(c1 binary(-1)); -- should error
ERROR:  You have an error in you SQL syntax in binary( ... 
LINE 1: CREATE TABLE my_binary_t1(c1 binary(-1));
                                     ^
CREATE TABLE my_binary_t2(c1 binary(0)); -- should ok
\d my_binary_t2;
             Table "public.my_binary_t2"
 Column |   Type    | Collation | Nullable | Default 
--------+-----------+-----------+----------+---------
 c1     | binary(0) |           |          | 

INSERT INTO my_binary_t2 VALUES('a'); -- should error
ERROR:  Data too long for column
LINE 1: INSERT INTO my_binary_t2 VALUES('a');
                                        ^
CREATE TABLE my_binary_t3(c1 binary); -- should ok
\d my_binary_t3;
             Table "public.my_binary_t3"
 Column |   Type    | Collation | Nullable | Default 
--------+-----------+-----------+----------+---------
 c1     | binary(1) |           |          | 

CREATE TABLE my_binary_t4(c1 binary(255)); -- should ok
\d my_binary_t4;
              Table "public.my_binary_t4"
 Column |    Type     | Collation | Nullable | Default 
--------+-------------+-----------+----------+---------
 c1     | binary(255) |           |          | 

CREATE TABLE my_binary_t5(c1 binary(256)); -- should error
ERROR:  length for type binary cannot exceed 255
LINE 1: CREATE TABLE my_binary_t5(c1 binary(256));
                                     ^
CREATE TABLE my_binary_t6(c1 binary(3)); -- should ok
\d my_binary_t6;
             Table "public.my_binary_t6"
 Column |   Type    | Collation | Nullable | Default 
--------+-----------+-----------+----------+---------
 c1     | binary(3) |           |          | 

INSERT INTO my_binary_t6 VALUES('a');
-- should get (a, 3, f)
SELECT *, length(c1), c1 = 'a' FROM my_binary_t6;
 c1 | length | ?column? 
----+--------+----------
 a  |      3 | f
(1 row)

-- should get (t, f)
SELECT c1 = 'a\0\0', c1 = 'b\0\0' FROM my_binary_t6;
 ?column? | ?column? 
----------+----------
 t        | f
(1 row)

CREATE TABLE my_binary_t7(c1 binary(3)); -- should ok
\d my_binary_t7;
             Table "public.my_binary_t7"
 Column |   Type    | Collation | Nullable | Default 
--------+-----------+-----------+----------+---------
 c1     | binary(3) |           |          | 

