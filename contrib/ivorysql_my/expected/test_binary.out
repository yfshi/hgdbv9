--------------------------------------------------------------------------------
-- should get "(1, 1.5, 0, 1, 0, 2, NULL, 2, 0, NULL)"
select c1/c1, c2/c1, c3/c1, c4/c1, c5/c1, c6/c1, c6/c7, c6/c8, c7/c8, c6/c9 from my_binary_t1;
