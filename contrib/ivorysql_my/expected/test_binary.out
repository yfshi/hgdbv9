\pset null 'NULL'
-- clean environment
DROP TABLE IF EXISTS my_binary_t1;
DROP TABLE IF EXISTS my_binary_t2;
CREATE TABLE my_binary_t1(
  c1 binary(3),
  c2 binary(3),
  c3 binary(3),
  c4 binary(3),
  c5 binary(3),
  c6 binary(10),
  c7 binary(10),
  c8 binary(10),
  c9 binary(10)
);
CREATE TABLE my_binary_t2(
  c1 binary(3),
  c2 binary(3),
  c3 binary(3),
  c4 binary(3),
  c5 binary(10),
  c6 binary(10),
  c7 binary(10),
  c8 binary(10)
);
