-- procedure
CREATE OR REPLACE PROCEDURE proc_mutil
(
c1 int,
c2 int
)
as $$
BEGIN
	delete from a,b using t_t_mutil_t1 a,t_t_mutil_t2 b where a.col2=c1 and b.col2=c2;
END;
$$ language plmysql;
begin;
CALL proc_mutil(1,2);
