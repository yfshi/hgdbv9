rename user u1 to u2;
select usename from pg_user where usename = 'u2';
 usename 
---------
 u2
(1 row)

rename user u2 to u3, u3 to u4;
select usename from pg_user where usename = 'u4';
 usename 
---------
 u4
(1 row)

