create index i1 on t(c);
alter table t rename index i1 to i2;
\d t;
                 Table "public.t"
 Column |  Type   | Collation | Nullable | Default 
--------+---------+-----------+----------+---------
 c      | integer |           |          | 
Indexes:
    "i2" btree (c)

alter table t rename index i2 to i3;
