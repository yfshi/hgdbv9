 id | name 
----+------
  1 | 张三
  2 | 李四
(2 rows)

select * from pt2_1;
 id | name 
----+------
  1 | 张三
  2 | 李四
(2 rows)

delete aa,bb from pt1 partition(pt1_1) aa use index(index_id),pt2 partition (pt2_1) bb use index(index_id2)   where aa.id = bb.id; 
select * from pt1_1;
 id | name 
----+------
(0 rows)

select * from pt2_1;
 id | name 
----+------
(0 rows)

drop table pt1,pt2;
