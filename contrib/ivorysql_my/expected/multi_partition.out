CREATE OR REPLACE PROCEDURE proc_mutil(c1 int,c2 int)
as $$ 
BEGIN
update test_p partition(p2) a,test_p1 partition(p12) b set a.id=c1, b.id=c2 where a.id = b.id;
END $$ language plmysql;
