create table t_int(
    a int1,
    b int2,
    c int3,
    d int4,
    e int8,
    f tinyint unsigned,
    g smallint unsigned,
    h mediumint unsigned,
    i int unsigned,
    j bigint unsigned
);
desc t_int;
 Field |         Type          | Null | Key | Default | Extra 
-------+-----------------------+------+-----+---------+-------
 a     | tinyint(4)            | YES  |     |         | 
 b     | smallint(6)           | YES  |     |         | 
 c     | mediumint(9)          | YES  |     |         | 
 d     | int(11)               | YES  |     |         | 
 e     | bigint(20)            | YES  |     |         | 
 f     | tinyint(3) unsigned   | YES  |     |         | 
 g     | smallint(5) unsigned  | YES  |     |         | 
 h     | mediumint(8) unsigned | YES  |     |         | 
 i     | int(10) unsigned      | YES  |     |         | 
 j     | bigint(20) unsigned   | YES  |     |         | 
(10 rows)

