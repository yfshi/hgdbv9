create table ins_dup(a int unique key, b int);
insert into ins_dup values(1, 1);
insert into ins_dup values(1, 3) on duplicate key update b = a + b;
select * from ins_dup; -- 1, 2
 a | b 
---+---
 1 | 2
(1 row)

insert into ins_dup values(1, 3) on duplicate key update b = values(b);
select * from ins_dup; -- 1, 3
 a | b 
---+---
 1 | 3
(1 row)

drop table ins_dup;
