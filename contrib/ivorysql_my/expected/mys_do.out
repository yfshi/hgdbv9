do testf1();
drop function testf1();
-- fix bug#Z6200
set mysql.at_or_atat = 1;
do
@temperature := 25.5,
@weather := IF(@temperature > 30, 'Hot',
  IF(@temperature > 20, 'Warm',
  IF(@temperature > 10, 'Cool', 'Cold')));
select @weather; --Warm
 @weather 
----------
 Warm
(1 row)

