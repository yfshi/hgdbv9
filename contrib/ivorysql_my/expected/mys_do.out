create procedure v1()
language plpgsql as 
$$
declare
area integer := 0;
begin
area :=1+1; 
end;
$$;
do v1();
ERROR:  v1() is a procedure
LINE 1: do v1();
           ^
HINT:  To call a procedure, use CALL.
call v1();
create procedure v2()
language plpgsql as 
$$
declare
area integer := 0;
begin
area :=1+1; 
do 1+1; 
end;
$$;
do v2();
ERROR:  v2() is a procedure
LINE 1: do v2();
           ^
HINT:  To call a procedure, use CALL.
call v2();
drop procedure v1(),v2();
create function testf1() returns int 
language plpgsql
as $$
begin
do hex(123);
return 1;
end;
$$;
select testf1();
 testf1 
--------
      1
