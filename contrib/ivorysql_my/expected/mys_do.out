do testf1();
drop function testf1();
-- fix bug#Z6200
set mysql.at_or_atat = 1;
do
@temperature := 25.5,
@weather := IF(@temperature > 30, 'Hot',
  IF(@temperature > 20, 'Warm',
  IF(@temperature > 10, 'Cool', 'Cold')));
select @weather; --Warm
 ?column? 
----------
 Warm
(1 row)

-- fix bug#Z6201
do @counter := 0,
@counter := @counter + 1,
@counter := @counter * 10,
@counter := @counter + 5;
select @counter; --15
 ?column? 
----------
       15
(1 row)

-- fix bug#Z6202
do  @a := 10 + 5;
select @a as addition_result; --15
 addition_result 
-----------------
              15
(1 row)

do @x := 100, @y := 50, @z := @x - @y;
