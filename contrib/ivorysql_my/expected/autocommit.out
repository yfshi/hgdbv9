	insert into t values (1);
END;
$$;
CREATE OR REPLACE PROCEDURE func2()
LANGUAGE plpgsql AS $$
BEGIN
	insert into t values (0);
	set autocommit = 1;
	insert into t values (1);
END;
$$;
