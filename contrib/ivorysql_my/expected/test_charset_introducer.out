SELECT id, HEX(vb)
FROM charset_intro_gbk_store_compare;
 id |  HEX   
----+--------
  1 | E4B8AD
  2 | D6D0
  3 | E4B8AD
(3 rows)

-- Expected: 1 warning: Invalid gbk character string: 'AD' 
-- +----+---------+
-- | id | HEX(vb) |
