      QUERY PLAN       
-----------------------
 Seq Scan on idx_2
   Filter: (idx > 222)
(2 rows)

drop table idx_1,idx_2;
create table tb1 (a bigint UNSIGNED);
create or replace procedure proc1()
as
$$
declare
i bigint := 0;
begin
    while i <= 10000 loop
        insert into tb1 (a) values (i);
        i = i+1;
    end loop;
end;
$$ language plmysql;
call proc1();
create index idx1 on tb1 using hash(a);
vacuum full analyze tb1;
explain (COSTS OFF) select * from tb1 where a = 10;
     QUERY PLAN     
--------------------
 Seq Scan on tb1
   Filter: (a = 10)
(2 rows)

drop index idx1;
create index idx_tree on tb1(a);
vacuum full analyze tb1;
set enable_bitmapscan =false;
set enable_seqscan =false;
explain (COSTS OFF) select * from tb1 where a < 10;
              QUERY PLAN               
---------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a < 10)
(2 rows)

explain (COSTS OFF) select * from tb1 where a <= 10;
              QUERY PLAN               
---------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a <= 10)
(2 rows)

explain (COSTS OFF) select * from tb1 where a = 10;
              QUERY PLAN               
---------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a = 10)
(2 rows)

explain (COSTS OFF) select * from tb1 where a != 10;
              QUERY PLAN               
---------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a <> 10)
(2 rows)

explain (COSTS OFF) select * from tb1 where a >= 10;
              QUERY PLAN               
---------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a >= 10)
(2 rows)

explain (COSTS OFF) select * from tb1 where a > 10;
              QUERY PLAN               
---------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a > 10)
(2 rows)

set enable_seqscan =true;
set enable_bitmapscan =true;
drop procedure proc1;
drop table tb1;
