create index idx1 on idx_1 using btree (idx);
insert into idx_1 values ('1022-01-01'),('1522-01-01'),('2022-01-01');
vacuum full analyze idx_1;
explain (COSTS OFF) select * from idx_1 where idx < '2022-01-01';
