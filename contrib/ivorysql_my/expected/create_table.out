--TEST GUC: AUTO_INCREMENT_INCREMENT  AUTO_INCREMENT_OFFSET
CREATE TABLE test_table (
    id INT AUTO_INCREMENT,
    name VARCHAR(50),
    value INT,
    UNIQUE(id)
);
INSERT INTO test_table (name, value) VALUES ('A', 1), ('B', 2), ('C', 3);
SELECT * FROM test_table;
 id | name | value 
----+------+-------
  1 | A    |     1
  2 | B    |     2
  3 | C    |     3
(3 rows)

SET AUTO_INCREMENT_INCREMENT = 10;
SET AUTO_INCREMENT_OFFSET = 100;
INSERT INTO test_table (name, value) VALUES ('D', 4);
SELECT * FROM test_table;
 id | name | value 
----+------+-------
  1 | A    |     1
  2 | B    |     2
  3 | C    |     3
  4 | D    |     4
(4 rows)

INSERT INTO test_table (name, value) VALUES ('D', 4);
SELECT * FROM test_table;
 id | name | value 
----+------+-------
  1 | A    |     1
  2 | B    |     2
  3 | C    |     3
  4 | D    |     4
 14 | D    |     4
(5 rows)

INSERT INTO test_table (name, value) VALUES ('D', 4);
SELECT * FROM test_table;
 id | name | value 
----+------+-------
  1 | A    |     1
  2 | B    |     2
  3 | C    |     3
  4 | D    |     4
 14 | D    |     4
 24 | D    |     4
(6 rows)

SET AUTO_INCREMENT_INCREMENT = 1;
SET AUTO_INCREMENT_OFFSET = 1;
INSERT INTO test_table (name, value) VALUES ('D', 4);
SELECT * FROM test_table;
 id | name | value 
----+------+-------
  1 | A    |     1
  2 | B    |     2
  3 | C    |     3
  4 | D    |     4
 14 | D    |     4
 24 | D    |     4
 30 | D    |     4
(7 rows)

drop table test_table;
--test mysql  ===========================================================================================================
create table t1 (a int not null auto_increment,b int, primary key (a)) auto_increment=3;
insert into t1 values (1,1);
insert into t1 values (NULL,3);
insert into t1 values (NULL,4);
delete from t1 where a=4;
insert into t1 values (NULL,5),(NULL,6);
select * from t1 order by a;
 a | b 
---+---
 1 | 1
 3 | 3
 5 | 5
 6 | 6
(4 rows)

delete from t1 where a=6;
replace t1 values (3,1);
ALTER TABLE t1 add c int;
replace t1 values (3,3,3);
insert into t1 values (NULL,7,7);
update t1 set a=8,b=b+1,c=c+1 where a=7;
insert into t1 values (NULL,9,9);
ERROR:  duplicate key value violates unique constraint "t1_pkey"
DETAIL:  Key (a)=(8) already exists.
select * from t1 order by a;
 a | b | c 
---+---+---
 1 | 1 |  
 3 | 3 | 3
 5 | 5 |  
 8 | 8 | 8
(4 rows)

drop table t1;
create table t1 (
  skey tinyint unsigned NOT NULL auto_increment PRIMARY KEY,
  sval char(20)
);
insert into t1 values (NULL, 'hello');
insert into t1 values (NULL, 'hey');
select * from t1 order by skey;
 skey |         sval         
------+----------------------
 1    | hello               
 2    | hey                 
(2 rows)

drop table t1;
--
-- Test auto_increment on sub key
--
create table t1 (a char(10) not null, b int not null auto_increment, primary key(b));
insert into t1 values ('a',1),('b',2),('a',2),('c',1);
ERROR:  duplicate key value violates unique constraint "t1_pkey"
DETAIL:  Key (b)=(2) already exists.
insert into t1 values ('a',NULL),('b',NULL),('c',NULL),('e',NULL);
insert into t1 (a) values ('a'),('b'),('c'),('d');
insert into t1 (a) values ('k'),('d');
insert into t1 (a) values ('a');
insert into t1 values ('d',last_insert_id());
ERROR:  duplicate key value violates unique constraint "t1_pkey"
DETAIL:  Key (b)=(14) already exists.
select * from t1 order by a;
     a      | b  
------------+----
 a          |  4
 a          |  8
 a          | 14
 b          |  5
 b          |  9
 c          |  6
 c          | 10
 d          | 11
 d          | 13
 e          |  7
 k          | 12
(11 rows)

drop table t1;
