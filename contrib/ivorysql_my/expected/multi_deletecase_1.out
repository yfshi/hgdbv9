-- procedure
CREATE OR REPLACE PROCEDURE proc_mutil
(
c1 int,
c2 int
)
as $$
BEGIN
	delete from a,b using CT_T_MUTIL_T1 a,T_T_MUTIL_T2 b where a.col2=c1 and b.col2=c2;
END;
$$ language plmysql;
begin;
CALL proc_mutil(1,2);
