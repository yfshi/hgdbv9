--show triggers
--CREATE TABLE trig_tbl (id int, val text);
--CREATE FUNCTION trig_func()
--RETURNS trigger LANGUAGE plpgsql AS $$
--BEGIN
--  NEW.val := upper(NEW.val);
--  RETURN NEW;
--END;$$;
--CREATE TRIGGER before_ins BEFORE INSERT ON trig_tbl
