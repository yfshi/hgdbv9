    id SERIAL PRIMARY KEY,
    btree_col INT NOT NULL,
    hash_col VARCHAR(50) NOT NULL,
    data DATE,
    text_col TEXT,
    jsonb_col JSONB,
    array_col TEXT[],
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
