set mysql.at_or_atat = on;
CREATE TABLE t1 (
  id INT,
  table_type VARCHAR(30),
  table_name1 VARCHAR(30),
  flag INT
);
CREATE TABLE t2 (
  id INT,
  table_type VARCHAR(30),
  table_name2 VARCHAR(30),
  flag INT
);
CREATE TABLE t3 (
  id INT,
  table_type VARCHAR(30),
  table_name3 VARCHAR(30),
  flag INT
);
INSERT INTO t1 VALUES(1, 'BASE TABLE1', 't1', 1);
INSERT INTO t2 VALUES(2, 'BASE TABLE2', 't2', 2);
INSERT INTO t3 VALUES(3, 'BASE TABLE3', 't3', 3);
-- grouped HAVING blocks source-column lookup from the same subquery level
select flag from t1
having (
  select flag from t2 group by flag
  having (
    select count(table_name3) from t3 having table_name3 = 't3'
  ) != 0
) > 0;
ERROR:  column "table_name3" does not exist
LINE 5:     select count(table_name3) from t3 having table_name3 = '...
                                                     ^
HINT:  There is a column named "table_name3" in table "t3", but it cannot be referenced from this part of the query.
-- correlated lookup still works through WHERE
select flag from t1
where (
  select flag from t2
  where (
    select count(table_name3) from t3 having id = 3
  ) != 0
) > 0;
 flag 
------
(0 rows)

select flag from t1
where (
  select flag from t2
  where (
    select count(table_name3) from t3 having id = 2
  ) != 0
) > 0;
 flag 
------
    1
(1 row)

-- non-grouped HAVING still allows correlated lookup
select flag from t1
having (
  select flag from t2
  having (
    select count(table_name3) from t3 having id = 2
  ) != 0
) > 0;
 flag 
------
    1
(1 row)

-- grouped outer HAVING blocks lookup into that level too
select flag from t1 group by flag
having (
  select flag from t2 group by flag
  having (
    select count(table_name3) from t3 having id = 2
  ) != 0
) > 0;
ERROR:  column "id" does not exist
LINE 5:     select count(table_name3) from t3 having id = 2
                                                     ^
HINT:  There is a column named "id" in table "t3", but it cannot be referenced from this part of the query.
select flag from t1
having (
  select flag from t2 group by flag
  having (
    select count(table_name3) from t3 having id = 2
  ) != 0
) > 0;
 flag 
------
(0 rows)

select flag from t1
having (
  select flag from t2 group by flag
  having (
    select count(table_name3) from t3 having id = 1
  ) != 0
) > 0;
 flag 
------
    1
(1 row)

select flag from t1 group by flag
having (
  select flag from t2
  having (
    select count(table_name3) from t3 having id = 1
  ) != 0
) > 0;
 flag 
------
(0 rows)

select flag from t1 group by flag
having (
  select flag from t2
  having (
    select count(table_name3) from t3 having id = 2
  ) != 0
) > 0;
 flag 
------
    1
(1 row)

