-- test priority
create table prio_t(table_type text, table_schema text);
insert into prio_t values('BASE TABLE', 'public');
select 
    case
        when table_type = 'BASE TABLE' then 'TABLE'
        else table_type
    end as table_type
from
    prio_t
where
    table_schema = 'public'
having
    -- table_type is alias
    table_type in ('TABLE');
