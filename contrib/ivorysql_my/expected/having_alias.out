NOTICE:  table "t2" does not exist, skipping
NOTICE:  table "t3" does not exist, skipping
--enable_warnings
create table t1 (a int);
select count(a) as b from t1 where a=0 having b > 0;
 b 
---
(0 rows)

insert into t1 values (null);
select count(a) as b from t1 where a=0 having b > 0;
