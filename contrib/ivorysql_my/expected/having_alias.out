CREATE TABLE orders (
    user_id INT,
    amount DECIMAL(10, 2), 
    category VARCHAR(20),  
    is_vip BOOLEAN         
);
SELECT 
    user_id,
    SUM(
        (amount * CASE WHEN is_vip THEN 1.5 ELSE 1.0 END) 
        + 
        (CASE WHEN category = 'A' THEN 50 WHEN category = 'B' THEN 20 ELSE 0 END)
    ) AS complex_score_alias
FROM orders
GROUP BY user_id
HAVING complex_score_alias > 400; 
 user_id | complex_score_alias 
