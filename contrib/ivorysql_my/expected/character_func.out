SELECT AES_DECRYPT(AES_ENCRYPT('CFB test 128', 'cfbkey128bit!@#', 'iv16bytes1234567'), 'cfbkey128bit!@#', 'iv16bytes1234567') AS result;
    result    
--------------
 CFB test 128
(1 row)

