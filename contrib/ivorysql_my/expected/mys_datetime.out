 2013-01-01 00:00:00.000 | 2013-01-02 00:00:00.000
(1 row)

drop table test_date,test_tmp;
create table tb1 (a datetime(3));
create or replace procedure proc1()
as
$$
declare
i int := 1000;
j int := 1;
k int := 1;
begin
    while i <= 1200 loop
	j = 1;
		while j <=12 loop 
		k = 1;
			while k <= 28 loop
				insert into tb1 (a) values (i*10000+j*100+k);
				k = k+1;
			end loop;
			j = j+1;
		end loop;
    i = i+1;
    end loop;
end;
$$ language plmysql;
call proc1();
create index idx1 on tb1 using hash(a);
vacuum full analyze tb1;
explain (COSTS OFF) select * from tb1 where a = '1004-04-04';
                     QUERY PLAN                      
-----------------------------------------------------
 Index Scan using idx1 on tb1
   Index Cond: (a = '1004-04-04 00:00:00'::datetime)
(2 rows)

drop index idx1;
create index idx_tree on tb1(a);
vacuum full analyze tb1;
set enable_bitmapscan =false;
set enable_seqscan =false;
explain (COSTS OFF) select * from tb1 where a < '1004-04-04';
                     QUERY PLAN                      
-----------------------------------------------------
 Index Only Scan using idx_tree on tb1
   Index Cond: (a < '1004-04-04 00:00:00'::datetime)
(2 rows)

explain (COSTS OFF) select * from tb1 where a <= '1004-04-04';
                      QUERY PLAN                      
------------------------------------------------------
 Index Only Scan using idx_tree on tb1
   Index Cond: (a <= '1004-04-04 00:00:00'::datetime)
(2 rows)

explain (COSTS OFF) select * from tb1 where a = '1004-04-04';
                     QUERY PLAN                      
-----------------------------------------------------
 Index Only Scan using idx_tree on tb1
   Index Cond: (a = '1004-04-04 00:00:00'::datetime)
(2 rows)

explain (COSTS OFF) select * from tb1 where a != '1004-04-04';
                    QUERY PLAN                    
--------------------------------------------------
 Index Only Scan using idx_tree on tb1
   Filter: (a <> '1004-04-04 00:00:00'::datetime)
(2 rows)

set enable_seqscan =true;
set enable_bitmapscan =true;
drop procedure proc1;
