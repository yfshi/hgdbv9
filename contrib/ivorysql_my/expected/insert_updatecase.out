-- ALTER TABLE T03 DROP CONSTRAINT T03_pkey;
CREATE FUNCTION DROPCONSTRAINT() RETURNS text AS $$
DECLARE
	lowernum int;
BEGIN
	select setting::int into lowernum from pg_settings where name = 'lower_case_table_names' ;
	if lowernum = 0 then
		ALTER TABLE T03 DROP CONSTRAINT T03_pkey;
	else
		ALTER TABLE T03 DROP CONSTRAINT t03_pkey;
	end if;
	
	return 'ok';
  
END
$$ LANGUAGE plpgsql;
select DROPCONSTRAINT();
 DROPCONSTRAINT 
----------------
 ok
