create table TFUNC(a int, b int);
create or replace function att(b int) returns int AS
$$
declare a int:=100;
begin
	insert into TFUNC values(10, a * 3);
	return a;
end;
$$ language plpgsql;
create or replace function att(b int) returns int AS
$$
declare c int:=100;
begin
	insert into TFUNC values(10, a * 3);
	return c;
end;
$$ language plpgsql;
