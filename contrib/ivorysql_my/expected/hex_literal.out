    date_col >= 0x323032332d31302d3031,
    date_col < 0x323032332d31302d3031,
    date_col <> 0x323032332d31302d3031,
    date_col != 0x323032332d31302d3031,
    date_col <= 0x323032332d31302d3031,
    date_col <=> 0x323032332d31302d3031,
