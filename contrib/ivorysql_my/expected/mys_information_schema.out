------------------------------------------------------------
-- clean
------------------------------------------------------------
DROP SCHEMA test_schema CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to table test_schema.list_part
drop cascades to table test_schema.test_table
DROP SCHEMA test_schema_ivymy CASCADE;
NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to table test_schema_ivymy.base_tbl
drop cascades to view test_schema_ivymy.vw_tbl
drop cascades to table test_schema_ivymy.part_tbl
DROP SCHEMA test_schema_views CASCADE;
NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to table test_schema_views.base_tbl
drop cascades to view test_schema_views.simple_view
drop cascades to view test_schema_views.chk_view
DROP SCHEMA test_schema_routines CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to function test_schema_routines.add_one(integer)
drop cascades to function test_schema_routines.do_nothing()
DROP SCHEMA test_schema_triggers CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to table test_schema_triggers.trig_tbl
drop cascades to function test_schema_triggers.trig_func()
DROP SCHEMA test_schema_constraints CASCADE;
NOTICE:  drop cascades to table test_schema_constraints.cons_tbl
DROP SCHEMA test_schema_schemata CASCADE;
DROP SCHEMA test_schema_schema_privs CASCADE;
DROP SCHEMA test_schema_stats CASCADE;
NOTICE:  drop cascades to table test_schema_stats.stats_tbl
DROP ROLE IF EXISTS test_user;
DROP ROLE IF EXISTS user_a;
DROP ROLE IF EXISTS user_b;
DROP ROLE IF EXISTS schema_user;
DROP ROLE IF EXISTS testuser;
