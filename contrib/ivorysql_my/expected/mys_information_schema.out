-- 10. Test for information_schema.table_constraints
------------------------------------------------------------
CREATE SCHEMA test_schema_constraints;
CREATE TABLE test_schema_constraints.cons_tbl (
    id INT PRIMARY KEY,
    code TEXT UNIQUE,
    val INT NOT NULL,
    ref_id INT,
    CONSTRAINT fk_ref FOREIGN KEY (ref_id) REFERENCES test_schema_constraints.cons_tbl(id)
);
SELECT constraint_schema, table_schema,
       table_name, constraint_type
FROM information_schema.table_constraints
WHERE table_schema = 'test_schema_constraints'
ORDER BY constraint_type;
    constraint_schema    |      table_schema       | table_name | constraint_type 
-------------------------+-------------------------+------------+-----------------
 test_schema_constraints | test_schema_constraints | cons_tbl   | CHECK
 test_schema_constraints | test_schema_constraints | cons_tbl   | CHECK
 test_schema_constraints | test_schema_constraints | cons_tbl   | FOREIGN KEY
 test_schema_constraints | test_schema_constraints | cons_tbl   | PRIMARY KEY
 test_schema_constraints | test_schema_constraints | cons_tbl   | UNIQUE
(5 rows)

