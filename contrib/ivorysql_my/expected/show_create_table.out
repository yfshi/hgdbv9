--
-- test the "star" operators a bit more thoroughly -- this time,
-- throw in lots of NULL fields...
--
-- a is the type root
-- b and c inherit from a (one-level single inheritance)
-- d inherits from b and c (two-level multiple inheritance)
-- e inherits from c (two-level single inheritance)
-- f inherits from e (three-level single inheritance)
--
CREATE TABLE a_star (
	class		char,
	a 			int4
);
SHOW CREATE TABLE a_star;
 Table  |       Create Table        
--------+---------------------------
 a_star | CREATE TABLE "a_star" (  +
        |     "class" character(1),+
        |     "a" integer          +
        | )
(1 row)

CREATE TABLE b_star (
	b 			text
) INHERITS (a_star);
ERROR:  CREATE TABLE ... INHERITS is not yet supported.
HINT:  Please note whether it's compatible with MySQL.
SHOW CREATE TABLE b_star;
ERROR:  relation "b_star" does not exist
CREATE TABLE c_star (
	c 			name
) INHERITS (a_star);
ERROR:  CREATE TABLE ... INHERITS is not yet supported.
HINT:  Please note whether it's compatible with MySQL.
SHOW CREATE TABLE c_star;
ERROR:  relation "c_star" does not exist
CREATE TABLE d_star (
	d 			float8
) INHERITS (b_star, c_star);
ERROR:  CREATE TABLE ... INHERITS is not yet supported.
HINT:  Please note whether it's compatible with MySQL.
SHOW CREATE TABLE d_star;
ERROR:  relation "d_star" does not exist
CREATE TABLE e_star (
	e 			int2
) INHERITS (c_star);
ERROR:  CREATE TABLE ... INHERITS is not yet supported.
HINT:  Please note whether it's compatible with MySQL.
SHOW CREATE TABLE e_star;
ERROR:  relation "e_star" does not exist
CREATE TABLE f_star (
	f 			polygon
) INHERITS (e_star);
ERROR:  CREATE TABLE ... INHERITS is not yet supported.
HINT:  Please note whether it's compatible with MySQL.
SHOW CREATE TABLE f_star;
ERROR:  relation "f_star" does not exist
DROP TABLE a_star;
DROP TABLE b_star;
ERROR:  table "b_star" does not exist
DROP TABLE c_star;
ERROR:  table "c_star" does not exist
DROP TABLE d_star;
ERROR:  table "d_star" does not exist
DROP TABLE e_star;
ERROR:  table "e_star" does not exist
DROP TABLE f_star;
