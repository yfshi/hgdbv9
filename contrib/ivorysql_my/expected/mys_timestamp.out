create table tb1 (a timestamp);
create or replace procedure proc1()
as
$$
declare
i int := 1970;
j int := 1;
k int := 1;
begin
    while i <= 2038 loop
	j = 1;
		while j <=12 loop 
		k = 1;
			while k <= 28 loop
				insert into tb1 (a) values (i*10000+j*100+k);
				k = k+1;
			end loop;
			j = j+1;
		end loop;
    i = i+1;
    end loop;
end;
$$ language plmysql;
call proc1();
create index idx1 on tb1 using hash(a);
vacuum full analyze tb1;
explain (COSTS OFF) select * from tb1 where a = '1970-04-04';
                      QUERY PLAN                      
------------------------------------------------------
 Index Scan using idx1 on tb1
   Index Cond: (a = '1970-04-04 00:00:00'::timestamp)
(2 rows)

drop index idx1;
create index idx_tree on tb1(a);
vacuum full analyze tb1;
set enable_bitmapscan =false;
set enable_seqscan =false;
explain (COSTS OFF) select * from tb1 where a < '1970-01-04';
                      QUERY PLAN                      
------------------------------------------------------
