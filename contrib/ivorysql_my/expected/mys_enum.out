create type pp_colors as enum ('green', 'blue', 'black');
create table pp_enumpart (a pp_colors) partition by list (a);
create table pp_enumpart_green partition of pp_enumpart for values in ('green');
create table pp_enumpart_blue partition of pp_enumpart for values in ('blue');
explain (costs off) select * from pp_enumpart where a = 'blue';
                QUERY PLAN                
------------------------------------------
 Seq Scan on pp_enumpart_blue pp_enumpart
   Filter: (a = 'blue'::text)
(2 rows)

explain (costs off) select * from pp_enumpart where a = 'green';
                QUERY PLAN                 
-------------------------------------------
 Seq Scan on pp_enumpart_green pp_enumpart
   Filter: (a = 'green'::text)
(2 rows)

explain (costs off) select * from pp_enumpart where a in ('blue', 'green');
                         QUERY PLAN                          
-------------------------------------------------------------
 Append
   ->  Seq Scan on pp_enumpart_green pp_enumpart_1
         Filter: ((a = 'blue'::text) OR (a = 'green'::text))
   ->  Seq Scan on pp_enumpart_blue pp_enumpart_2
         Filter: ((a = 'blue'::text) OR (a = 'green'::text))
(5 rows)

explain (costs off) select * from pp_enumpart where a = 'xxx';
        QUERY PLAN        
--------------------------
 Result
   One-Time Filter: false
(2 rows)

