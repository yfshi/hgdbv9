DISCARD ALL;
/*
 * test mysql mediumblob type index.
 */
-- parameter settings
set ivorysql.compatible_mode to mysql;
set enable_seqscan = off;
\pset null 'NULL'
-- clean environment
DROP TABLE IF EXISTS my_mediumblob_t01;
CREATE TABLE my_mediumblob_t01(
  c1 mediumblob,
  c2 mediumblob,
  c3 mediumblob,
  c4 mediumblob
);
INSERT INTO my_mediumblob_t01 VALUES ('abcdefghij', 'bcdefghijk', 'cdefghijkl', 'defghijklm');
INSERT INTO my_mediumblob_t01 VALUES ('abcdefghij', 'bcdefghijk', 'cdefghijkl', 'defghijklm');
INSERT INTO my_mediumblob_t01 VALUES ('abcdefghij', 'bcdefghijk', 'cdefghijkl', 'defghijklm');
--------------------------------------------------------------------------------
-- case: gin
create index my_mediumblob_t01_gin on my_mediumblob_t01 using gin(c1);
select c1 from my_mediumblob_t01 where c1 = 'abcdefghij';
           c1           
------------------------
 \x6162636465666768696a
 \x6162636465666768696a
 \x6162636465666768696a
(3 rows)

explain select c1 from my_mediumblob_t01 where c1 = 'abcdefghij';
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Bitmap Heap Scan on my_mediumblob_t01  (cost=8.01..12.02 rows=1 width=32)
   Recheck Cond: (c1 = '\x6162636465666768696a'::mediumblob)
   ->  Bitmap Index Scan on my_mediumblob_t01_gin  (cost=0.00..8.01 rows=1 width=0)
         Index Cond: (c1 = '\x6162636465666768696a'::mediumblob)
(4 rows)

-- case: brin
create index my_mediumblob_t01_brin on my_mediumblob_t01 using brin(c2);
select c2 from my_mediumblob_t01 where c2 = 'bcdefghijk';
           c2           
------------------------
 \x62636465666768696a6b
 \x62636465666768696a6b
 \x62636465666768696a6b
(3 rows)

explain select c2 from my_mediumblob_t01 where c2 = 'bcdefghijk';
                                      QUERY PLAN                                      
--------------------------------------------------------------------------------------
 Bitmap Heap Scan on my_mediumblob_t01  (cost=12.03..16.07 rows=1 width=32)
   Recheck Cond: (c2 = '\x62636465666768696a6b'::mediumblob)
   ->  Bitmap Index Scan on my_mediumblob_t01_brin  (cost=0.00..12.03 rows=3 width=0)
         Index Cond: (c2 = '\x62636465666768696a6b'::mediumblob)
(4 rows)

-- case: btree
create index my_mediumblob_t01_btree on my_mediumblob_t01 using btree(c3);
select c3 from my_mediumblob_t01 where c3 = 'cdefghijkl';
           c3           
------------------------
 \x636465666768696a6b6c
 \x636465666768696a6b6c
 \x636465666768696a6b6c
(3 rows)

explain select c3 from my_mediumblob_t01 where c3 = 'cdefghijkl';
                                              QUERY PLAN                                               
-------------------------------------------------------------------------------------------------------
 Index Only Scan using my_mediumblob_t01_btree on my_mediumblob_t01  (cost=0.13..8.15 rows=1 width=32)
   Index Cond: (c3 = '\x636465666768696a6b6c'::mediumblob)
(2 rows)

-- case: hash
create index my_mediumblob_t01_hash on my_mediumblob_t01 using hash(c4);
select c4 from my_mediumblob_t01 where c4 = 'defghijklm';
           c4           
------------------------
 \x6465666768696a6b6c6d
 \x6465666768696a6b6c6d
 \x6465666768696a6b6c6d
(3 rows)

explain select c4 from my_mediumblob_t01 where c4 = 'defghijklm';
                                            QUERY PLAN                                            
--------------------------------------------------------------------------------------------------
 Index Scan using my_mediumblob_t01_hash on my_mediumblob_t01  (cost=0.00..12.02 rows=1 width=32)
   Index Cond: (c4 = '\x6465666768696a6b6c6d'::mediumblob)
(2 rows)

