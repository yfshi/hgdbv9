create or replace procedure proc_test()
as
$$
declare
i int := 1000;
j int := 1;
k int := 1;
begin
    while i <= 1200 loop
	j = 1;
		while j <=12 loop 
		k = 1;
			while k <= 28 loop
				k = k+1;
			end loop;
			j = j+1;
		end loop;
    i = i+1;
    end loop;
end;
$$ language plmysql;
show create function proc_test;
ERROR:  FUNCTION public.proc_test does not exist
CONTEXT:  PL/pgSQL function show_create_function(character,character) line 4 at RAISE
