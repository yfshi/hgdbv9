-- user define variable argument test
-- user define variable can be any type
create or replace procedure arg_test(IN arg1 text, OUT arg2 text, INOUT arg3 text)
as $$
begin
	set arg1 = concat(arg1, '-1');
	set arg2 = concat(arg2, '-2');
	set arg3 = concat(arg3, '-3');
end;
$$ language plmysql;
-- case 1
set @var1 = 'a';
set @var2 = 'b';
set @var3 = 'c';
-- a, null, c-3
call arg_test(@var1, @var2, @var3);
 arg2 | arg3 
------+------
      | c-3
(1 row)

-- a, null, c-3
select @var1, @var2, @var3;
 @var1 | @var2 | @var3 
-------+-------+-------
 a     |       | c-3
(1 row)

-- case 2
set @var1 = 1::text;
set @var2 = 2::text;
set @var3 = 3::text;
-- 1, null, 3-3
call arg_test(@var1, @var2, @var3);
 arg2 | arg3 
------+------
      | 3-3
(1 row)

-- 1, null, 3-3
select @var1, @var2, @var3;
 @var1 | @var2 | @var3 
-------+-------+-------
 1     |       | 3-3
(1 row)

-- case 3
set @var1 = 1;
set @var2 = 2;
set @var3 = 3;
-- 1, null, 3-3
call arg_test(@var1::text, @var2::text, @var3::text);
 arg2 | arg3 
------+------
      | 3-3
(1 row)

-- 1, null, 3
select @var1, @var2, @var3;
 @var1 | @var2 | @var3 
-------+-------+-------
     1 |     2 |     3
(1 row)

-- system variable can only be IN-type
call arg_test(@var1::text, @@autocommit, @var3::text);
ERROR:  OUT or INOUT argument 1 for routine arg_test is not a variable or NEW pseudo-variable in BEFORE trigger
call arg_test(@var1::text, @var2::text, @@autocommit);
ERROR:  OUT or INOUT argument 2 for routine arg_test is not a variable or NEW pseudo-variable in BEFORE trigger
-- test sql_mode
set sql_mode = 'ansi_quotes';
create or replace function sql_mode_func1()
returns text
as $$
declare
	ret text;
begin
	select current_setting('sql_mode') into ret;
	return ret;
end;
$$ language plmysql;
set sql_mode = 'pipes_as_concat';
create or replace function sql_mode_func2()
returns text
as $$
declare
	ret text;
begin
	select current_setting('sql_mode') into ret;
	return ret;
end;
$$ language plmysql;
set sql_mode = 'only_full_group_by';
create or replace function sql_mode_func3()
returns text
as $$
declare
	ret text;
begin
	select current_setting('sql_mode') into ret;
	return ret;
end;
$$ language plmysql;
set sql_mode = '';
select sql_mode_func1(), sql_mode_func2(), sql_mode_func3();
 sql_mode_func1 | sql_mode_func2  |   sql_mode_func3   
----------------+-----------------+--------------------
 ANSI_QUOTES    | PIPES_AS_CONCAT | ONLY_FULL_GROUP_BY
(1 row)

