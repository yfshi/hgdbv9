set ivorysql.compatible_mode to mysql;
set datestyle to 'ISO,YMD';
-- SET sql_mode = '';
-- #
-- # Test year
-- #
drop table if exists t1;
NOTICE:  table "t1" does not exist, skipping
create table t1 (y year,y4 year(4));
insert into t1 values (0,0),(1999,1999),(2000,2000),(2001,2001),(70,70),(69,69);
select * from t1;
  y   |  y4  
------+------
 0000 | 0000
 1999 | 1999
 2000 | 2000
 2001 | 2001
 1970 | 1970
 2069 | 2069
(6 rows)

select * from t1 order by y;
  y   |  y4  
------+------
 0000 | 0000
 1970 | 1970
 1999 | 1999
 2000 | 2000
 2001 | 2001
 2069 | 2069
(6 rows)

select * from t1 order by y4;
  y   |  y4  
------+------
 0000 | 0000
 1970 | 1970
 1999 | 1999
 2000 | 2000
 2001 | 2001
 2069 | 2069
(6 rows)

drop table t1;
create table t1 (y year);
insert into t1 values (now());
-- select if(y = now(), 1, 0) from t1;
drop table t1;
-- #
-- # Bug #27176: Assigning a string to an year column has unexpected results
-- #
create table t1(a year);
insert ignore into t1 values (2000.5), ('2000.5'), ('2001a'), ('2.001E3');
select * from t1;
  a   
------
 2001
 2001
 2001
 2001
(4 rows)

drop table t1;
--echo #
--echo # Bug #49480: WHERE using YEAR columns returns unexpected results
--echo #
CREATE TABLE t2(yy YEAR(4), c2 CHAR(4));
CREATE TABLE t4(yyyy YEAR(4), c4 CHAR(4));
INSERT INTO t2 (c2) VALUES (NULL),(1970),(1999),(2000),(2001),(2069);
INSERT INTO t4 (c4) SELECT c2 FROM t2;
UPDATE t2 SET yy = c2;
UPDATE t4 SET yyyy = c4;
SELECT * FROM t2;
  yy  |  c2  
------+------
      | 
 1970 | 1970
 1999 | 1999
 2000 | 2000
 2001 | 2001
 2069 | 2069
(6 rows)

SELECT * FROM t4;
 yyyy |  c4  
------+------
      | 
 1970 | 1970
 1999 | 1999
 2000 | 2000
 2001 | 2001
 2069 | 2069
(6 rows)

--echo # Comparison of YEAR with YEAR
SELECT * FROM t4 a, t4 b WHERE a.yyyy = b.yyyy;
 yyyy |  c4  | yyyy |  c4  
------+------+------+------
 1970 | 1970 | 1970 | 1970
 1999 | 1999 | 1999 | 1999
 2000 | 2000 | 2000 | 2000
 2001 | 2001 | 2001 | 2001
 2069 | 2069 | 2069 | 2069
(5 rows)

SELECT * FROM t4 a, t4 b WHERE a.yyyy <=> b.yyyy;
 yyyy |  c4  | yyyy |  c4  
------+------+------+------
 1970 | 1970 | 1970 | 1970
 1999 | 1999 | 1999 | 1999
 2000 | 2000 | 2000 | 2000
 2001 | 2001 | 2001 | 2001
 2069 | 2069 | 2069 | 2069
(5 rows)

SELECT * FROM t4 a, t4 b WHERE a.yyyy < b.yyyy;
 yyyy |  c4  | yyyy |  c4  
------+------+------+------
 1970 | 1970 | 1999 | 1999
 1970 | 1970 | 2000 | 2000
 1970 | 1970 | 2001 | 2001
 1970 | 1970 | 2069 | 2069
 1999 | 1999 | 2000 | 2000
 1999 | 1999 | 2001 | 2001
 1999 | 1999 | 2069 | 2069
 2000 | 2000 | 2001 | 2001
 2000 | 2000 | 2069 | 2069
 2001 | 2001 | 2069 | 2069
(10 rows)

