---------+---------------------------------------------
 test_c2 | CREATE TABLE "test_c2" (                   +
         |     "a" integer,                           +
         |     "id" integer NOT NULL AUTO_INCREMENT,  +
         |     "name" character varying(20),          +
         |     CONSTRAINT "test_c2_id_key" UNIQUE (id)+
