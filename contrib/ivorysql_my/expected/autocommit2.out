CREATE OR REPLACE FUNCTION test_case_18_basic_pk_conflict(p_id int, p_data text) 
returns boolean
language plpgsql
as $$
begin
	insert into t1 values (p_id, p_data);
	return true;
exception
	when others then
		set autocommit = 1;
		insert into t1 values (10, 'exception');
	return false;
end;
$$;
