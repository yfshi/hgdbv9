 t
(1 row)

-- test bug7540
create table test_7540(a int, b varchar(10), c int);
load data infile '@abs_srcdir@/data/test_load_data_7540.csv' into table test_7540 COLUMNS terminated by ',';
ERROR:  value too long for type character varying(10)
CONTEXT:  COPY test_7540, line 1, column b: "ddddddddddfff"
set sql_mode='';
load data infile '@abs_srcdir@/data/test_load_data_7540.csv' into table test_7540 COLUMNS terminated by ',';
select * from test_7540;
 a  |     b      | c  
----+------------+----
 10 | dddddddddd | 10
 20 | qqqqqqqqqq | 20
(2 rows)

drop table test_7540;
reset sql_mode;
-- clean up
\c contrib_regression
drop database gbk_copy;
drop table test_load_data;
