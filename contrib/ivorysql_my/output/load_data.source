-- create table
create table test_load_data(id int, age int, name varchar(20));
-- default value
load data infile '@abs_srcdir@/data/test_load_data_1.csv' into table test_load_data;
select * from test_load_data;
 id | age |  name   
----+-----+---------
  1 |   1 | hello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

delete from test_load_data;
-- test TERMINATED BY
load data infile '@abs_srcdir@/data/test_load_data_2.csv' into table test_load_data FIELDS TERMINATED BY E'\t';
select * from test_load_data;
 id | age |  name   
----+-----+---------
  1 |   1 | wello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

delete from test_load_data;
load data infile '@abs_srcdir@/data/test_load_data_3.csv' into table test_load_data FIELDS TERMINATED BY '|';
select * from test_load_data;
 id | age |  name   
----+-----+---------
  1 |   1 | hello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

delete from test_load_data;
-- test ENCLOSED by and ESCAPED BY
load data infile '@abs_srcdir@/data/test_load_data_4.csv' into table test_load_data FIELDS ENCLOSED BY '''' ESCAPED BY '$';
select * from test_load_data;
 id | age |   name   
----+-----+----------
  1 |   1 | hello
  2 |   2 | wor'k
  3 |   3 | high''go
(3 rows)

delete from test_load_data;
-- test OPTIONALLY ENCLOSED BY
load data infile '@abs_srcdir@/data/test_load_data_4.csv' into table test_load_data FIELDS OPTIONALLY ENCLOSED BY '''' ESCAPED BY '$';
select * from test_load_data;
 id | age |   name   
----+-----+----------
  1 |   1 | hello
  2 |   2 | wor'k
  3 |   3 | high''go
(3 rows)

delete from test_load_data;
-- test FIELDS or COLUMNS
load data infile '@abs_srcdir@/data/test_load_data_4.csv' into table test_load_data COLUMNS ENCLOSED BY '''' ESCAPED BY '$';
select * from test_load_data;
 id | age |   name   
----+-----+----------
  1 |   1 | hello
  2 |   2 | wor'k
  3 |   3 | high''go
(3 rows)

delete from test_load_data;
-- test column list
load data infile '@abs_srcdir@/data/test_load_data_5.csv' into table test_load_data COLUMNS ENCLOSED BY '''' ESCAPED BY '$' (age,name);
select * from test_load_data;
 id | age |   name   
----+-----+----------
    |   1 | hello
    |   2 | wor'k
    |   3 | high''go
(3 rows)

delete from test_load_data;
-- test CHARACTER SET
create database gbk_copy encoding='gbk' LC_COLLATE='C' LC_CTYPE ='C' TEMPLATE=template0;
\c gbk_copy;
create table test_load_data(id int, age int, name varchar(20));
select pg_catalog.getdatabaseencoding();
 getdatabaseencoding 
---------------------
 GBK
(1 row)

load data infile '@abs_srcdir@/data/test_load_data_1.csv' into table test_load_data;
select * from test_load_data;
 id | age |  name   
----+-----+---------
  1 |   1 | hello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

delete from test_load_data;
load data infile '@abs_srcdir@/data/test_load_data_1.csv' into table test_load_data CHARACTER SET 'utf8';
select * from test_load_data;
 id | age |  name   
----+-----+---------
  1 |   1 | hello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

delete from test_load_data;
-- error case
-- double into
load data infile '@abs_srcdir@/data/test_load_data_1.csv' into table test_load_data into table test_load_data;
ERROR:  syntax error at or near "into"
LINE 1: ...a/test_load_data_1.csv' into table test_load_data into table...
                                                             ^
-- double fields
load data infile '@abs_srcdir@/data/test_load_data_1.csv' into table test_load_data COLUMNS TERMINATED BY '|' TERMINATED BY ',';
ERROR:  conflicting or redundant options
LINE 1: ...to table test_load_data COLUMNS TERMINATED BY '|' TERMINATED...
                                                             ^
load data infile '@abs_srcdir@/data/test_load_data_1.csv' into table test_load_data FIELDS TERMINATED BY '|' COLUMNS TERMINATED BY ',';
ERROR:  syntax error at or near "COLUMNS"
LINE 1: ...nto table test_load_data FIELDS TERMINATED BY '|' COLUMNS TE...
                                                             ^
-- file did not exit
load data infile '@abs_srcdir@/data/test_load_data_7.csv' into table test_load_data;
ERROR:  could not open file "@abs_srcdir@/data/test_load_data_7.csv" for reading: No such file or directory
HINT:  COPY FROM instructs the PostgreSQL server process to read a file. You may want a client-side facility such as psql's \copy.
