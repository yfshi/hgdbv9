---- bug#8274
create table test_8274(id int primary key auto_increment, name varchar(50) not null, city varchar(100), create_time date default current_date );
-- strict mode
LOAD DATA INFILE '@abs_srcdir@/data/test_load_data_8274.csv' INTO TABLE test_8274 FIELDS TERMINATED BY ',';
ERROR:  Incorrect datetime value: 'default'
CONTEXT:  COPY test_8274, line 3, column create_time: "default"
-- no-strict mode
set sql_mode='REAL_AS_FLOAT,PIPES_AS_CONCAT,ANSI_QUOTES,ONLY_FULL_GROUP_BY,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION';
LOAD DATA INFILE '@abs_srcdir@/data/test_load_data_8274.csv' INTO TABLE test_8274 FIELDS TERMINATED BY ',';
WARNING:  Incorrect datetime value: 'default'
select * from test_8274;
 id |  name   |        city         | create_time 
----+---------+---------------------+-------------
  1 | Alice   | 亚特兰大Atlanta | 2026-01-01
  2 | Bob     | 波士顿Boston     | 2026-02-01
  3 | Charlie | 芝加哥Chicago    | 0000-00-00
(3 rows)

delete from test_8274;
drop table test_8274;
reset sql_mode;
