copy test_check from '@abs_builddir@/results/test_select_into_11.csv' with(format csv, delimiter ',');
select * from test_check;
 id | age | name  
----+-----+-------
  1 |   1 | hello
  2 |   2 | wor$k
(2 rows)

delete from test_check;
