-- test case: 7477
create table test_7477(id int primary key auto_increment, name varchar(50) not null, age tinyint, city varchar(100));
insert into test_7477(name, age, city) values('Alice', 25, 'Atlanta'), ('Bob', 30, 'Boston'), ('Charlie', 28, 'Chicago');
-- succ
select * from test_7477 into OUTFILE '@abs_builddir@/results/test_select_into_7477.csv';
-- error, file exist
select * from test_7477 into OUTFILE '@abs_builddir@/results/test_select_into_7477.csv';
ERROR:  file "@abs_builddir@/results/test_select_into_7477.csv" already exists
drop table test_7477;
\! rm @abs_builddir@/results/test_select_into_7477.csv
-- test character set
create database select_into_gbk encoding='gbk' LC_COLLATE='C' LC_CTYPE ='C' TEMPLATE=template0;
\c select_into_gbk
select pg_catalog.getdatabaseencoding();
 getdatabaseencoding 
---------------------
 GBK
(1 row)

create table test_select_gbk(id int, age int, name varchar(20));
insert into test_select_gbk values(1,1,'hello');
insert into test_select_gbk values(2,2,'wor$k');
insert into test_select_gbk values(3,3,'high,go');
select * from test_select_gbk;
 id | age |  name   
----+-----+---------
  1 |   1 | hello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

create table test_check_gbk(like test_select_gbk);
select * into OUTFILE '@abs_builddir@/results/test_select_into_12.csv' CHARACTER SET 'UTF8' from test_select_gbk;
copy test_check_gbk from '@abs_builddir@/results/test_select_into_12.csv' with(format csv, delimiter ',' , encoding 'utf8');
select * from test_check_gbk;
 id | age |  name   
----+-----+---------
  1 |   1 | hello
  2 |   2 | wor$k
  3 |   3 | high,go
(3 rows)

------ bug#z7476
\c contrib_regression
create table test_7476 (id int primary key auto_increment, name varchar(50) not null, age tinyint, city varchar(100), create_time date);
-- bug7476 test case
insert into test_7476(name, age, city, create_time) values('Alice', 25, '亚特兰大Atlanta', '2026-05-27');
insert into test_7476(name, age, city, create_time) values ('Bob', 30, '波士顿Boston', '2026-05-28');
insert into test_7476(name, age, city, create_time) values ('Charlie', 28, '芝加哥Chicago', '2026-05-29');
