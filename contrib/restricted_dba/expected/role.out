---- GRANT ROLE
------ pass
grant sysdba_role to n_user_1;
revoke sysdba_role from n_user_1;
------ fail
grant n_r1 to dba_u2;
ERROR:  permission denied
DETAIL:  cannot give other role to security role "dba_u2"
grant dba_u1 to n_user_2;
ERROR:  permission denied
DETAIL:  a user of security role cannot operate itself in membership
grant syssso_role to n_user_2;
ERROR:  permission denied
DETAIL:  must have admin option to operate security role "syssso_role"
grant syssao_role to n_user_2;
ERROR:  permission denied
DETAIL:  must have admin option to operate security role "syssao_role"
