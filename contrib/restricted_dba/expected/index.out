---- ALTER INDEX RENAME
------ pass
begin;
alter index idx2_dba_u1_id rename to idx2_dba_u1_id_new;
rollback;
alter index if exists idx_non_exist rename to idx_non_exist_new;
NOTICE:  relation "idx_non_exist" does not exist, skipping
------ fail
