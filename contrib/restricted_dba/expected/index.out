DETAIL:  member of sysdba_role can only create index on its own relation
create index idx2_u1_id on tb1_u1(id);
ERROR:  permission denied
DETAIL:  member of sysdba_role can only create index on its own relation
create index idx_non_exist on tb1_non_exist(id);
