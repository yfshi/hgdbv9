-- TEST CREATE DATABASE
create database gbk_enc encoding='gbk' LC_COLLATE='C' LC_CTYPE ='C' TEMPLATE=template0;
\c gbk_enc
load 'gb18030_2022';
show server_encoding;
 server_encoding 
-----------------
 GBK
(1 row)

set client_encoding = 'UTF8';
show client_encoding;
 client_encoding 
-----------------
 UTF8
(1 row)

-- 1. insert test character two-byte：
