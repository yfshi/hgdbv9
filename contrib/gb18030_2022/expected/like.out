-- 丄 (0x81 0x41) vs 乤 (0x81 0x61): the trailing 'A'/'a' must NOT be folded.
select '丄' ILIKE '乤' as shang_xia_no_fold_false;
 shang_xia_no_fold_false 
-------------------------
 f
