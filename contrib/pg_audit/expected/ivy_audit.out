DO $$
DECLARE
	confoid_1 oid;
	confoid_2 oid;
	confoid_3 oid;
BEGIN
	SELECT confid INTO confoid_1
	FROM pg_audit_config
	WHERE actionname = 'CREATE TABLE'
	LIMIT 1;
	
	SELECT confid INTO confoid_2
	FROM pg_audit_config
	WHERE actionname = 'INSERT'
	LIMIT 1;
	
	SELECT confid INTO confoid_3
	FROM pg_audit_config
	WHERE actionname = 'DELETE'
	LIMIT 1;
	
	PERFORM hg_security.pg_create_secmon_rule('rule1',confoid_1,'successful',true);
	PERFORM hg_security.pg_create_secmon_rule('rule2',confoid_2,'successful',true);
	PERFORM hg_security.pg_create_secmon_rule('rule3',confoid_3,'successful',true);
end $$;
DO $$
DECLARE
	confoid_1 oid;
	confoid_2 oid;
	confoid_3 oid;
	rule_oid_1 oid;
	rule_oid_2 oid;
	rule_oid_3 oid;
BEGIN
	SELECT confid INTO confoid_1
	FROM pg_audit_config
	WHERE actionname = 'CREATE TABLE'
	LIMIT 1;
	
	SELECT ruleoid INTO rule_oid_1
	FROM pg_secmon_rule
	WHERE confid = confoid_1
	LIMIT 1;
	
	SELECT confid INTO confoid_2
	FROM pg_audit_config
	WHERE actionname = 'INSERT'
	LIMIT 1;
	
	SELECT ruleoid INTO rule_oid_2
	FROM pg_secmon_rule
	WHERE confid = confoid_2
	LIMIT 1;
	
	SELECT confid INTO confoid_3
	FROM pg_audit_config
	WHERE actionname = 'DELETE'
	LIMIT 1;
	
	SELECT ruleoid INTO rule_oid_3
	FROM pg_secmon_rule
	WHERE confid = confoid_3
	LIMIT 1;
	
	PERFORM hg_security.pg_create_secmon_threshold('thr1',ARRAY[rule_oid_1,rule_oid_2,rule_oid_3],20,1,NULL,NULL,NULL,NULL,NULL,1,true);
end $$;
