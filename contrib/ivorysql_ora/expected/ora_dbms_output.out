-- put(null) do nothing.
DECLARE
	buff varchar2(1024) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT('a');
	DBMS_OUTPUT.PUT(NULL);
	DBMS_OUTPUT.PUT('b');
	DBMS_OUTPUT.NEW_LINE();
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
