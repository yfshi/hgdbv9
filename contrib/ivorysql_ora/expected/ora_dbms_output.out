SET SERVEROUTPUT OFF
-- reset buffer to smaller, all lines that have not been read are valid. 
DROP TABLE dbms_output_test;
CREATE TABLE dbms_output_test(buff varchar2(6000), status int);
DECLARE
	buff varchar2(32767) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(4000);
	buff := rpad('a', 4000, 'b');
	DBMS_OUTPUT.PUT_line(buff);
	DBMS_OUTPUT.ENABLE(3000);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
/
SELECT length(buff), lengthb(buff) FROM dbms_output_test;	-- 4000
 length | lengthb 
--------+---------
   4000 |    4000
(1 row)

DELETE FROM dbms_output_test;
-- test the validity of the old data row before the second call to enable(x).
DECLARE
	buff varchar2(32767) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(4000);
	buff := rpad('a', 100, 'a');
	DBMS_OUTPUT.PUT_line(buff);
	buff := rpad('b', 100, 'b');
	DBMS_OUTPUT.PUT_line(buff);
	buff := rpad('c', 100, 'c');
	DBMS_OUTPUT.PUT_line(buff);
	DBMS_OUTPUT.GET_LINE(buff,stts);	-- make buffer dirty
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.ENABLE(6000);
	buff := rpad('d', 100, 'd');
	DBMS_OUTPUT.PUT_line(buff);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
/
SELECT * FROM dbms_output_test;
                                                 buff                                                 | status 
------------------------------------------------------------------------------------------------------+--------
 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa |      0
 dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd |      0
(2 rows)

DELETE FROM dbms_output_test;
DECLARE
	buff varchar2(32767) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(4000);
	buff := rpad('a', 100, 'a');
	DBMS_OUTPUT.PUT_line(buff);
	buff := rpad('b', 100, 'b');
	DBMS_OUTPUT.PUT_line(buff);
	buff := rpad('c', 100, 'c');
	DBMS_OUTPUT.PUT_line(buff);
	DBMS_OUTPUT.GET_LINE(buff,stts);	-- make buffer dirty
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.ENABLE(6000);			-- enable()
	DBMS_OUTPUT.GET_LINE(buff,stts);	-- get line now 
	INSERT INTO dbms_output_test VALUES (buff, stts);
	buff := rpad('d', 100, 'd');
	DBMS_OUTPUT.PUT_line(buff);			-- buffer dirty, so reset buffer
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
/
SELECT * FROM dbms_output_test;
                                                 buff                                                 | status 
------------------------------------------------------------------------------------------------------+--------
 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa |      0
 bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb |      0
 dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd |      0
(3 rows)

DELETE FROM dbms_output_test;
-- newline characters do not take up the storage space of buffer.
DECLARE
	buff varchar2(32767) := 'init';
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(3000);
	for i in 1..30000 loop
		DBMS_OUTPUT.PUT_LINE(NULL);		-- OK
	end loop;
END;
/
DECLARE
	buff varchar2(32767) := 'init';
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(3000);
	for i in 1..3001 loop
		DBMS_OUTPUT.PUT_LINE('a');		-- ERROR
	end loop;
END;
/
ERROR:  buffer overflow, limit of 3000 bytes
CONTEXT:  SQL statement "CALL sys.dbmsoutput_putline(item)"
PL/iSQL function put_line line 32 at CALL
SQL statement "CALL DBMS_OUTPUT.PUT_LINE('a')"
