-- when set serveroutput to on and issue error, will flush the buffer, print all
-- lines of put before error. 
SET SERVEROUTPUT ON
DECLARE
	buff varchar2(32767) := 'init';
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(1000000);
	buff := rpad('a', 100, 'b');
	DBMS_OUTPUT.PUT(buff);
	DBMS_OUTPUT.NEW_LINE();
	buff := rpad('a', 32760, 'b');
	DBMS_OUTPUT.PUT(buff);
	DBMS_OUTPUT.PUT(buff);
END;
/
