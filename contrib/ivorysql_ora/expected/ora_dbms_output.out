-- newline within line content.
DECLARE
	buff varchar2(32767) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE(20000);
	DBMS_OUTPUT.PUT_LINE('BBB'||chr(10)||'CCC');
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
