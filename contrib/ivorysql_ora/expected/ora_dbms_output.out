--
-- Regression tests for Oracle dbms_output package
--
/* Begin - BUG#Z6218 */
CREATE USER system WITH superuser;
\c - system
/* End - BUG#Z6218 */
-- without call enable(), put_line not work.
CREATE TABLE dbms_output_test(buff varchar2(1024), status int);
DECLARE
	buff varchar2(1024);
	status int;
BEGIN	
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
SELECT * FROM dbms_output_test;
 buff | status 
------+--------
      |      1
(1 row)

DELETE FROM dbms_output_test;
-- with enable(), put_line and get_line can work.
DECLARE
	buff varchar2(1024);
	status int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
SELECT * FROM dbms_output_test;
     buff      | status 
---------------+--------
 ORAFCE TEST 1 |      0
(1 row)

DELETE FROM dbms_output_test;
-- disable() will lose the content already put into the buffer.
DECLARE
	buff varchar2(1024);
	status int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
SELECT * FROM dbms_output_test;
 buff | status 
------+--------
      |      1
(1 row)

DELETE FROM dbms_output_test;
-- the buffer of dbms_output life is session level.
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
END;
/
DECLARE
	buff varchar2(1024);
	status int;
BEGIN
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
SELECT * FROM dbms_output_test;
     buff      | status 
---------------+--------
 ORAFCE TEST 1 |      0
(1 row)

DELETE FROM dbms_output_test;
-- enable serveroutput does not print the content that has already been read.
-- so the table dbms_output_test has one tupe "ORAFCE TEST 1", serveroutput only print "ORAFCE TEST 2".
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
END;
/
SET SERVEROUTPUT ON
DECLARE
	buff varchar2(1024);
	status int;
BEGIN
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
ORAFCE TEST 2
SELECT * FROM dbms_output_test;
     buff      | status 
---------------+--------
 ORAFCE TEST 1 |      0
(1 row)

DELETE FROM dbms_output_test;
SET SERVEROUTPUT OFF
-- the test result is the same as above except that the contents of buffer are written after serveroutput starts.
SET SERVEROUTPUT ON
DECLARE
	buff varchar2(1024);
	status int;
BEGIN	
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
ORAFCE TEST 2
SELECT * FROM dbms_output_test;
     buff      | status 
---------------+--------
 ORAFCE TEST 1 |      0
(1 row)

DELETE FROM dbms_output_test;
SET SERVEROUTPUT OFF
-- after diable() buffer is empty, so serveroutput print nothing and get_line read failed.
SET SERVEROUTPUT ON
DECLARE
	buff varchar2(1024);
	status int;
BEGIN	
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE('ORAFCE TEST 2');
	DBMS_OUTPUT.GET_LINE(buff,status);
	INSERT INTO dbms_output_test VALUES (buff, status);	
END;
/
SELECT * FROM dbms_output_test;
 buff | status 
------+--------
      |      1
(1 row)

DELETE FROM dbms_output_test;
SET SERVEROUTPUT OFF
-- put_line('') = new_line()
SET SERVEROUTPUT ON
BEGIN
	DBMS_OUTPUT.PUT ('ORA');
	DBMS_OUTPUT.PUT ('F');
	DBMS_OUTPUT.PUT ('CE');
	DBMS_OUTPUT.PUT_LINE ('');
	DBMS_OUTPUT.PUT ('ABC');
	DBMS_OUTPUT.PUT_LINE ('');
END;
/
ORAFCE
ABC
SET SERVEROUTPUT OFF
-- after get_line, the buffer become dirty and the buffer will be reset when put/put_line data again.
DECLARE
	buff varchar2(1024);
	status int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT_LINE ('ORAFCE TEST 1');
	DBMS_OUTPUT.PUT_LINE ('ORAFCE TEST 2');
	DBMS_OUTPUT.GET_LINE(buff, status);
	INSERT INTO dbms_output_test VALUES (buff, status);
	DBMS_OUTPUT.PUT_LINE ('ORAFCE TEST 3');
	DBMS_OUTPUT.GET_LINE(buff, status);
	INSERT INTO dbms_output_test VALUES (buff, status);
	DBMS_OUTPUT.GET_LINE(buff, status);
	INSERT INTO dbms_output_test VALUES (buff, status);
	DBMS_OUTPUT.GET_LINE(buff, status);
	INSERT INTO dbms_output_test VALUES (buff, status);
	DBMS_OUTPUT.DISABLE();
END;
/
SELECT * FROM dbms_output_test;
     buff      | status 
---------------+--------
 ORAFCE TEST 1 |      0
 ORAFCE TEST 3 |      0
               |      1
               |      1
(4 rows)

DELETE FROM dbms_output_test;
-- new_line() generate a single empty line.
DECLARE
	buff varchar2(1024) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT_LINE ('ORAFCE TEST 1');
	DBMS_OUTPUT.NEW_LINE();
	DBMS_OUTPUT.PUT_LINE ('ORAFCE TEST 3');
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
/
SELECT * FROM dbms_output_test;
     buff      | status 
---------------+--------
 ORAFCE TEST 1 |      0
               |      0
 ORAFCE TEST 3 |      0
(3 rows)

DELETE FROM dbms_output_test;
-- after all the lines in the buffer have been read, further reading fails and the status is 1.
DECLARE
	buff varchar2(1024) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.NEW_LINE();
	DBMS_OUTPUT.NEW_LINE();
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
/
SELECT * FROM dbms_output_test;
 buff | status 
------+--------
      |      0
      |      0
      |      1
(3 rows)

DELETE FROM dbms_output_test;
-- get_line read the lines of the buffer using the new line character as the delimiter.
-- data without new line character will not be read.
DECLARE
	buff varchar2(1024) := 'init';
	stts int;
BEGIN
	DBMS_OUTPUT.DISABLE();
	DBMS_OUTPUT.ENABLE();
	DBMS_OUTPUT.PUT('aa');
	DBMS_OUTPUT.PUT('bb');
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
	DBMS_OUTPUT.GET_LINE(buff,stts);
	INSERT INTO dbms_output_test VALUES (buff, stts);
END;
/
SELECT * FROM dbms_output_test;
 buff | status 
------+--------
      |      1
      |      1
      |      1
(3 rows)

DELETE FROM dbms_output_test;
-- empty lines can be read correctly by get_line, but will not be printed by serveroutput. 
SET SERVEROUTPUT ON
BEGIN
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE(NULL);
END;
/
BEGIN
	DBMS_OUTPUT.PUT_LINE('line 1');
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE('line 2');
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE('line 3');
END;
/
line 1
line 2
line 3
BEGIN
	DBMS_OUTPUT.PUT_LINE('line 1');
	DBMS_OUTPUT.PUT_LINE(NULL);
	DBMS_OUTPUT.PUT_LINE('line 2');
	DBMS_OUTPUT.NEW_LINE();
	DBMS_OUTPUT.PUT_LINE('line 3');
END;
/
line 1
line 2
line 3
SET SERVEROUTPUT OFF
