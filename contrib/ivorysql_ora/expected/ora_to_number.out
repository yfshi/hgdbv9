--
-- SHOW / SET system_variable value
--
show num numw numwi numwid numwidt numwidth
NUMWIDTH -1
NUMWIDTH -1
NUMWIDTH -1
NUMWIDTH -1
NUMWIDTH -1
NUMWIDTH -1
set num 1
NUMWIDTH option 1 out of range (2 through 128)
show num
NUMWIDTH -1
set numw 2
show num
NUMWIDTH 2
set numwi 3
show num
NUMWIDTH 3
set numwid 4
show num
NUMWIDTH 4
set numwidt 5
show num
NUMWIDTH 5
set numwidth 6
show num
NUMWIDTH 6
set num 2 numw 3 numwi 4 numwid 5 numwidt 6 numwidth 7
show num
NUMWIDTH 7
set num -1
set schema 'test';
show search_path;
 search_path 
-------------
 test
(1 row)

reset search_path;
