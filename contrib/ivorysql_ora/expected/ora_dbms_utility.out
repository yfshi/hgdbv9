-- Test for PROCEDURE TABLE_TO_COMMA() and COMMA_TO_TABLE()
-- Uses CALL inside PL/pgSQL to capture OUT parameter.
-- ==============================================================
DECLARE
    l_names   text[4];
    l_list    VARCHAR2(32767);
    l_count   BINARY_INTEGER;
BEGIN
    l_names[1] := 'SCOTT';
    l_names[2] := 'HR';
    l_names[3] := 'OE';
    l_names[4] := NULL; 
    DBMS_UTILITY.TABLE_TO_COMMA(
        tab    => l_names,
        tablen => l_count,
        list   => l_list
    );
    DBMS_OUTPUT.PUT_LINE('Count: ' || l_count);
    DBMS_OUTPUT.PUT_LINE('List : ' || l_list);
END;
/
Count: 3
List : SCOTT,HR,OE
DECLARE
    l_name VARCHAR2 := ' "Emp, Table", DEPT , "My_Schema".    "My_Table" ';
    l_tablen BINARY_INTEGER;
    l_tab VARCHAR2[];
BEGIN
    DBMS_UTILITY.COMMA_TO_TABLE(l_name, l_tablen, l_tab);
    FOR i IN 1..l_tablen LOOP
        RAISE NOTICE '[%]: [%]', i, l_tab[i];
    END LOOP;
END;
/
NOTICE:  [1]: [ "Emp, Table"]
NOTICE:  [2]: [ DEPT ]
NOTICE:  [3]: [ "My_Schema".    "My_Table" ]
DECLARE
    l_name VARCHAR2 := ' Emp,    Table, DEPT , "My_Schema",    "My_Table" ';
    l_tablen BINARY_INTEGER;
    l_tab VARCHAR2[];
BEGIN
    DBMS_UTILITY.COMMA_TO_TABLE(l_name, l_tablen, l_tab);
    FOR i IN 1..l_tablen LOOP
        RAISE NOTICE '[%]: [%]', i, l_tab[i];
    END LOOP;
END;
/
NOTICE:  [1]: [ Emp]
NOTICE:  [2]: [    Table]
NOTICE:  [3]: [ DEPT ]
NOTICE:  [4]: [ "My_Schema"]
NOTICE:  [5]: [    "My_Table" ]
