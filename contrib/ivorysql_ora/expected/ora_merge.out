  DELETE WHERE pt.title  = 'Mrs.';
ERROR:  null value in column "first_name" of relation "people_target" violates not-null constraint
DETAIL:  Failing row contains (2, null, jones, Mrs.).
-- Create target table with FK reference
CREATE TABLE s1(
    id  INT NOT NULL PRIMARY KEY,
    sp  VARCHAR2(20)
);
CREATE TABLE t1(
    id  INT,
    sid INT,
    tp  VARCHAR2(20),
    FOREIGN KEY(sid) REFERENCES s1(id) ON DELETE CASCADE
);
INSERT INTO s1 VALUES(1, '#s1');
INSERT INTO s1 VALUES(2, '#s2');
INSERT INTO s1 VALUES(10, '#s10');
INSERT INTO t1 VALUES(1, 1, '#t1');
INSERT INTO t1 VALUES(3, 2, '#t3');
select * from s1;
 id |  sp  
----+------
  1 | #s1
  2 | #s2
 10 | #s10
(3 rows)

select * from t1;
 id | sid | tp  
----+-----+-----
  1 |   1 | #t1
  3 |   2 | #t3
(2 rows)

-- Except a constraint violation error report
MERGE INTO t1 t
 USING s1 s ON(t.id = s.id)
WHEN MATCHED THEN
 UPDATE SET t.sid = s.id + 100
 DELETE WHERE t.sid = 101;
ERROR:  insert or update on table "t1" violates foreign key constraint "t1_sid_fkey"
DETAIL:  Key (sid)=(101) is not present in table "s1".
