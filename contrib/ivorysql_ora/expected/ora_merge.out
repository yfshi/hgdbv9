    "NET_TYPE" CHAR(3) ,"VENDOR" CHAR(18) ,"CREATE_BY" CHAR(6) ,"CREATE_DATE" DATE ,"STATEFLAG" NUMBER ,"TIME_STAMP" DATE ,
    "RELATED_BBU" VARCHAR2(255) ,"DN" VARCHAR2(255) ,"SERIALNUMBER" VARCHAR2(255) ,"RELATED_OMC_ID" VARCHAR2(32) ,
    "RELATED_CELL" VARCHAR2(255) ,"VENDORNAME" VARCHAR2(255) ,"FREQUENCYBAND" VARCHAR2(255) ,"DATEOFMANUFACTURE" VARCHAR2(255) ,
    "DATEOFLASTSERVICE" VARCHAR2(255) ,"MANUFACTURERDATA" VARCHAR2(255) ,"VENDORUNITFAMILYTYPE" VARCHAR2(255) ,
    "USERLABEL" VARCHAR2(255) ,"RMUID" VARCHAR2(255) ,"ENB_RMUID" VARCHAR2(255)
);
