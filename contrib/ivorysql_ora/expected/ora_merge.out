USING people_source ps
ON    (pt.person_id + 1 = ps.person_id + 1)
WHEN MATCHED THEN UPDATE
  SET pt.person_id = pt.person_id + 10
;
ERROR:  Columns referenced in the ON Clause cannot be updated: people_target.person_id
