    "IS_ACCESS_4A" VARCHAR2(3100) ,"GROUP_CANONICAL_NAME" VARCHAR2(3100) ,"SUPPORT_CONTACTS" VARCHAR2(3100) ,
    "CAPACITY_DESCRIPTION" VARCHAR2(3100) ,"EMPTY_CABINET" VARCHAR2(3100) ,"DEVICE_TIME_MARKET" VARCHAR2(3100) ,
    "REMARK" VARCHAR2(3100) ,"SYSTEM_VERSION" VARCHAR2(3100) ,"MANAGEMENT_SYSTEM" VARCHAR2(3100) ,"MR_INTERFACE_VERSION" VARCHAR2(3100) ,
    "NE_CODE" VARCHAR2(3100) ,"NRM_NAME" VARCHAR2(3100) ,"WORKING_FREQUENCY" VARCHAR2(3100) ,"PROFESSIONAL" VARCHAR2(3100) ,
    "SERVICE_PROVIDERS" VARCHAR2(3100) ,"LABEL" VARCHAR2(3100) ,"VERSION" VARCHAR2(3100) ,"IP_ADDRESS" VARCHAR2(3100) ,
    "INSPECTION_PERSONNEL" VARCHAR2(3100) ,"VICTORIA" VARCHAR2(3100) ,"RESPONSE_LEVELS" VARCHAR2(3100) ,
    "SOFTWARE_MANUFACTURERS" VARCHAR2(3100) ,"OMC_TYPE" VARCHAR2(3100) ,"POWER_REQUIRE" VARCHAR2(3100) ,
    "MAINTENANCE_FACTORY" VARCHAR2(3100) ,"ACCEPTANCE" VARCHAR2(3100) ,"MAC" VARCHAR2(3100) ,"TELNET_PORT" VARCHAR2(3100) ,
    "ENGINE_VERSION" VARCHAR2(3100) ,"DATABAS_TIME" VARCHAR2(3100) ,"HARDWARE_LEVELS" VARCHAR2(3100) ,
    "SOFTWARE_LEVELS" VARCHAR2(3100) ,"OMC_DESCRIPTION" VARCHAR2(3100) ,"CLOCK_DESCRIPTION" VARCHAR2(3100) ,
    "POWER_MODULE" VARCHAR2(3100) ,"ELECTRIC_UNIT" VARCHAR2(3100) ,"CPU" VARCHAR2(3100) ,"HARDWARE_PLATFORM2" VARCHAR2(3100) ,
    "DATABASE_MANUFACTURER" VARCHAR2(3100) ,"HARDWARE_MANUFACTURER" VARCHAR2(3100) ,"PROCESS_ID" VARCHAR2(3100) ,
    "INSPECTION" VARCHAR2(3100) ,"TIME_WARRANTY" VARCHAR2(3100) ,"OPENING_TIME" VARCHAR2(3100) ,"GROUNDING" VARCHAR2(3100) ,
    "CLOCK_SOURCE" VARCHAR2(3100) ,"HARD_DISK_CAPACITY" VARCHAR2(3100) ,"COVERAGE" VARCHAR2(3100) ,"DEVICE_PROPERTIES" VARCHAR2(3100) ,
    "EQUIPMENT_MANAGER" VARCHAR2(3100) ,"PROCESS_NODE_ID" VARCHAR2(3100) ,"VERSION_HISTORY" VARCHAR2(3100) ,"MODEL_OVERVIEW" VARCHAR2(3100) ,
    "FULLY_LOADED_WEIGHT" VARCHAR2(3100) ,"CLOCK_TYPE" VARCHAR2(3100) ,"EQUIPMENT_PROVIDERS" VARCHAR2(3100) ,
    "PERSON_CHARGE" VARCHAR2(3100) ,"REMOTE" VARCHAR2(3100) ,"FAULTS_UNIT" VARCHAR2(3100) ,"DOMAIN_NAME" VARCHAR2(3100) ,
    "MAXIMUM_POWER" VARCHAR2(3100) ,"BASIC_UNITS" VARCHAR2(3100) ,"IP_SEGMENT" VARCHAR2(3100) ,"MEMORY" VARCHAR2(3100) ,
    "ALIAS" VARCHAR2(3100) ,"CITY_MANAGER" VARCHAR2(3100) ,"DATABASE_VERSION" VARCHAR2(3100) ,"CLOCK_PORTS" VARCHAR2(3100) ,
    "CLOCK_LEVEL_ORIENTATION" VARCHAR2(3100) ,"HARDWARE_PLATFORM3" VARCHAR2(3100) ,"PATCH_VERSION" VARCHAR2(3100) ,
    "HARDWARE_CALLS" VARCHAR2(3100) ,"WIRELESS_VERSION" VARCHAR2(3100) ,"MODEL_REMARKS" VARCHAR2(3100) ,"DESCRIPTION" VARCHAR2(100) ,
    "TEQUIP_INST_ID" NUMBER(9,0) ,"TVENDOR" VARCHAR2(30) ,"STATUS" VARCHAR2(20) ,"TYPE" VARCHAR2(30) ,"MODEL" VARCHAR2(30) ,
    "REV" VARCHAR2(30) ,"SW_REV" VARCHAR2(30) ,"DESCR" VARCHAR2(100) ,"SITE_INST_ID" NUMBER(9,0) ,"PARENT_EQ_INST_ID" NUMBER(9,0) ,
    "EQ_CLASS" CHAR(1) ,"ORDERED" DATE ,"DUE" DATE ,"INSTALLED" DATE ,"IN_SERVICE" DATE ,"SCHED_DATE" DATE ,"SERIAL_NO" VARCHAR2(30) ,
    "BATCH_NO" VARCHAR2(20) ,"BAR_CODE" VARCHAR2(30) ,"LAST_MOD_TS" DATE ,"LAST_MOD_BY" VARCHAR2(20) ,"EQ_TPLT_INST_ID" NUMBER(9,0) ,
    "CUST_INST_ID" NUMBER(9,0) ,"NUM_SLOTS" NUMBER ,"NUM_CARDS" NUMBER ,"SITE_HUM_ID" VARCHAR2(100) ,"SITE_CLLI" VARCHAR2(50) ,
    "PARENT_EQUIPMENT" VARCHAR2(100) ,"EQUIP_CUSTOMER" VARCHAR2(50) ,"TEMPLATE_NAME" VARCHAR2(100) ,"ADMIN_COMPANY" VARCHAR2(50) ,
    "FRAME" VARCHAR2(12) ,"LINEUP" VARCHAR2(12) ,"DIM_HEIGHT" NUMBER(10,3) ,"DIM_WIDTH" NUMBER(10,3) ,"DIM_DEPTH" NUMBER(10,3) ,
    "TIME_STAMP" TIMESTAMP(6) ,"MODIFY_TIME" TIMESTAMP(6) ,"INT_ID" NUMBER   NOT NULL,"STATEFLAG" NUMBER   NOT NULL,"CREATOR" VARCHAR2(255) ,
    "CREAT_TIME" TIMESTAMP(6) ,"MODIFIER" VARCHAR2(255) ,"IS_WRONG" NUMBER ,"WRONG_INFO" VARCHAR2(1024) ,"ZH_LABEL" VARCHAR2(32) ,
    "CITY_ID" NUMBER  DEFAULT '1',"RELATED_EQUIPROOM_ID" NUMBER ,"XNG_ID" NUMBER ,"USETYPE" VARCHAR2(125) ,"EQUIPROOM_ID" NUMBER ,
    "REMARK2" VARCHAR2(1000)
);
COMMENT ON TABLE "RMS_OMC" IS 'OMC';
CREATE  TABLE "RMS_RRU"(
    "VENDOR" VARCHAR2(60) ,"RELATED_SITE_ID" VARCHAR2(255) ,"RELATED_CELL_ID" VARCHAR2(255) ,"STATUS" VARCHAR2(40) ,
    "MODEL" VARCHAR2(60) ,"INT_ID" NUMBER   NOT NULL,"STATEFLAG" NUMBER ,"ZH_LABEL" VARCHAR2(255) ,"CITY_ID" NUMBER  DEFAULT '1',
    "IS_WRONG" VARCHAR2(255) ,"TIME_STAMP" DATE ,"CREATOR" VARCHAR2(255) ,"MODIFIER" VARCHAR2(255) ,"MODIFY_TIME" DATE ,
    "CREAT_TIME" DATE ,"WRONG_INFO" VARCHAR2(4000) ,"RELATED_EQUIPROOM_ID" NUMBER ,"REMARK2" VARCHAR2(2000) ,"REMARK1" VARCHAR2(2000) ,
    "IS_UNIONUSE" VARCHAR2(255) ,"RELATED_BBU_ID" VARCHAR2(300) ,"RELATED_CASCADE_RRU_ID" NUMBER(15,5) ,"NET_STANDARD" VARCHAR2(40) ,
    "COVER_AREA" VARCHAR2(255) ,"FLOW_ID_HIS" NUMBER ,"QRCODE" VARCHAR2(255)  DEFAULT '',"DATE_MANAGE" VARCHAR2(255)  DEFAULT '',
    "NE_LOCATION" VARCHAR2(255) ,"RELATED_EQUIPROOM" NUMBER ,"DATA_MANAGER" VARCHAR2(256) ,"RRU_CM" VARCHAR2(255)  DEFAULT '',
    "RATED_POWER" NUMBER ,"RELATED_CELL_ID_4G" VARCHAR2(512) ,"PROPERTY_SEQ" VARCHAR2(4000) ,"BOCO_ROW_NUM" NUMBER ,
    "IF_CHANGE_CELL" NUMBER ,"FINANCE_NAME" VARCHAR2(64)  DEFAULT '',"ASSETS_TYPE" VARCHAR2(255)  DEFAULT '',
    "REMOTE_COMMUNITIES" VARCHAR2(10)  DEFAULT '',"PEACEKEEP" VARCHAR2(22)  DEFAULT '',"REMARK" VARCHAR2(2000) ,"DN" VARCHAR2(255) ,
    "RELATED_OMC_ID" VARCHAR2(255) ,"VENDORUNITFAMILYTYPE" VARCHAR2(64) ,"VENDORUNITTYPENUMBER" VARCHAR2(64) ,"VENDORNAME" VARCHAR2(32) ,
    "SERIALNUMBER" VARCHAR2(64) ,"DATEOFMANUFACTURE" VARCHAR2(16) ,"DATEOFLASTSERVICE" VARCHAR2(16) ,"MANUFACTURERDATA" VARCHAR2(4000) ,
    "FREQUENCYBAND" VARCHAR2(32) ,"RELATEDCELLLIST" VARCHAR2(64) ,"USERLABEL" VARCHAR2(255) ,"CONNECT_MODEL" VARCHAR2(255) ,
    "RMUID" VARCHAR2(128) ,"ENB_RMUID" VARCHAR2(128)
);
COMMENT ON COLUMN "RMS_RRU"."ENB_RMUID" IS 'add by han 20230307';
set ivorysql.insert_enable_alias to on;
MERGE INTO rms_rru n
    USING (SELECT zh_label,
                related_ne,
                model,
                net_type,
                related_bbu,
                vendor,
                create_by,
                create_date,
                stateflag,
                TIME_STAMP,
                autocollect,
                dn,
                SerialNumber,
                (select zh_label from rms_omc k where k.alias=m.related_omc_id and rownum=1) as related_omc_id
                FROM (SELECT SerialNumber,
                    max(zh_label) zh_label,
                    max(related_ne) related_ne,
                    max(model) model,
                    max(net_type) net_type,
                    max(related_bbu) related_bbu,
                    max(vendor) vendor,
                    max(create_by) create_by,
                    max(create_date) create_date,
                    stateflag,
                    max(TIME_STAMP) TIME_STAMP,
                    max(autocollect) autocollect,
                    max(dn) dn,
                    max(related_omc_id) related_omc_id
                FROM (select zh_label,
                        related_ne,
                        model,
                        net_type,
                        related_bbu,
                        vendor,
                        create_by,
                        create_date,
                        stateflag,
                        TIME_STAMP,
                        'autocollect' autocollect,
                        dn,
                        SerialNumber,
                        related_omc_id
                    from dat_lte_rru_temp
                    where SerialNumber IS NOT NULL
                    and not exists
                        (select 1
                            from rms_rru
                            where RRU_CM = dat_lte_rru_temp.SerialNumber
                            and stateflag = 0))
                            group by SerialNumber, stateflag) m) zb
                            ON (n.RRU_CM = zb.SerialNumber and n.stateflag = zb.stateflag)
    WHEN NOT MATCHED THEN
    INSERT  (n.int_id,
        n.zh_label,
        n.related_site_id,
        n.model,
        n.net_standard,
        n.RELATED_BBU_ID,
        n.vendor,
        n.CREATOR,
        n.CREAT_TIME,
        n.stateflag,
        n.TIME_STAMP,
        n.remark,
        n.dn,
        n.RRU_CM,
        n.related_omc_id)
    VALUES  (rms_lte_seq.nextval,
        zb.zh_label,
        zb.related_ne,
        zb.model,
        zb.net_type,
        zb.related_bbu,
        zb.vendor,
        zb.create_by,
        zb.create_date,
        zb.stateflag,
        zb.TIME_STAMP,
        zb.autocollect,
        zb.dn,
        zb.SerialNumber,
        zb.related_omc_id);
-- cleanup
drop table rms_omc;
drop table rms_rru;
drop table dat_lte_rru_temp;
drop sequence rms_lte_seq;
/* End - OA-REQ-1669 */
