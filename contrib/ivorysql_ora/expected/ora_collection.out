  b second_type;
  b2 second_type;
  c third_type;
BEGIN
  a(1) := 11;
  a(2) := 22;
  a(3) := 33;
  a2(100) := 101;
  a2(200) := 202;
  b(1) := a;
  b(2) := a2;
  b2(1) := a;
  b2(3) := a2;
  c(1) := b;
  c(2) := b2;
  raise notice 'a.NEXT(2) = %, b.NEXT(1) = %, b(1).NEXT(2) = %, c(2)(3).NEXT(100) =%', a.NEXT(2), b.NEXT(1), b(1).NEXT(2), c(2)(3).NEXT(100); 
END;
