  raise notice '%,%,%', b(1)(1),b(1)(2),b(1)(3);
  b(1) := a2;
  raise notice '%', b(1)(1); 
  b(1)(1) := 22;
  raise notice '%', b(1)(1); 
  c1(1)(2) := a1;
  raise notice '%,%,%',c1(1)(2)(1),c1(1)(2)(2),c1(1)(2)(3);
  c1(1)(2)(3) := 10;
  raise notice '%,%,%',c1(1)(2)(1),c1(1)(2)(2),c1(1)(2)(3);
  a1 := b(1);
  raise notice '%',a1(1);
END;
/
NOTICE:  1,2,0
