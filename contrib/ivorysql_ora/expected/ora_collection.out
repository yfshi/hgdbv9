  TYPE myrecord2 IS RECORD(i population);
  TYPE population2 IS VARRAY(20) OF myrecord2;
  r myrecord;
  a population;
  r2 myrecord2;
  b population2;
BEGIN
  r.id := 11;
  a := population(r, r);
  r2.i := a;
  b := population2(r2, r2);
  raise notice 'b(1).i(2).id = %', b(1).i(2).id;
  b(1).i(2).id := 100;
  raise notice 'b(1).i(2).id = %', b(1).i(2).id;
END;
/
NOTICE:  b(1).i(2).id = 11
NOTICE:  b(1).i(2).id = 100
DECLARE
  TYPE myrecord IS RECORD(id INT);
