     raise notice 'a1 = a2';
  ELSE
	 raise notice 'a1 != a2';
  END IF;
  IF a1 = a3  THEN
     raise notice 'a1 = a3';
  ELSE
	 raise notice 'a1 != a3';
  END IF; 
  IF a2 = a4  THEN
     raise notice 'a2 = a4';
  ELSE
	 raise notice 'a2 != a4';
  END IF;   
END;
