--associative array of associative array
DECLARE
  TYPE first_type IS TABLE OF varchar(10) INDEX BY VARCHAR(10);
  TYPE second_type IS TABLE OF first_type INDEX BY VARCHAR(10);
  a first_type;
  b second_type;
BEGIN
  a('tom') := 'good';
  b('Jone')('Jim') := 'high';
  raise notice '%', b('Jone')('Jim');  
END;
/
