--nested table assignment
DECLARE
  TYPE first_type IS TABLE OF INT;
  TYPE second_type IS TABLE OF first_type;
  TYPE third_type IS TABLE OF second_type;
  a1 first_type; 
  a2 first_type;    
  b second_type;
  b2 second_type; 
  c1 third_type;
BEGIN
  a1 := first_type(1, 2, 0);
  a2 := first_type(11);
  b := second_type(a1);
  raise notice '%,%,%', b(1)(1),b(1)(2),b(1)(3);
  b(1) := a2;
  raise notice '%', b(1)(1); 
  b(1)(1) := 22;
  raise notice '%', b(1)(1);
  b2 := second_type(a1);
  c1 := third_type(b, b2);
  raise notice '%,%,%',c1(2)(1)(1),c1(2)(1)(2),c1(2)(1)(3);
  c1(2)(1)(3) := 10;
  raise notice '%,%,%',c1(2)(1)(1),c1(2)(1)(2),c1(2)(1)(3);
  a1 := b(1);
  raise notice '%',a1(1);
END;
