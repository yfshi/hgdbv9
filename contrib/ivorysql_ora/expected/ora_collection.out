DECLARE
  TYPE mytype IS VARRAY(30) OF INT;
  a mytype := mytype(10, 20, 30);
  i int;
  j int;  
BEGIN
  raise notice 'a.first() = %, a.last() = %', a.first(), a.last();
  i := a.first();
  j := a.last();
  raise notice 'i = %, j = %', i, j;
END;
