DECLARE
  TYPE record_type IS RECORD(i int, j int); 
  TYPE mytype IS TABLE OF record_type;
  rec record_type;
  a mytype;
  j int;
BEGIN
  rec.i := 1;
  rec.j := 2;
  a := mytype();
  a.extend(3);
  a(2) := rec;
  j := a(2).i;
  raise notice 'j = %', j;
END;
/
NOTICE:  j = 1
