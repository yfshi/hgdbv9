  TYPE population IS TABLE OF INT NOT NULL INDEX BY INT;
  a population;
BEGIN
  a(1) := 10;
  a(3) := 1000;
  SELECT id INTO a(2) FROM tc WHERE age = a(1) and name like 'name1' and salary = a(3);
  raise notice 'a(2) = %', a(2);
END;
/
NOTICE:  a(2) = 1
