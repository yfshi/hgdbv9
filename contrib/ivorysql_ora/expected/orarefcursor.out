--clean data
DROP FUNCTION test_f;
DROP FUNCTION test_f1;
DROP TABLE test_sysrefcursor;
DROP TABLE test_orarefcursor;
--ok
create type test_type as (id integer,name sys_refcursor);
alter type test_type add attribute name1 sys_refcursor;
alter type test_type alter attribute id set data type sys_refcursor;
drop type test_type;
--test table
create table test_refcursor(id integer,name sys_refcursor);
--test add column
alter table test_refcursor add column name1 sys_refcursor;
drop table test_refcursor;
