DECLARE
  TYPE empnos_t IS TABLE OF NUMBER;
  v_empnos empnos_t;
BEGIN
  SELECT empno
  BULK COLLECT INTO v_empnos
  FROM employee order by empno ;
  FOR i IN 1..v_empnos.COUNT LOOP
    DBMS_OUTPUT.PUT_LINE('  ID: ' || v_empnos(i));
  END LOOP;
END;
