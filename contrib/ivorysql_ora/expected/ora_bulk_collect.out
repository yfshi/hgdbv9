--REFCURSOR
DECLARE  
  c1 REFCURSOR;
  TYPE NumList IS TABLE OF NUMBER INDEX BY INT;
  enums  NumList;
BEGIN
  OPEN c1 FOR
    SELECT empno FROM tmp;  
  FETCH c1 BULK COLLECT INTO enums;
  FOR i IN 1 .. enums.COUNT LOOP
    raise notice '%', 'Employee Id: ' || enums(i);
  END LOOP;
  CLOSE c1;
END;
/
