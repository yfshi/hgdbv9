-------+-------
 5     | 5    
(1 row)

-- Spaces are not ignored when VARCHAR2 compared with VARCHAR2
SELECT * FROM TEST_ORAVARCHAR WHERE a = '5   ';
 a | b 
---+---
(0 rows)

