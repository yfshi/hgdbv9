create table toast_char4(a char(2005 byte));
declare
  var int := 0;
begin
  select reltoastrelid into var from pg_class where relname='toast_char4';
  if var > 0 then
    raise notice 'toast';
  else
    raise notice 'no toast';
  end if;
end;
/
NOTICE:  toast
