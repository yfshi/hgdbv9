  TYPE NumList IS VARRAY(20) OF NUMBER;
  depts NumList := NumList(1, 2, 10);
BEGIN
  FORALL i IN depts.FIRST..depts.LAST
    DELETE FROM employees_temp
    WHERE departno = depts(i);
END;
/
