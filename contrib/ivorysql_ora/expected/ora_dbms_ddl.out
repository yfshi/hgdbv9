CREATE OR REPLACE TRIGGER trg_test_compile
BEFORE INSERT ON t_compile_test
FOR EACH ROW
BEGIN
    :NEW.val := NVL(:NEW.val, 0);
END;
/
-- alter_compile TRIGGER
BEGIN
	SYS.DBMS_DDL.ALTER_COMPILE(
		type   => 'TRIGGER',
		schema => 'public',
		name   => 'trg_test_compile'
	);
END;
