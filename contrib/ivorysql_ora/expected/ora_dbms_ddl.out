CREATE SCHEMA dbmsddl;
CREATE SCHEMA "dbmsddl1";
CREATE SCHEMA "DBMSDDL2";
CREATE SCHEMA "DbMsDdL3";
CREATE TABLE t_compile_test(
    id NUMBER,
    val NUMBER
);
CREATE TABLE dbmsddl.tc(
    id NUMBER,
    val NUMBER
);
CREATE TABLE "dbmsddl1".tc1(
    id NUMBER,
    val NUMBER
);
CREATE TABLE "DBMSDDL2".tc2(
    id NUMBER,
    val NUMBER
);
CREATE TABLE "DbMsDdL3".tc3(
    id NUMBER,
    val NUMBER
);
CREATE OR REPLACE PROCEDURE proc_test_compile
AS
BEGIN
    INSERT INTO t_compile_test VALUES (1, 100);
END;
/
CREATE OR REPLACE PROCEDURE dbmsddl.proc_tc
AS
BEGIN
    INSERT INTO dbmsddl.tc VALUES (1, 10);
END;
/
CREATE OR REPLACE PROCEDURE "dbmsddl1".proc_tc1
AS
BEGIN
    INSERT INTO "dbmsddl1".tc1 VALUES (2, 100);
END;
/
CREATE OR REPLACE PROCEDURE "DBMSDDL2".proc_tc2
AS
BEGIN
    INSERT INTO "DBMSDDL2".tc2 VALUES (3, 1000);
END;
/
CREATE OR REPLACE PROCEDURE "DbMsDdL3"."PROC_tc3"
AS
BEGIN
    INSERT INTO "DbMsDdL3".tc3 VALUES (4, 10000);
END;
/
