CREATE OR REPLACE PACKAGE pkg_test_compile AS
    PROCEDURE p1;
END pkg_test_compile;
/
CREATE OR REPLACE PACKAGE BODY pkg_test_compile AS
    PROCEDURE p1 IS
    BEGIN
        INSERT INTO t_compile_test VALUES (2, 200);
    END;
END pkg_test_compile;
/
