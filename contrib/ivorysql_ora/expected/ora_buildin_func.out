SELECT
  '"' || TRIM(CAST(' A ' AS CHAR(5))) || '"' AS trimmed_value,
  LENGTH(TRIM(CAST(' A ' AS CHAR(5)))) AS trimmed_length
FROM dual; -- "A"	1
 trimmed_value | trimmed_length 
---------------+----------------
 "A"           |              1
