/*
 * Test compatible Oracle's build-in functions
 */
--
-- REGEXP_REPLACE
--
SELECT REGEXP_REPLACE('abc123def456', '\d+') AS result FROM dual; -- abcdef
 result 
--------
 abcdef
(1 row)

SELECT REGEXP_REPLACE('abc123def456', '\d+', '#') AS result FROM dual; -- abc#def#
  result  
----------
 abc#def#
(1 row)

SELECT REGEXP_REPLACE(
         '2024-12-31',
         '(\d{4})-(\d{2})-(\d{2})',
         '\3/\2/\1'
       ) AS result
FROM dual; -- 31/12/2024
   result   
------------
 31/12/2024
(1 row)

SELECT REGEXP_REPLACE(
         'a\b\c',
         '\\',
         '\\\\'
       ) AS result
FROM dual; -- a\\b\\c
 result  
---------
 a\\b\\c
(1 row)

SELECT REGEXP_REPLACE(
         'abc123def456',
         '\d+',
         '#',
         7
       ) AS result
FROM dual; -- abc123def#
   result   
------------
 abc123def#
(1 row)

SELECT REGEXP_REPLACE(
         'x1y2z3',
         '\d',
         '#',
         1,
         0
       ) AS result
FROM dual; -- x#y#z#
 result 
--------
 x#y#z#
(1 row)

--occurrence = 1
SELECT REGEXP_REPLACE(
         'x1y2z3',
         '\d',
         '#',
         1,
         1
       ) AS result
FROM dual; -- x#y2z3
 result 
--------
 x#y2z3
(1 row)

--ccurrence = 2
SELECT REGEXP_REPLACE(
         'x1y2z3',
         '\d',
         '#',
         1,
         2
       ) AS result
FROM dual; -- x1y#z3
 result 
--------
 x1y#z3
(1 row)

SELECT REGEXP_REPLACE(
         'AbCabc',
         'abc',
         '#',
         1,
         0,
         'i'
       ) AS result
FROM dual; -- ##
 result 
--------
 ##
(1 row)

SELECT REGEXP_REPLACE(
         'AbCabc',
         'abc',
         '#',
         1,
         0,
         'c'
       ) AS result
FROM dual; -- AbC#
 result 
--------
 AbC#
(1 row)

SELECT REGEXP_REPLACE(
         'a\nb\nc',
         'a.*c',
         '#',
         1,
         0,
         'n'
       ) AS result
FROM dual; -- #
 result 
--------
 #
(1 row)

SELECT REGEXP_REPLACE(
         'a\nb\nc',
         'a.*c',
         '#'
       ) AS result
FROM dual; -- #
 result 
--------
 #
(1 row)

SELECT REGEXP_REPLACE(
         'a\nb\nc',
         '^.',
         '#',
         1,
         0,
         'm'
       ) AS result
FROM dual; -- #\nb\nc
 result  
---------
 #\nb\nc
(1 row)

SELECT REGEXP_REPLACE(
         'ABC\nabc',
         '^abc',
         '#',
         1,
         0,
         'im'
       ) AS result
FROM dual; -- #\nabc
 result 
--------
 #\nabc
(1 row)

SELECT REGEXP_REPLACE(
         'abc',
         RPAD('a', 512, 'a'),
         '#'
       )
FROM dual; -- abc
 regexp_replace 
----------------
 abc
(1 row)

SELECT REGEXP_REPLACE(
         'a1b2',
         '\d',
         '#',
         1,
         5
       ) AS result
FROM dual; -- a1b2
 result 
--------
 a1b2
(1 row)

SELECT REGEXP_REPLACE(
         'abc123def456ghi',
         '(\d+)',
         '[\1]',
         4,
         2,
         'c'
       ) AS result
FROM dual; -- abc123def[456]ghi
      result       
-------------------
 abc123def[456]ghi
(1 row)

