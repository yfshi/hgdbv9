CREATE OR REPLACE FUNCTION FN_REGEXP_SUBSTR
RETURN VARCHAR2
AS
   V_RESULT VARCHAR2(100);
BEGIN
   SELECT 'ABB' INTO V_RESULT FROM DUAL;
   RETURN V_RESULT;
END;
/
SELECT REGEXP_SUBSTR(FN_REGEXP_SUBSTR(),'[^,]+',1, ROWNUM) FROM DUAL CONNECT BY ROWNUM <= 5;
 regexp_substr 
---------------
 ABB
 
 
 
 
