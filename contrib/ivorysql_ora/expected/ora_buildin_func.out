--
-- TRIM 
--
SELECT
  TRIM('  Oracle 21c  ') AS result
FROM dual; -- Oracle 21c
   result   
------------
 Oracle 21c
(1 row)

SELECT
  TRIM('  Oracle   21c  ') AS result
FROM dual; -- Oracle   21c
    result    
--------------
 Oracle   21c
(1 row)

SELECT
  TRIM(LEADING FROM '   Oracle  ') AS result
FROM dual; -- Oracle  
  result  
----------
 Oracle  
(1 row)

SELECT
  TRIM(TRAILING FROM '   Oracle  ') AS result
FROM dual; --    Oracle
  result   
-----------
    Oracle
