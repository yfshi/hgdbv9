ERROR:  invalid option of regexp_like: z
SELECT
  CASE
    WHEN REGEXP_LIKE(
           'user.name@example.com',
           '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
         )
    THEN 'VALID'
    ELSE 'INVALID'
  END AS email_check
FROM dual;  -- VALID
 email_check 
-------------
 VALID
(1 row)

SELECT
  CASE
    WHEN REGEXP_LIKE(
           '001234',
           '^\d+$'
         )
    THEN 'NUMERIC'
    ELSE 'NON-NUMERIC'
  END AS result
FROM dual;  -- NUMERIC
 result  
---------
 NUMERIC
(1 row)

