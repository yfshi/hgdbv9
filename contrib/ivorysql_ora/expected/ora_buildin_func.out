--
-- REGEXP_LIKE
--
SELECT
  CASE
    WHEN REGEXP_LIKE('abc123def', '\d+') THEN 'Y'
    ELSE 'N'
  END AS result
FROM dual;  -- Y
 result 
--------
 Y
(1 row)

SELECT
  CASE
    WHEN REGEXP_LIKE('abcdef', '\d+') THEN 'Y'
    ELSE 'N'
  END AS result
FROM dual;  -- N
 result 
--------
 N
(1 row)

