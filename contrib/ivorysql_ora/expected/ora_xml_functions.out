-- Serialization must preserve text content, including mixed-content spacing.
select case when cast(extract(XMLTYPE('before<a/>after'), '/') as varchar2(100)) = 'before<a/>after' then 'ok' else 'mismatch' end from dual;
 case 
------
 ok
(1 row)

