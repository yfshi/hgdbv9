explain(costs off) SELECT f1 AS three FROM VARCHAR_TBL where f1 = 'ab' UNION SELECT f1 FROM CHAR_TBL where f1 = 'ab'  ORDER BY 1;    -- 2 rows
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Subquery Scan on "*SELECT* PseudoCollationReplace 3"
   ->  Unique
         ->  Sort
               Sort Key: ((varchar_tbl.f1)::varchar2(4)) COLLATE "binary"
               ->  Append
                     ->  Index Only Scan using varchar_tbl_pkey on varchar_tbl
                           Index Cond: (f1 #= 'ab'::varchar2)
                     ->  Index Only Scan using char_tbl_pkey on char_tbl
                           Index Cond: (f1 #= 'ab'::oracharbyte)
(9 rows)

SELECT f1 AS three FROM VARCHAR_TBL where f1 = 'ab' UNION SELECT f1 FROM CHAR_TBL where f1 = 'ab'  ORDER BY 1;    -- 2 rows
