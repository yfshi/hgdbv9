                             QUERY PLAN                              
---------------------------------------------------------------------
 Subquery Scan on "*SELECT* PseudoCollationReplace 3"
   ->  Sort
         Sort Key: ((char_tbl.f1)::varchar2) COLLATE "binary"
         ->  HashAggregate
               Group Key: ((char_tbl.f1)::varchar2)
               ->  Append
                     ->  Bitmap Heap Scan on char_tbl
                           ->  Bitmap Index Scan on char_tbl_pkey
                     ->  Bitmap Heap Scan on varchar_tbl
                           ->  Bitmap Index Scan on varchar_tbl_pkey
(10 rows)

SELECT f1 AS three FROM CHAR_TBL UNION SELECT f1 FROM VARCHAR_TBL  ORDER BY 1;	-- orachar union varchar2,expected 5 rows
 three 
