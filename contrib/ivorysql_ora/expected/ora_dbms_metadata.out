 ) PARTITION BY LIST ("LTRIM"(("C")::"TEXT", 'A'::"TEXT") COLLATE "BINARY")                                     +
 TABLESPACE "PG_DEFAULT"                                                                                        +
 CREATE TABLE "PUBLIC"."PLT1_E_P1" PARTITION OF "PUBLIC"."PLT1_E" FOR VALUES IN ('0000', '0003', '0004', '0010')+
 TABLESPACE "PG_DEFAULT"                                                                                        +
 
(1 row)

