--
create or replace package pkg_503 as
  i int;
  function test(id integer) return integer;
end;
/
create or replace package body pkg_503 as
 function test(id integer) return integer as
 var1 integer;
 begin
    var1 := id;
    return var1 + 1;
  end;
end;
/
