  name varchar2(100);                                                                                                                                            +
 BEGIN                                                                                                                                                           +
   o_code := 'p';                                                                                                                                                +
   o_msg := 'pro2';                                                                                                                                              +
   name := PLPM.FN_GETPNAME();                                                                                                                                   +
   dbms_output.put_line('in procedure, name = ' || name);                                                                                                        +
 END;                                                                                                                                                            +
 
(1 row)

