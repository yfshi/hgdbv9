create database link dblnk1
connect to system identified by "oracle"
using '(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=127.0.0.1)(PORT=5432)))
(CONNECT_DATA=(SERVICE_NAME=postgres)))';
