--
-- partition table
--
CREATE TABLE prt (a int, b int, c varchar(4000)) PARTITION BY RANGE(a);
CREATE TABLE prt_p1 PARTITION OF prt FOR VALUES FROM (0) TO (250);
CREATE TABLE prt_p2 PARTITION OF prt FOR VALUES FROM (500) TO (600);
CREATE INDEX iprt_p1_a on prt_p1(a);
SELECT dbms_metadata.get_ddl('TABLE','PRT', 'PUBLIC') from dual;
                                          get_ddl                                          
-------------------------------------------------------------------------------------------
 CREATE TABLE "PUBLIC"."PRT"(                                                             +
  "A" integer,                                                                            +
  "B" integer,                                                                            +
  "C" varchar2(4000)                                                                      +
 ) PARTITION BY RANGE ("A")                                                               +
 TABLESPACE "PG_DEFAULT"                                                                  +
 CREATE TABLE "PUBLIC"."PRT_P1" PARTITION OF "PUBLIC"."PRT" FOR VALUES FROM (0) TO (250)  +
 TABLESPACE "PG_DEFAULT"                                                                  +
 CREATE INDEX "IPRT_P1_A" ON "PUBLIC"."PRT_P1" USING "BTREE" ("A");                       +
 CREATE TABLE "PUBLIC"."PRT_P2" PARTITION OF "PUBLIC"."PRT" FOR VALUES FROM (500) TO (600)+
 TABLESPACE "PG_DEFAULT"                                                                  +
 
(1 row)

