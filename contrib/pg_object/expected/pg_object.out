/* Test functions and stored procedures below */
/*
 * test 1:
 *		step 1
 * create function and query the pg_object table.
 */
CREATE OR REPLACE FUNCTION testfunc(num INT)
RETURNS INT
as $$
DECLARE
i int;
a text;
BEGIN
	i = 0;
	num = num +1;
	a = function1(112);
	i = function2(num);
	return i;
END;
$$ LANGUAGE plpgsql;
/
select * from pg_object;
