/*
 * test 2:
 *		step 1
 * create procedure and query the pg_object table.
 */
CREATE OR REPLACE PROCEDURE testproc(num INT)
as $$
DECLARE
i int;
a text;
BEGIN
	i = 0;
	num = num +1;
	a = function1(112);
	i = function2(num);
	raise notice ' i = %', i;
END;
$$ LANGUAGE plpgsql;
/
/*
 * test 2:
 *		step 2
 * alter procedure schema and query the pg_object table.
 */
alter procedure testproc set schema mysql;
