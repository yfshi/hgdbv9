<refentry id="sql-createredactionpolicy">
 <indexterm zone="sql-createredactionpolicy">
  <primary>CREATE REDACTION POLICY</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>CREATE REDACTION POLICY</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>CREATE REDACTION POLICY</refname>
  <refpurpose>create a redaction policy</refpurpose>
 </refnamediv>

<refsynopsisdiv>
  <synopsis>

CREATE REDACTION POLICY name ON table_name
  FOR (for_expression)
  ADD [ COLUMN ] 
  [ 
	name USING func_name [WITH OPTIONS (SCOP value | EXCEPTION value)]
  ] [, ...]
  [ ENABLE | DISAABLE ]

  </synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>

  <para>
   <command>postmaster</command> is a deprecated alias of <command>postgres</command>.
  </para>
 </refsect1>

 <refsect1>
  <title>See Also</title>

  <para>
   <xref linkend="app-postgres"/>
  </para>
 </refsect1>
</refentry>
