 <refnamediv>
  <refname>DROP REDACTION POLICY</refname>
  <refpurpose>drop a redaction policy </refpurpose>
 </refnamediv>

<refsynopsisdiv>
  <synopsis>

DROP REDCATION POLICY [ IF EXISTS ] name ON table_name [ CASCADE | RESTRICT ]

  </synopsis>
 </refsynopsisdiv>

